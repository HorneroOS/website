---
/**
 * Edition maturity as a segmented meter (Hornero Signal, RFC 0001 §2) plus its
 * text label. The value always comes from the pinned edition catalogue; the
 * meter is decorative and hidden from assistive tech, the label carries meaning.
 */
import type { Maturity } from '../data/product';
import type { Locale } from '../i18n/ui';

interface Props {
  maturity: Maturity;
  locale?: Locale;
}

const { maturity, locale = 'es' } = Astro.props;
const displayMaturity: Maturity = maturity === 'planned' ? 'planned' : 'supported';
const steps: Maturity[] = ['planned', 'experimental', 'preview', 'supported'];
const level = steps.indexOf(displayMaturity) + 1;
const names: Record<Maturity, string> =
  locale === 'es'
    ? { planned: 'Planificado', experimental: 'Soportado', preview: 'Soportado', supported: 'Soportado' }
    : { planned: 'Planned', experimental: 'Supported', preview: 'Supported', supported: 'Supported' };
const color: Record<Maturity, string> = {
  planned: 'var(--rule-strong)',
  experimental: 'var(--phosphor)',
  preview: 'var(--phosphor)',
  supported: 'var(--phosphor)',
};
---

<span class="meter maturity-meter" style={`--meter-color:${color[displayMaturity]}`}>
  <span class="maturity" data-maturity={displayMaturity}>{names[displayMaturity]}</span>
  <span class="meter-track" aria-hidden="true">
    {steps.map((_, index) => <i class={index < level ? 'on' : undefined} />)}
  </span>
  <span class="meter-value" aria-hidden="true">{level}/{steps.length}</span>
</span>

<style>
  .maturity-meter {
    flex-wrap: wrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .meter-track :global(i.on) {
      transform-origin: left;
      animation: segment-in var(--dur-settle) var(--ease-settle) both;
    }

    .meter-track :global(i.on:nth-child(2)) {
      animation-delay: 50ms;
    }

    .meter-track :global(i.on:nth-child(3)) {
      animation-delay: 100ms;
    }

    .meter-track :global(i.on:nth-child(4)) {
      animation-delay: 150ms;
    }
  }
</style>
