---
import SiteLayout from '../../layouts/SiteLayout.astro';
import MaturityMeter from '../MaturityMeter.astro';
import StageBadge from '../StageBadge.astro';
import CaptureFigure from '../CaptureFigure.astro';
import { feature, stageFromMaturity } from '../../data/features';
import { editionCatalogue, editions, extensionCatalogue, layouts, themes } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);
const desktop = editions.find((e) => e.id === 'desktop');
if (!desktop) throw new Error('The pinned edition catalogue has no desktop edition');
const compositors = editionCatalogue.compositors.filter((c) => c.id !== 'labwc');
const layoutCount = layouts.length;
const themeCount = themes.length;
const extensionCount = extensionCatalogue.plugins.length;

// What you can change, each with its ledger stage. Stages are never typed here.
const levers = [
  { id: 'layouts', href: '/layouts', stage: feature('layouts').stage, es: `${layoutCount} layouts`, en: `${layoutCount} layouts`, noteEs: 'Barras, rieles, islas y docks intercambiables.', noteEn: 'Swappable bars, rails, islands and docks.' },
  { id: 'themes', href: '/themes', stage: feature('themes').stage, es: `${themeCount} temas`, en: `${themeCount} themes`, noteEs: 'Apariencias coordinadas con sus fondos.', noteEn: 'Coordinated appearances with their wallpapers.' },
  { id: 'modes', href: '/modes', stage: feature('experience-modes').stage, es: '5 modos', en: '5 modes', noteEs: 'Focus, Everyday, Signal, Gaming y Studio.', noteEn: 'Focus, Everyday, Signal, Gaming and Studio.' },
  { id: 'chromatic', href: '/chromatic', stage: feature('chromatic').stage, es: 'Chromatic', en: 'Chromatic', noteEs: 'Color dinámico desde tu fondo, opcional.', noteEn: 'Optional dynamic colour from your wallpaper.' },
  { id: 'extensions', href: '/extensions', stage: feature('pluginkit').stage, es: `${extensionCount} extensiones`, en: `${extensionCount} extensions`, noteEs: 'Widgets de barra, escritorio y Dashboard.', noteEn: 'Bar, desktop and Dashboard widgets.' },
  { id: 'javi', href: '/companion', stage: feature('companion').stage, es: 'Javi', en: 'Javi', noteEs: 'El hornero que vive en el escritorio. Se puede apagar.', noteEn: 'The hornero that lives on the desktop. You can turn him off.' },
];

// Quick keys documented in HorneroOS/docs desktop/shortcuts.md and everyday-apps.md.
const keys = [
  { k: 'Ctrl + Space', es: 'Abrir el launcher: aplicaciones y comandos', en: 'Open the launcher: applications and commands' },
  { k: 'Super + T', es: 'Terminal', en: 'Terminal' },
  { k: 'Super + W', es: 'Navegador', en: 'Browser' },
  { k: 'Super + F', es: 'Archivos (gráfico)', en: 'Files (graphical)' },
  { k: 'Super + E', es: 'Archivos (en la terminal)', en: 'Files (in the terminal)' },
  { k: 'Super + X', es: 'Menú de sesión: bloquear, salir, apagar', en: 'Session menu: lock, log out, shut down' },
  { k: 'Super + /', es: 'Ayuda con todos los atajos', en: 'Help with every shortcut' },
];
---

<SiteLayout
  title={isEs ? 'Desktop: la base de HorneroOS | HorneroOS' : 'Desktop: the HorneroOS base | HorneroOS'}
  socialImage="/og/desktop.png"
  socialImageAlt={isEs ? 'HorneroOS Desktop con el estado de cada función (layouts, temas, modos, Chromatic y PluginKit) tomado del registro del proyecto.' : 'HorneroOS Desktop with the status of each feature (layouts, themes, modes, Chromatic and PluginKit) taken from the project ledger.'}
  description={isEs ? 'HorneroOS Desktop es la edición base: un escritorio Wayland sobre Arch con Hyprland, shell propio, layouts, temas y extensiones, pensado para trabajar horas sin estorbar.' : 'HorneroOS Desktop is the base edition: a Wayland desktop on Arch with Hyprland, its own shell, layouts, themes and extensions, made for working long hours without getting in the way.'}
>
  <section class="section desk-intro" aria-labelledby="desk-title">
    <p class="plate-id"><strong>CH 01</strong><span>{isEs ? 'Edición Desktop' : 'Desktop edition'}</span><span>{isEs ? 'La base de las tres' : 'The base of all three'}</span></p>
    <div class="hero-head">
      <h1 id="desk-title">Desktop <span class="tagline">{isEs ? 'Tu escritorio, a tu manera.' : 'Your desktop, your way.'}</span></h1>
      <MaturityMeter maturity={desktop.maturity} locale={locale} />
    </div>
    <p class="lede">
      {isEs ? 'Desktop es el escritorio sobre el que se apoyan Studio y Gaming: shell propio sobre Quickshell, un launcher, un Dashboard, un Centro de control y un compositor Wayland. Todo lo que ves tiene un ajuste, con vista previa y vuelta atrás.' : 'Desktop is the desktop that Studio and Gaming build on: its own shell on Quickshell, a launcher, a Dashboard, a Control Center and a Wayland compositor. Everything you see has a setting, with a preview and a way back.'}
    </p>
    <p class="hero-ctas">
      <a class="cta primary" href={L('/install')}>{isEs ? 'Descargá la ISO Preview' : 'Download the Preview ISO'}</a>
      <a class="cta secondary" href={L('/showroom')}>{isEs ? 'Ver capturas reales' : 'See real captures'}</a>
    </p>
  </section>

  <section class="section desk-capture" aria-label={isEs ? 'El escritorio trabajando' : 'The desktop at work'}>
    <CaptureFigure slot="desktop-hero" locale={locale} eager />
  </section>

  <section class="section" aria-labelledby="levers-title">
    <h2 id="levers-title">{isEs ? 'Todo se puede cambiar' : 'Everything can be changed'}</h2>
    <p class="desk-copy">
      {isEs ? 'HorneroOS trae los mejores valores por defecto y te deja cambiar el resto. Cada palanca muestra su estado real: lo lanzado, lo que está en main sin lanzar y lo experimental salen del registro del proyecto, no de este texto.' : 'HorneroOS ships the best defaults and lets you change the rest. Each lever shows its real status: what is released, what is on main but unreleased and what is experimental come from the project ledger, not from this text.'}
    </p>
    <ul class="desk-levers" role="list">
      {
        levers.map((l) => (
          <li>
            <a href={L(l.href)}>
              <strong>{isEs ? l.es : l.en}</strong>
              <span>{isEs ? l.noteEs : l.noteEn}</span>
              <StageBadge stage={l.stage} locale={locale} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="flow-title">
    <h2 id="flow-title">{isEs ? 'Un día de trabajo, con el teclado' : 'A working day, from the keyboard'}</h2>
    <p class="desk-copy">
      {isEs ? 'Los atajos de la configuración por defecto de Hyprland. Pueden variar con tu versión y tu configuración.' : 'The default Hyprland configuration’s shortcuts. They can vary with your version and configuration.'}{' '}
      <a class="text-link" href={L('/docs/desktop/shortcuts/')}>{isEs ? 'Todos los atajos' : 'All shortcuts'}</a>
    </p>
    <dl class="desk-keys">
      {
        keys.map((key) => (
          <div>
            <dt><kbd>{key.k}</kbd></dt>
            <dd>{isEs ? key.es : key.en}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section desk-split" aria-labelledby="custom-title">
    <div>
      <h2 id="custom-title">{isEs ? 'Cambiá la forma, no el sistema' : 'Change the shape, not the system'}</h2>
      <p class="desk-copy">
        {isEs ? 'El selector de layouts reordena barras y rieles sin tocar tus aplicaciones ni tu tema. La captura es real y anterior a Hornero Signal; está etiquetada así.' : 'The layout picker rearranges bars and rails without touching your applications or theme. The capture is real and predates Hornero Signal; it is labelled accordingly.'}
      </p>
    </div>
    <CaptureFigure slot="customise-layout-picker" locale={locale} />
  </section>

  <section class="section" aria-labelledby="comp-title">
    <h2 id="comp-title">{isEs ? 'Compositores' : 'Compositors'}</h2>
    <ul class="desk-comps" role="list">
      {
        compositors.map((c) => (
          <li>
            <strong>{c.id === 'hyprland' ? 'Hyprland' : 'Niri'}</strong>
            <StageBadge stage={stageFromMaturity(c.maturity)} locale={locale} />
            <span>{isEs ? (c.id === 'hyprland' ? 'El compositor por defecto.' : 'Disponible para quien quiera probarlo; todavía experimental.') : (c.id === 'hyprland' ? 'The default compositor.' : 'Available for those who want to try it; still experimental.')}</span>
          </li>
        ))
      }
    </ul>
    <p class="desk-copy"><a class="text-link" href={L('/docs/desktop/compositors/')}>{isEs ? 'Elegir o resolver problemas con un compositor' : 'Choose or troubleshoot a compositor'}</a></p>
  </section>

  <section class="section" aria-labelledby="more-title">
    <h2 id="more-title">{isEs ? 'Y después, Studio o Gaming' : 'And then Studio or Gaming'}</h2>
    <p class="desk-copy">
      {isEs ? 'Studio y Gaming son Desktop con un oficio: se eligen al instalar desde la misma ISO.' : 'Studio and Gaming are Desktop with a craft: you choose them when installing from the same ISO.'}
    </p>
    <p class="hero-ctas">
      <a class="cta secondary" href={L('/studio')}>Studio</a>
      <a class="cta secondary" href={L('/gaming')}>Gaming</a>
      <a class="cta secondary" href={L('/editions')}>{isEs ? 'Todas las ediciones' : 'All editions'}</a>
    </p>
  </section>
</SiteLayout>

<style>
  .desk-intro h1 .tagline {
    display: block;
  }

  .desk-copy {
    max-width: 68ch;
    color: var(--ink-muted);
  }

  .desk-capture {
    max-width: 70rem;
  }

  .desk-levers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .desk-levers li {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .desk-levers a {
    display: grid;
    height: 100%;
    align-content: start;
    gap: 0.5rem;
    padding: 1.1rem;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-standard);
  }

  .desk-levers a:hover {
    background: var(--raised);
  }

  .desk-levers strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .desk-levers span:not(.stage-badge) {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .desk-keys {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin: 0;
  }

  .desk-keys div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--rule);
  }

  .desk-keys dd {
    margin: 0;
    color: var(--ink-muted);
  }

  kbd {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule-strong);
    border-bottom-width: 2px;
    border-radius: var(--radius-small);
    background: var(--panel);
    font: 500 0.78rem var(--font-mono);
    white-space: nowrap;
  }

  .desk-split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .desk-comps {
    display: grid;
    gap: 0;
    padding: 0;
    list-style: none;
  }

  .desk-comps li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--rule);
  }

  .desk-comps span:not(.stage-badge) {
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .desk-levers,
    .desk-keys {
      grid-template-columns: 1fr;
    }

    .desk-split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .desk-keys div {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
