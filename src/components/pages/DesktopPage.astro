---
import SiteLayout from '../../layouts/SiteLayout.astro';
import MaturityMeter from '../MaturityMeter.astro';
import StageBadge from '../StageBadge.astro';
import CaptureFigure from '../CaptureFigure.astro';
import CaptureGallery from '../CaptureGallery.astro';
import { feature, stageFromMaturity } from '../../data/features';
import { appsCatalog, editionCatalogue, editions, extensionCatalogue, layouts, themes } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/desktop';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const desktop = editions.find((e) => e.id === 'desktop');
if (!desktop) throw new Error('The pinned edition catalogue has no desktop edition');
const compositors = editionCatalogue.compositors.filter((c) => c.id !== 'labwc');
const layoutCount = layouts.length;
const themeCount = themes.length;
const extensionCount = extensionCatalogue.plugins.length;

// What you can change, each with its ledger stage. Stages are never typed here.
const levers = [
  {
    id: 'layouts',
    href: '/layouts',
    stage: feature('layouts').stage,
    es: `${layoutCount} layouts`,
    en: `${layoutCount} layouts`,
    note: { es: 'Barras, rieles, islas y docks intercambiables.', en: 'Swappable bars, rails, islands and docks.' },
  },
  {
    id: 'themes',
    href: '/themes',
    stage: feature('themes').stage,
    es: `${themeCount} temas`,
    en: `${themeCount} themes`,
    note: { es: 'Apariencias coordinadas con sus fondos.', en: 'Coordinated appearances with their wallpapers.' },
  },
  {
    id: 'modes',
    href: '/modes',
    stage: feature('experience-modes').stage,
    es: '5 modos',
    en: '5 modes',
    note: { es: 'Focus, Everyday, Signal, Gaming y Studio.', en: 'Focus, Everyday, Signal, Gaming and Studio.' },
  },
  {
    id: 'chromatic',
    href: '/chromatic',
    stage: feature('chromatic').stage,
    es: 'Chromatic',
    en: 'Chromatic',
    note: { es: 'Color dinámico desde tu fondo, opcional.', en: 'Optional dynamic colour from your wallpaper.' },
  },
  {
    id: 'extensions',
    href: '/extensions',
    stage: feature('pluginkit').stage,
    es: `${extensionCount} extensiones`,
    en: `${extensionCount} extensions`,
    note: { es: 'Widgets de barra, escritorio y Dashboard.', en: 'Bar, desktop and Dashboard widgets.' },
  },
  {
    id: 'javi',
    href: '/companion',
    stage: feature('companion').stage,
    es: 'Javi',
    en: 'Javi',
    note: {
      es: 'El hornero que vive en el escritorio. Se puede apagar.',
      en: 'The hornero that lives on the desktop. You can turn it off.',
    },
  },
  {
    id: 'apps',
    href: '/apps',
    stage: feature('hornero-apps').stage,
    es: `${appsCatalog.total_apps} apps verificadas`,
    en: `${appsCatalog.total_apps} verified apps`,
    note: {
      es: 'Hornero Apps: Arch, Flathub, Web Apps y 9 perfiles con procedencia.',
      en: 'Hornero Apps: Arch, Flathub, Web Apps, and 9 profiles with provenance.',
    },
  },
  {
    id: 'welcome',
    href: '/welcome',
    stage: feature('hornero-welcome').stage,
    es: 'Hornero Welcome',
    en: 'Hornero Welcome',
    note: {
      es: 'First Flight (9 escenas), Explore Hornero y What’s New.',
      en: 'First Flight (9 scenes), Explore Hornero, and What’s New.',
    },
  },
  {
    id: 'try',
    href: '/try',
    stage: feature('hornero-playground').stage,
    es: 'Hornero Playground',
    en: 'Hornero Playground',
    note: {
      es: 'Probá en browser self-host, VM local (60 FPS) o Live USB.',
      en: 'Try in self-hosted browser, local VM (60 FPS), or Live USB.',
    },
  },
];

// Quick keys documented in HorneroOS/docs desktop/shortcuts.md and everyday-apps.md.
const keys = [
  {
    k: 'Ctrl + Space',
    es: 'Abrir el launcher: aplicaciones y comandos',
    en: 'Open the launcher: applications and commands',
  },
  { k: 'Super + T', es: 'Terminal', en: 'Terminal' },
  { k: 'Super + W', es: 'Navegador', en: 'Browser' },
  { k: 'Super + F', es: 'Archivos (gráfico)', en: 'Files (graphical)' },
  { k: 'Super + E', es: 'Archivos (en la terminal)', en: 'Files (in the terminal)' },
  { k: 'Super + X', es: 'Menú de sesión: bloquear, salir, apagar', en: 'Session menu: lock, log out, shut down' },
  { k: 'Super + /', es: 'Ayuda con todos los atajos', en: 'Help with every shortcut' },
];
---

<SiteLayout
  title={m.desktopLaBaseDeHorneroos}
  socialImage="/og/desktop.png"
  socialImageAlt={m.horneroosDesktopConElEstado}
  description={m.horneroosDesktopEsLaEdicion}
>
  <section class="section desk-intro" aria-labelledby="desk-title">
    <p class="plate-id">
      <strong>CH 01</strong>
      <span>{m.edicionDesktop}</span>
      <span>{m.laBaseDeLasTres}</span>
    </p>
    <div class="hero-head">
      <h1 id="desk-title">
        Desktop <span class="tagline">{m.tuEscritorioATuManera}</span>
      </h1>
      <MaturityMeter maturity={desktop.maturity} locale={locale} />
    </div>
    <p class="lede">{m.desktopEsElEscritorioSobre}</p>
    <p class="hero-ctas">
      <a class="cta primary" href={L('/install')}>
        {m.descargaLaIsoActual}
      </a>
      <a class="cta secondary" href={L('/try')}>
        {m.probarHorneroOS}
      </a>
      <a class="cta secondary" href={L('/showroom')}>
        {m.verElShowroom}
      </a>
    </p>
  </section>

  <section class="section desk-capture" aria-label={m.elEscritorioTrabajando}>
    <CaptureFigure slot="CAP-DESKTOP-01" locale={locale} eager />
  </section>

  <section class="section" aria-labelledby="levers-title">
    <h2 id="levers-title">{m.ajustesDelEscritorio}</h2>
    <p class="desk-copy">{m.horneroosTraeValoresPorDefecto}</p>
    <ul class="desk-levers" role="list">
      {levers.map((l) => (
        <li>
          <a href={L(l.href)}>
            <strong>{l[locale]}</strong>
            <span>{l.note[locale]}</span>
            <StageBadge stage={l.stage} locale={locale} />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="flow-title">
    <h2 id="flow-title">{m.unDiaDeTrabajoCon}</h2>
    <p class="desk-copy">
      {m.losAtajosDeLaConfiguracion}{' '}
      <a class="text-link" href={L('/docs/desktop/shortcuts/')}>
        {m.todosLosAtajos}
      </a>
    </p>
    <dl class="desk-keys">
      {keys.map((key) => (
        <div>
          <dt>
            <kbd>{key.k}</kbd>
          </dt>
          <dd>{key[locale]}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section desk-split" aria-labelledby="custom-title">
    <div>
      <h2 id="custom-title">{m.cambiaLaFormaNoEl}</h2>
      <p class="desk-copy">{m.elSelectorDeLayoutsReordena}</p>
    </div>
    <CaptureFigure slot="CAP-DESKTOP-02" locale={locale} />
  </section>

  <section class="section" aria-labelledby="comp-title">
    <h2 id="comp-title">{m.compositores}</h2>
    <ul class="desk-comps" role="list">
      {compositors.map((c) => (
        <li>
          <strong>{c.id === 'hyprland' ? 'Hyprland' : 'Niri'}</strong>
          <StageBadge stage={stageFromMaturity(c.maturity)} locale={locale} />
          <span>{c.id === 'hyprland' ? m.defaultCompositor : m.niriCompositor}</span>
        </li>
      ))}
    </ul>
    <p class="desk-copy">
      <a class="text-link" href={L('/docs/desktop/compositors/')}>
        {m.elegirOResolverProblemasCon}
      </a>
    </p>
  </section>

  <section class="section" aria-labelledby="more-title">
    <h2 id="more-title">{m.yDespuesStudioOGaming}</h2>
    <p class="desk-copy">{m.studioYGamingSonDesktop}</p>
    <p class="hero-ctas">
      <a class="cta secondary" href={L('/studio')}>
        Studio
      </a>
      <a class="cta secondary" href={L('/gaming')}>
        Gaming
      </a>
      <a class="cta secondary" href={L('/editions')}>
        {m.todasLasEdiciones}
      </a>
    </p>
  </section>

  <CaptureGallery route="/desktop" locale={locale} exclude={['CAP-DESKTOP-01', 'CAP-DESKTOP-02']} />
</SiteLayout>

<style>
  .desk-intro h1 .tagline {
    display: block;
  }

  .desk-copy {
    max-width: 68ch;
    color: var(--ink-muted);
  }

  .desk-capture {
    max-width: 70rem;
  }

  .desk-levers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .desk-levers li {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .desk-levers a {
    display: grid;
    height: 100%;
    align-content: start;
    gap: 0.5rem;
    padding: 1.1rem;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-standard);
  }

  .desk-levers a:hover {
    background: var(--raised);
  }

  .desk-levers strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .desk-levers span:not(.stage-badge) {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .desk-keys {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin: 0;
  }

  .desk-keys div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--rule);
  }

  .desk-keys dd {
    margin: 0;
    color: var(--ink-muted);
  }

  kbd {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule-strong);
    border-bottom-width: 2px;
    border-radius: var(--radius-small);
    background: var(--panel);
    font: 500 0.78rem var(--font-mono);
    white-space: nowrap;
  }

  .desk-split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .desk-comps {
    display: grid;
    gap: 0;
    padding: 0;
    list-style: none;
  }

  .desk-comps li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--rule);
  }

  .desk-comps span:not(.stage-badge) {
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .desk-levers,
    .desk-keys {
      grid-template-columns: 1fr;
    }

    .desk-split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .desk-keys div {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
