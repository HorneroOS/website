---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);
---

<SiteLayout title={isEs ? 'Buscar | HorneroOS' : 'Search | HorneroOS'} description={isEs ? 'Buscá en el sitio de HorneroOS y en la documentación.' : 'Search the HorneroOS site and documentation.'} noindex>
  <section class="section">
    <p class="plate-id"><strong>Índice local</strong><span>ARG / 199X</span><span>Pagefind · en tu navegador</span></p>
    <h1>{isEs ? 'Buscar' : 'Search'}</h1>
    <p>
      {isEs ? 'Buscá en este sitio y en la documentación. El índice se construye con el sitio y corre en tu navegador: nada de lo que escribas sale de esta página.' : 'Searches this site and the documentation. The index is built with the site and runs in your browser: nothing you type leaves this page.'}
    </p>
    <div class="search" data-pagefind-ignore>
      <pagefind-input placeholder={isEs ? 'Buscar en HorneroOS' : 'Search HorneroOS'}></pagefind-input>
      <pagefind-summary default-message={isEs ? 'Buscá temas, layouts, comandos y documentación.' : 'Search themes, layouts, commands, and documentation.'}></pagefind-summary>
      <pagefind-results></pagefind-results>
    </div>
    <noscript>
      <p>
        {isEs ? 'La búsqueda necesita JavaScript. Explorá la ' : 'Search needs JavaScript. Browse the '}<a href={L('/docs/')}>{isEs ? 'documentación' : 'documentation'}</a>{isEs ? ' en su lugar.' : ' instead.'}
      </p>
    </noscript>
  </section>
</SiteLayout>

<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
<script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>

<style is:global>
  .search {
    --pf-text: var(--text);
    --pf-text-secondary: var(--text-muted);
    --pf-text-muted: var(--text-muted);
    --pf-background: var(--surface-raised);
    --pf-border: var(--line);
    --pf-border-focus: var(--focus);
    --pf-hover: var(--surface);
    --pf-mark: var(--accent-ink);
    --pf-font: var(--font-ui);
    --pf-outline-focus: var(--focus);
    --pf-input-height: 3.25rem;
    --pf-input-font-size: 1rem;
    --pf-summary-font-size: 0.78rem;
    --pf-result-title-font-size: 1.08rem;
    --pf-result-excerpt-font-size: 0.95rem;
    --pf-border-radius: 10px;
    --pf-results-gap: 0.75rem;
    margin-top: 1.5rem;
    max-width: 72ch;
  }

  .search pagefind-summary {
    display: block;
    margin: 1rem 0;
    color: var(--text-muted);
    font-family: var(--font-data);
  }

  .search mark {
    /* Pagefind uses high-specificity selectors for highlighted excerpts. */
    background: var(--accent) !important;
    border-radius: 0.15em;
    padding-inline: 0.12em;
  }

  @media (max-width: 40rem) {
    .search {
      --pf-input-height: 3rem;
      --pf-result-title-font-size: 1rem;
      --pf-result-excerpt-font-size: 0.9rem;
    }
  }
</style>
