---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/search';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
---

<SiteLayout title={m.buscarHorneroos} description={m.buscaEnElSitioDe} noindex>
  <section class="section">
    <p class="plate-id">
      <strong>{m.plateLabel}</strong>
      <span>{m.plateMeta}</span>
    </p>
    <h1>{m.buscar}</h1>
    <p>{m.buscaEnEsteSitioY}</p>
    <div class="search" data-pagefind-ignore>
      <pagefind-input placeholder={m.buscarEnHorneroos}></pagefind-input>
      <pagefind-summary default-message={m.buscaTemasLayoutsComandosY}></pagefind-summary>
      <pagefind-results></pagefind-results>
    </div>
    <noscript>
      <p>
        {m.laBusquedaNecesitaJavascriptExplora}
        <a href={L('/docs/')}>{m.documentacion}</a>
        {m.enSuLugar}
      </p>
    </noscript>
  </section>
</SiteLayout>

<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
<script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>

<style is:global>
  .search {
    --pf-text: var(--ink);
    --pf-text-secondary: var(--ink-muted);
    --pf-text-muted: var(--ink-muted);
    --pf-background: var(--raised);
    --pf-border: var(--rule);
    --pf-border-focus: var(--focus);
    --pf-hover: var(--panel);
    --pf-mark: var(--on-signal);
    --pf-font: var(--font-sans);
    --pf-outline-focus: var(--focus);
    --pf-input-height: 3.25rem;
    --pf-input-font-size: 1rem;
    --pf-summary-font-size: 0.78rem;
    --pf-result-title-font-size: 1.08rem;
    --pf-result-excerpt-font-size: 0.95rem;
    --pf-border-radius: 10px;
    --pf-results-gap: 0.75rem;
    margin-top: 1.5rem;
    max-width: 72ch;
  }

  .search pagefind-summary {
    display: block;
    margin: 1rem 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }

  .search mark {
    /* Pagefind uses high-specificity selectors for highlighted excerpts. */
    background: var(--signal) !important;
    border-radius: 0.15em;
    padding-inline: 0.12em;
  }

  @media (max-width: 40rem) {
    .search {
      --pf-input-height: 3rem;
      --pf-result-title-font-size: 1rem;
      --pf-result-excerpt-font-size: 0.9rem;
    }
  }
</style>
