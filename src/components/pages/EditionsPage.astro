---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AppLogo from '../../components/AppLogo.astro';
import MaturityMeter from '../../components/MaturityMeter.astro';
import CaptureFigure from '../../components/CaptureFigure.astro';
import {
  editions,
  editionCatalogue,
  studioCatalogue,
  gamingCatalogue,
  layouts,
  themes,
  type Maturity,
} from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/editions';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const maturityLabels: Record<Maturity, string> = m.maturityLabels;
const displayMaturity = (maturity: Maturity): Maturity => (maturity === 'planned' ? 'planned' : 'supported');
type EditionId = 'desktop' | 'server' | 'agents' | 'studio' | 'gaming';
const copy: Record<EditionId, { channel: string; tagline: string; body: string; href: string; link: string }> = m.copy(
  layouts.length,
  themes.length,
);
const familyOrder: EditionId[] = ['desktop', 'studio', 'gaming', 'server', 'agents'];
const byId = Object.fromEntries(editions.map((edition) => [edition.id, edition]));
const rows = familyOrder.map((id) => {
  const edition = byId[id];
  if (!edition) throw new Error(`Edition ${id} is missing from the pinned catalogue`);
  const parent = edition.extends ? byId[edition.extends] : undefined;
  const inherited = edition.compositor?.supported ?? parent?.compositor?.supported ?? [];
  const compositors = inherited.map((backend) => ({
    id: backend,
    maturity: (editionCatalogue.compositors.find((item) => item.id === backend)?.maturity ?? 'planned') as Maturity,
  }));
  return {
    ...edition,
    ...copy[id],
    name: edition.title.replace('HorneroOS ', ''),
    parent: parent?.title.replace('HorneroOS ', ''),
    compositors,
  };
});
const compositorName = (id: string) => (id === 'hyprland' ? 'Hyprland' : id === 'niri' ? 'Niri' : id);

const yes = m.si;
const no = '—';
const studioSpecs = studioCatalogue.specializations.length;
const gamingSpecs = gamingCatalogue?.specializations.length ?? 0;
const matrix = [
  { label: m.baseHorneroosYHorneroctl, cells: [yes, yes, yes, yes, yes] },
  { label: m.horneroShellYCentroDe, cells: [yes, yes, yes, no, no] },
  { label: m.especializacionesCreativas, cells: [no, String(studioSpecs), no, no, no] },
  { label: m.perfilesDeJuego, cells: [no, no, String(gamingSpecs), no, no] },
  {
    label: m.seInstalaHoyDesdeLa,
    cells: rows.map((row) => (row.maturity === 'planned' ? no : yes)),
  },
];
---

<SiteLayout
  socialImage="/og/editions.png"
  socialImageAlt={m.lasEdicionesDeHorneroosCon}
  title={m.edicionesDesktopStudioYGaming}
  description={m.horneroosEsUnaBaseCon}
>
  <section class="intro section">
    <p class="plate-id">
      <strong>{m.ediciones}</strong>
      <span>{m.madurezDesdeElCatalogoFijado}</span>
    </p>
    <h1>{m.unaBaseUnOficioPor}</h1>
    <p class="lede">{m.desktopStudioYGamingSon}</p>
    <div class="cta-row">
      <a class="cta primary" href={L('/install')}>
        {m.descargaLaIsoActual}
      </a>
      <a class="cta secondary" href="#matrix-title">
        {m.comparaLasEdiciones}
      </a>
    </div>
  </section>

  <section class="section family" aria-labelledby="family-title">
    <h2 id="family-title" class="sr-only">
      {m.lasEdicionesDeHorneroos}
    </h2>
    <ol class="rows" role="list">
      {rows.map((row) => (
        <li class:list={['row', `maturity-${displayMaturity(row.maturity)}`]} id={row.id}>
          <div class="row-id">
            <p class="eyebrow">
              <b>{row.channel}</b>
              <span>{row.name}</span>
            </p>
            <h2>{row.tagline}</h2>
            <MaturityMeter maturity={row.maturity} locale={locale} />
          </div>
          <div class="row-body">
            <p>{row.body}</p>
            {row.parent && (
              <p class="extends">
                {m.seBasaEn}
                <a href={`#${row.extends}`}>{row.parent}</a>
              </p>
            )}
            {row.compositors.length > 0 && (
              <ul class="backends" role="list" aria-label={m.compositoresWayland}>
                {row.compositors.map((backend) => (
                  <li>
                    <AppLogo id={backend.id} />
                    <strong>{compositorName(backend.id)}</strong>
                    <span class="maturity" data-maturity={displayMaturity(backend.maturity)}>
                      {maturityLabels[displayMaturity(backend.maturity)]}
                    </span>
                  </li>
                ))}
              </ul>
            )}
            <a class="row-link" href={row.href.startsWith('/') ? L(row.href) : row.href}>
              {row.link}
            </a>
          </div>
          {row.id === 'desktop' && (
            <div class="row-shot">
              <CaptureFigure
                slot="CAP-HERO-01"
                crop="top"
                locale={locale}
                sizes="(min-width: 1100px) 420px, calc(100vw - 2rem)"
              />
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="section matrix" aria-labelledby="matrix-title">
    <h2 id="matrix-title">{m.queTraeCadaEdicion}</h2>
    <div class="table-scroll">
      <table>
        <caption>{m.composicionDeLasEdicionesSegun}</caption>
        <thead>
          <tr>
            <th scope="col">{m.capacidad}</th>
            {rows.map((row) => (
              <th scope="col">{row.name}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{m.madurez}</th>
            {rows.map((row) => (
              <td>
                <span class="maturity" data-maturity={displayMaturity(row.maturity)}>
                  {maturityLabels[displayMaturity(row.maturity)]}
                </span>
              </td>
            ))}
          </tr>
          {matrix.map((line) => (
            <tr>
              <th scope="row">{line.label}</th>
              {line.cells.map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section composition-note">
    <h2>{m.comoSeRelacionanLasEdiciones}</h2>
    <p>{m.studioYGamingSeBasan}</p>
    <p>{m.losEstadosDeEstaPagina}</p>
  </section>
</SiteLayout>

<style>
  .intro.section {
    margin-top: 0;
    padding-block: clamp(1rem, 3vw, 2.5rem) 0;
  }
  .intro h1 {
    max-width: 18ch;
    margin-block: 0.4rem 1rem;
    font-size: var(--step-4);
    line-height: 0.98;
  }
  .intro .lede {
    margin-bottom: 1.25rem;
  }
  .rows {
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: 1rem clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  .row:has(.row-shot) {
    grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 5fr);
  }
  .row::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: 2px;
    height: 10px;
    background: var(--signal);
    content: '';
  }
  .maturity-planned::before {
    background: var(--rule-strong);
  }
  .row-id {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }
  .row-id h2 {
    font-size: var(--step-2);
  }
  .maturity-planned .row-id h2 {
    color: var(--ink-muted);
  }
  .row-body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    color: var(--ink-muted);
  }
  .extends {
    font-size: var(--step--1);
  }
  .backends {
    --app-logo-size: 1.1rem;
    display: grid;
    gap: 0.4rem;
    list-style: none;
  }
  .backends li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
  }
  .row-shot {
    margin: 0;
  }
  .matrix td,
  .matrix th[scope='row'] {
    font-size: 0.92rem;
  }
  .matrix td {
    font-family: var(--font-mono);
  }
  .composition-note p {
    max-width: var(--measure);
    color: var(--ink-muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .row,
    .row:has(.row-shot) {
      grid-template-columns: 1fr;
    }
  }
</style>
