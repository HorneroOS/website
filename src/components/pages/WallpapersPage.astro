---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { themes, wallpapers } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);

const featuredWallpaper = wallpapers.find((wallpaper) => wallpaper.id === 'buenos-aires-nocturno');
if (!featuredWallpaper) throw new Error('Buenos Aires night photograph is missing from the pinned wallpaper catalogue');
const featuredTheme = themes.find((theme) => theme.id === featuredWallpaper.themeId);
if (!featuredTheme) throw new Error(`Theme ${featuredWallpaper.themeId} is missing from the pinned catalogue`);
const galleryWallpapers = wallpapers.filter((wallpaper) => wallpaper.id !== featuredWallpaper.id);

const filters = (
  isEs
    ? [
        { id: 'all', label: 'Todas las escenas' },
        { id: 'urban-night', label: 'Noche urbana' },
        { id: 'blue-hour', label: 'Hora azul' },
        { id: 'wetlands', label: 'Humedales' },
        { id: 'grassland', label: 'Pastizal' },
        { id: 'glacier', label: 'Glaciar' },
        { id: 'mineral', label: 'Luz mineral' },
      ]
    : [
        { id: 'all', label: 'All scenes' },
        { id: 'urban-night', label: 'Urban night' },
        { id: 'blue-hour', label: 'Blue hour' },
        { id: 'wetlands', label: 'Wetlands' },
        { id: 'grassland', label: 'Grassland' },
        { id: 'glacier', label: 'Glacier' },
        { id: 'mineral', label: 'Mineral light' },
      ]
).map((filter) => ({
  ...filter,
  count:
    filter.id === 'all'
      ? wallpapers.length
      : wallpapers.filter((wallpaper) => wallpaper.aestheticTags.includes(filter.id)).length,
}));
---

<SiteLayout
  title={isEs ? 'Fondos | HorneroOS' : 'Wallpapers | HorneroOS'}
  description={isEs ? 'Nueve fotografías hechas en Argentina, usadas como escenas por defecto de los temas Hornero Originals, con ubicación, fotógrafo, fuente y licencia Creative Commons.' : 'Nine photographs made in Argentina, used as the default scenes of the Hornero Originals themes, with location, photographer, source and Creative Commons license.'}
>
  <main class="wallpapers-page" data-locale={locale}>
    <header class="wallpaper-intro">
      <div class="wallpaper-intro-copy">
        <p class="plate-id"><strong>Fotografía argentina</strong><span>ARG / 199X</span><span>Autor y licencia en cada obra</span></p>
        <h1>{isEs ? 'Fondos' : 'Wallpapers'}</h1>
        <p>
          {isEs ? 'Fotografías hechas en Argentina, combinadas con los temas regionales Hornero Originals: el canal Beagle en la hora azul, los Esteros del Iberá, Buenos Aires de noche.' : 'Photographs made in Argentina, paired with the regional Hornero Originals themes: the Beagle Channel at blue hour, the Iberá wetlands, Buenos Aires at night.'}
        </p>
        <p class="collection-facts">
          <span>{wallpapers.length} {isEs ? 'fotografías' : 'photographs'}</span>
          <span>{new Set(wallpapers.map((wallpaper) => wallpaper.themeId)).size} {isEs ? 'looks de Hornero' : 'Hornero looks'}</span>
          <span>CC BY / CC BY-SA</span>
        </p>
      </div>
      <figure class="wallpaper-feature" data-tags={featuredWallpaper.aestheticTags.join(' ')}>
        <a
          href={featuredWallpaper.preview}
          aria-label={isEs ? `Abrí la fotografía completa: ${featuredWallpaper.title}` : `Open full photograph: ${featuredWallpaper.title}`}
          data-lightbox-image={featuredWallpaper.preview}
          data-lightbox-alt={featuredWallpaper.previewAlt}
          data-lightbox-title={featuredWallpaper.title}
          data-lightbox-place={featuredWallpaper.place}
          data-lightbox-photographer={featuredWallpaper.photographer}
          data-lightbox-license={featuredWallpaper.license}
          data-lightbox-license-url={featuredWallpaper.licenseUrl}
          data-lightbox-source={featuredWallpaper.sourcePage}
        >
          <img
            src={featuredWallpaper.previewSmall}
            srcset={`${featuredWallpaper.previewSmall} 720w, ${featuredWallpaper.preview} 1280w`}
            sizes="(min-width: 1100px) 42vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
            alt={featuredWallpaper.previewAlt}
            width="1280"
            height="720"
            fetchpriority="high"
            decoding="async"
          />
          <span class="feature-index">
            HORNERO ORIGINALS / {String(wallpapers.indexOf(featuredWallpaper) + 1).padStart(2, '0')}
          </span>
        </a>
        <figcaption>
          <div>
            <p>{featuredWallpaper.place}</p>
            <strong>{featuredWallpaper.title}</strong>
          </div>
          <div class="feature-credit">
            <span>{isEs ? 'Fotografía de' : 'Photograph by'} {featuredWallpaper.photographer}</span>
            <div class="feature-links">
              <a href={featuredWallpaper.sourcePage}>{isEs ? 'Fuente' : 'Source'}</a>
              <a href={featuredWallpaper.licenseUrl}>{featuredWallpaper.license}</a>
              <a href={`${L('/themes')}#${featuredTheme.id}`}>
                {isEs ? 'Ver' : 'See'} {featuredTheme.name} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </figcaption>
      </figure>
    </header>

    <section class="gallery" aria-labelledby="gallery-heading">
      <div class="gallery-heading">
        <div>
          <h2 id="gallery-heading">{isEs ? 'Todas las fotografías' : 'All photographs'}</h2>
        </div>
        <p>{isEs ? 'Cada fotografía es la escena por defecto de su tema de Hornero correspondiente.' : 'Each photograph is the default scene of its matching Hornero theme.'}</p>
      </div>
      <div class="filters" role="group" aria-label={isEs ? 'Filtrá los fondos por ambiente' : 'Filter wallpapers by atmosphere'}>
        {filters.map((filter, index) => (
          <button
            type="button"
            data-filter={filter.id}
            data-label={filter.label}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {filter.label}
            <span class="filter-count" aria-hidden="true">
              {filter.count}
            </span>
          </button>
        ))}
      </div>
      <p class="filter-status" aria-live="polite" aria-atomic="true">
        {isEs ? `Mostrando las ${wallpapers.length} fotografías.` : `Showing all ${wallpapers.length} photographs.`}
      </p>
      <ul class="wallpaper-grid" role="list">
        {galleryWallpapers.map((wallpaper, index) => (
          <li
            id={wallpaper.id}
            class:list={['wallpaper-card', `wallpaper-card-${index + 1}`]}
            data-tags={wallpaper.aestheticTags.join(' ')}
          >
            <a
              class="wallpaper-image"
              href={wallpaper.preview}
              aria-label={isEs ? `Abrí la vista previa completa: ${wallpaper.title}` : `Open full preview: ${wallpaper.title}`}
              data-lightbox-image={wallpaper.preview}
              data-lightbox-alt={wallpaper.previewAlt}
              data-lightbox-title={wallpaper.title}
              data-lightbox-place={wallpaper.place}
              data-lightbox-photographer={wallpaper.photographer}
              data-lightbox-license={wallpaper.license}
              data-lightbox-license-url={wallpaper.licenseUrl}
              data-lightbox-source={wallpaper.sourcePage}
            >
              <picture>
                <source
                  srcset={`${wallpaper.previewSmall} 720w, ${wallpaper.preview} 1280w`}
                  sizes="(min-width: 1100px) 48vw, (min-width: 680px) 48vw, calc(100vw - 2rem)"
                  type="image/webp"
                />
                <img
                  src={wallpaper.preview}
                  alt={wallpaper.previewAlt}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <span>
                {isEs ? 'Abrí la imagen' : 'Open image'} <span aria-hidden="true">↗</span>
              </span>
            </a>
            <div class="wallpaper-caption">
              <div class="wallpaper-title">
                <div>
                  <p>{wallpaper.place}</p>
                  <h3>{wallpaper.title}</h3>
                </div>
                <a class="theme-link" href={`${L('/themes')}#${wallpaper.themeId}`}>
                  {isEs ? `Ver el tema ${wallpaper.themeId}` : `View ${wallpaper.themeId} theme`}
                </a>
              </div>
              <dl class="credits">
                <div>
                  <dt>{isEs ? 'Fotógrafo' : 'Photographer'}</dt>
                  <dd>{wallpaper.photographer}</dd>
                </div>
                <div>
                  <dt>{isEs ? 'Licencia' : 'License'}</dt>
                  <dd>
                    <a href={wallpaper.licenseUrl}>{wallpaper.license}</a>
                  </dd>
                </div>
              </dl>
              <a class="source-link" href={wallpaper.sourcePage}>
                {isEs ? 'Fuente y atribución completa' : 'Source and full attribution'}
              </a>
            </div>
          </li>
        ))}
      </ul>
      <p class="no-results" hidden>
        {isEs ? 'Ninguna escena coincide con ese filtro.' : 'No scenes match that filter.'}
      </p>
      <dialog class="wallpaper-lightbox" aria-labelledby="lightbox-title">
        <form method="dialog" class="lightbox-close-row">
          <button type="submit" class="lightbox-close" aria-label={isEs ? 'Cerrá la vista previa del fondo' : 'Close wallpaper preview'}>
            {isEs ? 'Cerrar' : 'Close'} <span aria-hidden="true">×</span>
          </button>
        </form>
        <figure>
          <img class="lightbox-image" src="" alt="" width="1280" height="720" />
          <figcaption>
            <p class="lightbox-place"></p>
            <h2 id="lightbox-title">{isEs ? 'Vista previa del fondo' : 'Wallpaper preview'}</h2>
            <p class="lightbox-credit"></p>
            <div class="lightbox-links">
              <a class="lightbox-license" href="#">{isEs ? 'Detalles de la licencia' : 'License details'}</a>
              <a class="lightbox-source" href="">
                {isEs ? 'Fuente y atribución ↗' : 'Source and attribution ↗'}
              </a>
              <a class="lightbox-original" href="">
                {isEs ? 'Abrí la imagen completa ↗' : 'Open full image ↗'}
              </a>
            </div>
          </figcaption>
        </figure>
      </dialog>
    </section>

    <section class="photo-note" aria-labelledby="photo-note-title">
      <h2 id="photo-note-title">{isEs ? 'Sobre las fotografías' : 'About the photographs'}</h2>
      <p>
        {isEs ? 'Son fotografías con licencia y ubicaciones verificadas, recortadas y redimensionadas para uso de escritorio. La imagen fuente, el fotógrafo, la licencia y la modificación quedan registrados en el paquete del producto. No se generaron ni reconstruyeron edificios, cielos, luces ni detalles del paisaje.' : 'These are licensed photographs with verified locations, cropped and resized for desktop use. The source image, photographer, license and modification are recorded in the product package. No buildings, skies, lights or landscape details were generated or reconstructed.'}
      </p>
      <div class="note-links">
        <a href="https://github.com/HorneroOS/config/blob/main/docs/WALLPAPERS.md">
          {isEs ? 'Cómo se seleccionan y empaquetan los fondos' : 'How wallpapers are selected and packaged'}
        </a>
        <a href="https://github.com/HorneroOS/config/blob/main/profiles/themes/WALLPAPER-CREDITS.md">
          {isEs ? 'Todos los créditos y licencias de las fotos' : 'All photo credits and licenses'}
        </a>
        <a href={L('/themes')}>{isEs ? 'Explorá todos los temas' : 'Browse all themes'}</a>
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.wallpaper-card')];
  const feature = document.querySelector<HTMLElement>('.wallpaper-feature');
  const intro = document.querySelector<HTMLElement>('.wallpaper-intro');
  const empty = document.querySelector<HTMLElement>('.no-results');
  const filterIds = buttons.map((button) => button.dataset.filter ?? 'all');
  const filterStatus = document.querySelector<HTMLElement>('.filter-status');
  const isEs = document.querySelector<HTMLElement>('.wallpapers-page')?.dataset.locale === 'es';

  function applyFilter(tag: string): void {
    const button = buttons.find((candidate) => candidate.dataset.filter === tag);
    if (!button) return;

    let visible = 0;
    const featureMatches = tag === 'all' || (feature?.dataset.tags ?? '').split(' ').includes(tag);
    if (feature) feature.hidden = !featureMatches;
    intro?.classList.toggle('feature-hidden', !featureMatches);
    visible += Number(featureMatches);
    for (const card of cards) {
      const show = tag === 'all' || (card.dataset.tags ?? '').split(' ').includes(tag);
      card.hidden = !show;
      visible += Number(show);
    }
    buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
    if (empty) empty.hidden = visible !== 0;
    const noun = isEs ? (visible === 1 ? 'fotografía' : 'fotografías') : visible === 1 ? 'photograph' : 'photographs';
    if (filterStatus)
      filterStatus.textContent =
        tag === 'all'
          ? isEs
            ? `Mostrando las ${visible} ${noun}.`
            : `Showing all ${visible} ${noun}.`
          : isEs
            ? `Mostrando ${visible} ${noun} para ${(button.dataset.label ?? 'este filtro').toLowerCase()}.`
            : `Showing ${visible} ${noun} for ${(button.dataset.label ?? 'this filter').toLowerCase()}.`;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const tag = button.dataset.filter ?? 'all';
      if (button.getAttribute('aria-pressed') === 'true') return;

      const url = new URL(window.location.href);
      if (tag === 'all') url.searchParams.delete('scene');
      else url.searchParams.set('scene', tag);
      window.history.pushState({ wallpaperScene: tag }, '', url);
      applyFilter(tag);
    });
  }

  const initialScene = new URL(window.location.href).searchParams.get('scene');
  applyFilter(initialScene && filterIds.includes(initialScene) ? initialScene : 'all');
  window.addEventListener('popstate', () => {
    const scene = new URL(window.location.href).searchParams.get('scene');
    applyFilter(scene && filterIds.includes(scene) ? scene : 'all');
  });

  const lightbox = document.querySelector<HTMLDialogElement>('.wallpaper-lightbox');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('.lightbox-image');
  const lightboxPlace = lightbox?.querySelector<HTMLElement>('.lightbox-place');
  const lightboxTitle = lightbox?.querySelector<HTMLElement>('#lightbox-title');
  const lightboxCredit = lightbox?.querySelector<HTMLElement>('.lightbox-credit');
  const lightboxLicense = lightbox?.querySelector<HTMLAnchorElement>('.lightbox-license');
  const lightboxSource = lightbox?.querySelector<HTMLAnchorElement>('.lightbox-source');
  const lightboxOriginal = lightbox?.querySelector<HTMLAnchorElement>('.lightbox-original');

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-image]')) {
    link.addEventListener('click', (event) => {
      if (!lightbox?.showModal || !lightboxImage || !lightboxTitle || !lightboxPlace || !lightboxCredit) return;
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const data = link.dataset;
      lightboxImage.src = data.lightboxImage ?? link.href;
      lightboxImage.alt = data.lightboxAlt ?? '';
      lightboxTitle.textContent = data.lightboxTitle ?? '';
      lightboxPlace.textContent = data.lightboxPlace ?? '';
      lightboxCredit.textContent = isEs ? `Fotografía de ${data.lightboxPhotographer ?? 'fotógrafo desconocido'}` : `Photograph by ${data.lightboxPhotographer ?? 'unknown photographer'}`;
      if (lightboxLicense) {
        lightboxLicense.href = data.lightboxLicenseUrl ?? '#';
        lightboxLicense.textContent = data.lightboxLicense ?? (isEs ? 'Detalles de la licencia' : 'License details');
      }
      if (lightboxSource) lightboxSource.href = data.lightboxSource ?? link.href;
      if (lightboxOriginal) lightboxOriginal.href = link.href;
      lightbox.showModal();
    });
  }

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>

<style>
  .wallpapers-page {
    max-width: 88rem;
    margin: auto;
    padding: clamp(1.5rem, 4vw, 4rem) clamp(1rem, 4vw, 3.5rem) 5rem;
  }
  .wallpaper-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(1.5rem, 5vw, 4rem);
  }
  .wallpaper-intro-copy {
    max-width: 48rem;
  }
  .eyebrow {
    color: var(--accent);
    font: 0.72rem var(--font-data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 1rem 0 1.5rem;
    font-size: clamp(2.8rem, 5.6vw, 4.75rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }
  h1 em,
  h2 em {
    color: var(--accent);
    font-weight: 400;
  }
  .wallpaper-intro-copy > p:not(.eyebrow):not(.collection-facts) {
    max-width: 42rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }
  .collection-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .collection-facts span {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font: 0.68rem var(--font-data);
  }
  .wallpaper-feature {
    min-width: 0;
    border-left: 1px solid var(--line);
    padding-left: clamp(1rem, 2vw, 1.5rem);
  }
  .wallpaper-feature[hidden] {
    display: none;
  }
  .wallpaper-intro.feature-hidden {
    grid-template-columns: 1fr;
  }
  .wallpaper-feature > a {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface-raised);
  }
  .wallpaper-feature img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .wallpaper-feature > a:hover img {
    transform: scale(1.025);
  }
  .feature-index {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    padding: 0.5rem 0.65rem;
    color: white;
    background: rgb(8 11 20 / 78%);
    font: 0.62rem var(--font-data);
    letter-spacing: 0.08em;
  }
  .wallpaper-feature figcaption {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
  }
  .wallpaper-feature figcaption p {
    margin-bottom: 0.35rem;
    color: var(--muted);
    font: 0.64rem var(--font-data);
  }
  .wallpaper-feature figcaption strong {
    font-size: 1.12rem;
    letter-spacing: -0.025em;
  }
  .feature-credit {
    display: grid;
    gap: 0.35rem;
    text-align: right;
    font-size: 0.68rem;
  }
  .feature-credit span {
    color: var(--muted);
  }
  .feature-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.35rem 0.65rem;
  }
  .feature-links a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .gallery {
    border-top: 1px solid var(--line);
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .gallery-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  h2 {
    margin: 0.6rem 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }
  .gallery-heading > p {
    max-width: 27rem;
    color: var(--muted);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.8rem 0 2rem;
  }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.6rem 0.9rem;
    cursor: pointer;
    font: 0.7rem var(--font-data);
  }
  .filter-count {
    color: var(--muted);
    font-size: 0.62rem;
  }
  .filters button[aria-pressed='true'] .filter-count {
    color: currentColor;
    opacity: 0.72;
  }
  .filter-status {
    min-height: 1.2em;
    margin: -1rem 0 1.25rem;
    color: var(--muted);
    font: 0.66rem var(--font-data);
  }
  .filters button[aria-pressed='true'] {
    color: var(--surface);
    background: var(--accent);
    border-color: var(--accent);
  }
  .filters button:focus-visible,
  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .wallpaper-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .wallpaper-card {
    grid-column: span 3;
    min-width: 0;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .wallpaper-card:nth-child(3n + 1) {
    grid-column: span 4;
  }
  .wallpaper-card:nth-child(3n + 2) {
    grid-column: span 2;
  }
  .wallpaper-image {
    display: block;
    position: relative;
    overflow: hidden;
    background: #101114;
    aspect-ratio: 16 / 9;
  }
  .wallpaper-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }
  .wallpaper-image:hover img {
    transform: scale(1.025);
  }
  .wallpaper-image > span {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 0.45rem 0.65rem;
    color: white;
    background: #090a0dcc;
    font: 0.65rem var(--font-data);
  }
  .wallpaper-caption {
    padding: clamp(1rem, 2vw, 1.4rem);
  }
  .wallpaper-title {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .wallpaper-title p,
  .wallpaper-title h3 {
    margin: 0;
  }
  .wallpaper-title p {
    color: var(--muted);
    font: 0.67rem var(--font-data);
  }
  .wallpaper-title h3 {
    margin-top: 0.45rem;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    letter-spacing: -0.04em;
  }
  .theme-link,
  .source-link,
  .credits a,
  .note-links a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .theme-link {
    font-size: 0.78rem;
  }
  .credits {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.2rem 0 0.75rem;
  }
  .credits div {
    display: flex;
    gap: 0.5rem;
    font-size: 0.76rem;
  }
  .credits dt {
    color: var(--muted);
  }
  .credits dd {
    margin: 0;
  }
  .source-link {
    font-size: 0.75rem;
  }
  .photo-note {
