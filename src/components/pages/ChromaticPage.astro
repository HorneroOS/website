---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StageBadge from '../StageBadge.astro';
import CaptureFigure from '../CaptureFigure.astro';
import CaptureGallery from '../CaptureGallery.astro';
import ReleaseChannelNote from '../ReleaseChannelNote.astro';
import { feature } from '../../data/features';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/chromatic';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const ledger = feature('chromatic');
const rfc = ledger.evidence[0].href;

// Variants as specified in RFC 0002 §6. Automatic choice is limited to the
// first four; neon is only ever suggested.
const variants = [
  {
    id: 'balanced',
    auto: true,
    es: 'Quieto: superficies suaves y un solo acento firme. El valor por defecto.',
    en: 'Quiet surfaces and one confident accent. The default.',
  },
  {
    id: 'vibrant',
    auto: true,
    es: 'Acentos más fuertes y un marco con tinte.',
    en: 'Stronger accents and tinted chrome.',
  },
  {
    id: 'expressive',
    auto: true,
    es: 'Un segundo tono cuando la imagen lo tiene; estados más armonizados.',
    en: 'A second hue when the image has one; more harmonised status colours.',
  },
  { id: 'muted', auto: true, es: 'Marco casi neutro y acentos suaves.', en: 'Near-neutral chrome and soft accents.' },
  {
    id: 'faithful',
    auto: false,
    es: 'El acento es el color de la imagen, si pasa los controles de contraste.',
    en: 'The accent is the image’s own colour when it passes the contrast gates.',
  },
  {
    id: 'monochrome',
    auto: false,
    es: 'Marco y tinta neutros; los acentos susurran el tono. Sin brillo.',
    en: 'Neutral chrome and ink; accents whisper the hue. No glow.',
  },
  {
    id: 'high-contrast',
    auto: false,
    es: 'Controles máximos, base más profunda, sin brillo ni transparencia.',
    en: 'Maximum gates, deeper ground, no glow and no translucency.',
  },
  {
    id: 'neon',
    auto: false,
    es: 'Solo oscuro. Se sugiere para imágenes muy oscuras y saturadas, nunca se aplica solo.',
    en: 'Dark only. Suggested for very dark, saturated images, never applied on its own.',
  },
];
const steps = [
  {
    n: '01',
    es: 'Imagen',
    en: 'Image',
    note: { es: 'Fondo, imagen o un color a elección', en: 'Wallpaper, an image or a chosen colour' },
  },
  {
    n: '02',
    es: 'Semillas',
    en: 'Seeds',
    note: { es: 'Cuantización y puntaje de color', en: 'Quantisation and seed scoring' },
  },
  {
    n: '03',
    es: 'Roles Signal',
    en: 'Signal roles',
    note: { es: 'Los mismos roles que Signal Night y Day', en: 'The same roles as Signal Night and Day' },
  },
  {
    n: '04',
    es: 'Contraste',
    en: 'Contrast gate',
    note: { es: 'Una paleta que no pasa no se aplica', en: 'A palette that fails is never applied' },
  },
  {
    n: '05',
    es: 'Todo el sistema',
    en: 'Whole system',
    note: { es: 'Shell, terminales, apps, extensiones', en: 'Shell, terminals, apps, extensions' },
  },
];
const curated = [
  { name: 'Signal Night', es: 'Oscuro, grafito con tinta crema', en: 'Dark, graphite with cream ink' },
  { name: 'Signal Day', es: 'Claro, papel de dibujo técnico', en: 'Light, technical-drawing paper' },
  { name: 'Signal High Contrast', es: 'Contraste máximo, protegido', en: 'Maximum contrast, protected' },
];
const roles = ['ground', 'panel', 'ink', 'signal', 'cue', 'phosphor', 'alert'];
---

<SiteLayout
  socialImage="/og/chromatic.png"
  socialImageAlt={m.diagramaDeHorneroChromaticEn}
  title={m.horneroChromaticColorDesdeTu}
  description={m.horneroChromaticEsColorDinamico}
>
  <section class="section chroma-intro" aria-labelledby="chroma-title">
    <p class="plate-id">
      <strong>RFC 0002</strong>
      <span>{m.colorDinamico}</span>
    </p>
    <h1 id="chroma-title">Hornero Chromatic</h1>
    <p class="chroma-tag">{m.tuFondoTuPaletaSin}</p>
    <p class="lede">{m.chromaticEsUnaOpcionGenera}</p>
    <p class="chroma-status">
      <StageBadge stage={ledger.stage} locale={locale} />
      <ReleaseChannelNote feature={ledger} locale={locale} />
    </p>
  </section>

  <section class="section" aria-labelledby="flow-title">
    <h2 id="flow-title">{m.deLaImagenATodo}</h2>
    <ol class="chroma-flow" role="list">
      {steps.map((step) => (
        <li>
          <span class="chroma-n" aria-hidden="true">
            {step.n}
          </span>
          <strong>{step[locale]}</strong>
          <span>{step.note[locale]}</span>
        </li>
      ))}
    </ol>
    <p class="section-copy">{m.esUnEsquemaDelProceso}</p>
  </section>

  <section class="section" aria-labelledby="promises-title">
    <h2 id="promises-title">{m.loQueChromaticSeCompromete}</h2>
    <ul class="chroma-promises" role="list">
      <li>
        <h3>{m.siempreLegible}</h3>
        <p>{m.tresNivelesDeContrasteEstandar}</p>
      </li>
      <li>
        <h3>{m.lasBarrasClarasSiguenClaras}</h3>
        <p>{m.chromaticPuedeCambiarLaTinta}</p>
      </li>
      <li>
        <h3>{m.altoContrasteEstaProtegido}</h3>
        <p>{m.elInterruptorDeAltoContraste}</p>
      </li>
      <li>
        <h3>{m.movimientoConPermiso}</h3>
        <p>{m.conMovimientoReducidoLasTransiciones}</p>
      </li>
    </ul>
  </section>

  <section class="section" aria-labelledby="variants-title">
    <h2 id="variants-title">{m.ochoVariantes}</h2>
    <p class="section-copy">{m.laEleccionAutomaticaSeLimita}</p>
    <dl class="chroma-variants">
      {variants.map((v) => (
        <div>
          <dt>
            <code>{v.id}</code>
            {v.auto && <span class="chroma-auto">{m.automatica}</span>}
          </dt>
          <dd>{v[locale]}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section" aria-labelledby="default-title">
    <h2 id="default-title">{m.elValorDeFabricaNo}</h2>
    <p class="section-copy">{m.chromaticEstaApagadoHastaQue}</p>
    <ul class="chroma-curated" role="list">
      {curated.map((t) => (
        <li>
          <strong>{t.name}</strong>
          <span class="chroma-mode">{t[locale]}</span>
        </li>
      ))}
    </ul>
    <p class="section-copy">{m.losRolesDeSignalEn}</p>
    <ul class="chroma-swatches" role="list">
      {roles.map((r) => (
        <li>
          <i style={`background:var(--${r})`} aria-hidden="true" />
          <code>{r}</code>
        </li>
      ))}
    </ul>
    <p class="section-copy">
      <a class="text-link" href={L('/themes')}>
        {m.verTodosLosTemas}
      </a>
    </p>
  </section>

  <section class="section" aria-labelledby="pair-title">
    <h2 id="pair-title">{m.unEscritorioDosFondos}</h2>
    <p class="section-copy">{m.laPruebaEstaEnEl}</p>
    <CaptureFigure slot="CAP-CHROMA-07" locale={locale} />
    <div class="chroma-pair">
      <CaptureFigure slot="CAP-CHROMA-01" locale={locale} />
      <CaptureFigure slot="CAP-CHROMA-02" locale={locale} />
    </div>
  </section>

  <section class="section" aria-labelledby="lineage-title">
    <h2 id="lineage-title">{m.linajeYCreditos}</h2>
    <p class="section-copy">
      {m.laIdeaSemillasDesdeEl}
      <a class="text-link" href={rfc}>
        {m.leeLaRfc0002} <span aria-hidden="true">↗</span>
      </a>
    </p>
    <ul class="chroma-evidence" role="list" aria-label={m.evidencia}>
      {ledger.evidence.map((e) => (
        <li>
          <a href={e.href}>{e.label}</a>
        </li>
      ))}
    </ul>
  </section>

  <CaptureGallery route="/chromatic" locale={locale} exclude={['CAP-CHROMA-01', 'CAP-CHROMA-02', 'CAP-CHROMA-07']} />
</SiteLayout>

<style>
  .chroma-intro h1 {
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .chroma-tag {
    margin-top: 0.8rem;
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
  }

  .chroma-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1rem;
    max-width: 70ch;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .section-copy {
    max-width: 68ch;
    color: var(--ink-muted);
  }

  .chroma-flow {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .chroma-flow li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1rem;
    border-left: 1px solid var(--rule);
  }

  .chroma-flow li:first-child {
    border-left: 0;
  }

  .chroma-flow strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .chroma-flow span:not(.chroma-n) {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .chroma-n {
    color: var(--signal);
    font: 500 0.72rem var(--font-mono);
    letter-spacing: 0.08em;
  }

  .chroma-promises {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.5rem;
    padding: 0;
    list-style: none;
  }

  .chroma-promises li {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule-strong);
  }

  .chroma-promises p {
    color: var(--ink-muted);
  }

  .chroma-variants {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin: 0;
  }

  .chroma-variants div {
    padding-block: 0.8rem;
    border-top: 1px solid var(--rule);
  }

  .chroma-variants dt {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .chroma-variants dd {
    margin: 0.25rem 0 0;
    color: var(--ink-muted);
  }

  .chroma-auto {
    color: var(--phosphor);
    font: 500 0.64rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chroma-curated {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding: 0;
    list-style: none;
  }

  .chroma-curated li {
    display: grid;
    gap: 0.3rem;
  }

  .chroma-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding: 0;
    list-style: none;
  }

  .chroma-swatches li {
    display: grid;
    justify-items: start;
    gap: 0.25rem;
  }

  .chroma-swatches i {
    width: 3.2rem;
    height: 2rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-small);
  }

  .chroma-mode {
    color: var(--ink-muted);
    font: 500 0.66rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chroma-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .chroma-evidence {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .chroma-flow {
      grid-template-columns: 1fr;
    }

    .chroma-flow li {
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .chroma-flow li:first-child {
      border-top: 0;
    }

    .chroma-promises,
    .chroma-variants,
    .chroma-pair {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .chroma-flow li {
      animation: chroma-in var(--dur-medium) var(--ease-enter) both;
    }

    .chroma-flow li:nth-child(2) {
      animation-delay: 60ms;
    }

    .chroma-flow li:nth-child(3) {
      animation-delay: 120ms;
    }

    .chroma-flow li:nth-child(4) {
      animation-delay: 180ms;
    }

    .chroma-flow li:nth-child(5) {
      animation-delay: 240ms;
    }
  }

  @keyframes chroma-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
