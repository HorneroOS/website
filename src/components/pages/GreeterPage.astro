---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { greeterSceneCatalogue, greeterScenes } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);

const videoScenes = greeterScenes.filter((scene) => scene.kind === 'video');
const firstScene = videoScenes[0];
const moods = isEs
  ? [
      { id: 'auto', label: 'Hora local' },
      { id: 'day', label: 'Día' },
      { id: 'golden-hour', label: 'Hora dorada' },
      { id: 'night', label: 'Noche' },
    ]
  : [
      { id: 'auto', label: 'Local time' },
      { id: 'day', label: 'Day' },
      { id: 'golden-hour', label: 'Golden hour' },
      { id: 'night', label: 'Night' },
    ];
const title = 'Greeter | HorneroOS';
const description = isEs
  ? 'La pantalla de login de HorneroOS: un greeter de SDDM sin conexión cuyo fondo sigue la hora del día. Esta página es una recreación interactiva en tu navegador.'
  : 'The HorneroOS login screen: an offline SDDM greeter whose background follows the time of day. This page is an interactive recreation in your browser.';
---

<SiteLayout
  title={title}
  description={description}
  socialImage="/og/greeter.png"
  socialImageAlt={isEs ? "Recreación del greeter de HorneroOS sobre una vista en la hora dorada del Parque Nacional El Palmar, etiquetada como no captura, junto a la línea 'El greeter de HorneroOS'." : "HorneroOS greeter recreation over a golden-hour view of El Palmar National Park, labelled as not a screenshot, beside the line 'The HorneroOS greeter'."}
>
  <div class="greeter-page" data-locale={locale}>
    <div class="greeter-hero">
      <header class="greeter-intro">
        <p class="plate-id"><strong>Antes del escritorio</strong><span>ARG / 199X</span><span>Recreación en navegador · no es una captura</span></p>
        <h1>{isEs ? 'El greeter de HorneroOS' : 'The HorneroOS greeter'}</h1>
        <p class="intro-copy">
          {isEs ? 'La pantalla de login es un tema de SDDM. Su fondo cambia con la hora y muestra paisajes argentinos y escenas urbanas guardados en tu computadora.' : 'The login screen is an SDDM theme. Its background changes with the hour and shows Argentine landscapes and city scenes stored on your computer.'}
        </p>
      </header>

      <section class="experience" aria-label={isEs ? 'Vista previa interactiva del greeter de HorneroOS' : 'Interactive HorneroOS greeter preview'}>
        <p class="preview-label">
          <span aria-hidden="true">◉</span> {isEs ? 'Recreación en el navegador · vista previa interactiva · no se recopilan credenciales' : 'Browser recreation · interactive preview · no credentials collected'}
        </p>
        <div
          class="screen"
          id="greeter-preview"
          data-day-start={greeterSceneCatalogue.dayparts.dayStart}
          data-day-end={greeterSceneCatalogue.dayparts.dayEnd}
          data-golden-start={greeterSceneCatalogue.dayparts.goldenHourStart}
          data-golden-end={greeterSceneCatalogue.dayparts.goldenHourEnd}
        >
          <img class="screen-poster" src={firstScene.poster} alt="" width="1280" height="720" fetchpriority="high" />
          <img
            class="screen-poster screen-poster-alt"
            src={firstScene.poster}
            alt=""
            width="1280"
            height="720"
            aria-hidden="true"
          />
          <video
            class="screen-video"
            muted
            playsinline
            loop
            preload="none"
            poster={firstScene.poster}
            aria-hidden="true"
          ></video>
          <div class="screen-shade" aria-hidden="true"></div>
          <div class="screen-top" aria-hidden="true">
            <div class="session-tools">
              <span class="session-select">
                Hyprland <i>⌄</i>
              </span>
              <span class="layout-select">
                EN <i>⌄</i>
              </span>
            </div>
            <div class="power-tools">
              <span title={isEs ? 'Reiniciar' : 'Reboot'}>↻</span>
              <span title={isEs ? 'Apagar' : 'Shut down'}>⏻</span>
            </div>
          </div>
          <div class="login-scene">
            <div class="clock-block" aria-live="off">
              <time class="clock" id="preview-clock">
                --:--
              </time>
              <span class="date" id="preview-date">
                {isEs ? 'Hora local' : 'Local time'}
              </span>
            </div>
            <div class="login-card" role="group" aria-label={isEs ? 'Aspecto de ejemplo de login, no interactivo' : 'Non-interactive sample login appearance'}>
              <div class="sample-row">
                <span>{isEs ? 'Usuario' : 'Username'}</span>
                <span class="sample-field">sample-user</span>
              </div>
              <div class="sample-row">
                <span>{isEs ? 'Contraseña' : 'Password'}</span>
                <span class="sample-field password-field">
                  •••••••• <i>›</i>
                </span>
              </div>
            </div>
          </div>
          <img
            class="screen-brand"
            src="/media/greeter/hornero-symbolic.svg"
            alt=""
            aria-hidden="true"
            width="30"
            height="30"
          />
          <div class="scene-label">
            <span class="scene-pip"></span>
            <span id="scene-location">
              {firstScene.place} · {firstScene.province}
            </span>
          </div>
          <span class="screen-edge" aria-hidden="true"></span>
        </div>

        <div class="preview-controls">
          <div class="mood-control" role="group" aria-label={isEs ? 'Elegí el momento del día del greeter' : 'Choose greeter time of day'}>
            {moods.map((mood) => (
              <button
                type="button"
                class:list={['mood-button', mood.id === 'auto' && 'is-active']}
                data-mood={mood.id}
                aria-pressed={mood.id === 'auto'}
              >
                {mood.label}
              </button>
            ))}
          </div>
          <div class="scene-control">
            <div class="scene-copy">
              <span class="control-kicker" id="mood-status">
                {isEs ? 'Siguiendo tu hora local' : 'Following your local time'}
              </span>
              <strong id="scene-title">{firstScene.title}</strong>
              <small id="scene-credit">
                {firstScene.creator} · {firstScene.license}
              </small>
            </div>
            <button
              type="button"
              class="icon-button"
              id="play-toggle"
              aria-label={isEs ? 'Pausá la reproducción del paisaje' : 'Pause landscape playback'}
              title={isEs ? 'Pausá la reproducción del paisaje' : 'Pause landscape playback'}
            >
              <span aria-hidden="true">Ⅱ</span>
            </button>
            <button type="button" class="next-button" id="next-scene">
              <span class="next-label">{isEs ? 'Siguiente paisaje' : 'Next landscape'}</span>
              <span aria-hidden="true">↗</span>
            </button>
          </div>
        </div>
        <p class="experience-caption">
          <span>{isEs ? 'Greeter SDDM de HorneroOS' : 'HorneroOS SDDM greeter'}</span>
          <span>{isEs ? `De día: ${videoScenes.length} clips de video locales. Otros momentos: imágenes fijas con licencia` : `Daytime: ${videoScenes.length} local video clips. Other moods: licensed stills`}</span>
        </p>
      </section>
    </div>

    <section class="mood-story" aria-labelledby="moods-heading">
      <div class="section-head">
        <h2 id="moods-heading">{isEs ? 'Según la hora del día' : 'By time of day'}</h2>
        <p>
          {isEs ? 'Usá los controles de hora de arriba para cambiar de ambiente. Automático sigue tu reloj y no necesita permiso de ubicación.' : 'Use the time controls above to switch moods. Auto follows your clock and needs no location permission.'}
        </p>
      </div>
      <div class="mood-rail">
        {greeterScenes
          .filter((scene) => scene.kind === 'still')
          .map((scene) => (
            <button
              type="button"
              class="mood-card"
              data-mood-card={scene.daypart}
              aria-label={isEs ? `Previsualizá ${{ day: 'de día', 'golden-hour': 'en la hora dorada', night: 'de noche' }[scene.daypart] ?? scene.daypart}: ${scene.place}` : `Preview ${scene.daypart}: ${scene.place}`}
            >
              <img src={scene.poster} alt="" loading="lazy" width="1280" height="720" />
              <span class="mood-card-copy">
                <small>
                  {scene.daypart === 'golden-hour'
                    ? isEs
                      ? '17:00—20:00 · VENTANA LOCAL CONFIGURADA'
                      : '17:00—20:00 · CONFIGURED LOCAL WINDOW'
                    : isEs
                      ? 'DE NOCHE · RESPALDO CONFIGURADO'
                      : 'AFTER DARK · CONFIGURED FALLBACK'}
                </small>
                <strong>{scene.place}</strong>
                <span>{scene.title} · {isEs ? 'Abrilo en el greeter' : 'Open in the greeter'}</span>
              </span>
              <span class="mood-card-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        <button
          type="button"
          class="mood-card"
          data-mood-card="day"
          aria-label={isEs ? `Previsualizá el día: ${firstScene.place}` : `Preview daytime: ${firstScene.place}`}
        >
          <img src={firstScene.poster} alt="" loading="lazy" width="1280" height="720" />
          <span class="mood-card-copy">
            <small>{isEs ? '07:00—19:00 · VIDEO LOCAL ALEATORIO' : '07:00—19:00 · RANDOM LOCAL VIDEO'}</small>
            <strong>{isEs ? 'Luz de día en toda Argentina' : 'Daylight across Argentina'}</strong>
            <span>{firstScene.title} {isEs ? 'y otros clips de paisajes seleccionados.' : 'and other curated landscape clips.'}</span>
          </span>
          <span class="mood-card-arrow" aria-hidden="true">
            ↗
          </span>
        </button>
      </div>
    </section>

    <section class="scene-section" aria-labelledby="scenes-heading">
      <div class="scene-section-head">
        <div>
          <h2 id="scenes-heading">{isEs ? 'Escenas' : 'Scenes'}</h2>
        </div>
        <p>
          {isEs ? 'Cada clip se revisa por composición, legibilidad detrás del panel de login, reproducción y derechos de redistribución. Las escenas de día son videos locales. Los demás ambientes usan imágenes fijas con licencia hasta que un video adecuado pase las mismas revisiones.' : 'Each clip is checked for composition, readability behind the login panel, playback and redistribution rights. The daytime scenes are local videos. The other moods use licensed stills until suitable video passes the same checks.'}
        </p>
      </div>
      <div class="scene-grid">
        {greeterScenes.map((scene) => (
          <article class:list={['scene-card', scene.kind === 'still' && 'still-scene']}>
            <button
              type="button"
              class="scene-image"
              data-select-scene={scene.id}
              aria-label={isEs ? `Mostrá ${scene.title} en la vista previa` : `Show ${scene.title} in the preview`}
            >
              <img
                src={scene.poster}
                alt={`${scene.place}, ${scene.province}`}
                loading="lazy"
                width="1280"
                height="720"
              />
              {scene.kind === 'video' && <span class="film-mark">{isEs ? 'MOVIMIENTO' : 'MOTION'}</span>}
            </button>
            <div class="scene-meta">
              <span>
                {scene.province} <i aria-hidden="true">·</i> {scene.region}
              </span>
              <span>
                {scene.daypart === 'golden-hour'
                  ? isEs
                    ? 'IMAGEN FIJA · HORA DORADA'
                    : 'GOLDEN HOUR STILL'
                  : scene.daypart === 'night'
                    ? isEs
                      ? 'IMAGEN FIJA · NOCHE'
                      : 'NIGHT STILL'
                    : isEs
                      ? 'VIDEO DE DÍA'
                      : 'DAYTIME VIDEO'}
              </span>
            </div>
            <h3>{scene.title}</h3>
            <p>{scene.description}</p>
            <div class="credit-line">
              <span>{scene.creator}</span>
              <span>
                <a href={scene.licenseUrl} target="_blank" rel="noreferrer">
                  {scene.license}
                </a>{' '}
                ·{' '}
                <a href={scene.sourceUrl} target="_blank" rel="noreferrer">
                  {isEs ? 'Fuente ↗' : 'Source ↗'}
                </a>
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="quiet-design" aria-labelledby="quiet-heading">
      <div>
        <h2 id="quiet-heading">{isEs ? 'Cómo se comporta el greeter' : 'How the greeter behaves'}</h2>
      </div>
      <ul>
        <li>
          <strong>{isEs ? 'Legibilidad.' : 'Readability.'}</strong>
          <span>{isEs ? 'Capas oscuras estables mantienen legibles el reloj y los controles de login mientras cambian las escenas.' : 'Stable dark overlays keep the clock and login controls legible as scenes change.'}</span>
        </li>
        <li>
          <strong>{isEs ? 'Sin conexión.' : 'Offline.'}</strong>
          <span>
            {isEs ? 'Los fondos de video e imágenes fijas se instalan localmente. El login nunca espera un stream de red.' : 'Video and still backgrounds are installed locally. Login never waits for a network stream.'}
          </span>
        </li>
        <li>
          <strong>{isEs ? 'Transiciones.' : 'Transitions.'}</strong>
          <span>
            {isEs ? 'Los clips aleatorios evitan repeticiones inmediatas, precargan la escena siguiente y hacen un fundido cruzado sobre una imagen fija local.' : 'Randomized clips avoid immediate repeats, preload the next scene and crossfade over a local still.'}
          </span>
        </li>
        <li>
          <strong>{isEs ? 'Respaldo.' : 'Fallback.'}</strong>
          <span>
            {isEs ? 'Si falta un video o no se puede decodificar, el fondo estático queda en su lugar. El greeter es una pantalla de login, no un reproductor multimedia.' : 'If a video is missing or cannot be decoded, the static background stays in place. The greeter is a login screen, not a media player.'}
          </span>
        </li>
      </ul>
    </section>

    <section class="technical" aria-labelledby="technical-heading">
      <div>
        <h2 id="technical-heading">{isEs ? 'Detalles técnicos' : 'Technical details'}</h2>
        <p>
          {isEs ? 'El greeter de Hornero es un tema SDDM en Qt6/QML. Un pack multimedia instalado por separado contiene clips H.264; el tema incluye sus imágenes fijas de respaldo. Un catálogo local generado impulsa la reproducción aleatoria y consciente del momento del día sin acceso a la red al iniciar sesión.' : 'The Hornero greeter is a Qt6/QML SDDM theme. A separately installed media pack contains H.264 clips; the theme includes its fallback stills. A generated local catalog drives randomized, day-aware playback without login-time network access.'}
        </p>
      </div>
      <div class="tech-facts">
        <p>
          <span>{isEs ? 'Gestor de login' : 'Login manager'}</span>
          <strong>SDDM · Qt6</strong>
        </p>
        <p>
          <span>{isEs ? 'Reproducción' : 'Playback'}</span>
          <strong>{isEs ? 'H.264 local, sin sonido' : 'Local H.264, muted'}</strong>
        </p>
        <p>
          <span>{isEs ? 'Ventanas del día' : 'Daypart windows'}</span>
          <strong>{isEs ? '07:00–19:00 · 17:00–20:00 dorada' : '07:00–19:00 · 17:00–20:00 golden'}</strong>
        </p>
        <p>
          <span>{isEs ? 'Estado del proyecto' : 'Project status'}</span>
          <strong>{isEs ? 'Preview de desarrollo de HorneroOS' : 'HorneroOS development preview'}</strong>
        </p>
      </div>
    </section>

    <section class="get-greeter">
      <div>
        <h2>{isEs ? 'Fuente y estado' : 'Source and status'}</h2>
        <p>
          {isEs ? 'Esta página recrea el greeter en tu navegador. No autentica ni recopila credenciales. El tema real y el pack multimedia son de código abierto. HorneroOS es una preview de desarrollo.' : 'This page recreates the greeter in your browser. It does not authenticate or collect credentials. The real theme and media pack are open source. HorneroOS is a development preview.'}
        </p>
      </div>
      <div class="get-links">
        <a class="cta primary" href="https://github.com/HorneroOS/greeter">
          {isEs ? 'Código del greeter' : 'Greeter source'} <span aria-hidden="true">↗</span>
        </a>
        <a href={L('/install')}>
          {isEs ? 'Consultá el estado de instalación' : 'Check installation status'}
        </a>
        <a href="https://github.com/HorneroOS/greeter/tree/main/media">
          {isEs ? 'Procedencia multimedia y manifiestos' : 'Media provenance and manifests'} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <script
    id="greeter-scene-data"
    type="application/json"
    set:html={JSON.stringify({ scenes: greeterScenes, dayparts: greeterSceneCatalogue.dayparts }).replaceAll(
      '<',
      '\\u003c',
    )}
  />
  <script>
    type Scene = {
      id: string;
      title: string;
      place: string;
      province: string;
      daypart: string;
      kind: 'video' | 'still';
      preview: string | null;
      poster: string;
      creator: string;
      license: string;
    };
    const root = document.querySelector<HTMLElement>('#greeter-preview');
    const isEs = document.querySelector<HTMLElement>('.greeter-page')?.dataset.locale === 'es';
    const moodNameEs: Record<string, string> = { day: 'día', 'golden-hour': 'hora dorada', night: 'noche' };
    const dataNode = document.querySelector<HTMLScriptElement>('#greeter-scene-data');
    const scenes = dataNode ? (JSON.parse(dataNode.textContent || '{}').scenes as Scene[]) : [];
    const windows = root
      ? {
          dayStart: Number(root.dataset.dayStart),
          dayEnd: Number(root.dataset.dayEnd),
          goldenStart: Number(root.dataset.goldenStart),
          goldenEnd: Number(root.dataset.goldenEnd),
        }
      : null;
    const video = document.querySelector<HTMLVideoElement>('.screen-video');
    const posters = [...document.querySelectorAll<HTMLImageElement>('.screen-poster')];
    const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData ?? false;
    let mode = 'auto';
    let current: Scene | null = null;
    let playing = !prefersReduced.matches && !saveData;
    let previewVisible = false;
    let posterTransition = 0;
    const clock = document.querySelector<HTMLElement>('#preview-clock');
    const date = document.querySelector<HTMLElement>('#preview-date');
    const status = document.querySelector<HTMLElement>('#mood-status');
    const textNodes = {
      title: document.querySelector<HTMLElement>('#scene-title'),
      credit: document.querySelector<HTMLElement>('#scene-credit'),
      location: document.querySelector<HTMLElement>('#scene-location'),
    };
    const nextButton = document.querySelector<HTMLButtonElement>('#next-scene');
    const updateNextButton = (activeMood: string) => {
      if (!nextButton) return;
      const hasAlternatives = scenes.filter((scene) => scene.daypart === activeMood).length > 1;
      const moodName = activeMood.replace('-', ' ');
      nextButton.disabled = !hasAlternatives;
      nextButton.setAttribute(
        'aria-label',
        hasAlternatives
          ? isEs
            ? 'Mostrá otro paisaje'
            : 'Show another landscape'
          : isEs
            ? `Solo hay un paisaje disponible para ${moodNameEs[activeMood] ?? moodName}`
            : `Only one landscape is available for ${moodName}`,
      );
      const label = nextButton.querySelector<HTMLElement>('.next-label');
      if (label)
        label.textContent = hasAlternatives ? (isEs ? 'Siguiente paisaje' : 'Next landscape') : isEs ? 'Única escena' : 'Only scene';
    };
    const hourMood = (hour: number) => {
      if (!windows) return 'day';
      if (hour >= windows.goldenStart && hour < windows.goldenEnd) return 'golden-hour';
      if (hour >= windows.dayStart && hour < windows.dayEnd) return 'day';
      return 'night';
    };
    const mood = () => (mode === 'auto' ? hourMood(new Date().getHours()) : mode);
    const choose = (activeMood: string, preferred?: Scene) => {
      const available = scenes.filter((scene) => scene.daypart === activeMood);
      if (!available.length) return;
      updateNextButton(activeMood);
      const pool = available.filter((scene) => scene.id !== current?.id);
      const next = preferred ?? pool[Math.floor(Math.random() * Math.max(pool.length, 1))] ?? available[0];
      current = next;
      const posterCurrent = posters[0];
      const posterBack = posters[1];
      if (posterBack && posterCurrent && posterBack.src !== new URL(next.poster, location.href).href) {
        window.clearTimeout(posterTransition);
        posterBack.classList.remove('is-visible');
        posterBack.src = next.poster;
        requestAnimationFrame(() => posterBack.classList.add('is-visible'));
        posterTransition = window.setTimeout(() => {
          posterCurrent.src = next.poster;
          posterBack.classList.remove('is-visible');
        }, 820);
      }
      if (textNodes.title) textNodes.title.textContent = next.title;
      if (textNodes.credit) textNodes.credit.textContent = `${next.creator} · ${next.license}`;
      if (textNodes.location) textNodes.location.textContent = `${next.place} · ${next.province}`;
      if (status)
        status.textContent =
          mode === 'auto'
            ? isEs
              ? `Siguiendo la hora local (${moodNameEs[activeMood] ?? activeMood})`
              : `Following local time (${activeMood.replace('-', ' ')})`
            : isEs
              ? `Elección manual (${moodNameEs[activeMood] ?? activeMood})`
              : `Manual choice (${activeMood.replace('-', ' ')})`;
      if (video) {
        video.pause();
        video.classList.remove('is-ready');
        video.removeAttribute('src');
        video.load();
        if (next.kind === 'video' && next.preview) {
          video.poster = next.poster;
          video.src = next.preview;
          if (playing && previewVisible && !document.hidden)
            void video.play().catch(() => {
              playing = false;
            });
        }
      }
      document.querySelectorAll<HTMLButtonElement>('.mood-button').forEach((button) => {
        const active = button.dataset.mood === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      document
        .querySelectorAll<HTMLElement>('[data-mood-card]')
        .forEach((card) => card.classList.toggle('is-selected', card.dataset.moodCard === activeMood));
    };
    const updateClock = () => {
      const now = new Date();
      if (clock)
        clock.textContent = new Intl.DateTimeFormat(isEs ? 'es-AR' : 'en-US', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        }).format(now);
      if (date)
        date.textContent = new Intl.DateTimeFormat(isEs ? 'es-AR' : 'en-US', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        }).format(now);
      if (mode === 'auto' && current?.daypart !== hourMood(now.getHours())) choose(hourMood(now.getHours()));
    };
    document.querySelectorAll<HTMLButtonElement>('.mood-button').forEach((button) =>
      button.addEventListener('click', () => {
        mode = button.dataset.mood || 'auto';
        choose(mood());
      }),
    );
    document.querySelector<HTMLButtonElement>('#next-scene')?.addEventListener('click', () => choose(mood()));
    document.querySelectorAll<HTMLButtonElement>('[data-select-scene]').forEach((button) =>
      button.addEventListener('click', () => {
        const scene = scenes.find((item) => item.id === button.dataset.selectScene);
        if (!scene) return;
        mode = scene.daypart;
        choose(mode, scene);
        document
          .querySelector('#greeter-preview')
          ?.scrollIntoView({ behavior: prefersReduced.matches ? 'auto' : 'smooth', block: 'center' });
      }),
    );
    document.querySelectorAll<HTMLButtonElement>('[data-mood-card]').forEach((button) =>
      button.addEventListener('click', () => {
        mode = button.dataset.moodCard || 'auto';
        choose(mode);
        document
          .querySelector('#greeter-preview')
          ?.scrollIntoView({ behavior: prefersReduced.matches ? 'auto' : 'smooth', block: 'center' });
      }),
    );
    const playButton = document.querySelector<HTMLButtonElement>('#play-toggle');
    const setPlaying = (value: boolean) => {
      playing = value;
      if (video && playing && previewVisible && current?.kind === 'video')
        void video.play().catch(() => {
          playing = false;
        });
      else video?.pause();
      if (playButton) {
        playButton.innerHTML = playing ? '<span aria-hidden="true">Ⅱ</span>' : '<span aria-hidden="true">▶</span>';
        playButton.setAttribute('aria-label', playing ? (isEs ? 'Pausá la reproducción del paisaje' : 'Pause landscape playback') : isEs ? 'Reanudá la reproducción del paisaje' : 'Play landscape playback');
      }
    };
    playButton?.addEventListener('click', () => setPlaying(!playing));
    video?.addEventListener('canplay', () => video.classList.add('is-ready'));
    prefersReduced.addEventListener('change', (event) => {
      if (event.matches) setPlaying(false);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video?.pause();
      else if (previewVisible && playing && current?.kind === 'video') void video?.play().catch(() => {});
    });
    if (root && 'IntersectionObserver' in window)
      new IntersectionObserver(([entry]) => {
        previewVisible = entry.isIntersecting;
        if (!previewVisible) video?.pause();
        else if (playing && current?.kind === 'video') void video?.play().catch(() => {});
      }).observe(root);
    updateClock();
    setInterval(updateClock, 30_000);
    choose(mood());
    if (saveData || prefersReduced.matches) setPlaying(false);
  </script>
</SiteLayout>

