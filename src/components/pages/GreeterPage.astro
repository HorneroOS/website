---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaptureFigure from '../../components/CaptureFigure.astro';
import CaptureGallery from '../../components/CaptureGallery.astro';
import { greeter, pins, short } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/greeter';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const greeterPin = pins.greeter;
const renderUrl = (file: string) => `${greeterPin.repo}/blob/${greeterPin.sha}/${file}`;
const defaults = greeter.defaults;
const paletteNames = greeter.palettes.map((palette) => palette.name).join(' · ');

// Credits for the landscape scenes of the still-published hornero-greeter
// 1.1.0 package. The Signal greeter bundles none of this media; the credits
// stay on the site for as long as that release is published (website#257).
// Source: the 1.1.0 scene manifests in HorneroOS/greeter (media/, removed
// from main by the Signal redesign and kept in Git history).
const publishedSceneCredits = [
  {
    title: 'Iguazú in tiers of mist',
    place: 'Iguazú Falls, Misiones',
    creator: 'Brandon Antonio Segura Torres & Priscilla Vieto Bonilla',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Cascadas_del_Iguaz%C3%BA_en_varios_pisos_escalonadas.webm',
  },
  {
    title: 'Across the Perito Moreno ice front',
    place: 'Los Glaciares National Park, Lago Argentino',
    creator: 'Brandon Antonio Segura Torres & Priscilla Vieto Bonilla',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Paneo_a_Glaciar_Perito_Moreno.webm',
  },
  {
    title: 'Penguin colony at the End of the World lighthouse, Ushuaia',
    place: 'Les Eclaireurs lighthouse area, Beagle Channel, Ushuaia',
    creator: 'Brandon Antonio Segura Torres & Priscilla Vieto Bonilla',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl:
      'https://commons.wikimedia.org/wiki/File:Poblaci%C3%B3n_de_pinguinos_en_Faro_del_Fin_del_mundo_en_Ushuaia.webm',
  },
  {
    title: 'Corrientes Avenue after dark',
    place: 'Avenida Corrientes and Avenida 9 de Julio, Buenos Aires',
    creator: 'ProtoplasmaKid',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl:
      'https://commons.wikimedia.org/wiki/File:Vista_a%C3%A9rea_nocturna_de_Avenida_9_de_julio_y_Avenida_Corrientes_02.jpg',
  },
  {
    title: 'Palmar at the last light',
    place: 'Parque Nacional El Palmar',
    creator: 'Leandro Kibisz (Loco085)',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl:
      'https://commons.wikimedia.org/wiki/File:Argentina_-_Entre_R%C3%ADos_-_Parque_Nacional_El_Palmar_(atardecer).JPG',
  },
];

const title = 'Greeter | HorneroOS';
const description = m.laPantallaDeLoginDe;
---

<SiteLayout
  title={title}
  description={description}
  socialImage="/og/greeter.png"
  socialImageAlt={m.tarjetaSocialDelGreeterDe}
>
  <div class="greeter-page" data-locale={locale}>
    <div class="greeter-hero">
      <header class="greeter-intro">
        <p class="plate-id">
          <strong>{m.antesDelEscritorio}</strong>
          <span>{m.disenoSignalEnMainSin}</span>
        </p>
        <h1>{m.elGreeterDeHorneroos}</h1>
        <p class="intro-copy">{m.laPantallaDeLoginEs}</p>
        <p class="intro-copy">{m.elFondoNoEsUna}</p>
        <p class="intro-copy status-note">{m.estadoEsteDisenoEstaEn(short(greeterPin.sha))}</p>
      </header>
      <div class="greeter-hero-capture">
        <CaptureFigure slot="CAP-LOCK-01" locale={locale} eager />
      </div>
    </div>

    <section class="section" aria-labelledby="design-heading">
      <div class="section-head">
        <h2 id="design-heading">{m.unGreeterPropioEnSignal}</h2>
        <p>{m.cadaPiezaSaleDelCodigo}</p>
      </div>
      <ul class="design-list" role="list">
        <li>
          <strong>{m.elHorizonteHorizonfield}</strong>
          <span>{m.unCieloDeMarcasDe}</span>
        </li>
        <li>
          <strong>{m.elRelojYJavi}</strong>
          <span>{m.esElRelojDeLa}</span>
        </li>
        <li>
          <strong>{m.lasCuentasComoCanales}</strong>
          <span>{m.cadaCuentaEsUnCanal}</span>
        </li>
        <li>
          <strong>{m.susPropiasPaletas}</strong>
          <span>{m.correComoElUsuarioSddm(paletteNames)}</span>
        </li>
        <li>
          <strong>{m.variasPantallas}</strong>
          <span>{m.elModuloDeIngresoVa}</span>
        </li>
        <li>
          <strong>{m.erroresHonestos}</strong>
          <span>{m.unaContrasenaIncorrectaSeCuenta}</span>
        </li>
      </ul>
    </section>

    <section class="section renders" aria-labelledby="renders-heading">
      <div class="section-head">
        <h2 id="renders-heading">{m.rendersFueraDePantallaNo}</h2>
        <p>{m.elRepositorioDelGreeterPublica}</p>
      </div>
      <p class="renders-note">
        {m.laListaCompletaDeRenders}
        <a class="text-link" href={renderUrl('screens/README.md')}>
          {m.verLosRendersEnEl} <span aria-hidden="true">↗</span>
        </a>
      </p>
    </section>

    <section class="section technical" aria-labelledby="technical-heading">
      <div class="section-head">
        <h2 id="technical-heading">{m.detallesTecnicos}</h2>
        <p>{m.unTemaSddmEnQt6}</p>
      </div>
      <div class="tech-facts">
        <p>
          <span>{m.gestorDeLogin}</span>
          <strong>SDDM · Qt6/QML</strong>
        </p>
        <p>
          <span>{m.fondo}</span>
          <strong>{defaults.background === 'horizon' ? m.horizonteGenerativo : defaults.background}</strong>
        </p>
        <p>
          <span>{m.paleta}</span>
          <strong>{paletteNames}</strong>
        </p>
        <p>
          <span>{m.esquemaDeColor}</span>
          <strong>colorScheme={defaults.colorScheme}</strong>
        </p>
        <p>
          <span>{m.vozDelSaludo}</span>
          <strong>voice={defaults.voice}</strong>
        </p>
        <p>
          <span>Javi</span>
          <strong>mascot={String(defaults.mascot)}</strong>
        </p>
        <p>
          <span>{m.canalesDeCuenta}</span>
          <strong>
            showUserChannels={String(defaults.showUserChannels)} · allowOtherUser={String(defaults.allowOtherUser)}
          </strong>
        </p>
        <p>
          <span>{m.confirmarEnergia}</span>
          <strong>confirmPower={String(defaults.confirmPower)}</strong>
        </p>
        <p>
          <span>{m.accesibilidad}</span>
          <strong>
            highContrast={String(defaults.highContrast)} · largeText={String(defaults.largeText)} · reducedMotion=
            {String(defaults.reducedMotion)}
          </strong>
        </p>
        <p>
          <span>{m.idiomas}</span>
          <strong>
            {greeter.languages.join(' · ')} (language={defaults.language})
          </strong>
        </p>
        <p>
          <span>{m.multimediaIncluida}</span>
          <strong>{greeter.bundledMedia ? m.si : m.ninguna}</strong>
        </p>
        <p>
          <span>{m.componentes}</span>
          <strong>{greeter.components.join(' · ')}</strong>
        </p>
      </div>
    </section>

    <section class="section credits" aria-labelledby="credits-heading">
      <div class="section-head">
        <h2 id="credits-heading">{m.creditosDeLaVersionPublicada}</h2>
        <p>{m.elPaquetePublicadoHorneroGreeter}</p>
      </div>
      <ul class="credit-list" role="list">
        {publishedSceneCredits.map((scene) => (
          <li>
            <strong>{scene.title}</strong>
            <span>{scene.place}</span>
            <span>
              {scene.creator} ·{' '}
              <a href={scene.licenseUrl} target="_blank" rel="noreferrer">
                {scene.license}
              </a>{' '}
              ·{' '}
              <a href={scene.sourceUrl} target="_blank" rel="noreferrer">
                {m.fuente}
              </a>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="section get-greeter">
      <div class="section-head">
        <h2>{m.fuenteYEstado}</h2>
        <p>{m.estaPaginaDescribeElGreeter}</p>
      </div>
      <div class="get-links">
        <a class="cta primary" href="https://github.com/HorneroOS/greeter">
          {m.codigoDelGreeter} <span aria-hidden="true">↗</span>
        </a>
        <a href={L('/install')}>{m.consultaElEstadoDeInstalacion}</a>
        <a href={`${greeterPin.repo}/blob/${greeterPin.sha}/screens/README.md`}>
          {m.comoSeHicieronLosRenders} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <CaptureGallery
    route="/greeter"
    locale={locale}
    exclude={['CAP-LOCK-01']}
    id="greeter-captures"
    heading={m.elGreeterSignalYLa}
    intro={m.estasSonLasCapturasReales}
  />
</SiteLayout>

<style>
  .greeter-page {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }
  .greeter-hero {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    width: min(100%, 1600px);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .greeter-intro h1 {
    margin-top: 1.1rem;
    max-width: 12ch;
    font-size: clamp(3rem, 4.4vw, 4.5rem);
    line-height: 0.98;
  }
  .intro-copy {
    max-width: 60ch;
    margin-top: 1.25rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }
  .status-note {
    color: var(--ink);
  }
  .greeter-hero-capture {
    min-width: 0;
  }
  .section {
    width: min(100%, 1480px);
    margin-block: 0;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .section-head {
    display: grid;
    gap: 0.9rem;
    max-width: 76rem;
  }
  .section-head > p {
    max-width: 62ch;
    color: var(--ink-muted);
    line-height: 1.65;
  }
  h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.05;
  }
  .design-list,
  .credit-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .design-list li,
  .credit-list li {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .design-list span,
  .credit-list span {
    color: var(--ink-muted);
    line-height: 1.6;
  }
  .render-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .render-list code {
    overflow-wrap: anywhere;
  }
  .render-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
  }
  .render-list span {
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
  }
  .renders-note {
    margin-top: 1rem;
    color: var(--ink-muted);
    line-height: 1.6;
  }
  .tech-facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 0.8rem;
    margin-top: 1.5rem;
  }
  .tech-facts p {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    overflow-wrap: anywhere;
  }
  .tech-facts span {
    color: var(--ink-muted);
    font: 600 0.65rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .get-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.25rem;
  }
  @media (max-width: 900px) {
    .greeter-hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
