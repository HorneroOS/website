---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaptureFigure from '../../components/CaptureFigure.astro';
import CaptureGallery from '../../components/CaptureGallery.astro';
import { greeter, pins, short } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);

const greeterPin = pins.greeter;
const renderUrl = (file: string) => `${greeterPin.repo}/blob/${greeterPin.sha}/${file}`;
const defaults = greeter.defaults;
const paletteNames = greeter.palettes.map((palette) => palette.name).join(' · ');

// Credits for the landscape scenes of the still-published hornero-greeter
// 1.1.0 package. The Signal greeter bundles none of this media; the credits
// stay on the site for as long as that release is published (website#257).
// Source: the 1.1.0 scene manifests in HorneroOS/greeter (media/, removed
// from main by the Signal redesign and kept in Git history).
const publishedSceneCredits = [
  {
    title: 'Iguazú in tiers of mist',
    place: 'Iguazú Falls, Misiones',
    creator: 'Brandon Antonio Segura Torres & Priscilla Vieto Bonilla',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Cascadas_del_Iguaz%C3%BA_en_varios_pisos_escalonadas.webm',
  },
  {
    title: 'Across the Perito Moreno ice front',
    place: 'Los Glaciares National Park, Lago Argentino',
    creator: 'Brandon Antonio Segura Torres & Priscilla Vieto Bonilla',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Paneo_a_Glaciar_Perito_Moreno.webm',
  },
  {
    title: 'Penguin colony at the End of the World lighthouse, Ushuaia',
    place: 'Les Eclaireurs lighthouse area, Beagle Channel, Ushuaia',
    creator: 'Brandon Antonio Segura Torres & Priscilla Vieto Bonilla',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl:
      'https://commons.wikimedia.org/wiki/File:Poblaci%C3%B3n_de_pinguinos_en_Faro_del_Fin_del_mundo_en_Ushuaia.webm',
  },
  {
    title: 'Corrientes Avenue after dark',
    place: 'Avenida Corrientes and Avenida 9 de Julio, Buenos Aires',
    creator: 'ProtoplasmaKid',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl:
      'https://commons.wikimedia.org/wiki/File:Vista_a%C3%A9rea_nocturna_de_Avenida_9_de_julio_y_Avenida_Corrientes_02.jpg',
  },
  {
    title: 'Palmar at the last light',
    place: 'Parque Nacional El Palmar',
    creator: 'Leandro Kibisz (Loco085)',
    license: 'CC-BY-SA-4.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0',
    sourceUrl:
      'https://commons.wikimedia.org/wiki/File:Argentina_-_Entre_R%C3%ADos_-_Parque_Nacional_El_Palmar_(atardecer).JPG',
  },
];

const title = 'Greeter | HorneroOS';
const description = isEs
  ? 'La pantalla de login de HorneroOS: un greeter de SDDM original en Hornero Signal, con un horizonte generativo de la pampa, el saludo de Javi, las cuentas como canales y ninguna multimedia de terceros.'
  : 'The HorneroOS login screen: an original SDDM greeter on Hornero Signal, with a generative Pampa horizon, a greeting from Javi, accounts as channels and no third-party media.';
---

<SiteLayout
  title={title}
  description={description}
  socialImage="/og/greeter.png"
  socialImageAlt={
    isEs
      ? "Tarjeta social del greeter de HorneroOS: la línea 'El greeter de Hornero' junto a los datos del diseño Signal (horizonte generativo, cuentas como canales, paletas e idiomas), sin ninguna captura."
      : "HorneroOS greeter social card: the line 'The Hornero greeter' beside the Signal design data (generative horizon, accounts as channels, palettes and languages), with no screenshot."
  }
>
  <div class="greeter-page" data-locale={locale}>
    <div class="greeter-hero">
      <header class="greeter-intro">
        <p class="plate-id">
          <strong>{isEs ? 'Antes del escritorio' : 'Before the desktop'}</strong>
          <span>{isEs ? 'Diseño Signal · en main, sin publicar' : 'Signal design · on main, unreleased'}</span>
        </p>
        <h1>{isEs ? 'El greeter de HorneroOS' : 'The HorneroOS greeter'}</h1>
        <p class="intro-copy">
          {isEs
            ? 'La pantalla de login es un tema de SDDM del mismo universo que la pantalla de bloqueo de la shell: un panel de instrumentos sobre Signal Night, con tipografía IBM Plex, el reloj al centro y el saludo de Javi. Debajo va un solo módulo de ingreso donde las cuentas son canales (CH 01, CH 02…) y el selector de sesión lista lo que SDDM ofrece: Desktop, Studio y Gaming, con las sesiones experimentales al final y nunca como predeterminada.'
            : 'The login screen is an SDDM theme from the same universe as the shell lock screen: an instrument panel on Signal Night in IBM Plex type, with the clock in the centre and a greeting from Javi. Below it sits one sign-in module where accounts are channels (CH 01, CH 02…) and the session selector lists what SDDM offers: Desktop, Studio and Gaming, with experimental sessions last and never the default.'}
        </p>
        <p class="intro-copy">
          {isEs
            ? 'El fondo no es una foto: es un horizonte de la pampa dibujado en código (HorizonField) —un sol a medio salir en franjas, un molino, un alambrado y una escala de instrumento sobre el horizonte— que se pinta una vez y queda quieto salvo el reloj. No se incluye ninguna foto ni video de terceros.'
            : 'The background is not a photograph: it is a Pampa horizon drawn in code (HorizonField) — a striped half-set sun, a windmill, a wire fence and an instrument scale along the horizon — painted once and still except for the clock. No third-party photo or video is bundled.'}
        </p>
        <p class="intro-copy status-note">
          {isEs
            ? `Estado: este diseño está en la rama principal del greeter (pin ${short(greeterPin.sha)}) y todavía no está en un paquete publicado. El paquete publicado hornero-greeter 1.1.0 sigue siendo el greeter de paisajes; sus créditos quedan al final de esta página mientras esa versión siga publicada. Todavía no existe una captura de un login real con el nuevo diseño: hasta que exista, esta página no muestra ninguna imagen del greeter (la de abajo es la pantalla de bloqueo, rotulada como tal).`
            : `Status: this design is on the greeter's main branch (pin ${short(greeterPin.sha)}) and is not in a published package yet. The published hornero-greeter 1.1.0 package is still the landscape greeter; its credits stay at the end of this page while that release is published. No capture of a real login with the new design exists yet: until one does, this page shows no image of the greeter (the one below is the lock screen, labelled as such).`}
        </p>
      </header>
      <div class="greeter-hero-capture">
        <CaptureFigure slot="CAP-LOCK-01" locale={locale} eager />
      </div>
    </div>

    <section class="section" aria-labelledby="design-heading">
      <div class="section-head">
        <h2 id="design-heading">{isEs ? 'Un greeter propio, en Signal' : 'A greeter of its own, on Signal'}</h2>
        <p>
          {isEs
            ? 'Cada pieza sale del código pineado del greeter; esta página no la recrea en el navegador ni la dibuja como si fuera una captura.'
            : 'Every piece comes from the pinned greeter source; this page does not recreate it in the browser or draw it as if it were a screenshot.'}
        </p>
      </div>
      <ul class="design-list" role="list">
        <li>
          <strong>{isEs ? 'El horizonte (HorizonField).' : 'The horizon (HorizonField).'}</strong>
          <span>
            {isEs
              ? 'Un cielo de marcas de instrumento con constelaciones, sembrado por el nombre del equipo y la fecha: cada computadora tiene su cielo y cambia de un día para el otro. Se pinta una sola vez en un lienzo por software; el único movimiento ambiental es una línea de escaneo de un paso por segundo, apagada con movimiento reducido o alto contraste.'
              : 'A sky of instrument ticks with constellations, seeded by the host name and the date: each computer gets its own sky and it changes from one day to the next. It is painted once into a software canvas; the only ambient motion is a scan hairline stepping once per second, off with reduced motion or high contrast.'}
          </span>
        </li>
        <li>
          <strong>{isEs ? 'El reloj y Javi.' : 'The clock and Javi.'}</strong>
          <span>
            {isEs
              ? 'Es el reloj de la pantalla de bloqueo: números en Plex Sans Condensed, una sola línea de señal y la fecha en mono mayúsculas. Javi, el hornero de la shell, saluda según la hora con la voz cálida de la shell o con la neutra (voice=plain), y se puede ocultar (mascot=false).'
              : 'It is the lock screen clock: Plex Sans Condensed numerals, one signal hairline and the date in uppercase mono. Javi, the shell hornero, greets by the hour in the shell cosy voice or the plain one (voice=plain), and can be hidden (mascot=false).'}
          </span>
        </li>
        <li>
          <strong>{isEs ? 'Las cuentas como canales.' : 'Accounts as channels.'}</strong>
          <span>
            {isEs
              ? 'Cada cuenta es un canal con su tally y su barra on-air cuando está sintonizado, más un canal «Otro» opcional para escribir un nombre. El campo de contraseña se nombra según la cuenta elegida, y al lado van el selector de sesión y el de distribución de teclado.'
              : 'Each account is a channel with a tally and an on-air bar when tuned, plus an optional Other channel for a typed name. The password well is named after the chosen account, with the session and keyboard-layout selectors beside it.'}
          </span>
        </li>
        <li>
          <strong>{isEs ? 'Sus propias paletas.' : 'Its own palettes.'}</strong>
          <span>
            {isEs
              ? `Corre como el usuario sddm antes de cualquier sesión, así que no puede leer tu paleta del Centro de control: trae ${paletteNames}. colorScheme=auto sigue la preferencia clara u oscura solo cuando la plataforma la informa.`
              : `It runs as the sddm user before any session, so it cannot read your Control Center palette: it carries ${paletteNames}. colorScheme=auto follows the light or dark preference only when the platform reports one.`}
          </span>
        </li>
        <li>
          <strong>{isEs ? 'Varias pantallas.' : 'Several displays.'}</strong>
          <span>
            {isEs
              ? 'El módulo de ingreso va en la pantalla principal de SDDM; las demás salidas muestran una placa tranquila con la marca, la hora y el aviso de ingresar en la pantalla principal.'
              : 'The sign-in module sits on SDDM primary display; every other output shows a quiet plate with the mark, the time and the note to sign in on the main display.'}
          </span>
        </li>
        <li>
          <strong>{isEs ? 'Errores honestos.' : 'Honest errors.'}</strong>
          <span>
            {isEs
              ? 'Una contraseña incorrecta se cuenta desde el segundo intento, Bloq Mayús se anuncia, sin sesiones instaladas el ingreso se deshabilita y se dice por qué, y si SDDM no responde en 12 segundos el greeter lo cuenta. Suspender, reiniciar y apagar piden confirmación con Cancelar enfocado.'
              : 'A wrong password is counted from the second attempt, Caps Lock is announced, with no sessions installed log in is disabled and says why, and if SDDM does not answer within 12 seconds the greeter says so. Suspend, restart and shut down ask first, with Cancel focused.'}
          </span>
        </li>
      </ul>
    </section>

    <section class="section renders" aria-labelledby="renders-heading">
      <div class="section-head">
        <h2 id="renders-heading">
          {isEs ? 'Renders fuera de pantalla, no capturas' : 'Offscreen renders, not captures'}
        </h2>
        <p>
          {isEs
            ? 'El repositorio del greeter publica renders del tema real (sddm-greeter-qt6 --test-mode en la plataforma offscreen de Qt, con cuentas y sesiones de prueba): Signal Night, Signal Day, alto contraste con texto grande, 1366×768 y 1920×1080, la placa secundaria y los estados de error. Son la referencia de diseño vigente, pero no son capturas de un login real ni de un paquete publicado, así que este sitio los enlaza en vez de mostrarlos como capturas.'
            : 'The greeter repository publishes renders of the real theme (sddm-greeter-qt6 --test-mode on Qt offscreen platform, with fixture accounts and sessions): Signal Night, Signal Day, high contrast with large text, 1366×768 and 1920×1080, the secondary plate and the error states. They are the current design reference, but they are not captures of a real login or of a published package, so this site links to them instead of showing them as captures.'}
        </p>
      </div>
      <p class="renders-note">
        {isEs
          ? 'La lista completa de renders (con tamaños) vive en el repositorio del greeter pineado; esta página no muestra ninguna imagen del greeter hasta que exista una captura de un login real.'
          : 'The full render list (with sizes) lives in the pinned greeter repository; this page shows no image of the greeter until a capture of a real login exists.'}
        <a class="text-link" href={renderUrl('screens/README.md')}>{isEs ? 'Ver los renders en el repositorio' : 'See the renders in the repository'} <span aria-hidden="true">↗</span></a>
      </p>
    </section>

    <section class="section technical" aria-labelledby="technical-heading">
      <div class="section-head">
        <h2 id="technical-heading">{isEs ? 'Detalles técnicos' : 'Technical details'}</h2>
        <p>
          {isEs
            ? 'Un tema SDDM en Qt6/QML que funciona sin conexión y sin ningún pack multimedia. Quien administra el equipo puede elegir su propia imagen o video con backgroundImage en theme.conf: solo ese video elegido necesita Qt 6 Multimedia, y si el archivo falta o no se puede decodificar queda el horizonte generativo. Los valores de abajo son los predeterminados del theme.conf pineado, generados en cada sincronización de datos.'
            : 'A Qt6/QML SDDM theme that works offline with no media pack. An administrator can choose their own image or video with backgroundImage in theme.conf: only that chosen video needs Qt 6 Multimedia, and if the file is missing or cannot be decoded the generative horizon stays. The values below are the defaults in the pinned theme.conf, generated on every data sync.'}
        </p>
      </div>
      <div class="tech-facts">
        <p>
          <span>{isEs ? 'Gestor de login' : 'Login manager'}</span>
          <strong>SDDM · Qt6/QML</strong>
        </p>
        <p>
          <span>{isEs ? 'Fondo' : 'Background'}</span>
          <strong>
            {defaults.background === 'horizon'
              ? isEs
                ? 'Horizonte generativo'
                : 'Generative horizon'
              : defaults.background}
          </strong>
        </p>
        <p>
          <span>{isEs ? 'Paleta' : 'Palette'}</span>
          <strong>{paletteNames}</strong>
        </p>
        <p>
          <span>{isEs ? 'Esquema de color' : 'Colour scheme'}</span>
          <strong>colorScheme={defaults.colorScheme}</strong>
        </p>
        <p>
          <span>{isEs ? 'Voz del saludo' : 'Greeting voice'}</span>
          <strong>voice={defaults.voice}</strong>
        </p>
        <p>
          <span>Javi</span>
          <strong>mascot={String(defaults.mascot)}</strong>
        </p>
        <p>
          <span>{isEs ? 'Canales de cuenta' : 'Account channels'}</span>
          <strong>
            showUserChannels={String(defaults.showUserChannels)} · allowOtherUser={String(defaults.allowOtherUser)}
          </strong>
        </p>
        <p>
          <span>{isEs ? 'Confirmar energía' : 'Confirm power'}</span>
          <strong>confirmPower={String(defaults.confirmPower)}</strong>
        </p>
        <p>
          <span>{isEs ? 'Accesibilidad' : 'Accessibility'}</span>
          <strong>
            highContrast={String(defaults.highContrast)} · largeText={String(defaults.largeText)} · reducedMotion=
            {String(defaults.reducedMotion)}
          </strong>
        </p>
        <p>
          <span>{isEs ? 'Idiomas' : 'Languages'}</span>
          <strong>
            {greeter.languages.join(' · ')} (language={defaults.language})
          </strong>
        </p>
        <p>
          <span>{isEs ? 'Multimedia incluida' : 'Bundled media'}</span>
          <strong>{greeter.bundledMedia ? (isEs ? 'Sí' : 'Yes') : isEs ? 'Ninguna' : 'None'}</strong>
        </p>
        <p>
          <span>{isEs ? 'Componentes' : 'Components'}</span>
          <strong>{greeter.components.join(' · ')}</strong>
        </p>
      </div>
    </section>

    <section class="section credits" aria-labelledby="credits-heading">
      <div class="section-head">
        <h2 id="credits-heading">
          {isEs ? 'Créditos de la versión publicada de paisajes' : 'Credits for the published landscape release'}
        </h2>
        <p>
          {isEs
            ? 'El paquete publicado hornero-greeter 1.1.0 todavía muestra estas escenas argentinas con licencia. El greeter Signal no las usa ni las incluye, y esta página ya no las reproduce; los créditos quedan acá mientras esa versión siga publicada.'
            : 'The published hornero-greeter 1.1.0 package still shows these licensed Argentine scenes. The Signal greeter does not use or bundle them, and this page no longer plays them; the credits stay here while that release is published.'}
        </p>
      </div>
      <ul class="credit-list" role="list">
        {publishedSceneCredits.map((scene) => (
          <li>
            <strong>{scene.title}</strong>
            <span>{scene.place}</span>
            <span>
              {scene.creator} ·{' '}
              <a href={scene.licenseUrl} target="_blank" rel="noreferrer">
                {scene.license}
              </a>{' '}
              ·{' '}
              <a href={scene.sourceUrl} target="_blank" rel="noreferrer">
                {isEs ? 'Fuente ↗' : 'Source ↗'}
              </a>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="section get-greeter">
      <div class="section-head">
        <h2>{isEs ? 'Fuente y estado' : 'Source and status'}</h2>
        <p>
          {isEs
            ? 'Esta página describe el greeter; no autentica ni recopila credenciales. El tema real es de código abierto y HorneroOS es una preview de desarrollo.'
            : 'This page describes the greeter; it does not authenticate or collect credentials. The real theme is open source and HorneroOS is a development preview.'}
        </p>
      </div>
      <div class="get-links">
        <a class="cta primary" href="https://github.com/HorneroOS/greeter">
          {isEs ? 'Código del greeter' : 'Greeter source'} <span aria-hidden="true">↗</span>
        </a>
        <a href={L('/install')}>{isEs ? 'Consultá el estado de instalación' : 'Check installation status'}</a>
        <a href={`${greeterPin.repo}/blob/${greeterPin.sha}/screens/README.md`}>
          {isEs ? 'Cómo se hicieron los renders' : 'How the renders were made'} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <CaptureGallery
    route="/greeter"
    locale={locale}
    exclude={['CAP-LOCK-01']}
    id="greeter-captures"
    heading={isEs ? 'El greeter Signal y la pantalla de bloqueo, de verdad' : 'The real Signal greeter and lock screen'}
    intro={
      isEs
        ? 'Estas son las capturas reales previstas del greeter Signal (paletas, sesiones y energía, dos monitores) y de la pantalla de bloqueo. Se toman de un login real cuando el diseño esté publicado; hasta entonces cada espacio dice qué va a mostrar.'
        : 'These are the planned real captures of the Signal greeter (palettes, sessions and power, two monitors) and of the lock screen. They are taken from a real login once the design is released; until then each slot says what it will show.'
    }
  />
</SiteLayout>

<style>
  .greeter-page {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }
  .greeter-hero {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    width: min(100%, 1600px);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .greeter-intro h1 {
    margin-top: 1.1rem;
    max-width: 12ch;
    font-size: clamp(3rem, 4.4vw, 4.5rem);
    line-height: 0.98;
  }
  .intro-copy {
    max-width: 60ch;
    margin-top: 1.25rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }
  .status-note {
    color: var(--ink);
  }
  .greeter-hero-capture {
    min-width: 0;
  }
  .section {
    width: min(100%, 1480px);
    margin-block: 0;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .section-head {
    display: grid;
    gap: 0.9rem;
    max-width: 76rem;
  }
  .section-head > p {
    max-width: 62ch;
    color: var(--ink-muted);
    line-height: 1.65;
  }
  h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.05;
  }
  .design-list,
  .credit-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .design-list li,
  .credit-list li {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .design-list span,
  .credit-list span {
    color: var(--ink-muted);
    line-height: 1.6;
  }
  .render-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .render-list code {
    overflow-wrap: anywhere;
  }
  .render-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
  }
  .render-list span {
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
  }
  .renders-note {
    margin-top: 1rem;
    color: var(--ink-muted);
    line-height: 1.6;
  }
  .tech-facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 0.8rem;
    margin-top: 1.5rem;
  }
  .tech-facts p {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    overflow-wrap: anywhere;
  }
  .tech-facts span {
    color: var(--ink-muted);
    font: 600 0.65rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .get-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.25rem;
  }
  @media (max-width: 900px) {
    .greeter-hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
