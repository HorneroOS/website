---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import ArchFrame from '../../components/ArchFrame.astro';
import ThemePaletteStudy from '../../components/ThemePaletteStudy.astro';
import AppLogo from '../../components/AppLogo.astro';
import { paletteApplications, themes, wallpapers } from '../../data/product';
import variantSample from '../../data/product/palette-variants.json';

const originals = themes.filter((theme) => theme.collection === 'hornero-originals');
const paletteRoles = ['background', 'surface', 'text', 'primary', 'secondary', 'accent'] as const;
const paletteStudies = originals.filter(
  (theme) => theme.paletteModel === 'semantic' && paletteRoles.every((role) => theme.palette[role]),
);
const otherLooks = themes.filter((theme) => theme.collection !== 'hornero-originals');
const photosByTheme = new Map(wallpapers.map((wallpaper) => [wallpaper.themeId, wallpaper]));
const wallpaperMedia = {
  gruvbox: (await import('../../../assets/screenshots/theme-wallpapers/gruvbox.webp')).default,
  landscape: (await import('../../../assets/screenshots/theme-wallpapers/landscape.webp')).default,
  monochrome: (await import('../../../assets/screenshots/theme-wallpapers/monochrome.webp')).default,
  'neon-city': (await import('../../../assets/screenshots/theme-wallpapers/neon-city.webp')).default,
  'soft-morning': (await import('../../../assets/screenshots/theme-wallpapers/soft-morning.webp')).default,
  'vapor-dreams': (await import('../../../assets/screenshots/theme-wallpapers/vapor-dreams.webp')).default,
  'warm-sunset': (await import('../../../assets/screenshots/theme-wallpapers/warm-sunset.webp')).default,
};
const modes = (mode: string) => (mode === 'light' ? (isEs ? 'Claro' : 'Light') : (isEs ? 'Oscuro' : 'Dark'));
const buenosAires = wallpapers.find((wallpaper) => wallpaper.id === 'buenos-aires-nocturno');
if (!buenosAires) throw new Error('Buenos Aires Original is missing from the pinned wallpaper catalogue');
const paletteVariants = variantSample.variants;
const showroom = await getCollection('showroom');
const desktopCaptures = ['hornero-light', 'pampa', 'neon-city', 'vapor-roadtrip', 'morning-lake'].map((id) => {
  const capture = showroom.find((item) => item.id === id);
  if (!capture) throw new Error(`Showroom capture not found: ${id}`);
  return capture;
});
---

<SiteLayout
  title={isEs ? 'Temas | HorneroOS' : 'Themes | HorneroOS'}
  description={isEs ? `${themes.length} temas: los Hornero Originals más aspectos naturales, minimalistas, cyberpunk, synthwave y clásicos. Cada aspecto coordina el escritorio y se puede ajustar con variantes de color del fondo.` : `${themes.length} themes: the Hornero Originals plus natural, minimal, cyberpunk, synthwave and classic looks. Each look coordinates the desktop and can be adjusted with wallpaper color variants.`}
>
  <section class="intro section">
    <div class="intro-copy-column">
      <p class="plate-id"><strong>Catálogo de apariencias</strong><span>ARG / 199X</span><span>Temas · paletas · fondos</span></p>
      <h1>{isEs ? 'Temas' : 'Themes'}</h1>
      <p class="intro-copy">
        {isEs ? 'Un aspecto define más que el fondo. Hornero coordina los colores de la shell, las apps GTK y los íconos, y te deja ajustar cada pieza.' : 'A look sets more than the wallpaper. Hornero coordinates the colors of the shell, GTK apps and icons, and lets you adjust each piece.'}
      </p>
      <div class="intro-meta">
        <span>{themes.length} {isEs ? 'aspectos' : 'looks'}</span>
        <span>{originals.length} Hornero Originals</span>
        <span>{isEs ? '7 estilos de generación de paleta' : '7 palette-generation styles'}</span>
      </div>
    </div>
    <div class="intro-preview">
      <img
        src={buenosAires.previewSmall}
        srcset={`${buenosAires.previewSmall} 720w, ${buenosAires.preview} 1280w`}
        sizes="(min-width: 900px) 50vw, calc(100vw - 2rem)"
        alt={buenosAires.previewAlt}
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
      />
      <p>
        <span>{buenosAires.place}</span>
        <strong>{buenosAires.title}</strong>
        <small>{isEs ? 'Foto de ' : 'Photograph by '}{buenosAires.photographer} · <a href={buenosAires.licenseUrl}>{buenosAires.license}</a></small>
      </p>
    </div>
  </section>

  <section class="section desktop-gallery" aria-labelledby="desktop-gallery-title">
    <div class="section-heading">
      <div>
        <h2 id="desktop-gallery-title">{isEs ? 'Aspectos en un escritorio andando' : 'Looks on a running desktop'}</h2>
      </div>
      <p>
        {isEs ? 'Elegí una captura para ver un aspecto en la Shell. Cada cuadro conserva su fuente y los datos de la captura. Son capturas separadas, no un solo escritorio en vivo.' : 'Choose a capture to see a look in the Shell. Each frame keeps its source and capture details. They are separate captures, not one live desktop.'}
      </p>
    </div>
    <fieldset class="capture-switcher">
      <legend>{isEs ? 'Explorá capturas reales del escritorio Hornero' : 'Explore real Hornero desktop captures'}</legend>
      {desktopCaptures.map((capture, i) => {
        const captureId = `capture-${capture.id}`;
        return (
          <>
            <input
              class="capture-radio"
              type="radio"
              name="desktop-capture"
              id={`${captureId}-choice`}
              value={capture.id}
              checked={i === 0}
            />
            <label class="capture-tab" for={`${captureId}-choice`}>
              <span class="capture-index">0{i + 1}</span>
              <span class="capture-tab-copy">
                <strong>{capture.data.title}</strong>
                <small>{capture.data.provenance.theme ?? (isEs ? 'Apariencia personalizada' : 'Custom appearance')}</small>
              </span>
              <span class="capture-arrow" aria-hidden="true">↗</span>
            </label>
          </>
        );
      })}
      <div class="capture-stage">
        {desktopCaptures.map((capture) => {
          const captureId = `capture-${capture.id}`;
          return (
            <article class="capture-slide" id={`${captureId}-panel`} aria-label={capture.data.title}>
              <ArchFrame
                src={capture.data.image}
                alt={capture.data.alt}
                provenance={capture.data.provenance}
                sizes="(min-width: 1100px) 68vw, calc(100vw - 2rem)"
                widths={[480, 800, 1280, 1600]}
              />
              <div class="capture-slide-copy">
                <h3>{capture.data.title}</h3>
                <p aria-hidden="true">{capture.data.alt}</p>
              </div>
            </article>
          );
        })}
      </div>
    </fieldset>
    <p class="capture-footnote">
      {isEs ? 'Si usás teclado, podés moverte entre capturas con las flechas. ' : 'Keyboard users can move between captures with the arrow keys. '}<a href={L('/showroom')}>{isEs ? 'Explorá la vidriera completa del escritorio' : 'Browse the complete desktop showcase'}</a>.
    </p>
  </section>

  <ThemePaletteStudy themes={paletteStudies} locale={locale} />

  <section class="section collection-section" aria-labelledby="looks-title">
    <div class="section-heading">
      <div>
        <h2 id="looks-title">{isEs ? 'Todos los aspectos' : 'All looks'}</h2>
      </div>
      <p>
        {isEs ? 'Primero van los Hornero Originals, seguidos por aspectos clásicos, naturales, minimalistas, cyberpunk y synthwave. Cada tarjeta es una apariencia completa. Su imagen es la escena asociada al aspecto, no una captura del escritorio. Nueve Hornero Originals usan fotos con atribución de distintos lugares de Argentina.' : 'The Hornero Originals come first, followed by classic, natural, minimal, cyberpunk and synthwave looks. Each card is a complete appearance. Its image is the scene associated with the look, not a desktop screenshot. Nine Hornero Originals use attributed photographs from across Argentina.'}
      </p>
    </div>
    <div class="collection-label" id="hornero-originals">
      <div>
        <h3>Hornero Originals</h3>
      </div>
      <p>{isEs ? 'Aspectos propios, basados en la identidad visual de Hornero y en lugares de Argentina.' : 'First-party looks based on Hornero’s visual identity and on places in Argentina.'}</p>
    </div>
    <ul class="look-grid" role="list">
      {originals.map((theme) => (
        <li class="look-card" id={theme.id}>
          <div class="look-art">
            {photosByTheme.has(theme.id) ? (
              <a class="look-photo" href={L(`/wallpapers#${theme.id}`)} aria-label={isEs ? `Ver la foto de ${theme.name} y sus créditos` : `View ${theme.name} photograph and credits`}>
                <img
                  src={photosByTheme.get(theme.id)!.previewSmall}
                  srcset={`${photosByTheme.get(theme.id)!.previewSmall} 720w, ${photosByTheme.get(theme.id)!.preview} 1280w`}
                  sizes="(min-width: 1100px) 28vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
                  alt={photosByTheme.get(theme.id)!.previewAlt}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : theme.palette ? (
              <div
                class="palette-study"
                style={`--palette-background:${theme.palette.background};--palette-surface:${theme.palette.surface};--palette-text:${theme.palette.text};--palette-primary:${theme.palette.primary};--palette-secondary:${theme.palette.secondary};--palette-accent:${theme.palette.accent}`}
                role="img"
                aria-label={isEs ? `${theme.name}, paleta de color: fondo ${theme.palette.background}, primario ${theme.palette.primary}, secundario ${theme.palette.secondary}, acento ${theme.palette.accent}` : `${theme.name} color palette: background ${theme.palette.background}, primary ${theme.palette.primary}, secondary ${theme.palette.secondary}, accent ${theme.palette.accent}`}
              >
                <div class="palette-arch" aria-hidden="true"><span></span></div>
                <div class="palette-swatches" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <span class="palette-caption" aria-hidden="true">{isEs ? 'Estudio de color' : 'Color study'} · {theme.mode}</span>
              </div>
            ) : (
              <div class="artwork-unavailable">
                <span aria-hidden="true">◌</span>
                <span>{isEs ? 'Elegí un fondo' : 'Choose a wallpaper'}</span>
              </div>
            )}
            <span class="look-mode">{modes(theme.mode)}</span>
            <span class="look-category">Hornero Original</span>
          </div>
          <div class="look-copy">
            <h4>{theme.name}</h4>
            <p>{theme.description}</p>
            {photosByTheme.get(theme.id) ? (
              <p class="look-credit">
                {photosByTheme.get(theme.id)!.photographer} · <a href={photosByTheme.get(theme.id)!.licenseUrl}>{photosByTheme.get(theme.id)!.license}</a>
              </p>
            ) : (
              <p class="look-credit">{isEs ? 'Paleta de color de Hornero Config · combinala con cualquier fondo' : 'Color palette from Hornero Config · pair with any wallpaper'}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
    <div class="collection-label other-label" id="more-looks">
      <div>
        <h3>{isEs ? 'Otros aspectos' : 'Other looks'}</h3>
      </div>
      <p>{isEs ? 'Otras direcciones, elegidas por cómo se ven en toda la Shell.' : 'Other directions, chosen for how they look across the Shell.'}</p>
    </div>
    <ul class="look-grid" role="list">
      {otherLooks.map((theme) => (
        <li class="look-card" id={theme.id}>
          <div class="look-art">
            {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? (
              <Picture
                src={wallpaperMedia[theme.id as keyof typeof wallpaperMedia]}
                alt={isEs ? `${['pampa', 'patagonia', 'fin-del-mundo', 'quebrada', 'ibera', 'buenos-aires-nocturno'].includes(theme.id) ? 'Foto' : 'Vista previa del fondo'} de ${theme.name}.` : `${['pampa', 'patagonia', 'fin-del-mundo', 'quebrada', 'ibera', 'buenos-aires-nocturno'].includes(theme.id) ? 'Photograph' : 'Wallpaper preview'} for ${theme.name}.`}
                formats={['webp']}
                fallbackFormat="webp"
                widths={[520, 800]}
                sizes="(min-width: 1100px) 28vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="artwork-unavailable">
                <span aria-hidden="true">◌</span>
                <span>{isEs ? 'Combiná con tu fondo' : 'Pair with your wallpaper'}</span>
              </div>
            )}
            <span class="look-mode">{modes(theme.mode)}</span>
            <span class="look-category">
              {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? (isEs ? 'Aspecto con fondo' : 'Wallpaper look') : (isEs ? 'Guiado por el fondo' : 'Wallpaper-led')}
            </span>
          </div>
          <div class="look-copy">
            <h4>{theme.name}</h4>
            <p>{theme.description}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="artwork-note">
      {isEs ? 'Estas tarjetas muestran la escena asociada a un aspecto, no el escritorio andando. Los nueve Hornero Originals usan fotos verificadas y con atribución; el resto del material opcional es una colección aparte del usuario. Explorá la ' : 'These cards show the scene associated with a look, not the running desktop. The nine Hornero Originals use verified, attributed photographs; other optional media is a separate user collection. Browse the '}{' '}
      <a href={L('/wallpapers')}>{isEs ? 'colección fotográfica de fondos' : 'photographic wallpaper collection'}</a> {isEs ? 'para ver lugares, fotógrafos y licencias.' : 'for locations, photographers and licenses.'}{' '}
      <a href={L('/showroom')}>{isEs ? 'Mirá las capturas del escritorio en el Showroom' : 'See desktop captures in the Showroom'}</a>.
    </p>
  </section>

  <section class="section variants-section" id="palette-variants" aria-labelledby="palette-variants-title">
    <div class="section-heading">
      <div>
        <h2 id="palette-variants-title">{isEs ? 'Siete estilos de generación de paleta' : 'Seven palette-generation styles'}</h2>
      </div>
      <p>
        {isEs ? 'El estilo define cómo Hornero lee el fondo y deriva los colores de la Shell, desde tonos sobrios hasta una paleta más expresiva. El fondo queda igual.' : 'The style sets how Hornero reads the wallpaper and derives the Shell colors, from restrained tones to a more expressive palette. The wallpaper stays the same.'}
      </p>
    </div>
    <ul class="variant-grid" role="list">
      {paletteVariants.map((variant) => (
        <li class="variant-card" data-variant={variant.id}>
          <span
            class="variant-swatches"
            aria-hidden="true"
            style={`--swatch-a:${variant.colors[0]};--swatch-b:${variant.colors[1]};--swatch-c:${variant.colors[2]}`}
          >
            <i></i>
            <i></i>
            <i></i>
          </span>
          <strong>{variant.name}</strong>
          <span>{variant.mood}</span>
        </li>
      ))}
    </ul>
    <p class="variant-footnote">
      {isEs ? 'Las siete paletas de muestra se generaron en modo oscuro desde el mismo fondo Neon City, con el generador Material 3 de Hornero Config. Son salidas reales para esa imagen. Otro fondo o el modo claro dan colores distintos. ' : 'All seven sample palettes were generated in dark mode from the same Neon City wallpaper with Hornero Config’s Material 3 generator. They are real outputs for that image. Another wallpaper or light mode gives different colors. '}<a href={L('/docs/desktop/appearance/')}>{isEs ? 'Leé cómo funcionan los colores del fondo' : 'Read how wallpaper colors work'}</a>.
    </p>
  </section>

  <section class="section terminals-section" aria-labelledby="terminals-title">
    <div class="section-heading">
      <div>
        <h2 id="terminals-title">{isEs ? 'Terminales' : 'Terminals'}</h2>
      </div>
      <p>
        {isEs ? 'Hornero escribe la paleta activa del fondo en el formato nativo de cada terminal. Kitty es la que viene por defecto; Alacritty y Ghostty son alternativas opcionales.' : 'Hornero writes the active wallpaper palette in each terminal’s native format. Kitty is the included default; Alacritty and Ghostty are optional alternatives.'}
      </p>
    </div>
    <div class="terminal-grid">
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name"><AppLogo id="kitty" /><h3>Kitty</h3></span>
          <span>{isEs ? 'Incluida por defecto' : 'Included default'}</span>
        </div>
        <p>{isEs ? 'La config empaquetada incluye la paleta generada para tu apariencia actual.' : 'The packaged config includes the palette generated for your current appearance.'}</p>
        <pre><code>include ~/.cache/hornero/smart-colors/colors-kitty.conf</code></pre>
      </article>
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name"><AppLogo id="alacritty" /><h3>Alacritty</h3></span>
          <span>{isEs ? 'Opcional' : 'Optional'}</span>
        </div>
        <p>{isEs ? 'Un import TOML nativo mantiene los colores estáticos de Hornero como respaldo.' : 'A native TOML import keeps the static Hornero colors as a fallback.'}</p>
        <pre><code>import = ["hornero-dark.toml", "hornero-colors.toml"]</code></pre>
      </article>
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name"><AppLogo id="ghostty" /><h3>Ghostty</h3></span>
          <span>{isEs ? 'Opcional' : 'Optional'}</span>
        </div>
        <p>{isEs ? 'El nombre de tema estable apunta a una paleta generada, con un respaldo empaquetado.' : 'The stable theme name points to a generated palette, with a packaged fallback.'}</p>
        <pre><code>theme = Hornero Dynamic</code></pre>
      </article>
    </div>
    <p class="terminal-note">
      {isEs ? 'Elegí una terminal instalada en ' : 'Choose an installed terminal in '}<strong>{isEs ? 'Ajustes → Terminal' : 'Settings → Terminal'}</strong> {isEs ? 'o con' : 'or with'}
      <code>horneroctl config default-apps set terminal ghostty --yes</code>.
      <a href={L('/docs/applications/terminal')}>{isEs ? 'Leé la guía de la terminal' : 'Read the terminal guide'}</a> {isEs ? 'para ver la configuración y los detalles de apariencia.' : 'for setup and appearance details.'}
    </p>
    <aside class="native-tool-note" aria-label={isEs ? 'Otras aplicaciones con temas de color nativos de Hornero' : 'Other applications with native Hornero color themes'}>
      <span class="native-tool-label">{isEs ? 'Otras herramientas' : 'Other tools'}</span>
      <div class="native-tool-body">
        <p>{isEs ? 'Hornero Config puede generar temas nativos derivados del fondo para estas herramientas. Sus configuraciones curadas eligen ' : 'Hornero Config can generate native wallpaper-derived themes for these tools. Their curated configurations select '}<code>Hornero Dynamic</code>{isEs ? '; estas aplicaciones siguen siendo paquetes opcionales de Arch.' : '; these applications remain optional Arch packages.'}</p>
        <ul class="native-tool-list" role="list">
          {paletteApplications.map((application) => (
            <li><AppLogo id={application.id} /><span><strong>{application.name}</strong><small>{application.category}</small></span></li>
          ))}
        </ul>
      </div>
    </aside>
  </section>

  <section class="section practical">
    <div>
      <h2>{isEs ? 'Qué incluye un aspecto' : 'What a look includes'}</h2>
      <p>
        {isEs ? 'Un aspecto cubre la Shell, la política GTK, los íconos y el fondo. Algunos packs referencian estilos GTK o de íconos opcionales; Hornero verifica si están instalados y nunca los descarga en silencio. Podés cambiar el estilo de generación de paleta y el modo claro u oscuro en Apariencia.' : 'A look covers the Shell, GTK policy, icons and wallpaper. Some packs reference optional GTK or icon styles; Hornero checks whether they are installed and never downloads them silently. You can change the palette-generation style and light or dark mode in Appearance.'}
      </p>
    </div>
    <div class="try-panel">
      <span class="mode-tag">{isEs ? 'Desde el escritorio' : 'From the desktop'}</span>
      <strong>{isEs ? 'Ajustes → Apariencia' : 'Settings → Appearance'}</strong>
      <span>{isEs ? 'Previsualizá un aspecto, aplicalo y después ajustá el modo, el fondo y los colores.' : 'Preview a look, apply it, then refine mode, wallpaper and colors.'}</span>
      <a class="cta primary" href={L('/showroom')}>
        {isEs ? 'Mirá el escritorio' : 'See the desktop'}
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  :global(main.app) {
    padding-top: 1.5rem;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(0.5rem, 2vw, 2rem) 1rem;
    margin-block-start: 0.75rem;
  }
  .intro > * + * {
    margin-top: 0;
  }
  .intro-preview {
    position: relative;
    min-width: 0;
  }
  .intro-preview :global(picture) {
    display: block;
    width: 100%;
  }
  .intro-preview img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--highlight) 45%, var(--line));
    box-shadow: 0.7rem 0.7rem 0 -0.1rem var(--bg), 0.7rem 0.7rem 0 var(--highlight);
  }
  .desktop-gallery {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-block: 1px solid var(--line);
  }
  .desktop-gallery .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .desktop-gallery .section-heading h2 {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .desktop-gallery .section-heading > p {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
  }
  .capture-switcher {
    position: relative;
    display: grid;
    grid-template-columns: minmax(13rem, 0.32fr) minmax(0, 1fr);
    grid-template-rows: auto repeat(5, minmax(4.5rem, auto));
    align-items: stretch;
    gap: 0.4rem 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .capture-switcher legend {
    grid-column: 1 / -1;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font: 0.72rem var(--font-data);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .capture-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .capture-tab {
    display: grid;
    min-width: 0;
    grid-column: 1;
    grid-template-columns: 2rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }
  .capture-tab:hover,
  .capture-radio:checked + .capture-tab {
    color: var(--ink);
    border-color: var(--highlight);
    background: color-mix(in srgb, var(--highlight) 8%, transparent);
  }
  .capture-radio:focus-visible + .capture-tab {
    outline: 2px solid var(--highlight);
    outline-offset: 2px;
  }
  .capture-index {
    color: var(--text-muted);
    font: 0.68rem var(--font-data);
  }
  .capture-tab-copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
