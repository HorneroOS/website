---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const PHOTO_THEME_IDS = ['pampa', 'patagonia', 'fin-del-mundo', 'quebrada', 'ibera', 'buenos-aires-nocturno'];
const L = (path: string) => localizePath(path, locale);
import { Picture } from 'astro:assets';
import CaptureGallery from '../../components/CaptureGallery.astro';
import ThemePaletteStudy from '../../components/ThemePaletteStudy.astro';
import AppLogo from '../../components/AppLogo.astro';
import { paletteApplications, themes, wallpapers } from '../../data/product';
import { messages } from '../../i18n/messages/themes';

const originals = themes.filter((theme) => theme.collection === 'hornero-originals');
const paletteRoles = ['background', 'surface', 'text', 'primary', 'secondary', 'accent'] as const;
const paletteStudies = originals.filter(
  (theme) => theme.paletteModel === 'semantic' && paletteRoles.every((role) => theme.palette[role]),
);
const otherLooks = themes.filter((theme) => theme.collection !== 'hornero-originals');
const photosByTheme = new Map(wallpapers.map((wallpaper) => [wallpaper.themeId, wallpaper]));
const wallpaperMedia = {
  gruvbox: (await import('../../../assets/wallpapers/theme-wallpapers/gruvbox.webp')).default,
  landscape: (await import('../../../assets/wallpapers/theme-wallpapers/landscape.webp')).default,
  monochrome: (await import('../../../assets/wallpapers/theme-wallpapers/monochrome.webp')).default,
  'neon-city': (await import('../../../assets/wallpapers/theme-wallpapers/neon-city.webp')).default,
  'soft-morning': (await import('../../../assets/wallpapers/theme-wallpapers/soft-morning.webp')).default,
  'vapor-dreams': (await import('../../../assets/wallpapers/theme-wallpapers/vapor-dreams.webp')).default,
  'warm-sunset': (await import('../../../assets/wallpapers/theme-wallpapers/warm-sunset.webp')).default,
};
const modes = (mode: string) => (mode === 'light' ? m.claro : m.oscuro);
// Theme descriptions arrive English-only in the pinned product data; the
// Spanish page must not render them untranslated. Presentation-layer
// translations by theme id (upstream data stays untouched).
const themeDescription = (theme: { id: string; description: string }) =>
  m.themeDescriptions[theme.id] ?? theme.description;
const buenosAires = wallpapers.find((wallpaper) => wallpaper.id === 'buenos-aires-nocturno');
if (!buenosAires) throw new Error('Buenos Aires Original is missing from the pinned wallpaper catalogue');
---

<SiteLayout title={m.temasHorneroos} description={m.temasLosHorneroOriginalsMas(themes.length)}>
  <section class="intro section">
    <div class="intro-copy-column">
      <p class="plate-id">
        <strong>Catálogo de apariencias</strong>
        <span>Temas · paletas · fondos</span>
      </p>
      <h1>{m.temas}</h1>
      <p class="intro-copy">{m.unAspectoDefineMasQue}</p>
      <div class="intro-meta">
        <span>
          {themes.length} {m.aspectos}
        </span>
        <span>{originals.length} Hornero Originals</span>
        <span>
          {themes.filter((theme) => theme.official).length} {m.aspectosHorneroSignal}
        </span>
      </div>
    </div>
    <div class="intro-preview">
      <img
        src={buenosAires.previewSmall}
        srcset={`${buenosAires.previewSmall} 720w, ${buenosAires.preview} 1280w`}
        sizes="(min-width: 900px) 50vw, calc(100vw - 2rem)"
        alt={buenosAires.previewAlt}
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
      />
      <p>
        <span>{buenosAires.place}</span>
        <strong>{buenosAires.title}</strong>
        <small>
          {m.fotoDe}
          {buenosAires.photographer} · <a href={buenosAires.licenseUrl}>{buenosAires.license}</a>
        </small>
      </p>
    </div>
  </section>

  <CaptureGallery
    route="/themes"
    locale={locale}
    id="desktop-gallery"
    heading={m.aspectosEnUnEscritorioAndando}
    intro={m.aspectosRealesSobreEscritoriosReales}
  />

  <ThemePaletteStudy themes={paletteStudies} locale={locale} />

  <section class="section collection-section" aria-labelledby="looks-title">
    <div class="section-heading">
      <div>
        <h2 id="looks-title">{m.todosLosAspectos}</h2>
      </div>
      <p>{m.primeroVanLosHorneroOriginals}</p>
    </div>
    <div class="collection-label" id="hornero-originals">
      <div>
        <h3>Hornero Originals</h3>
      </div>
      <p>{m.aspectosPropiosBasadosEnLa}</p>
    </div>
    <ul class="look-grid" role="list">
      {originals.map((theme) => (
        <li class="look-card" id={theme.id}>
          <div class="look-art">
            {photosByTheme.has(theme.id) ? (
              <a class="look-photo" href={L(`/wallpapers#${theme.id}`)} aria-label={m.verLaFotoDeY(theme.name)}>
                <img
                  src={photosByTheme.get(theme.id)!.previewSmall}
                  srcset={`${photosByTheme.get(theme.id)!.previewSmall} 720w, ${photosByTheme.get(theme.id)!.preview} 1280w`}
                  sizes="(min-width: 1100px) 28vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
                  alt={photosByTheme.get(theme.id)!.previewAlt}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : theme.palette ? (
              <div
                class="palette-study"
                style={`--palette-background:${theme.palette.background};--palette-surface:${theme.palette.surface};--palette-text:${theme.palette.text};--palette-primary:${theme.palette.primary};--palette-secondary:${theme.palette.secondary};--palette-accent:${theme.palette.accent}`}
                role="img"
                aria-label={m.paletaDeColorFondoPrimario(
                  theme.name,
                  theme.palette.background,
                  theme.palette.primary,
                  theme.palette.secondary,
                  theme.palette.accent,
                )}
              >
                <div class="palette-arch" aria-hidden="true">
                  <span></span>
                </div>
                <div class="palette-swatches" aria-hidden="true">
                  <i></i>
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
                <span class="palette-caption" aria-hidden="true">
                  {m.estudioDeColor} · {theme.mode}
                </span>
              </div>
            ) : (
              <div class="artwork-unavailable">
                <span aria-hidden="true">◌</span>
                <span>{m.elegiUnFondo}</span>
              </div>
            )}
            <span class="look-mode">{modes(theme.mode)}</span>
            <span class="look-category">Hornero Original</span>
          </div>
          <div class="look-copy">
            <h4>{theme.name}</h4>
            <p>{themeDescription(theme)}</p>
            {photosByTheme.get(theme.id) ? (
              <p class="look-credit">
                {photosByTheme.get(theme.id)!.photographer} ·{' '}
                <a href={photosByTheme.get(theme.id)!.licenseUrl}>{photosByTheme.get(theme.id)!.license}</a>
              </p>
            ) : (
              <p class="look-credit">{m.paletaDeColorDeHornero}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
    <div class="collection-label other-label" id="more-looks">
      <div>
        <h3>{m.otrosAspectos}</h3>
      </div>
      <p>{m.otrasDireccionesElegidasPorComo}</p>
    </div>
    <ul class="look-grid" role="list">
      {otherLooks.map((theme) => (
        <li class="look-card" id={theme.id}>
          <div class="look-art">
            {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? (
              <Picture
                src={wallpaperMedia[theme.id as keyof typeof wallpaperMedia]}
                alt={m.wallpaperAlt(PHOTO_THEME_IDS.includes(theme.id), theme.name)}
                fallbackFormat="webp"
                widths={[520, 800]}
                sizes="(min-width: 1100px) 28vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="artwork-unavailable">
                <span aria-hidden="true">◌</span>
                <span>{m.combinaConTuFondo}</span>
              </div>
            )}
            <span class="look-mode">{modes(theme.mode)}</span>
            <span class="look-category">
              {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? m.aspectoConFondo : m.guiadoPorElFondo}
            </span>
          </div>
          <div class="look-copy">
            <h4>{theme.name}</h4>
            <p>{themeDescription(theme)}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="artwork-note">
      {m.estasTarjetasMuestranLaEscena} <a href={L('/wallpapers')}>{m.coleccionFotograficaDeFondos}</a>{' '}
      {m.paraVerLugaresFotografosY} <a href={L('/showroom')}>{m.miraLasCapturasDelEscritorio}</a>.
    </p>
  </section>

  <section class="section terminals-section" aria-labelledby="terminals-title">
    <div class="section-heading">
      <div>
        <h2 id="terminals-title">{m.terminales}</h2>
      </div>
      <p>{m.horneroEscribeLaPaletaActiva}</p>
    </div>
    <div class="terminal-grid">
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name">
            <AppLogo id="kitty" />
            <h3>Kitty</h3>
          </span>
          <span>{m.incluidaPorDefecto}</span>
        </div>
        <p>{m.laConfigEmpaquetadaIncluyeLa}</p>
        <pre><code>include ~/.cache/hornero/smart-colors/colors-kitty.conf</code></pre>
      </article>
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name">
            <AppLogo id="alacritty" />
            <h3>Alacritty</h3>
          </span>
          <span>{m.opcional}</span>
        </div>
        <p>{m.unImportTomlNativoMantiene}</p>
        <pre><code>import = ["hornero-dark.toml", "hornero-colors.toml"]</code></pre>
      </article>
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name">
            <AppLogo id="ghostty" />
            <h3>Ghostty</h3>
          </span>
          <span>{m.opcional}</span>
        </div>
        <p>{m.elNombreDeTemaEstable}</p>
        <pre><code>theme = Hornero Dynamic</code></pre>
      </article>
    </div>
    <p class="terminal-note">
      {m.elegiUnaTerminalInstaladaEn}
      <strong>{m.ajustesTerminal}</strong> {m.oCon}
      <code>horneroctl config default-apps set terminal ghostty --yes</code>.
      <a href={L('/docs/applications/terminal')}>{m.leeLaGuiaDeLa}</a> {m.paraVerLaConfiguracionY}
    </p>
    <aside class="native-tool-note" aria-label={m.otrasAplicacionesConTemasDe}>
      <span class="native-tool-label">{m.otrasHerramientas}</span>
      <div class="native-tool-body">
        <p>
          {m.horneroConfigPuedeGenerarTemas}
          <code>Hornero Dynamic</code>
          {m.estasAplicacionesSiguenSiendoPaquetes}
        </p>
        <ul class="native-tool-list" role="list">
          {paletteApplications.map((application) => (
            <li>
              <AppLogo id={application.id} />
              <span>
                <strong>{application.name}</strong>
                <small>{application.category}</small>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </section>

  <section class="section practical">
    <div>
      <h2>{m.queIncluyeUnAspecto}</h2>
      <p>{m.unAspectoCubreLaShell}</p>
    </div>
    <div class="try-panel">
      <span class="mode-tag">{m.desdeElEscritorio}</span>
      <strong>{m.ajustesApariencia}</strong>
      <span>{m.previsualizaUnAspectoAplicaloY}</span>
      <a class="cta primary" href={L('/showroom')}>
        {m.miraElEscritorio}
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  :global(main.app) {
    padding-top: 1.5rem;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(0.5rem, 2vw, 2rem) 1rem;
    margin-block-start: 0.75rem;
  }
  .intro > * + * {
    margin-top: 0;
  }
  .intro-preview {
    position: relative;
    min-width: 0;
  }
  .intro-preview :global(picture) {
    display: block;
    width: 100%;
  }
  .intro-preview img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--cue) 45%, var(--rule));
    box-shadow:
      0.7rem 0.7rem 0 -0.1rem var(--base),
      0.7rem 0.7rem 0 var(--cue);
  }
  .intro-preview > p {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.2rem 1rem;
    margin-top: 0.6rem;
    color: var(--ink-muted);
    font: 0.7rem var(--font-mono);
    letter-spacing: 0.02em;
  }
  .intro-preview strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .intro-preview small {
    grid-column: 1 / -1;
    color: var(--ink-muted);
    font: 0.68rem/1.45 var(--font-mono);
  }
  .intro-preview small a {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }
  .intro h1 {
    margin-top: 0.7rem;
    font-size: clamp(3rem, 3.65vw, 4.3rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .intro h1 em {
    color: var(--signal);
    font-style: normal;
  }
  .intro-copy {
    max-width: 54ch;
    margin-top: 1.2rem;
    font-size: var(--step-1);
    color: var(--ink-muted);
  }
  .intro-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }
  .intro-meta span,
  .mode-tag {
    display: inline-flex;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
    color: var(--ink-muted);
    font: 0.72rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.3rem;
  }
  .section-heading h2 {
    margin-top: 0.35rem;
  }
  .section-heading > p {
    max-width: 43ch;
    color: var(--ink-muted);
  }
  .collection-label {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin: 2rem 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .collection-label > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .collection-index {
    color: var(--signal);
    font: 0.72rem var(--font-mono);
  }
  .collection-label h3 {
    font-size: 1.35rem;
  }
  .collection-label > p {
    max-width: 48ch;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .look-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .look-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }
  .look-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--signal) 50%, var(--rule));
  }
  .look-art {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--panel);
  }
  .look-photo,
  .palette-study {
    display: block;
    width: 100%;
    height: 100%;
  }
  .look-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .palette-study {
    position: relative;
    overflow: hidden;
    min-width: 0;
    display: grid;
    align-content: end;
    gap: 1.25rem;
    padding: clamp(1rem, 2.4vw, 2rem);
    background: var(--palette-background);
  }
  .palette-arch {
    position: absolute;
    inset: 10% 14% 17%;
    border: 1px solid color-mix(in srgb, var(--palette-primary) 70%, transparent);
    border-bottom: 0;
    border-radius: 48% 48% 0 0 / 35% 35% 0 0;
    opacity: 0.78;
  }
  .palette-arch span {
    position: absolute;
    inset: 16% 18% 0;
    border: 1px solid color-mix(in srgb, var(--palette-secondary) 55%, transparent);
    border-bottom: 0;
    border-radius: 48% 48% 0 0 / 35% 35% 0 0;
  }
  .palette-swatches {
    position: relative;
    display: flex;
    gap: 0.55rem;
  }
  .palette-swatches i {
    width: clamp(1.4rem, 3vw, 2rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: 50%;
    background: var(--palette-primary);
  }
  .palette-swatches i:nth-child(2) {
    background: var(--palette-secondary);
  }
  .palette-swatches i:nth-child(3) {
    background: var(--palette-accent);
  }
  .palette-swatches i:nth-child(4) {
    background: var(--palette-background);
  }
  .palette-caption {
    position: absolute;
    top: 0.85rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.28rem 0.48rem;
    border: 1px solid color-mix(in srgb, var(--palette-text) 25%, transparent);
    background: color-mix(in srgb, var(--palette-background) 88%, transparent);
    color: var(--palette-text);
    font: 0.68rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .look-credit {
    margin-top: 0.45rem;
    color: var(--ink-muted);
    font: 0.68rem/1.5 var(--font-mono);
  }
  .look-credit a {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }
  .look-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }
  .look-card:hover .look-art :global(img) {
    transform: scale(1.025);
  }
  .look-mode,
  .look-category {
    position: absolute;
    bottom: 0.55rem;
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.2rem 0.48rem;
    border: 1px solid color-mix(in oklab, white 24%, transparent);
    border-radius: var(--radius-small);
    color: white;
    /* Scene overlay: always dark over artwork, in both colour modes. */
    background: color-mix(in srgb, var(--scrim) 78%, transparent);
    font: 0.62rem var(--font-mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .look-mode {
    left: 0.55rem;
  }
  .look-category {
    right: 0.55rem;
  }
  .artwork-unavailable {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.45rem;
    height: 100%;
    color: var(--ink-muted);
    font: 0.72rem var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .artwork-unavailable span:first-child {
    color: var(--signal);
    font-size: 1.5rem;
  }
  .look-copy {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 0.9rem 1rem;
  }
  .look-copy h4 {
    font-size: 1rem;
    line-height: 1.2;
  }
  .look-copy p {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-muted);
    font-size: 0.8rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .artwork-note {
    margin-top: 1.2rem;
    color: var(--ink-muted);
    font-size: 0.82rem;
  }
  .artwork-note a {
    color: var(--ink);
  }
  .terminal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .terminal-card {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid var(--rule);
    background: var(--panel);
  }
  .terminal-card-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.8rem;
  }
  .terminal-card-name {
    --app-logo-size: 2.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .native-tool-list {
    --app-logo-size: 2.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    margin-top: 0.8rem;
    padding: 0;
    list-style: none;
  }
  .native-tool-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .native-tool-list li span {
    display: grid;
    gap: 0.1rem;
  }
  .native-tool-list strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.9rem;
  }
  .native-tool-list small {
    color: var(--ink-muted);
    font-size: 0.7rem;
  }
  .terminal-card-heading h3 {
    font-size: 1.15rem;
  }
  .terminal-card-heading span {
    color: var(--signal);
    font: 0.68rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .terminal-card > p,
  .terminal-note {
    color: var(--ink-muted);
    font-size: 0.86rem;
  }
  .terminal-card pre {
    display: flex;
    align-items: center;
    min-height: 4.25rem;
    overflow-x: auto;
    margin: 0;
    padding: 0.8rem;
    border-left: 2px solid var(--cue);
    background: var(--base);
