---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaptureFigure from '../CaptureFigure.astro';
import CaptureGallery from '../CaptureGallery.astro';
import AppLogo from '../../components/AppLogo.astro';
import MaturityMeter from '../../components/MaturityMeter.astro';
import { editions, gamingCatalogue, pins, short } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/gaming';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const gamingEdition = editions.find((edition) => edition.id === 'gaming');
if (!gamingEdition) throw new Error('Gaming edition is missing from the pinned catalogue');
const catalogue = gamingCatalogue;
const specializations = catalogue?.specializations ?? [];
const applications = catalogue?.applications ?? [];
const appById = Object.fromEntries(applications.map((app) => [app.id, app]));
const appTitle = (id: string) => appById[id]?.title ?? id;
// Hero lineup mirrors Studio: flagship tool per play style, always rendered
// from the generated catalogue, never hand-listed in markup.
const heroLineup = ['steam', 'lutris', 'bottles', 'wine', 'obs-studio']
  .map((id) => appById[id])
  .filter((app): app is GamingApp => Boolean(app));
// Runtime layer named in the lede but not catalogue applications: shown as
// styled text badges only — no unverified logos are vendored for them.
const runtimeLayer = m.runtimeLayer;
type GamingApp = NonNullable<typeof gamingCatalogue>['applications'][number];
const statusTag = (app: GamingApp) => {
  if (app.availability === 'reference-only') return m.soloDeReferencia;
  if (app.licenseClass === 'proprietary') return m.propietarioAEleccion;
  if (app.experimental) return 'Experimental';
  if (app.licenseClass === 'open-source') return m.codigoAbierto;
  if (app.optional) return m.opcional;
  return m.catalogado;
};
const stats = gamingCatalogue
  ? m.stats(gamingCatalogue.specializations.length, gamingCatalogue.applications.length)
  : [];
---

<SiteLayout
  title={m.gamingJugaATuManera}
  socialImage="/og/gaming.png"
  socialImageAlt={m.lasAplicacionesDelCatalogoGaming}
  description={m.horneroosGamingEsUnaEdicion}
>
  <section class="section intro">
    <p class="plate-id">
      <strong>CH 03</strong>
      <span>{m.edicionGaming}</span>
      <span>{m.escritorioParaJugar}</span>
    </p>
    <div class="hero-head">
      <h1>
        Gaming <span class="tagline">{m.jugaATuManera}</span>
      </h1>
      <MaturityMeter maturity={gamingEdition.maturity} locale={locale} />
    </div>
    <p class="lede">{m.horneroosGamingEsLaEdicion}</p>

    {heroLineup.length > 0 ? (
      <div class="lineup" aria-label={m.aplicacionesInsigniaDeGaming}>
        {heroLineup.map((app) => (
          <span class="lineup-item">
            <AppLogo id={app.id} name={app.title} />
            <span>{app.title}</span>
            {app.licenseClass === 'proprietary' ? <span class="tag">{m.propietarioAEleccion}</span> : null}
            {app.source === 'aur' ? <span class="tag">{m.aurManual}</span> : null}
          </span>
        ))}
      </div>
    ) : null}

    {stats.length > 0 ? (
      <dl class="stats">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    ) : null}

    <p class="availability" role="note">
      <strong>{m.hoy}</strong>
      {m.elCatalogoCanonicoY}
      <code>horneroctl gaming doctor</code>
      {m.yaTeAyudaAChequear}
    </p>
  </section>

  <section class="section" aria-label={m.unaSesionReal}>
    <CaptureFigure slot="CAP-CC-14" locale={locale} />
  </section>

  {gamingCatalogue ? (
    <section class="section" aria-labelledby="profiles-title">
      <h2 id="profiles-title">{m.perfilesCombinables}</h2>
      <p class="section-copy">{m.elegisPerfilesYAplicacionesEl}</p>
      <ol class="tracks" role="list">
        {specializations.map((spec) => (
          <li class="track">
            <h3>
              {spec.title} {spec.isDefault ? <span class="tag">{m.predeterminado}</span> : null}
              {spec.applications.includes('steam') ? <span class="tag">{m.steamAEleccion}</span> : null}
            </h3>
            {spec.applications.length > 0 ? (
              <ul class="chips" role="list">
                {spec.applications.map((id) => (
                  <li class="chip">
                    <AppLogo id={id} name={appTitle(id)} />
                    <span>{appTitle(id)}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">{m.sinAplicacionesPorDefectoSumas}</p>
            )}
          </li>
        ))}
      </ol>
    </section>
  ) : null}

  {gamingCatalogue ? (
    <section class="section" aria-labelledby="apps-title">
      <h2 id="apps-title">{m.aplicacionesFuentesYLicencias}</h2>
      <p class="section-copy">{m.esteCatalogoSeGeneraDesde(short(pins.hornero.sha))}</p>
      <ul class="app-grid" role="list">
        {applications.map((app) => (
          <li class="app-tile">
            <div class="app-head">
              <AppLogo id={app.id} name={app.title} />
              <h3>{app.title}</h3>
              <span class="tag">{statusTag(app)}</span>
              {app.source === 'aur' ? <span class="tag">{m.aurManualYOpcional}</span> : null}
            </div>
            <dl class="app-meta">
              <div>
                <dt>{m.paquetes}</dt>
                <dd>{app.packages.length > 0 ? app.packages.join(', ') : '—'}</dd>
              </div>
              <div>
                <dt>{m.fuente}</dt>
                <dd>{app.source ?? '—'}</dd>
              </div>
              <div>
                <dt>{m.licencia}</dt>
                <dd>{app.licenses.length > 0 ? app.licenses.join(', ') : m.verElPaquete}</dd>
              </div>
            </dl>
            {app.notes ? <p class="note">{app.notes}</p> : null}
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  <section class="section" aria-labelledby="runtime-title">
    <h2 id="runtime-title">{m.capaDeEjecucion}</h2>
    <p class="section-copy">{m.estosComponentesAcompananALas}</p>
    <ul class="modes" role="list">
      {runtimeLayer.map((tool) => (
        <li class="mode">
          <strong>
            <span class="tool-badge">{tool.name}</span>
          </strong>
          <span>{tool.detail}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="honest-title">
    <h2 id="honest-title">{m.limitesHonestos}</h2>
    <div class="status-grid">
      <article>
        <h3>{m.antiCheatYCompatibilidad}</h3>
        <ul>
          <li>{m.elAntiCheatANivel}</li>
          <li>{m.todaviaNoPublicamosUnaLista}</li>
        </ul>
      </article>
      <article>
        <h3>{m.gpuPantallasYHandhelds}</h3>
        <ul>
          <li>{m.losDriversDeGpuSon}</li>
          <li>{m.vrrYHdrSonExperimentales}</li>
        </ul>
      </article>
      <article>
        <h3>{m.diagnostico}</h3>
        <ul>
          <li>
            <code>horneroctl gaming doctor</code>
            {m.informaCapacidadYRegistroVulkan}
          </li>
          <li>{m.nuncaAfirmaCompatibilidadRendimientoNi}</li>
        </ul>
      </article>
    </div>
    <p class="section-copy">
      {m.horneroosDesktopStudioYGaming}
      <a href={L('/install')}>{m.laPaginaDeInstalacion}</a>.
    </p>
  </section>

  <CaptureGallery route="/gaming" locale={locale} exclude={['CAP-CC-14']} />
</SiteLayout>

<style>
  .lede {
    max-width: 54ch;
    font-size: var(--step-1);
  }
  .lineup {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.6rem;
    margin-top: 1.8rem;
    padding-block: 1rem;
    border-block: 1px solid var(--rule);
  }
  .lineup-item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    --app-logo-size: 2rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.4rem 0 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.15rem;
  }
  .stats dt {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-mono, monospace);
    font-size: var(--step-2, 1.6rem);
    font-weight: 700;
    color: var(--signal);
  }
  .availability {
    max-width: 66ch;
    margin-top: 1.6rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--phosphor);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .availability strong {
    color: var(--ink);
  }
  .section-copy {
    max-width: 66ch;
    color: var(--ink-muted);
  }
  .tracks {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .track {
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) 1fr;
    gap: 0.5rem 1.5rem;
    align-items: start;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .track:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .track h3 {
    margin: 0;
    font-size: var(--step-0);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-muted);
    --app-logo-size: 1.35rem;
  }
  .muted {
    margin: 0;
    color: var(--ink-muted);
  }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.9rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .app-tile {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .app-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.7rem;
    --app-logo-size: 2.6rem;
  }
  .app-head h3 {
    margin: 0;
    font-size: var(--step-0);
    flex: 1 1 8rem;
    min-width: 0;
  }
  .tag {
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--phosphor);
    border-radius: var(--radius-small);
    color: var(--phosphor);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .app-meta {
    display: grid;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    font-size: var(--step--1);
  }
  .app-meta div {
    display: grid;
    grid-template-columns: 5.2rem 1fr;
    gap: 0.5rem;
  }
  .app-meta dt {
    color: var(--ink-muted);
  }
  .app-meta dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .note {
    margin: 0.7rem 0 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .modes {
    display: grid;
    gap: 0.6rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .mode {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .mode span:not(.tag) {
    color: var(--ink-muted);
    flex: 1;
  }
  .tool-badge {
    display: inline-block;
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--phosphor);
    border-radius: var(--radius-small);
    color: var(--phosphor) !important;
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    flex: none !important;
  }
  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0.9rem;
    margin-top: 1.2rem;
  }
  .status-grid article {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .status-grid h3 {
    margin-top: 0;
  }
  .status-grid ul {
    padding-left: 1.1rem;
    color: var(--ink-muted);
  }
  @media (max-width: 40rem) {
    .track {
      grid-template-columns: 1fr;
    }
  }
</style>
