---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CompanionStage from '../CompanionStage.astro';
import { pins, short } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);

// Real companion frames from HorneroOS/shell assets/companion at the shell
// pin (checked out by the build); labels come from its manifest.json.
const frames = import.meta.glob<ImageMetadata>('../../../.cache/product-src/shell/assets/companion/frames/*.png', {
  eager: true,
  import: 'default',
});
const byBase = new Map<string, ImageMetadata>();
for (const [path, meta] of Object.entries(frames))
  byBase.set(path.split('/').pop() ?? path, meta);

interface FrameEntry { file: string }
interface SkinEntry {
  label?: string;
  palette?: Record<string, string>;
  animations: Record<string, { frames: FrameEntry[] }>;
}
const manifest = Object.values(
  import.meta.glob<{ skins: Record<string, SkinEntry>; assistantStates?: Record<string, string> }>(
    '../../../.cache/product-src/shell/assets/companion/manifest.json',
    { eager: true, import: 'default' },
  ),
)[0];
if (!manifest) throw new Error('companion manifest missing at the shell pin');

const firstFrame = (skin: string, anim: string) => {
  const rel = manifest.skins[skin]?.animations?.[anim]?.frames?.[0]?.file;
  const hit = rel ? byBase.get(rel.split('/').pop() ?? '') : undefined;
  if (!hit) throw new Error(`companion frame ${skin}/${anim} missing at the shell pin`);
  return hit;
};
const skinOrder = ['default', ...Object.keys(manifest.skins).filter((s) => s !== 'default')];
const shell = pins.shell;
const assets = `${shell.repo}/tree/${shell.sha}/assets/companion`;
const paletteOf = (s: string) => Object.entries(manifest.skins[s]?.palette ?? {}).slice(0, 5);
---

<SiteLayout
  title={isEs ? 'Companion | HorneroOS' : 'Companion | HorneroOS'}
  description={isEs ? 'Javi, el hornero que vive en el escritorio de HorneroOS: descansa, saluda, vuela, arma su nido de a poco y actúa los estados del asistente.' : 'Javi, the hornero that lives on the HorneroOS desktop: it rests, greets, flies, slowly builds its nest and acts out the assistant states.'}
>
  <section class="section">
    <p class="plate-id"><strong>Compañero Hornero</strong><span>ARG / 199X</span><span>Parte del shell</span></p>
    <h1>Companion</h1>
    <p class="lede">
      {isEs ? 'Javi es un hornero que vive en tu escritorio. Descansa en su rincón, pestañea, se despereza, junta ramitas para su nido y vuela hacia vos cuando lo llamás. No te saca el foco ni los clics de las ventanas que estás usando.' : 'Javi is a hornero that lives on your desktop. It rests in its corner, blinks, stretches, gathers twigs for its nest and flies in when you call it. It does not take focus or clicks away from the windows you are using.'}
    </p>
    <CompanionStage locale={locale} />
  </section>

  <section class="section">
    <h2>{isEs ? 'Personajes' : 'Characters'}</h2>
    <ul class="skins" role="list">
      {skinOrder.map((s) => (
        <li>
          <div class="skin-frames">
            <Image
              src={firstFrame(s, 'idle')}
              alt={isEs ? `El companion ${manifest.skins[s].label} en reposo` : `The ${manifest.skins[s].label} companion at rest`}
              height={140}
              densities={[1, 2]}
            />
            <Image
              src={firstFrame(s, 'fly')}
              alt={isEs ? `El companion ${manifest.skins[s].label} volando` : `The ${manifest.skins[s].label} companion flying`}
              height={140}
              densities={[1, 2]}
            />
          </div>
          <span>{manifest.skins[s].label}</span>
          {paletteOf(s).length > 0 && (
            <span class="swatches" aria-hidden="true">
              {paletteOf(s).map(([, hex]) => <span style={`background:${hex}`}></span>)}
            </span>
          )}
        </li>
      ))}
    </ul>
    <p>
      {isEs ? 'Cada personaje es la misma pose con su propia paleta y vestimenta — también al volar. Elegilo en Centro de control › Companion, o desde una terminal:' : 'Every character is the same pose with its own palette and clothing — in flight too. Pick one in Control Center › Companion, or from a terminal:'}
    </p>
    <pre><code>qs ipc call companion summon
qs ipc call companion setSkin gaucho
qs ipc call companion play celebrate
qs ipc call companion say "Back in five minutes" 5000</code></pre>
  </section>

  <section class="section">
    <h2>{isEs ? 'Comportamiento' : 'Behavior'}</h2>
    <dl class="rows">
      <div>
        <dt>{isEs ? 'Descansa' : 'Rests'}</dt>
        <dd>{isEs ? 'Respira tranquilo, pestañea, mira alrededor y de vez en cuando se acicala o pega un saltito. Tras diez minutos de quietud se duerme con la cabeza bajo el ala; cualquier interacción lo despierta desperezándose.' : 'It breathes quietly, blinks, looks around and now and then preens or hops. After ten quiet minutes it sleeps with its head tucked in; any interaction wakes it with a stretch.'}</dd>
      </div>
      <div>
        <dt>{isEs ? 'Arma su nido' : 'Builds its nest'}</dt>
        <dd>{isEs ? 'Cada tanto trae una ramita en el pico y el nido crece de a poco: ramitas, copa de barro, horno con entrada. Queda guardado entre sesiones y se puede reiniciar cuando quieras.' : 'Now and then it carries a twig in its beak and the nest grows a little: twigs, mud cup, oven dome with entrance. It is kept between sessions and can be reset whenever you want.'}</dd>
      </div>
      <div>
        <dt>{isEs ? 'No molesta' : 'Stays out of the way'}</dt>
        <dd>{isEs ? 'Vive en su propia capa sin foco de teclado. Se oculta solo en la pantalla de bloqueo, sobre ventanas a pantalla completa, en modo juego y mientras Ajustes está abierto, y vuelve después.' : 'It sits on its own layer without keyboard focus. It hides by itself on the lock screen, over fullscreen windows, in game mode and while Settings is open, and comes back afterwards.'}</dd>
      </div>
      <div>
        <dt>{isEs ? 'Vos lo ubicás' : 'You place it'}</dt>
        <dd>{isEs ? 'Arrastralo a cualquier lado; recuerda el lugar en cada monitor. Por defecto no se mueve solo: los vuelos de paseo son opcionales. Cuando lo apagás, se descargan todos sus temporizadores y superficies.' : 'Drag it anywhere; it remembers the spot on each monitor. It does not move on its own by default: wandering flights are opt-in. When switched off, every timer and surface is unloaded.'}</dd>
      </div>
      <div>
        <dt>{isEs ? 'Movimiento' : 'Motion'}</dt>
        <dd>{isEs ? 'Con el movimiento reducido activado, los frames quedan fijos y los vuelos se convierten en cortes simples. La intensidad de sus animaciones en reposo se ajusta entre tranquilo, normal y vivaz.' : 'With reduced motion turned on, frames hold still and flights become simple cuts. Its idle animation intensity adjusts between calm, normal and lively.'}</dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <h2>{isEs ? 'Controles' : 'Controls'}</h2>
    <p>
      {isEs ? 'Todo se ajusta en Centro de control › Companion: personaje, tamaño, borde desde el que se asoma, consejos, tema del globo, animaciones en reposo e intensidad, vuelos de paseo, construcción del nido y dormir en el nido. Nada de esto necesita tocar archivos.' : 'Everything adjusts in Control Center › Companion: character, size, the edge it peeks from, tips, bubble theme, idle animations and intensity, wandering flights, nest building and sleeping at the nest. None of it needs file editing.'}
    </p>
  </section>

  <section class="section optional-band" aria-labelledby="assistant-title">
    <h2 id="assistant-title">{isEs ? 'Asistente opcional (experimental, desactivado por defecto)' : 'Optional assistant (experimental, off by default)'}</h2>
    <p>
      {isEs ? 'El companion es solo presentación. Detrás puede haber un asistente opcional y experimental:' : 'The companion is presentation only. An optional, experimental assistant can sit behind it:'}{' '}
      <a href="https://github.com/NousResearch/hermes-agent">Hermes Agent</a> {isEs ? 'de Nous Research, al que se accede con' : 'by Nous Research, reached through'}{' '}
      <code>horneroctl assistant</code>. {isEs ? 'Está' : 'It is'} <strong>{isEs ? 'desactivado por defecto' : 'disabled by default'}</strong> {isEs ? 'y nunca corre como root. Cuando está activo, el gateway corre aislado del resto de tu sesión y cada acción pasa por permisos que vos controlás. El escritorio funciona igual con el asistente apagado o sin instalar.' : 'and never runs as root. When enabled, the gateway runs isolated from the rest of your session and every action passes through permissions you control. The desktop works the same with it off or not installed.'}
    </p>
    <p>{isEs ? 'Activalo desde una terminal:' : 'Enable it from a terminal:'}</p>
    <pre><code>horneroctl assistant enable
horneroctl assistant status
horneroctl assistant ask "what updates are available?"</code></pre>
    <p>
      {isEs ? 'Mientras una ejecución está en curso, Javi actúa el estado sin que tengas que leer nada:' : 'While a run is in progress, Javi acts out the state before you read anything:'}
    </p>
    <ul>
      {Object.entries(manifest.assistantStates ?? {}).map(([state, anim]) => (
        <li><code>{state}</code> → <code>{anim}</code></li>
      ))}
    </ul>
    <ul>
      <li>{isEs ? 'La información del sistema viene de herramientas tipadas con permisos ABAC. El asistente no puede correr comandos arbitrarios.' : 'System information comes from typed tools behind ABAC permissions. The assistant cannot run arbitrary commands.'}</li>
      <li>
        {isEs ? 'Cuando una ejecución necesita aprobación o una respuesta, el companion muestra el pedido preocupado y espera. Respondés con' : 'When a run needs approval or an answer, the companion shows the request looking worried and waits. You answer with'}
        <code>qs ipc call companion approve &lt;run-id&gt; approve|deny</code>{isEs ? '. Nada se aprueba automáticamente; si negás, niega con la cabeza.' : '. Nothing is approved automatically; on deny it shakes its head.'}
      </li>
      <li>{isEs ? 'El gateway escucha solo en loopback, detrás de una clave por usuario que la shell no puede leer.' : 'The gateway listens on loopback only, behind a per-user key the shell cannot read.'}</li>
    </ul>
  </section>

  <section class="section">
    <h2>{isEs ? 'Límites' : 'Limits'}</h2>
    <p>
      {isEs ? 'El companion no lee lo que escribís y no toma decisiones. Sus estados' : 'The companion does not read what you type and makes no decisions. Its'} <em>{isEs ? 'escuchando' : 'listening'}</em> {isEs ? 'y' : 'and'} <em>{isEs ? 'pensando' : 'thinking'}</em> {isEs ? 'son animaciones accionadas por IPC. El asistente detrás de ellos es opcional, experimental y está apagado hasta que lo activás. El vuelo entre monitores todavía no existe: cambiar de pantalla se hace arrastrando.' : 'states are animations driven over IPC. The assistant behind them is optional, experimental and off until you enable it. Cross-monitor flight does not exist yet: moving screens is done by dragging.'}
    </p>
    <p class="source">
      {isEs ? 'Frames de' : 'Frames from'}{' '}
      <a href={assets}>
        <code>HorneroOS/shell/assets/companion</code>
      </a>{' '}
      {isEs ? 'en el commit' : 'at commit'}{' '}
      <a href={`${shell.repo}/commit/${shell.sha}`}>
        <code>{short(shell.sha)}</code>
      </a>
      {isEs ? ', los assets que dibuja la shell, generados desde masters SVG parametrizados.' : ', the assets the shell draws, generated from parameterized SVG masters.'}
    </p>
  </section>
</SiteLayout>

<style>
  .skins {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .skins li {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 2px;
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--secondary) 16%, transparent);
    background: radial-gradient(circle at 50% 70%, var(--surface), transparent 70%);
    border: 1px solid var(--line);
    text-align: center;
  }

  .skin-frames {
    display: flex;
    gap: 0.25rem;
    align-items: end;
    justify-content: center;
  }

  .skin-frames img {
    height: 120px;
    width: auto;
  }

  .swatches {
    display: inline-flex;
    gap: 3px;
  }

  .swatches span {
    width: 14px;
    height: 14px;
    border: 1px solid var(--line);
    display: inline-block;
  }

  .rows {
    display: grid;
    gap: 0;
  }

  .rows > div {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) 1fr;
    gap: 0.5rem 1.5rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .rows dt {
    font-family: var(--font-data);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
    padding-top: 0.15rem;
  }

  .rows dd {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .rows > div {
      grid-template-columns: 1fr;
    }
  }

  .source {
    font-size: var(--step--1);
    border-top: 3px solid var(--accent);
    padding-top: 0.6rem;
  }

  pre {
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 600px) {
    pre {
      font-size: 0.72rem;
    }
  }

  .optional-band { padding: clamp(1.1rem, 3vw, 2rem); border: 1px dashed var(--secondary); }
</style>
