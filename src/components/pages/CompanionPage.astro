---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CompanionStage from '../CompanionStage.astro';
import CaptureFigure from '../CaptureFigure.astro';
import CaptureGallery from '../CaptureGallery.astro';
import { pins, short } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/companion';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

// Real companion frames from HorneroOS/shell assets/companion at the shell
// pin (checked out by the build); labels come from its manifest.json.
const frames = import.meta.glob<ImageMetadata>('../../../.cache/product-src/shell/assets/companion/frames/*.png', {
  eager: true,
  import: 'default',
});
const byBase = new Map<string, ImageMetadata>();
for (const [path, meta] of Object.entries(frames)) byBase.set(path.split('/').pop() ?? path, meta);

interface FrameEntry {
  file: string;
}
interface SkinEntry {
  label?: string;
  palette?: Record<string, string>;
  animations: Record<string, { frames: FrameEntry[] }>;
}
const manifest = Object.values(
  import.meta.glob<{ skins: Record<string, SkinEntry>; assistantStates?: Record<string, string> }>(
    '../../../.cache/product-src/shell/assets/companion/manifest.json',
    { eager: true, import: 'default' },
  ),
)[0];
if (!manifest) throw new Error('companion manifest missing at the shell pin');

const firstFrame = (skin: string, anim: string) => {
  const rel = manifest.skins[skin]?.animations?.[anim]?.frames?.[0]?.file;
  const hit = rel ? byBase.get(rel.split('/').pop() ?? '') : undefined;
  if (!hit) throw new Error(`companion frame ${skin}/${anim} missing at the shell pin`);
  return hit;
};
const skinOrder = ['default', ...Object.keys(manifest.skins).filter((s) => s !== 'default')];
const shell = pins.shell;
const assets = `${shell.repo}/tree/${shell.sha}/assets/companion`;
const paletteOf = (s: string) => Object.entries(manifest.skins[s]?.palette ?? {}).slice(0, 5);
---

<SiteLayout title={m.javiElCompaneroDelEscritorio} description={m.javiElHorneroQueVive}>
  <section class="section">
    <p class="plate-id">
      <strong>{m.companeroHornero}</strong>
      <span>{m.parteDelShell}</span>
    </p>
    <h1>{m.javiElCompanero}</h1>
    <p class="lede">{m.javiEsUnHorneroQue}</p>
    <CompanionStage locale={locale} />
  </section>

  <section class="section" aria-label={m.javiEnUnEscritorioReal}>
    <CaptureFigure slot="CAP-JAVI-08" locale={locale} />
  </section>

  <section class="section">
    <h2>{m.personajes}</h2>
    <ul class="skins" role="list">
      {skinOrder.map((s) => (
        <li>
          <div class="skin-frames">
            <Image
              src={firstFrame(s, 'idle')}
              alt={m.elCompanionEnReposo(manifest.skins[s].label)}
              height={140}
              densities={[1, 2]}
            />
            <Image
              src={firstFrame(s, 'fly')}
              alt={m.elCompanionVolando(manifest.skins[s].label)}
              height={140}
              densities={[1, 2]}
            />
          </div>
          <span>{manifest.skins[s].label}</span>
          {paletteOf(s).length > 0 && (
            <span class="swatches" aria-hidden="true">
              {paletteOf(s).map(([, hex]) => (
                <span style={`background:${hex}`}></span>
              ))}
            </span>
          )}
        </li>
      ))}
    </ul>
    <p>{m.cadaPersonajeEsLaMisma}</p>
    <pre><code>qs ipc call companion summon
qs ipc call companion setSkin gaucho
qs ipc call companion play celebrate
qs ipc call companion say "Back in five minutes" 5000</code></pre>
  </section>

  <section class="section">
    <h2>{m.comportamiento}</h2>
    <dl class="rows">
      <div>
        <dt>{m.descansa}</dt>
        <dd>{m.respiraTranquiloPestaneaMiraAlrededor}</dd>
      </div>
      <div>
        <dt>{m.armaSuNido}</dt>
        <dd>{m.cadaTantoTraeUnaRamita}</dd>
      </div>
      <div>
        <dt>{m.noMolesta}</dt>
        <dd>{m.viveEnSuPropiaCapa}</dd>
      </div>
      <div>
        <dt>{m.vosLoUbicas}</dt>
        <dd>{m.arrastraloACualquierLadoRecuerda}</dd>
      </div>
      <div>
        <dt>{m.movimiento}</dt>
        <dd>{m.conElMovimientoReducidoActivado}</dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <h2>{m.controles}</h2>
    <p>{m.todoSeAjustaEnCentro}</p>
  </section>

  <section class="section optional-band" aria-labelledby="assistant-title">
    <h2 id="assistant-title">{m.asistenteOpcionalExperimentalDesactivadoPor}</h2>
    <p>
      {m.elCompanionEsSoloPresentacion} <a href="https://github.com/NousResearch/hermes-agent">Hermes Agent</a>{' '}
      {m.deNousResearchAlQue} <code>horneroctl assistant</code>. {m.esta} <strong>{m.desactivadoPorDefecto}</strong>{' '}
      {m.yNuncaCorreComoRoot}
    </p>
    <p>{m.activaloDesdeUnaTerminal}</p>
    <pre><code>horneroctl assistant enable
horneroctl assistant status
horneroctl assistant ask "what updates are available?"</code></pre>
    <p>{m.mientrasUnaEjecucionEstaEn}</p>
    <ul>
      {Object.entries(manifest.assistantStates ?? {}).map(([state, anim]) => (
        <li>
          <code>{state}</code> → <code>{anim}</code>
        </li>
      ))}
    </ul>
    <ul>
      <li>{m.laInformacionDelSistemaViene}</li>
      <li>
        {m.cuandoUnaEjecucionNecesitaAprobacion}
        <code>qs ipc call companion approve &lt;run-id&gt; approve|deny</code>
        {m.nadaSeApruebaAutomaticamenteSi}
      </li>
      <li>{m.elGatewayEscuchaSoloEn}</li>
    </ul>
  </section>

  <section class="section" aria-labelledby="platform-title">
    <h2 id="platform-title">{m.unaPlataformaDeCompanerosVivos}</h2>
    <p>{m.javiEsElPrimerPersonaje}</p>
    <p>
      <a class="text-link" href={L('/editions')}>
        {m.verElEstadoDeCada}
      </a>
    </p>
  </section>

  <section class="section" aria-labelledby="agents-title">
    <h2 id="agents-title">{m.agentesEdicionPlanificada}</h2>
    <p>{m.laEdicionAgentsFiguraComo}</p>
    <p>
      <a class="text-link" href={L('/editions')}>
        {m.verElEstadoDeCada}
      </a>
    </p>
  </section>

  <section class="section">
    <h2>{m.limites}</h2>
    <p>
      {m.elCompanionNoLeeLo} <em>{m.escuchando}</em> {m.y} <em>{m.pensando}</em> {m.sonAnimacionesAccionadasPorIpc}
    </p>
    <p class="source">
      {m.framesDe}{' '}
      <a href={assets}>
        <code>HorneroOS/shell/assets/companion</code>
      </a>{' '}
      {m.enElCommit}{' '}
      <a href={`${shell.repo}/commit/${shell.sha}`}>
        <code>{short(shell.sha)}</code>
      </a>
      {m.losAssetsQueDibujaLa}
    </p>
  </section>

  <CaptureGallery route="/companion" locale={locale} exclude={['CAP-JAVI-08']} />
</SiteLayout>

<style>
  .skins {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .skins li {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 2px;

    background: var(--panel);
    border: 1px solid var(--rule);
    text-align: center;
  }

  .skin-frames {
    display: flex;
    gap: 0.25rem;
    align-items: end;
    justify-content: center;
  }

  .skin-frames img {
    height: 120px;
    width: auto;
  }

  .swatches {
    display: inline-flex;
    gap: 3px;
  }

  .swatches span {
    width: 14px;
    height: 14px;
    border: 1px solid var(--rule);
    display: inline-block;
  }

  .rows {
    display: grid;
    gap: 0;
  }

  .rows > div {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) 1fr;
    gap: 0.5rem 1.5rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }

  .rows dt {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    padding-top: 0.15rem;
  }

  .rows dd {
    margin: 0;
    color: var(--ink-muted);
  }

  @media (max-width: 640px) {
    .rows > div {
      grid-template-columns: 1fr;
    }
  }

  .source {
    font-size: var(--step--1);
    border-top: 3px solid var(--signal);
    padding-top: 0.6rem;
  }

  pre {
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 600px) {
    pre {
      font-size: 0.72rem;
    }
  }

  .optional-band {
    padding: clamp(1.1rem, 3vw, 2rem);
    border: 1px dashed var(--phosphor);
  }
</style>
