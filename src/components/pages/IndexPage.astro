<style>
  /* ------------------------------------------------------------ hero --- */
  /* The homepage hero is a brand surface: it may carry the La Plata diagonal. */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    margin-top: calc(-1 * clamp(2rem, 1rem + 4vw, 4rem));
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  .hero-field {
    position: absolute;
    z-index: -1;
    inset: 0 calc(50% - 50vw);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
  }

  /* One La Plata diagonal avenue cuts across the hero's right side. */
  .hero-field::before,
  .hero-field::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .hero-field::before {
    background: repeating-linear-gradient(45deg, var(--diagonal) 0 1px, transparent 1px 9px);
    clip-path: polygon(74% 0, 92% 0, 72% 100%, 54% 100%);
  }

  .hero-field::after {
    background: var(--signal);
    clip-path: polygon(92% 0, calc(92% + 2px) 0, calc(72% + 2px) 100%, 72% 100%);
    opacity: 0.55;
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    max-width: 62rem;
  }

  .hero h1 {
    max-width: 18ch;
    font-size: clamp(2.6rem, 1.5rem + 4vw, 5.4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .hero .lede {
    max-width: 56ch;
  }

  .hero .cta-row {
    margin-top: 0.4rem;
  }

  /* Telemetry: live readouts from the pinned product data, never invented. */
  .telemetry {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
  }

  .telemetry > div {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 1rem 0.2rem 0;
  }

  .telemetry > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .telemetry dt {
    color: var(--ink-muted);
    font: 500 0.68rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Readout wells (Signal Bezel §4.1): changing values sit in sunken wells. */
  .telemetry dd a {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
    background: var(--sunken);
    color: var(--ink);
    font: 500 0.92rem var(--font-mono);
    text-decoration: none;
  }

  .telemetry dd a:hover {
    color: var(--cue);
    text-decoration: underline;
  }

  .telemetry > div:first-child dt::before {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.5rem;
    background: var(--phosphor);
    /* The one live indicator on the page: a static halo, Night only (glow role). */
    box-shadow: 0 0 4px color-mix(in srgb, var(--phosphor) 40%, transparent);
    content: '';
    vertical-align: 0.1em;
  }

  :global(:root[data-color-mode='light']) .telemetry > div:first-child dt::before {
    box-shadow: none;
  }

  /* --------------------------------------------------------- monitor --- */
  .monitor {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .monitor-frame {
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--sunken);
  }

  .monitor-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid var(--rule);
    background:
      repeating-linear-gradient(0deg, var(--scanline) 0 1px, transparent 1px 3px),
      var(--panel);
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
    letter-spacing: 0.04em;
  }

  .monitor-strip a {
    margin-left: auto;
  }

  .monitor-frame :global(.capture-figure) {
    padding: clamp(0.5rem, 1.2vw, 0.9rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .telemetry > div {
      animation: readout-in var(--dur-settle) var(--ease-settle) both;
    }

    .telemetry > div:nth-child(2) {
      animation-delay: 60ms;
    }

    .telemetry > div:nth-child(3) {
      animation-delay: 120ms;
    }

    .telemetry > div:nth-child(4) {
      animation-delay: 180ms;
    }
  }

  @keyframes readout-in {
    from {
      transform: translateY(6px);
    }
    to {
      transform: none;
    }
  }

  /* ---------------------------------------------------------- shared --- */
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 0.8rem clamp(1.5rem, 5vw, 4.5rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .section-head .eyebrow {
    grid-column: 1 / -1;
  }

  .section-head h2 {
    font-size: var(--step-3);
    line-height: 1.02;
  }

  .section-head > p:last-child {
    max-width: 52ch;
    color: var(--ink-muted);
  }

  .section > * + * {
    margin-top: 0;
  }

  .section-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.5rem;
  }

  /* -------------------------------------------------------- editions --- */
  .channels {
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .channel-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 5fr);
    gap: 1rem clamp(1.5rem, 3.5vw, 3rem);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--rule);
  }

  .channel-row::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: 2px;
    height: 10px;
    background: var(--signal);
    content: '';
  }

  .channel-id {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }

  .channel-id h3 {
    font-size: var(--step-2);
  }

  .channel-summary {
    color: var(--ink-muted);
  }

  .channel-work h4 {
    margin-bottom: 0.5rem;
    color: var(--ink-muted);
    font: 500 0.7rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .channel-work ul {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
    list-style: none;
  }

  .channel-work li {
    padding-left: 0.9rem;
    border-left: 1px solid var(--rule-strong);
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .channel-work strong {
    color: var(--ink);
    font-weight: 600;
  }

  .editions-foot {
    margin-top: 1rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  /* ---------------------------------------------------------- system --- */
  .spec {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(0, 3fr);
    gap: 0.5rem 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .spec-row:nth-child(odd) {
    padding-right: clamp(1rem, 3vw, 2.5rem);
  }

  .spec-row:nth-child(even) {
    padding-left: clamp(1rem, 3vw, 2.5rem);
    border-left: 1px solid var(--rule);
  }

  .spec dt {
    color: var(--ink);
    font: 600 1.15rem var(--font-display);
  }

  .spec dd {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    color: var(--ink-muted);
  }

  .spec dd code {
    padding: 0.25rem 0.55rem;
    border-color: var(--rule);
    border-left: 2px solid var(--signal);
    color: var(--ink);
  }

  .spec dd code::before {
    margin-right: 0.5rem;
    color: var(--ink-muted);
    content: '$';
  }

  /* ------------------------------------------------------ experience --- */
  .experience-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(12rem, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }

  .concept {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
  }

  .concept-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    align-items: start;
  }

  .concept-note {
    max-width: 90ch;
    margin-top: 0.6rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .index {
    display: grid;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .index a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .index a:hover span {
    color: var(--cue);
    text-decoration: underline;
  }

  .index b {
    order: 2;
    color: var(--signal);
    font: 600 1.6rem var(--font-display);
  }

  .world {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 0;
    margin-top: 2rem;
    list-style: none;
  }

  .world li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule-strong);
  }

  .world .world-art {
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
  }

  .world .world-art > :not(:global(.world-javi)) {
    grid-column: 1;
  }

  .world :global(.world-javi) {
    grid-column: 2;
    grid-row: 1 / span 3;
    width: auto;
    height: 5.5rem;
  }

  .world p {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 900px) {
    .world {
      grid-template-columns: 1fr;
    }
  }

  .modes {
    display: grid;
    gap: 0.9rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius);
  }

  .modes-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .modes > p {
    max-width: 70ch;
    color: var(--ink-muted);
  }

  .modes ul {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .modes li {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 0.8rem 0.9rem 0.2rem 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .modes li + li {
    padding-left: 0.9rem;
    border-left: 1px solid var(--rule);
  }

  .modes strong {
    color: var(--ink);
    font: 600 1.05rem var(--font-display);
  }

  /* ------------------------------------------------------------- get --- */
  .journey {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 1.5rem;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .journey li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem 1.1rem 0;
  }

  .journey li + li {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .step {
    color: var(--signal);
    font: 500 0.8rem var(--font-mono);
  }

  .journey p {
    color: var(--ink-muted);
  }

  /* ------------------------------------------------------------ open --- */
  .ledger {
    display: grid;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--rule);
  }

  .ledger > div {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(0, 5fr);
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .ledger dt {
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ledger dd {
    max-width: 72ch;
    color: var(--ink-muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ------------------------------------------------------ responsive --- */
  @media (max-width: 1000px) {
    .channel-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .channel-work {
      grid-column: 1 / -1;
    }

    .modes ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .modes li,
    .modes li + li {
      padding: 0.8rem 0.9rem 0.6rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
  }

  @media (max-width: 860px) {
    .concept-pair,
    .section-head,
    .experience-grid,
    .spec {
      grid-template-columns: 1fr;
    }

    .spec-row:nth-child(n) {
      padding-inline: 0;
      border-left: 0;
    }

    .telemetry {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .telemetry > div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .telemetry > div:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }

    .journey {
      grid-template-columns: 1fr;
    }

    .journey li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 600px) {
    .channel-row,
    .spec-row,
    .ledger > div {
      grid-template-columns: 1fr;
    }

    .modes ul {
      grid-template-columns: 1fr;
    }

    .hero-field::before {
      clip-path: polygon(82% 0, 100% 0, 100% 40%);
    }

    .hero-field::after {
      display: none;
    }
  }
</style>
