---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import LookCompare from '../../components/LookCompare.astro';
import StoryTimeline from '../../components/StoryTimeline.astro';
import CommunityJoin from '../../components/CommunityJoin.astro';
import MaturityMeter from '../../components/MaturityMeter.astro';
import CaptureFigure from '../../components/CaptureFigure.astro';
import StageBadge from '../../components/StageBadge.astro';
import FaqList from '../../components/FaqList.astro';
import PixelArt from '../../components/PixelArt.astro';
import CyberTelemetry from '../../components/CyberTelemetry.astro';
import CyberTerminalDeck from '../../components/CyberTerminalDeck.astro';
import { faqItems } from '../../data/why';
import { editorialForPage, slotCounts } from '../../data/captures';
import { feature } from '../../data/features';
import { modes } from '../../data/modes';
import { featuredStory } from '../../data/story';
import {
  candidate,
  editionCatalogue,
  editions,
  extensionCatalogue,
  gamingCatalogue,
  latestTagged,
  layouts,
  pins,
  short,
  studioCatalogue,
  themes,
  type Maturity,
} from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/index';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const compareCaption = editorialForPage('/').find((section) => section.format === 'compare')?.caption[locale];
const editionById = Object.fromEntries(editions.map((edition) => [edition.id, edition]));
const edition = (id: string) => {
  const found = editionById[id];
  if (!found) throw new Error(`Edition ${id} is missing from the pinned catalogue`);
  return found;
};
const compositor = (id: string) => editionCatalogue.compositors.find((item) => item.id === id);
const maturityName = (maturity: Maturity) => m.maturityLabels[maturity];

const studioApp = (id: string) => studioCatalogue.applications.find((app) => app.id === id)?.title ?? id;
const studioSpec = (id: string) => {
  const spec = studioCatalogue.specializations.find((item) => item.id === id);
  if (!spec) throw new Error(`Studio specialization ${id} is missing from the pinned catalogue`);
  return { title: spec.title, apps: spec.applications.map(studioApp) };
};
if (!gamingCatalogue) throw new Error('The Gaming catalogue is missing from the pinned edition catalogue');
const gaming = gamingCatalogue;
const gamingApp = (id: string) => gaming.applications.find((app) => app.id === id)?.title ?? id;
const gamingSpec = (id: string) => {
  const spec = gaming.specializations.find((item) => item.id === id);
  if (!spec) throw new Error(`Gaming specialization ${id} is missing from the pinned catalogue`);
  return { title: spec.title, apps: spec.applications.map(gamingApp), isDefault: spec.isDefault };
};
const audioDefault = studioCatalogue.audioModes.find((mode) => mode.isDefault)?.title;
const audioOptIn = studioCatalogue.audioModes.filter((mode) => mode.explicitOptIn).map((mode) => mode.title);
const officialPlugins = extensionCatalogue.plugins.filter((plugin) => plugin.trust === 'official');
const previewLabel = m.usoDiario;
const hyprland = compositor('hyprland');
// Javi: a real frame from HorneroOS/shell assets/companion at the shell pin.
const javiFrames = import.meta.glob<ImageMetadata>(
  '../../../.cache/product-src/shell/assets/companion/frames/default-greet-01.png',
  {
    eager: true,
    import: 'default',
  },
);
const javiFrame = Object.values(javiFrames)[0];
if (!javiFrame) throw new Error('Javi greet frame is missing at the shell pin');
const modesFeature = feature('experience-modes');
const chromaticFeature = feature('chromatic');
const javiFeature = feature('companion');
const niri = compositor('niri');
const planned = editions
  .filter((item) => item.maturity === 'planned')
  .map((item) => item.title.replace('HorneroOS ', ''));
const shipping = editions.filter((item) => item.maturity !== 'planned');

const channels = [
  {
    id: 'desktop',
    channel: 'CH 01',
    name: 'Desktop',
    title: m.construiTuMundo,
    href: L('/desktop'),
    summary: m.laBaseDeTodasLas(maturityName(niri?.maturity ?? 'planned').toLowerCase(), layouts.length, themes.length),
    workflows: m.workflows(layouts.length, officialPlugins.length),
    maturity: edition('desktop').maturity,
  },
  {
    id: 'studio',
    channel: 'CH 02',
    name: 'Studio',
    title: m.haceAlgoReal,
    href: L('/studio'),
    summary: m.studioSummary(studioCatalogue.specializations.length - 2, audioDefault ?? 'Balanced', audioOptIn),
    workflows: [
      studioSpec('audio-music-production'),
      studioSpec('video-editing-post-production'),
      studioSpec('graphic-design-illustration'),
    ].map((spec) => ({ lead: spec.title, text: spec.apps.join(', ') })),
    maturity: edition('studio').maturity,
  },
  {
    id: 'gaming',
    channel: 'CH 03',
    name: 'Gaming',
    title: m.jugaATuManera,
    href: L('/gaming'),
    summary: m.desktopMasUnaCapaDe,
    workflows: [gamingSpec('desktop-gaming'), gamingSpec('multi-launcher'), gamingSpec('streaming')].map((spec) => ({
      lead: spec.title,
      text: spec.apps.join(', ') + (spec.isDefault ? m.seleccionPorDefecto : ''),
    })),
    maturity: edition('gaming').maturity,
  },
];

const readouts = [
  { label: m.version, value: latestTagged?.version ?? '—', href: L('/releases') },
  {
    label: m.ediciones,
    value: m.paraUsoDiarioPlanificadas(shipping.length, planned.length),
    href: L('/editions'),
  },
  {
    label: m.compositor,
    value: `Hyprland ${maturityName(hyprland?.maturity ?? 'planned').toLowerCase()} · Niri ${maturityName(niri?.maturity ?? 'planned').toLowerCase()}`,
    href: L('/docs/desktop/compositors/'),
  },
  { label: 'Shell', value: short(pins.shell.sha), href: `${pins.shell.repo}/commit/${pins.shell.sha}` },
];

const system = [
  {
    id: 'horneroctl',
    title: 'horneroctl (V 0.5.2)',
    text: m.unaHerramientaDeSistemaPara,
    command: 'horneroctl hardware rollcall',
  },
  {
    id: 'installer-rollback',
    title: m.instaladorYRollback,
    text: m.instaladorYRollbackDesc,
    command: 'horneroctl system info',
  },
  {
    id: 'ai-isolation',
    title: m.iaLocalYSeguridad,
    text: m.iaLocalYSeguridadDesc,
    command: 'systemctl status app-models.slice app-agents.slice',
  },
  {
    id: 'ecosystem-theming',
    title: m.ecosistemaYChromatic,
    text: m.ecosistemaYChromaticDesc,
    command: 'horneroctl apps webapp',
  },
  {
    id: 'updates',
    title: m.actualizaciones,
    text: m.lasConsultasDeActualizacionSolo,
    command: 'horneroctl package check',
  },
  {
    id: 'configuration',
    title: m.configuracion,
    text: m.elCentroDeControlY,
    command: 'horneroctl config validate',
  },
];

const journey = m.journey(latestTagged?.version ?? '0.2.0-preview32');

const title = m.horneroosUnaEstacionDeTrabajo;
const counts = slotCounts();
const description = m.horneroosEsUnaEstacionDe(latestTagged?.version ?? '0.2.0-preview32');
---

<SiteLayout
  title={title}
  description={description}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'HorneroOS',
    applicationCategory: 'OperatingSystem',
    operatingSystem: 'Arch Linux (x86_64)',
    description,
    url: Astro.site ? new URL(L('/'), Astro.site).toString() : undefined,
    softwareVersion: latestTagged?.version,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  }}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-field" aria-hidden="true">
      <div class="hero-crt-grid"></div>
    </div>
    <CyberTelemetry locale={locale} />
    <div class="hero-copy cyber-stagger">
      <p class="eyebrow">
        <b>HorneroOS</b>
        <span>{previewLabel}</span>
        <span>x86_64 · Arch Linux</span>
      </p>
      <h1 id="hero-title">{m.unaEstacionDeTrabajoPara}</h1>
      <p class="lede">{m.horneroosEsUnSistemaOperativo}</p>
      <div class="cta-row">
        <a href={L('/install')} class="cta primary">
          {m.descargaLaIsoActual}
        </a>
        <a href={L('/install/arch')} class="cta secondary">
          {m.yaUsasArchInstalaViaAur}
        </a>
        <a href={L('/editions')} class="cta secondary">
          {m.elegiTuEdicion}
        </a>
      </div>
    </div>
    <dl class="telemetry" aria-label={m.estadoActualDesdeLosDatos}>
      {readouts.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>
            <a href={item.href}>{item.value}</a>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="monitor cyber-stagger cyber-stagger-delay-1" aria-labelledby="monitor-title">
    <h2 id="monitor-title" class="visually-hidden">
      {m.elEscritorioTrabajando}
    </h2>
    <div class="monitor-frame cyber-chassis">
      <div class="monitor-strip">
        <span class="monitor-leds" aria-hidden="true">
          <i class="led-amber"></i>
          <i class="led-celeste"></i>
          <i class="led-gold"></i>
        </span>
        <span class="channel">HORNERO-OS // HYPRLAND + QUICKSHELL</span>
        <span class="monitor-coords">-34.6037° S, 58.3816° W // AR</span>
        <a href={L('/showroom')}>{m.todasLasCapturasSeleccionadas}</a>
      </div>
      <CaptureFigure
        slot="CAP-SIGNAL-01"
        locale={locale}
        eager
        sizes="(min-width: 1500px) 1400px, calc(100vw - 2rem)"
      />
    </div>
  </section>

  <div class="cyber-horizon-divider" aria-hidden="true">
    <PixelArt kind="skyline" />
  </div>

  <section class="section editions" aria-labelledby="editions-title">
    <header class="section-head">
      <p class="eyebrow">
        <b>{m.ediciones}</b>
        <span>{m.unaBaseTresOficios}</span>
      </p>
      <h2 id="editions-title">{m.elegiParaQueEsTu}</h2>
      <p>{m.lasTresEdicionesCompartenBase}</p>
    </header>
    <ol class="channels" role="list">
      {channels.map((item) => (
        <li class="channel-row cyber-bezel" id={`edition-${item.id}`}>
          <div class="channel-id">
            <p class="eyebrow">
              <b>{item.channel}</b>
              <span>{item.name}</span>
            </p>
            <h3>{item.title}</h3>
            <MaturityMeter maturity={item.maturity} locale={locale} />
          </div>
          <p class="channel-summary">{item.summary}</p>
          <div class="channel-work">
            <h4>{m.flujosDeTrabajo}</h4>
            <ul role="list">
              {item.workflows.map((flow) => (
                <li>
                  <strong>{flow.lead}</strong> {flow.text}
                </li>
              ))}
            </ul>
            <a href={item.href}>{m.conoce(item.name)}</a>
          </div>
        </li>
      ))}
    </ol>
    <p class="editions-foot">
      {m.plannedNote(planned)} <a href={L('/editions')}>{m.comparaTodasLasEdiciones}</a>
    </p>
  </section>

  <section class="section system" aria-labelledby="system-title">
    <header class="section-head">
      <p class="eyebrow">
        <b>{m.sistema}</b>
        <span>{m.debajoDelEscritorio}</span>
      </p>
      <h2 id="system-title">{m.elSistemaOperativo}</h2>
      <p>{m.loQueHaceConfiableA}</p>
    </header>
    <CyberTerminalDeck locale={locale} />
    <dl class="spec">
      {system.map((item) => (
        <div class="spec-row">
          <dt>{item.title}</dt>
          <dd>
            <p>{item.text}</p>
            <code>{item.command}</code>
          </dd>
        </div>
      ))}
    </dl>
    <p class="section-foot">
      <a href={L('/docs/desktop/horneroctl/')}>{m.leeLaGuiaDeHorneroctl}</a>
      <a href={L('/docs/architecture/updates-delivery/')}>{m.comoSeEntreganLosPaquetes}</a>
      <a href={L('/why-horneroos#capability-matrix')}>{m.verMatrizComparativa}</a>
    </p>
  </section>

  <section class="section experience" aria-labelledby="experience-title">
    <header class="section-head">
      <p class="eyebrow">
        <b>{m.experiencia}</b>
        <span>Hornero Shell</span>
      </p>
      <h2 id="experience-title">{m.unEscritorioPropioQueSe}</h2>
      <p>{m.horneroShellEsLaCapa(layouts.length, themes.length, officialPlugins.length)}</p>
    </header>
    <div class="concept">
      <div class="concept-pair">
        <CaptureFigure slot="CAP-THEME-05" locale={locale} />
        <CaptureFigure slot="CAP-SIGNAL-02" locale={locale} />
      </div>
      <p class="concept-note">
        {m.laDireccionSignalBezelTal}
        <a href="https://github.com/HorneroOS/docs/blob/main/development/signal-visual-language.md">
          {m.leeElLenguajeVisualSignal}
        </a>
        .
      </p>
    </div>

    <div class="experience-grid">
      <div class="experience-compare">
        <LookCompare dark="CAP-COMPARE-01" light="CAP-COMPARE-02" locale={locale} caption={compareCaption} />
      </div>
      <ul class="index" role="list">
        <li>
          <a href={L('/layouts')}>
            <b>{layouts.length}</b>
            <span>{m.layouts}</span>
          </a>
        </li>
        <li>
          <a href={L('/themes')}>
            <b>{themes.length}</b>
            <span>{m.temas}</span>
          </a>
        </li>
        <li>
          <a href={L('/extensions')}>
            <b>{officialPlugins.length}</b>
            <span>{m.extensionesOficiales}</span>
          </a>
        </li>
        <li>
          <a href={L('/companion')}>
            <b>1</b>
            <span>Javi</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="modes">
      <div class="modes-head">
        <h3>{m.atmosferasModosDeExperiencia}</h3>
        <StageBadge stage={modesFeature.stage} locale={locale} />
      </div>
      <p>{m.cincoModosQueCambianComo}</p>
      <ul role="list">
        {modes.map((mode) => (
          <li>
            <strong>{mode.name}</strong>
            <span>{mode.line[locale]}</span>
          </li>
        ))}
      </ul>
      <a href={L('/modes')}>{m.conoceLasCincoAtmosferas}</a>
    </div>
    <ul class="world" role="list">
      <li>
        <StageBadge stage={chromaticFeature.stage} locale={locale} />
        <h3>
          <a href={L('/chromatic')}>Hornero Chromatic</a>
        </h3>
        <p>{chromaticFeature.summary[locale]}</p>
      </li>
      <li class="world-art">
        <Image
          class="world-javi"
          src={javiFrame}
          alt={m.javiElHorneroDelEscritorio}
          height={112}
          densities={[1, 2]}
          loading="lazy"
        />
        <StageBadge stage={javiFeature.stage} locale={locale} />
        <h3>
          <a href={L('/companion')}>{m.javiElHorneroDelEscritorio2}</a>
        </h3>
        <p>{javiFeature.summary[locale]}</p>
        <CaptureFigure slot="CAP-JAVI-08" locale={locale} sizes="(min-width: 1100px) 420px, calc(100vw - 2rem)" />
      </li>
      <li>
        <StageBadge stage={feature('pluginkit').stage} locale={locale} />
        <h3>
          <a href={L('/extensions')}>{m.extensionesYPluginkit}</a>
        </h3>
        <p>{feature('pluginkit').summary[locale]}</p>
      </li>
    </ul>
  </section>

  <div class="cyber-horizon-divider" aria-hidden="true">
    <PixelArt kind="skyline" />
  </div>

  <section class="section get" aria-labelledby="get-title">
    <header class="section-head">
      <p class="eyebrow">
        <b>{m.instalacion}</b>
        <span>{previewLabel}</span>
      </p>
      <h2 id="get-title">{m.deLaDescargaAlPrimer}</h2>
      <p>{m.limitsNote(candidate?.version)}</p>
    </header>
    <ol class="journey" role="list">
      {journey.map((step, index) => (
        <li>
          <span class="step" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    <div class="cta-row">
      <a href={L('/install')} class="cta primary">
        {m.descargaLaIsoActual}
      </a>
      <a href={L('/docs/getting-started/')} class="cta secondary">
        {m.leeLaGuiaDeInicio}
      </a>
    </div>
  </section>

  <section class="section open" aria-labelledby="open-title">
    <header class="section-head">
      <p class="eyebrow">
        <b>{m.codigoAbierto}</b>
        <span>{m.evidenciaEHistoria}</span>
      </p>
      <h2 id="open-title">{m.deDotfilesAHorneroosEn}</h2>
      <p>{m.horneroEmpezoEn2018Como}</p>
    </header>
    <StoryTimeline entries={featuredStory} label={m.lineaDeTiempoDeHorneroos} locale={locale} />
    <dl class="ledger">
      <div>
        <dt>{m.evidencia}</dt>
        <dd>
          {m.elSitioMuestraUnaSeleccion(counts.public)}
          <a href={L('/showroom#capture-ledger')}>{m.showroom}</a>
          {m.muestraLaSeleccionCompleta}
          {m.losDatosDeProductoSalen}
          <a href={`${pins.shell.repo}/commit/${pins.shell.sha}`}>
            <code>{short(pins.shell.sha)}</code>
          </a>
          {m.yConfig}
          <a href={`${pins.config.repo}/commit/${pins.config.sha}`}>
            <code>{short(pins.config.sha)}</code>
          </a>
          .
        </dd>
      </div>
      <div>
        <dt>{m.usoDiario2}</dt>
        <dd>{m.dailyUseAccount}</dd>
      </div>
      <div>
        <dt>{m.personas}</dt>
        <dd>
          <a href="https://github.com/ulises-jeremias">Ulises Jeremías</a>
          {m.mantieneElProyecto}
          <a href="https://github.com/PandaFoss">Panda Foss</a>
          {m.mantenedorDe}
          <a href="https://gitlab.com/anarchyinstaller/installer">Anarchy Linux</a>
          {m.desarrollaElInstaladorLaShell}
          <a href="https://github.com/caelestia-dots/shell">Caelestia Shell</a>
          {m.su}
          <a href={`${pins.shell.repo}/blob/${pins.shell.sha}/NOTICE`}>{m.creditoYLicencia}</a>
          {m.quedanEnElRepositorio}
        </dd>
      </div>
    </dl>
    <p class="section-foot">
      <a href={L('/roots')}>{m.leeLaHistoriaCompleta}</a>
      <a href="https://github.com/HorneroOS">{m.exploraElCodigoFuente}</a>
      <a href="https://github.com/HorneroOS/.github/blob/main/CONTRIBUTING.md">{m.contribui}</a>
    </p>
  </section>

  <section class="section" aria-labelledby="faq-teaser-title">
    <header class="section-head">
      <h2 id="faq-teaser-title">{m.preguntasFrecuentes}</h2>
      <p>
        <a href={L('/why-horneroos#faq')}>{m.todasLasPreguntasLaComparacion}</a>.
      </p>
    </header>
    <FaqList items={faqItems.slice(0, 3)} locale={locale} />
  </section>

  <CommunityJoin locale={locale} />
</SiteLayout>

<style>
  /* ------------------------------------------------------------ hero --- */
  /* The homepage hero is a brand surface: it may carry the La Plata diagonal. */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    margin-top: calc(-1 * clamp(2rem, 1rem + 4vw, 4rem));
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  .hero-field {
    position: absolute;
    z-index: -1;
    inset: 0 calc(50% - 50vw);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
  }

  /* One La Plata diagonal avenue cuts across the hero's right side. */
  .hero-field::before,
  .hero-field::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .hero-field::before {
    background: repeating-linear-gradient(45deg, var(--diagonal) 0 1px, transparent 1px 9px);
    clip-path: polygon(74% 0, 92% 0, 72% 100%, 54% 100%);
  }

  .hero-field::after {
    background: var(--signal);
    clip-path: polygon(92% 0, calc(92% + 2px) 0, calc(72% + 2px) 100%, 72% 100%);
    opacity: 0.55;
  }

  /* Subtle CRT scanline + perspective synth-grid atmosphere (non-intrusive). */
  .hero-crt-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, var(--scanline) 0 1px, transparent 1px 3px),
      linear-gradient(
        180deg,
        transparent 55%,
        color-mix(in srgb, var(--cue) 6%, transparent) 100%
      );
  }

  .hero-crt-grid::after {
    position: absolute;
    inset: 60% 0 0 0;
    pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--cue) 10%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--cue) 8%, transparent) 1px, transparent 1px);
    background-size: 32px 18px;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.75) 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.75) 100%);
    content: '';
  }

  :global(:root[data-color-mode='light']) .hero-crt-grid::after {
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-crt-grid {
      display: none;
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    max-width: 62rem;
  }

  .hero h1 {
    max-width: 18ch;
    font-size: clamp(2.6rem, 1.5rem + 4vw, 5.4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .hero .lede {
    max-width: 56ch;
  }

  .hero .cta-row {
    margin-top: 0.4rem;
  }

  /* Telemetry: live readouts from the pinned product data, never invented. */
  .telemetry {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
  }

  .telemetry > div {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 1rem 0.2rem 0;
  }

  .telemetry > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .telemetry dt {
    color: var(--ink-muted);
    font: 500 0.68rem var(--font-mono);
