---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SourcePlate from '../../components/SourcePlate.astro';
import {
  candidate,
  commitUrl,
  latestReleased,
  latestTagged,
  pins,
  releases,
  short,
  type Release,
} from '../../data/product';
import { download } from '../../data/download';
import { localizePath, type Locale } from '../../i18n/ui';
import { releaseNotes } from '../../data/release-notes';
import { messages } from '../../i18n/messages/releases';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const title = (r: Release) => {
  return r.version.replace(/-draft$/, m.borrador);
};
const statusText: Record<Release['status'], string> = m.statusText;
const hornero = (path: string) => `${pins.hornero.repo}/blob/${pins.hornero.sha}/${path}`;
const shell = pins.shell.repo;
const config = pins.config.repo;
---

<SiteLayout title={m.releasesHorneroos} description={m.releasesDescription(latestTagged?.name)}>
  <section class="section">
    <p class="plate-id">
      <strong>Archivo de transmisiones</strong>
      <span>{m.historialDeReleases}</span>
    </p>
    <h1>Releases</h1>
    <p>
      {m.cadaReleaseCuentaQueCambio}
      <code>horneroctl</code> {m.seCompilaDesdeElMismo}
      <a href={L('/install')}>{m.instalar}</a> {m.paraElChecksumLaFirma}
    </p>
    <dl class="now">
      {latestReleased && latestReleased !== latestTagged && (
        <div>
          <dt>{m.ultimaPublicada}</dt>
          <dd>
            <a href={`#${latestReleased.name}`}>{title(latestReleased)}</a>, {latestReleased.date} (
            {m.paquetesLaIsoSigueEn(download.version)})
          </dd>
        </div>
      )}
      {latestTagged && (
        <div>
          <dt>{m.ultimaEtiquetada}</dt>
          <dd>
            <a href={`#${latestTagged.name}`}>{title(latestTagged)}</a>, {latestTagged.date}
          </dd>
        </div>
      )}
      {candidate && (
        <div>
          <dt>{m.enPreparacion}</dt>
          <dd>
            <a href={`#${candidate.name}`}>{title(candidate)}</a> ({m.candidataARelease})
          </dd>
        </div>
      )}
    </dl>
    <SourcePlate source="hornero" path="releases" locale={locale} />
  </section>

  <ol class="timeline" role="list">
    {releases.map((r) => (
      <li class:list={['release', r.status]} id={r.name}>
        <div class="release-head">
          <h2>{title(r)}</h2>
          <span class="status">{statusText[r.status]}</span>
        </div>
        <p class="when">
          <code>{r.name}</code> · {r.date}
        </p>
        {releaseNotes[r.version] ? (
          <>
            <p class="summary">{releaseNotes[r.version][locale]}</p>
            <details class="tech-summary">
              <summary>{m.resumenTecnico}</summary>
              <p class="summary">{r.summary}</p>
            </details>
          </>
        ) : (
          <p class="summary">{r.summary}</p>
        )}
        <dl class="pins">
          {r.shell && (
            <div>
              <dt>shell</dt>
              <dd>
                <a href={commitUrl(shell, r.shell.sha)}>
                  <code>{short(r.shell.sha)}</code>
                </a>{' '}
                {r.shell.subject}
              </dd>
            </div>
          )}
          {r.config && (
            <div>
              <dt>config</dt>
              <dd>
                <a href={commitUrl(config, r.config.sha)}>
                  <code>{short(r.config.sha)}</code>
                </a>{' '}
                {r.config.subject}
              </dd>
            </div>
          )}
        </dl>
        <p class="links">
          <a href={hornero(`manifests/v${r.version}.yaml`)}>Manifest</a>
          {' · '}
          <a href={hornero(`releases/v${r.version}-checklist.md`)}>Checklist</a>
        </p>
      </li>
    ))}
  </ol>
</SiteLayout>

<style>
  .now {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
  }

  .now dt {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--phosphor);
  }

  .timeline {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  .release {
    display: grid;
    gap: 0.5rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .release.untagged {
    background: transparent;
  }

  .release:target {
    outline: 2px solid var(--signal);
  }

  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .release h2 {
    font-size: var(--step-1);
  }

  .status {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-small);
    border: 1px solid var(--rule);
    color: var(--ink-muted);
  }

  .tagged .status,
  .published .status {
    border-color: var(--signal);
    color: var(--ink);
  }

  .candidate .status {
    border-color: var(--cue);
    color: var(--cue);
  }

  .when,
  .links {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .summary {
    max-width: var(--measure);
  }

  .pins {
    display: grid;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .pins div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
  }

  .pins dt {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.78rem;
    color: var(--phosphor);
  }
</style>
