---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SourcePlate from '../../components/SourcePlate.astro';
import { candidate, commitUrl, latestReleased, latestTagged, pins, releases, short, type Release } from '../../data/product';
import { download } from '../../data/download';
import { localizePath, type Locale } from '../../i18n/ui';
import { releaseNotes } from '../../data/release-notes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);
const title = (r: Release) => {
  return r.version.replace(/-draft$/, isEs ? ' borrador' : ' draft');
};
const statusText: Record<Release['status'], string> = isEs
  ? {
      tagged: 'Etiquetada en git',
      published: 'Publicada como paquetes, sin etiqueta git',
      candidate: 'Candidata a release',
      untagged: 'Registro de composición, sin etiquetar',
    }
  : {
      tagged: 'Tagged in git',
      published: 'Published as packages, no git tag yet',
      candidate: 'Release candidate',
      untagged: 'Composition record, not tagged',
    };
const hornero = (path: string) => `${pins.hornero.repo}/blob/${pins.hornero.sha}/${path}`;
const shell = pins.shell.repo;
const config = pins.config.repo;
---

<SiteLayout
  title={isEs ? 'Releases | HorneroOS' : 'Releases | HorneroOS'}
  description={isEs ? `Cada release de HorneroOS: qué cambió para quienes lo usan y el registro técnico completo. La última es ${latestTagged?.name ?? 'la release actual'}, con Desktop, Studio y Gaming en una ISO firmada.` : `Every HorneroOS release: what changed for the people using it, and the full technical record. The latest is ${latestTagged?.name ?? 'the current release'}, with Desktop, Studio and Gaming on one signed ISO.`}
>
  <section class="section">
    <p class="plate-id"><strong>Archivo de transmisiones</strong><span>{isEs ? 'Historial de releases' : 'Release history'}</span></p>
    <h1>Releases</h1>
    <p>
      {isEs ? 'Cada release cuenta qué cambió para quienes usan HorneroOS y deja el registro técnico completo a un clic: el manifiesto fija las versiones exactas de shell y config que salen juntas, y ' : 'Each release says what changed for the people using HorneroOS and keeps the full technical record one click away: the manifest pins the exact shell and config versions that ship together, and '}
      <code>horneroctl</code> {isEs ? 'se compila desde el mismo árbol. HorneroOS se usa a diario; los nombres previewNN son nombres de artefacto publicados y se conservan. Mirá ' : ' is built from the same tree. HorneroOS is used daily; the previewNN names are published artifact names and are kept. See '}
      <a href={L('/install')}>{isEs ? 'Instalar' : 'Install'}</a> {isEs ? 'para el checksum, la firma y las instrucciones de verificación.' : 'for the checksum, signature and verification instructions.'}
    </p>
    <dl class="now">
      {latestReleased && latestReleased !== latestTagged && (
        <div>
          <dt>{isEs ? 'Última publicada' : 'Latest published'}</dt>
          <dd>
            <a href={`#${latestReleased.name}`}>{title(latestReleased)}</a>, {latestReleased.date} ({isEs ? `paquetes; la ISO sigue en v${download.version}` : `packages; the ISO stays at v${download.version}`})
          </dd>
        </div>
      )}
      {latestTagged && (
        <div>
          <dt>{isEs ? 'Última etiquetada' : 'Latest tagged'}</dt>
          <dd>
            <a href={`#${latestTagged.name}`}>{title(latestTagged)}</a>, {latestTagged.date}
          </dd>
        </div>
      )}
      {candidate && (
        <div>
          <dt>{isEs ? 'En preparación' : 'In preparation'}</dt>
          <dd>
            <a href={`#${candidate.name}`}>{title(candidate)}</a> ({isEs ? 'candidata a release' : 'release candidate'})
          </dd>
        </div>
      )}
    </dl>
    <SourcePlate source="hornero" path="releases" locale={locale} />
  </section>

  <ol class="timeline" role="list">
    {releases.map((r) => (
      <li class:list={['release', r.status]} id={r.name}>
        <div class="release-head">
          <h2>{title(r)}</h2>
          <span class="status">{statusText[r.status]}</span>
        </div>
        <p class="when">
          <code>{r.name}</code> · {r.date}
        </p>
        {releaseNotes[r.version] ? (
          <>
            <p class="summary">{isEs ? releaseNotes[r.version].es : releaseNotes[r.version].en}</p>
            <details class="tech-summary">
              <summary>{isEs ? 'Resumen técnico' : 'Technical summary'}</summary>
              <p class="summary">{r.summary}</p>
            </details>
          </>
        ) : (
          <p class="summary">{r.summary}</p>
        )}
        <dl class="pins">
          {r.shell && (
            <div>
              <dt>shell</dt>
              <dd>
                <a href={commitUrl(shell, r.shell.sha)}>
                  <code>{short(r.shell.sha)}</code>
                </a>{' '}
                {r.shell.subject}
              </dd>
            </div>
          )}
          {r.config && (
            <div>
              <dt>config</dt>
              <dd>
                <a href={commitUrl(config, r.config.sha)}>
                  <code>{short(r.config.sha)}</code>
                </a>{' '}
                {r.config.subject}
              </dd>
            </div>
          )}
        </dl>
        <p class="links">
          <a href={hornero(`manifests/v${r.version}.yaml`)}>Manifest</a>
          {' · '}
          <a href={hornero(`releases/v${r.version}-checklist.md`)}>Checklist</a>
        </p>
      </li>
    ))}
  </ol>
</SiteLayout>

<style>
  .now {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
  }

  .now dt {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--phosphor);
  }

  .timeline {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  .release {
    display: grid;
    gap: 0.5rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .release.untagged {
    background: transparent;
  }

  .release:target {
    outline: 2px solid var(--signal);
  }

  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .release h2 {
    font-size: var(--step-1);
  }

  .status {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-small);
    border: 1px solid var(--rule);
    color: var(--ink-muted);
  }

  .tagged .status,
  .published .status {
    border-color: var(--signal);
    color: var(--ink);
  }

  .candidate .status {
    border-color: var(--cue);
    color: var(--cue);
  }

  .when,
  .links {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .summary {
    max-width: var(--measure);
  }

  .pins {
    display: grid;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .pins div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
  }

  .pins dt {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.78rem;
    color: var(--phosphor);
  }
</style>
