---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SourcePlate from '../../components/SourcePlate.astro';
import { candidate, commitUrl, latestTagged, pins, releases, short, type Release } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);
const title = (r: Release) => {
  const n = /preview(\d+)$/.exec(r.version);
  return n ? `Development Preview ${n[1]}` : r.version.replace(/-draft$/, isEs ? ' borrador' : ' draft');
};
const statusText: Record<Release['status'], string> = isEs
  ? {
      tagged: 'Pre-release etiquetada',
      candidate: 'Candidata a release',
      untagged: 'Registro de composición, sin etiquetar',
    }
  : {
      tagged: 'Tagged pre-release',
      candidate: 'Release candidate',
      untagged: 'Composition record, not tagged',
    };
const hornero = (path: string) => `${pins.hornero.repo}/blob/${pins.hornero.sha}/${path}`;
const shell = pins.shell.repo;
const config = pins.config.repo;
---

<SiteLayout
  title={isEs ? 'Releases | HorneroOS' : 'Releases | HorneroOS'}
  description={isEs ? 'Cada composición de HorneroOS: los commits de shell y config que fija, si fue etiquetada y qué cambió. Development Preview 22 trae la primera ISO Preview firmada publicada.' : 'Every HorneroOS composition: the shell and config commits it pins, whether it was tagged and what changed. Development Preview 22 ships the first published signed Preview ISO.'}
>
  <section class="section">
    <p class="plate-id"><strong>Archivo de transmisiones</strong><span>ARG / 199X</span><span>{isEs ? 'Historial de pre-releases' : 'Pre-release history'}</span></p>
    <h1>Releases</h1>
    <p>
      {isEs ? 'Una release de Hornero es un manifiesto de composición: fija los commits exactos de shell y config que salen juntos, y ' : 'A Hornero release is a composition manifest: it pins the exact shell and config commits that ship together, and '}
      <code>horneroctl</code> {isEs ? 'se compila desde el mismo árbol. Development Preview 22 es la primera release publicada con imagen de instalación: una ISO Preview x86_64 firmada (Desktop + Studio Preview) que pasó la matriz de instalación en VM. Preview 21 fue el primer candidato de ISO. Mirá ' : ' is built from the same tree. Development Preview 22 is the first published release with an install image: a signed x86_64 Preview ISO (Desktop + Studio Preview) that passed the VM installation matrix. Preview 21 was the first ISO candidate. See '}
      <a href={L('/install')}>{isEs ? 'Instalar' : 'Install'}</a> {isEs ? 'para el checksum, la firma y las instrucciones de verificación.' : 'for the checksum, signature and verification instructions.'}
    </p>
    <dl class="now">
      {latestTagged && (
        <div>
          <dt>{isEs ? 'Última etiquetada' : 'Latest tagged'}</dt>
          <dd>
            <a href={`#${latestTagged.name}`}>{title(latestTagged)}</a>, {latestTagged.date}
          </dd>
        </div>
      )}
      {candidate && (
        <div>
          <dt>{isEs ? 'En preparación' : 'In preparation'}</dt>
          <dd>
            <a href={`#${candidate.name}`}>{title(candidate)}</a> ({isEs ? 'candidata a release' : 'release candidate'})
          </dd>
        </div>
      )}
    </dl>
    <SourcePlate source="hornero" path="releases" />
  </section>

  <ol class="timeline" role="list">
    {releases.map((r) => (
      <li class:list={['release', r.status]} id={r.name}>
        <div class="release-head">
          <h2>{title(r)}</h2>
          <span class="status">{statusText[r.status]}</span>
        </div>
        <p class="when">
          <code>{r.name}</code> · {r.date}
        </p>
        <p class="summary">{r.summary}</p>
        <dl class="pins">
          {r.shell && (
            <div>
              <dt>shell</dt>
              <dd>
                <a href={commitUrl(shell, r.shell.sha)}>
                  <code>{short(r.shell.sha)}</code>
                </a>{' '}
                {r.shell.subject}
              </dd>
            </div>
          )}
          {r.config && (
            <div>
              <dt>config</dt>
              <dd>
                <a href={commitUrl(config, r.config.sha)}>
                  <code>{short(r.config.sha)}</code>
                </a>{' '}
                {r.config.subject}
              </dd>
            </div>
          )}
        </dl>
        <p class="links">
          <a href={hornero(`manifests/v${r.version}.yaml`)}>Manifest</a>
          {' · '}
          <a href={hornero(`releases/v${r.version}-checklist.md`)}>Checklist</a>
        </p>
      </li>
    ))}
  </ol>
</SiteLayout>

<style>
  .now {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
  }

  .now dt {
    font-family: var(--font-data);
    font-stretch: 87.5%;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--secondary);
  }

  .timeline {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
  }

  .release {
    display: grid;
    gap: 0.5rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .release.untagged {
    background: transparent;
  }

  .release:target {
    outline: 2px solid var(--accent);
  }

  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .release h2 {
    font-size: var(--step-1);
  }

  .status {
    font-family: var(--font-data);
    font-stretch: 87.5%;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-muted);
  }

  .tagged .status {
    border-color: var(--accent);
    color: var(--text);
  }

  .candidate .status {
    border-color: var(--highlight);
    color: var(--highlight);
  }

  .when,
  .links {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .summary {
    max-width: var(--measure);
  }

  .pins {
    display: grid;
    gap: 0.25rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .pins div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
  }

  .pins dt {
    font-family: var(--font-data);
    font-stretch: 87.5%;
    font-size: 0.78rem;
    color: var(--secondary);
  }
</style>
