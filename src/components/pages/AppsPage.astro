---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { appsCatalog, pins, short } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/apps';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const { categories, collections, profiles, apps } = appsCatalog;
const categoryById = new Map(categories.map((c) => [c.id, c]));
const catName = (id: string) => {
  const c = categoryById.get(id);
  if (!c) return id;
  return locale === 'es' ? c.name_es : c.name;
};
const colName = (col: (typeof collections)[number]) => (locale === 'es' ? col.name_es : col.name);
const profName = (p: (typeof profiles)[number]) => (locale === 'es' ? p.name_es : p.name);
const profDesc = (p: (typeof profiles)[number]) => (locale === 'es' ? p.description_es : p.description);
const appById = new Map(apps.map((a) => [a.id, a]));
const appName = (id: string) => appById.get(id)?.name ?? id;

const primarySourceOf = (app: (typeof apps)[number]) =>
  app.sources.find((s) => s.backend === app.recommended_source) ?? app.sources[0];

const provenanceKeysOf = (app: (typeof apps)[number]) => {
  const keys = new Set<string>();
  for (const s of app.sources) {
    if (s.provenance === 'arch_official' || s.provenance === 'hornero_official') keys.add('arch_official');
    else keys.add(s.provenance);
    if (s.backend === 'guided') keys.add('guided');
  }
  if (app.status === 'guided_setup_required') keys.add('guided');
  return [...keys];
};

const categoryCounts = new Map<string, number>();
for (const app of apps) {
  categoryCounts.set(app.category, (categoryCounts.get(app.category) ?? 0) + 1);
}

const orderedApps = [...apps].sort(
  (a, b) => Number(b.featured) - Number(a.featured) || a.name.localeCompare(b.name),
);
---

<SiteLayout
  title={m.pageTitle}
  description={m.pageDescription}
  socialImage="/og/apps.png"
  socialImageAlt={m.socialAlt}
>
  <section class="section apps-hero" aria-labelledby="apps-title">
    <p class="plate-id">
      <strong>{m.eyebrowApps}</strong>
      <span>{m.eyebrowCli}</span>
      <span>{m.eyebrowArch}</span>
    </p>
    <h1 id="apps-title">{m.heroTitle}</h1>
    <p class="lede">{m.heroLede}</p>
    <p class="cta-row">
      <a class="cta primary" href="#catalog">{m.ctaCatalog}</a>
      <a class="cta secondary" href="#profiles">{m.ctaProfiles}</a>
      <a class="cta secondary" href={L('/docs/desktop/hornero-apps/')}>{m.ctaDocs}</a>
    </p>

    <dl class="apps-stats" aria-label={m.eyebrowApps}>
      <div>
        <dt>{m.statApps}</dt>
        <dd>{appsCatalog.total_apps}</dd>
      </div>
      <div>
        <dt>{m.statCategories}</dt>
        <dd>{categories.length}</dd>
      </div>
      <div>
        <dt>{m.statCollections}</dt>
        <dd>{collections.length}</dd>
      </div>
      <div>
        <dt>{m.statProfiles}</dt>
        <dd>{profiles.length}</dd>
      </div>
      <div>
        <dt>{m.statBackends}</dt>
        <dd>6</dd>
      </div>
    </dl>
  </section>

  <section class="section" aria-labelledby="gallery-title">
    <header class="section-head-compact">
      <p class="eyebrow">
        <b>{m.galleryEyebrow}</b>
        <span>Signal Night &amp; Signal Day</span>
      </p>
      <h2 id="gallery-title">{m.galleryTitle}</h2>
      <p class="muted-copy">{m.galleryNote}</p>
    </header>
    <div class="capture-grid">
      {m.captures.map((shot) => (
        <figure class="capture-card">
          <div class="capture-bar">
            <span class="capture-mode">{shot.mode}</span>
            <span class="capture-res">1920×1080</span>
          </div>
          <img src={shot.src} alt={shot.alt} width="1920" height="1080" loading="lazy" />
          <figcaption>
            <strong>{shot.title}</strong>
            <span>{shot.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section" id="catalog" aria-labelledby="catalog-title">
    <header class="section-head-compact">
      <p class="eyebrow">
        <b>{m.catalogEyebrow}</b>
        <span>hornero@{short(pins.hornero.sha)} · {appsCatalog.verified_at}</span>
      </p>
      <h2 id="catalog-title">{m.catalogTitle}</h2>
      <p class="muted-copy">{m.catalogIntro}</p>
    </header>

    <div class="catalog-controls" data-apps-controls>
      <div class="controls-top">
        <label class="search-field">
          <span>{m.searchLabel}</span>
          <input
            type="search"
            data-apps-search
            placeholder={m.searchPlaceholder}
            autocomplete="off"
          />
        </label>

        <label class="select-field">
          <span>{m.provenanceFilterLabel}</span>
          <select data-apps-provenance>
            <option value="all">{m.allProvenances}</option>
            {m.provenanceFilterOptions.map((opt) => (
              <option value={opt.id}>{opt.label}</option>
            ))}
          </select>
        </label>

        <button type="button" class="reset-btn" data-apps-reset>
          {m.resetFilters}
        </button>
      </div>

      <div class="chip-group" role="group" aria-label={m.categoryFilterLabel}>
        <span class="chip-group-label">{m.categoryFilterLabel}</span>
        <div class="chip-row">
          <button type="button" class="filter-chip" data-filter-cat="all" aria-pressed="true">
            {m.allCategories} ({appsCatalog.total_apps})
          </button>
          {categories.map((cat) => (
            <button type="button" class="filter-chip" data-filter-cat={cat.id} aria-pressed="false">
              {locale === 'es' ? cat.name_es : cat.name} ({categoryCounts.get(cat.id) ?? 0})
            </button>
          ))}
        </div>
      </div>

      <div class="chip-group" role="group" aria-label={m.collectionFilterLabel}>
        <span class="chip-group-label">{m.collectionFilterLabel}</span>
        <div class="chip-row">
          <button type="button" class="filter-chip" data-filter-col="all" aria-pressed="true">
            {m.allCollections}
          </button>
          {collections.map((col) => (
            <button type="button" class="filter-chip" data-filter-col={col.id} aria-pressed="false">
              {colName(col)}
            </button>
          ))}
        </div>
      </div>

      <p
        class="result-status"
        data-apps-status
        data-total={String(appsCatalog.total_apps)}
        data-locale={locale}
        aria-live="polite"
      >
        {m.resultCount(appsCatalog.total_apps, appsCatalog.total_apps)}
      </p>
    </div>

    <ul class="apps-grid" role="list" data-apps-grid>
      {orderedApps.map((app) => {
        const primary = primarySourceOf(app);
        const provKeys = provenanceKeysOf(app);
        const provLabel = primary
          ? (m.provenanceLabels[primary.provenance as keyof typeof m.provenanceLabels] ?? primary.provenance)
          : app.recommended_source;
        const backendLabel = primary
          ? (m.backendLabels[primary.backend as keyof typeof m.backendLabels] ?? primary.backend)
          : app.recommended_source;
        const summary = locale === 'es' ? app.summary_es : app.summary;
        const searchIndex = [
          app.id,
          app.name,
          app.publisher,
          app.summary,
          app.summary_es,
          catName(app.category),
          ...app.tags,
        ]
          .join(' ')
          .toLocaleLowerCase();
        const cmd = `horneroctl store install ${app.id}`;
        return (
          <li
            class="app-card"
            data-app-card
            data-category={app.category}
            data-collections={app.collections.join(' ')}
            data-provenances={provKeys.join(' ')}
            data-search={searchIndex}
          >
            <article>
              <header class="app-card-head">
                <div>
                  <p class="app-cat">{catName(app.category)}</p>
                  <h3>{app.name}</h3>
                  <p class="app-pub">{app.publisher}</p>
                </div>
                <span class:list={['prov-pill', `prov-${primary?.provenance ?? 'arch_official'}`]}>
                  {provLabel}
                </span>
              </header>

              <p class="app-summary">{summary}</p>

              <div class="app-badges">
                <span class="meta-pill">{backendLabel}</span>
                {primary?.sandboxed && <span class="meta-pill meta-sandbox">{m.sandboxedLabel}</span>}
                <span class:list={['meta-pill', app.is_open_source ? 'meta-oss' : 'meta-prop']}>
                  {app.is_open_source ? m.openSourceBadge : m.proprietaryBadge} · {app.license}
                </span>
                {app.featured && <span class="meta-pill meta-featured">{m.featuredBadge}</span>}
                {app.requires_account && <span class="meta-pill">{m.accountBadge}</span>}
              </div>

              {app.known_limitations && <p class="app-limit">{app.known_limitations}</p>}

              <footer class="app-card-foot">
                <div class="cmd-wrap">
                  <code>{cmd}</code>
                  <button
                    type="button"
                    class="copy-cmd-btn"
                    data-copy-cmd={cmd}
                    data-label-copy={m.copyLabel}
                    data-label-copied={m.copiedLabel}
                    aria-label={m.copyAria(app.name)}
                  >
                    {m.copyLabel}
                  </button>
                </div>
                {app.homepage && (
                  <a class="app-home" href={app.homepage} rel="noopener noreferrer" target="_blank">
                    {m.homepageLabel} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </footer>
            </article>
          </li>
        );
      })}
    </ul>

    <div class="empty-state" data-apps-empty hidden>
      <p><strong>{m.emptyTitle}</strong></p>
      <p>{m.emptyHint}</p>
    </div>
  </section>

  <section class="section" id="profiles" aria-labelledby="profiles-title">
    <header class="section-head-compact">
      <p class="eyebrow">
        <b>{m.profilesEyebrow}</b>
        <span>horneroctl store profiles</span>
      </p>
      <h2 id="profiles-title">{m.profilesTitle}</h2>
      <p class="muted-copy">{m.profilesIntro}</p>
    </header>

    <ul class="profiles-grid" role="list">
      {profiles.map((prof) => (
        <li class="profile-card">
          <div class="profile-head">
            <h3>{profName(prof)}</h3>
            <span class="profile-count">{prof.apps.length + prof.proprietaryOptIn.length} apps</span>
          </div>
          <p class="profile-desc">{profDesc(prof)}</p>
          <p class="profile-label">{m.profileCoreAppsLabel}</p>
          <ul class="profile-chips" role="list">
            {prof.apps.map((id) => (
              <li>{appName(id)}</li>
            ))}
          </ul>
          {prof.proprietaryOptIn.length > 0 && (
            <>
              <p class="profile-label profile-label-prop">{m.profileOptInLabel}</p>
              <ul class="profile-chips profile-chips-prop" role="list">
                {prof.proprietaryOptIn.map((id) => (
                  <li>{appName(id)}</li>
                ))}
              </ul>
            </>
          )}
          <pre class="profile-cli" tabindex="0"><code>horneroctl store profile-show {prof.id}</code></pre>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="enterprise" aria-labelledby="enterprise-title">
    <header class="section-head-compact">
      <p class="eyebrow">
        <b>{m.enterpriseEyebrow}</b>
        <span>horneroctl store policy &amp; manifest</span>
      </p>
      <h2 id="enterprise-title">{m.enterpriseTitle}</h2>
      <p class="muted-copy">{m.enterpriseIntro}</p>
    </header>

    <div class="enterprise-grid">
      {m.enterpriseCards.map((card) => (
        <article class="enterprise-card">
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <pre tabindex="0"><code>{card.command}</code></pre>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="limits-title">
    <header class="section-head-compact">
      <p class="eyebrow">
        <b>{m.limitsEyebrow}</b>
        <span>Transparencia</span>
      </p>
      <h2 id="limits-title">{m.limitsTitle}</h2>
    </header>

    <div class="limits-grid">
      {m.limitsItems.map((item) => (
        <article class="limit-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>

    <div class="related-strip">
      <strong>{m.relatedLinksTitle}:</strong>
      <ul role="list">
        {m.relatedLinks.map((link) => (
          <li>
            <a href={L(link.href)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (() => {
    const search = document.querySelector('[data-apps-search]');
    const provenance = document.querySelector('[data-apps-provenance]');
    const resetBtn = document.querySelector('[data-apps-reset]');
    const status = document.querySelector('[data-apps-status]');
    const empty = document.querySelector('[data-apps-empty]');
    const catBtns = [...document.querySelectorAll('[data-filter-cat]')];
    const colBtns = [...document.querySelectorAll('[data-filter-col]')];
    const cards = [...document.querySelectorAll('[data-app-card]')];

    let activeCat = 'all';
    let activeCol = 'all';

    const applyFilters = () => {
      if (!search || !provenance || !status || !empty) return;
      const q = search.value.trim().toLocaleLowerCase();
      const prov = provenance.value;
      let visible = 0;

      for (const card of cards) {
        const matchesCat = activeCat === 'all' || card.dataset.category === activeCat;
        const matchesCol = activeCol === 'all' || (card.dataset.collections || '').split(' ').includes(activeCol);
        const matchesProv = prov === 'all' || (card.dataset.provenances || '').split(' ').includes(prov);
        const matchesQuery = !q || (card.dataset.search || '').includes(q);
        const show = matchesCat && matchesCol && matchesProv && matchesQuery;
        card.hidden = !show;
        if (show) visible += 1;
      }

      const total = Number(status.dataset.total || cards.length);
      status.textContent =
        status.dataset.locale === 'es'
          ? `Mostrando ${visible} de ${total} aplicaciones`
          : `Showing ${visible} of ${total} applications`;
      empty.hidden = visible !== 0;
    };

    const setPressed = (buttons, attr, value) => {
      buttons.forEach((btn) => {
        btn.setAttribute('aria-pressed', btn.getAttribute(attr) === value ? 'true' : 'false');
      });
    };

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.getAttribute('data-filter-cat') || 'all';
        setPressed(catBtns, 'data-filter-cat', activeCat);
        applyFilters();
      });
    });

    colBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCol = btn.getAttribute('data-filter-col') || 'all';
        setPressed(colBtns, 'data-filter-col', activeCol);
        applyFilters();
      });
    });

    search?.addEventListener('input', applyFilters);
    provenance?.addEventListener('change', applyFilters);
    resetBtn?.addEventListener('click', () => {
      if (search) search.value = '';
      if (provenance) provenance.value = 'all';
      activeCat = 'all';
      activeCol = 'all';
      setPressed(catBtns, 'data-filter-cat', 'all');
      setPressed(colBtns, 'data-filter-col', 'all');
      applyFilters();
    });

    document.querySelectorAll('[data-copy-cmd]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const cmd = btn.getAttribute('data-copy-cmd');
        if (!cmd) return;
        const labelCopy = btn.getAttribute('data-label-copy') || 'Copy';
        const labelCopied = btn.getAttribute('data-label-copied') || 'Copied';
        let ok = false;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(cmd);
            ok = true;
          }
        } catch {
          ok = false;
        }
        if (!ok) {
          try {
            const area = document.createElement('textarea');
            area.value = cmd;
            area.setAttribute('readonly', '');
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            document.execCommand('copy');
            area.remove();
            ok = true;
          } catch {
            ok = false;
          }
        }
        if (ok) {
          btn.textContent = labelCopied;
          btn.setAttribute('data-copied', 'true');
          setTimeout(() => {
            btn.textContent = labelCopy;
            btn.removeAttribute('data-copied');
          }, 1600);
        }
      });
    });
  })();
</script>

<style>
  .apps-hero h1 {
    max-width: 18ch;
    font-size: clamp(2.4rem, 1.4rem + 3.4vw, 4.4rem);
    line-height: 0.98;
  }

  .apps-stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 1.5rem;
    border-top: 1px solid var(--rule-strong);
  }

  .apps-stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    padding: 0.9rem 1rem 0.2rem 0;
  }

  .apps-stats > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .apps-stats dt {
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .apps-stats dd {
    margin: 0;
    color: var(--signal);
    font: 700 clamp(1.6rem, 2.5vw, 2.3rem) var(--font-display);
  }

  .section-head-compact {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .muted-copy {
    max-width: 72ch;
    color: var(--ink-muted);
  }

  .capture-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .capture-card {
    margin: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }

  .capture-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 0.8rem;
    border-bottom: 1px solid var(--rule);
    background: var(--sunken);
    font: 500 0.72rem var(--font-mono);
  }

  .capture-mode {
    color: var(--signal);
    text-transform: uppercase;
  }

  .capture-res {
    color: var(--ink-muted);
  }

  .capture-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .capture-card figcaption {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0.9rem;
    font-size: var(--step--1);
  }

  .capture-card figcaption span {
    color: var(--ink-muted);
  }

  .catalog-controls {
    display: grid;
    gap: 1rem;
    padding: 1.1rem;
    margin-bottom: 1.4rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .controls-top {
    display: grid;
    grid-template-columns: minmax(14rem, 1.5fr) minmax(12rem, 0.8fr) auto;
    gap: 0.9rem;
    align-items: end;
  }

  .search-field,
  .select-field {
    display: grid;
    gap: 0.35rem;
  }

  .search-field span,
  .select-field span,
  .chip-group-label {
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .search-field input,
  .select-field select {
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-small);
    background: var(--base);
    color: var(--ink);
    font: inherit;
  }

  .reset-btn {
    min-height: 2.75rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-small);
    background: var(--raised);
    color: var(--ink);
    font: 500 0.78rem var(--font-mono);
    cursor: pointer;
  }

  .reset-btn:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .chip-group {
    display: grid;
    gap: 0.45rem;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .filter-chip {
    min-height: 2.2rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
    background: var(--base);
    color: var(--ink-muted);
    font: 500 0.8rem var(--font-sans);
    cursor: pointer;
  }

  .filter-chip:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .filter-chip[aria-pressed='true'] {
    border-color: var(--signal);
    background: var(--signal-well);
    color: var(--on-signal-well);
    font-weight: 600;
  }

  .result-status {
    margin: 0;
    padding-top: 0.65rem;
    border-top: 1px solid var(--rule);
    color: var(--cue);
    font: 500 0.82rem var(--font-mono);
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20.5rem), 1fr));
    gap: 0.95rem;
    padding: 0;
    list-style: none;
  }

  .app-card[hidden] {
    display: none;
  }

  .app-card article {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    height: 100%;
    padding: 1rem 1.05rem;
    border: 1px solid var(--rule);
    border-top: 2px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .app-card-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 0.65rem;
  }

  .app-cat {
    margin: 0 0 0.2rem;
    color: var(--ink-muted);
    font: 500 0.7rem var(--font-mono);
    text-transform: uppercase;
  }

  .app-card-head h3 {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.15;
  }

  .app-pub {
    margin: 0.15rem 0 0;
    color: var(--ink-muted);
    font-size: 0.84rem;
  }

  .prov-pill {
    flex: none;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--phosphor);
    border-radius: var(--radius-small);
    background: var(--phosphor-well);
    color: var(--on-phosphor-well);
    font: 600 0.7rem var(--font-mono);
    white-space: nowrap;
  }

  .prov-pill.prov-community_package,
  .prov-pill.prov-flathub_community {
