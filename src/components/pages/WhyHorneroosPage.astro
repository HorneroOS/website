---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StageBadge from '../StageBadge.astro';
import CaptureFigure from '../CaptureFigure.astro';
import CompareTable from '../CompareTable.astro';
import FaqList from '../FaqList.astro';
import { editionStage, feature } from '../../data/features';
import { faqItems } from '../../data/why';
import { slotCounts } from '../../data/captures';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/why-horneroos';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const counts = slotCounts();

const pillars = [
  {
    id: 'editions',
    stage: editionStage('desktop'),
    title: m.edicionesPorOficio,
    body: m.horneroosSeComponeAlInstalar,
    href: '/editions',
    link: m.verLasEdiciones,
  },
  {
    id: 'signal',
    stage: feature('signal').stage,
    title: m.horneroSignalModosYChromatic,
    body: m.elEscritorioTieneUnLenguaje,
    href: '/modes',
    link: m.verLosModos,
  },
  {
    id: 'settings',
    stage: feature('layouts').stage,
    title: m.ajustesEnElCentroDe,
    body: m.layoutsTemasExtensionesYEl,
    href: '/desktop',
    link: m.verElDesktop,
  },
  {
    id: 'language',
    stage: 'released' as const,
    title: m.espanolRioplatenseEIngles,
    body: m.esteSitioSeEscribePrimero,
    href: '/docs/',
    link: m.leerLaDocumentacion,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question[locale],
    acceptedAnswer: { '@type': 'Answer', text: item.answer[locale] },
  })),
};
---

<SiteLayout
  socialImage="/og/why-horneroos.png"
  socialImageAlt={m.tarjetaDeHorneroosPorQue}
  title={m.porQueHorneroosHorneroos}
  description={m.queHaceHorneroosEnQue}
  structuredData={faqJsonLd}
>
  <section class="section why-intro" aria-labelledby="why-title">
    <p class="plate-id">
      <strong>{m.porQueHorneroos}</strong>
      <span>{m.usoDiario}</span>
    </p>
    <h1 id="why-title">{m.porQueHorneroos}</h1>
    <p class="lede">{m.horneroosEsUnSistemaOperativo}</p>
    <p class="why-ctas">
      <a class="cta primary" href={L('/install')}>
        {m.descargaLaIsoActual}
      </a>
      <a class="cta secondary" href={L('/editions')}>
        {m.comparaLasEdiciones}
      </a>
    </p>
    <CaptureFigure slot="CAP-CC-04" locale={locale} eager />
  </section>

  <section class="section" aria-labelledby="pillars-title">
    <h2 id="pillars-title">{m.queHaceHorneroos}</h2>
    <ol class="why-pillars" role="list">
      {pillars.map((pillar) => (
        <li id={pillar.id}>
          <h3>{pillar.title}</h3>
          <p>
            <StageBadge stage={pillar.stage} locale={locale} />
          </p>
          <p class="why-copy">{pillar.body}</p>
          <p>
            <a class="text-link" href={L(pillar.href)}>
              {pillar.link}
            </a>
          </p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <h2 id="compare-title">{m.comparacionSistemasOperativosYShells}</h2>
    <p class="why-copy">{m.losProyectosDeEstaTabla}</p>
    <CompareTable locale={locale} />
  </section>

  <section class="section" aria-labelledby="limits-title">
    <h2 id="limits-title">{m.limitesYEstado}</h2>
    <ul class="why-limits">
      <li>{m.laIsoActualEsLa}</li>
      <li>
        {m.elSitioMuestraUnaSeleccion(counts.public)} <a href={L('/showroom')}>{m.verElShowroom}</a>
      </li>
      <li>{m.horneroosNoPublicaBenchmarksLas}</li>
      <li>{m.elRollbackDelSistemaEsta}</li>
    </ul>
    <CaptureFigure slot="CAP-CC-01" locale={locale} />
  </section>

  <section class="section" aria-labelledby="faq-title" id="faq">
    <h2 id="faq-title">{m.preguntasFrecuentes}</h2>
    <FaqList items={faqItems} locale={locale} />
  </section>
</SiteLayout>

<style>
  .why-intro h1 {
    max-width: 16ch;
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .why-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .why-copy {
    max-width: 68ch;
    color: var(--ink-muted);
  }

  .why-pillars {
    display: grid;
    gap: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .why-pillars li {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(1.2rem, 3vw, 2rem);
    border-bottom: 1px solid var(--rule);
  }

  .why-limits {
    display: grid;
    gap: 0.6rem;
    max-width: 72ch;
    padding-left: 1.1rem;
    color: var(--ink-muted);
  }
</style>
