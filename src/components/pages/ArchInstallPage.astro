---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { packageRelease } from '../../data/download';

import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/arch-install';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const pkg = packageRelease?.version ?? '';
---

<SiteLayout
  socialImage="/og/install.png"
  socialImageAlt={m.instalarHorneroosSobreArchLinux}
  title={m.horneroosSobreArchLinuxInstalacion}
  description={m.yaUsasArchInstalaEl}
>
  <section class="section">
    <p class="plate-id">
      <strong>{m.instalacion}</strong>
      <span>Arch Linux</span>
      <span>AUR</span>
    </p>
    <h1>{m.yaUsasArchConvertiloEn}</h1>
    <p class="lede">{m.laIsoNoEsLa}</p>
    <p class="cta-row download-row">
      <a class="cta primary" href="#install">
        {m.irALosComandos}
      </a>
      <a class="cta secondary" href={L('/install')}>
        {m.prefieroLaIsoCompleta}
      </a>
    </p>
    <h2>{m.tresCaminosUnMismoEscritorio}</h2>
    <ul role="list" class="packages">
      <li>
        <code>{m.aIso}</code>
        <span>
          {m.laExperienciaCompletaDesdeCero}
          <a href={L('/install')}>{m.paginaDeDescarga}</a>.
        </span>
      </li>
      <li>
        <code>{m.bArch}</code>
        <span>{m.estaGuiaPaquetesSobreTu}</span>
      </li>
      <li>
        <code>{m.cSoloLaShell}</code>
        <span>{m.siYaCorreHyprlandY}</span>
      </li>
    </ul>
  </section>

  <section class="section" aria-labelledby="req-title">
    <h2 id="req-title">{m.requisitos}</h2>
    <h3>{m.obligatorios}</h3>
    <ul>
      <li>{m.archLinuxX8664Actualizado}</li>
      <li>{m.unaSesionWaylandConHyprland}</li>
      <li>{m.gitYBaseDevelPara}</li>
    </ul>
    <h3>{m.recomendados}</h3>
    <ul>
      <li>{m.pipewireWireplumberParaAudioCompleto}</li>
      <li>{m.unRespaldoDeTuConfiguracion}</li>
    </ul>
    <h3>{m.siNoTenesYay}</h3>
    <p>{m.elAurEsMantenidoPor}</p>
    <pre tabindex="0"><code>sudo pacman -S --needed git base-devel
git clone https://aur.archlinux.org/yay.git
cd yay
makepkg -si</code></pre>
  </section>

  <section class="section" id="install" aria-labelledby="journey-title">
    <h2 id="journey-title">{m.deArchAHorneroosPaso}</h2>
    <ol class="journey-steps" role="list">
      <li>
        <span class="journey-n" aria-hidden="true">
          01
        </span>
        <h3>{m.actualizaEInstalaLosPaquetes}</h3>
        <p>{m.horneroShellTraeComoDependencias}</p>
        <pre tabindex="0"><code>yay -Syu hornero-shell
yay -S --needed hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk kitty dex hypridle cliphist wl-clipboard</code></pre>
        <p>{m.elGreeterEsOpcionalY}</p>
      </li>
      <li>
        <span class="journey-n" aria-hidden="true">
          02
        </span>
        <h3>{m.respaldaYSembraTuConfiguracion}</h3>
        <p>{m.tuCuentaYaExisteAsi}</p>
        <pre tabindex="0"><code>tar -czf ~/hornero-pre-adopt-$(date +%F).tar.gz ~/.config/hypr ~/.config/ghostty ~/.config/environment.d 2&gt;/dev/null
/usr/share/hornero/seed-user.sh --dest "$HOME" --dry-run
/usr/share/hornero/seed-user.sh --dest "$HOME"
horneroctl doctor</code></pre>
        <p>{m.siTuConfigHyprHyprland}</p>
      </li>
      <li>
        <span class="journey-n" aria-hidden="true">
          03
        </span>
        <h3>{m.entraPorTuSesionHyprland}</h3>
        <p>{m.noHayUnaSesionNueva}</p>
        <pre tabindex="0"><code>horneroctl shell start --yes</code></pre>
      </li>
      <li>
        <span class="journey-n" aria-hidden="true">
          04
        </span>
        <h3>{m.personaliza}</h3>
        <p>{m.elCentroDeControlConcentra}</p>
        <p>
          <a href={L('/docs/applications/post-install-first-steps/')}>{m.primerosPasosTrasInstalar}</a>
          {m.yLa}
          <a href={L('/docs/getting-started/install-step-by-step/')}>{m.guiaPasoAPasoCompleta}</a>.
        </p>
      </li>
    </ol>
  </section>

  <section class="section" aria-labelledby="keep-title">
    <h2 id="keep-title">{m.quePasaConLoQue}</h2>
    <ul>
      <li>{m.tuHyprlandTuHyprlandLua}</li>
      <li>{m.otrosEscritoriosKdeGnomeU}</li>
      <li>{m.barrasYNotificacionesSiOtra}</li>
      <li>{m.tusDotfilesGtkQtTerminal}</li>
    </ul>
    <h3>{m.volverAtras}</h3>
    <p>{m.desinstalarEsQuitarPaquetesTu}</p>
    <pre tabindex="0"><code>yay -Rns hornero-shell hornero-config horneroctl-bin</code></pre>
    <p>{m.siSembrasteConfiguracionLosUnicos}</p>
  </section>

  <section class="section" aria-labelledby="scope-title">
    <h2 id="scope-title">{m.alcanceHonesto}</h2>
    <ul>
      <li>{m.losPaquetesTraenElEscritorio}</li>
      <li>{m.packagesAhead(pkg)}</li>
      <li>{m.derivadosDeArchCachyosEndeavouros}</li>
    </ul>
    <p>
      <a href={L('/why-horneroos#faq')}>{m.preguntasFrecuentes}</a> ·{' '}
      <a href={L('/docs/troubleshooting/by-symptom/')}>{m.problemasPorSintoma}</a> ·{' '}
      <a href={L('/releases')}>{m.releasesYPaquetesVigentes}</a>
    </p>
  </section>
</SiteLayout>
