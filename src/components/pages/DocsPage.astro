---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localizePath, type Locale } from '../../i18n/ui';
import AppLogo from '../../components/AppLogo.astro';
import { docsAreas } from '../../data/docs-nav';
import { docsApps } from '../../data/docs-apps';
import { pins, short } from '../../data/product';
import { messages } from '../../i18n/messages/docs';

interface Props {
  entry: CollectionEntry<'docs'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const { Content, headings } = await render(entry);
const allRaw = await getCollection('docs');
// Canonical slug of an entry: Spanish translations mirror English paths
// under es/ (es/README.md -> 'es', the Spanish docs home).
const canonicalOf = (id: string) => (id === 'es' ? 'index' : id.startsWith('es/') ? id.slice(3) : id);
const isSpanishEntry = entry.id === 'es' || entry.id.startsWith('es/');
const translated = locale === 'es' && isSpanishEntry;
const canonicalId = canonicalOf(entry.id);
// Navigation lists each canonical page once, preferring this locale's
// entry so Spanish pages show Spanish titles where translations exist.
const byCanonicalNav = new Map<string, CollectionEntry<'docs'>>();
for (const e of allRaw) {
  const canonical = canonicalOf(e.id);
  const spanish = e.id === 'es' || e.id.startsWith('es/');
  const existing = byCanonicalNav.get(canonical);
  if (!existing || (locale === 'es') === spanish) byCanonicalNav.set(canonical, e);
}
const all = [...byCanonicalNav.values()];

type Heading = { depth: number; text: string };
const titleOf = (e: CollectionEntry<'docs'>) =>
  (e.rendered?.metadata?.headings as Heading[] | undefined)?.find((h) => h.depth === 1)?.text ?? e.id;
const hrefOf = (id: string) => L(id === 'index' ? '/docs/' : `/docs/${canonicalOf(id)}/`);
const title = titleOf(entry);

// Meta description: the first prose line, stripped of Markdown syntax.
const firstLine =
  (entry.body ?? '')
    .split('\n')
    .map((l) => l.trim())
    .find((l) => l && !/^(#|>|\||-|\*|```|!\[)/.test(l)) ?? '';
const englishDescription = firstLine
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[`*_]/g, '')
  .slice(0, 180);
// Untranslated docs are English upstream: say so in Spanish metadata
// instead of shipping an English description under an es-AR page.
// Translated pages use their own (Spanish) first line.
const description = locale === 'es' && !translated ? m.untranslatedDescription(title) : englishDescription;

const featuredApps = docsApps[canonicalId] ?? [];
const sourcePath = (entry.filePath ?? '').replace(/^\.?\/?\.cache\/product-src\/docs\//, '');
const docsPin = pins.docs;
const toc = headings.filter((h) => h.depth === 2);

const areaLabelsEs: Record<string, string> = {
  'getting-started': 'Primeros pasos',
  desktop: 'Escritorio',
  applications: 'Aplicaciones y flujos',
  hardware: 'Hardware',
  troubleshooting: 'Solución de problemas',
  security: 'Seguridad y privacidad',
  architecture: 'Arquitectura',
  infrastructure: 'Infraestructura',
  studio: 'Studio y multimedia',
  contributing: 'Contribuir',
  development: 'Desarrollo',
};
const areas = docsAreas.map((a) => ({
  ...a,
  label: locale === 'es' ? (areaLabelsEs[a.id] ?? a.label) : a.label,
  index: all.find((e) => canonicalOf(e.id) === a.id),
  pages: all
    .filter((e) => canonicalOf(e.id).startsWith(`${a.id}/`))
    .sort((x, y) => titleOf(x).localeCompare(titleOf(y))),
}));
const current = canonicalId;
---

<SiteLayout title={m.documentacionDeHorneroOs(title)} description={description || m.documentacionDeHorneroOs2(title)}>
  <div class="docs">
    <nav class="docs-nav" aria-label={m.documentacion}>
      <a href={L('/docs/')} aria-current={current === 'index' ? 'page' : undefined} class="docs-home">
        {m.resumen}
      </a>
      {areas.map((a) => (
        <div class="area">
          {a.index ? (
            <a href={hrefOf(a.id)} aria-current={current === a.id ? 'page' : undefined} class="area-title">
              {a.label}
            </a>
          ) : (
            <span class="area-title">{a.label}</span>
          )}
          {a.pages.length > 0 && (
            <ul role="list">
              {a.pages.map((p) => (
                <li>
                  <a href={hrefOf(p.id)} aria-current={current === p.id ? 'page' : undefined}>
                    {titleOf(p)}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
      <a href={L('/search/')} class="docs-search">
        {m.buscarEnElSitio}
      </a>
    </nav>

    <article
      lang={locale === 'es' && !translated ? 'en' : undefined}
      class="prose"
    >
      {featuredApps.length > 0 && (
        <div class="doc-tools" role="group" aria-label={m.herramientasDestacadasEnEstaPagina}>
          <span class="doc-tools-label">{m.herramientasDestacadas}</span>
          <ul role="list">
            {featuredApps.map((app) => (
              <li>
                <AppLogo id={app.id} />
                <span>{app.name}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {locale === 'es' && !translated && (
        <p class="docs-lang-note">
          Esta documentación todavía está en inglés. Sale del repositorio HorneroOS/docs y su traducción al español está
          pendiente ahí. La navegación del sitio ya está en español.
        </p>
      )}
      <Content />
      <footer class="doc-foot">
        <p>
          {m.desde}{' '}
          <a href={`${docsPin.repo}/blob/${docsPin.sha}/${sourcePath}`}>
            <code>HorneroOS/docs/{sourcePath}</code>
          </a>
          {m.enElCommit}{' '}
          <a href={`${docsPin.repo}/commit/${docsPin.sha}`}>
            <code>{short(docsPin.sha)}</code>
          </a>
          . <a href={`${docsPin.repo}/edit/main/${sourcePath}`}>{m.sugeriUnCambioEnGithub}</a>.
        </p>
      </footer>
    </article>

    {toc.length > 1 && (
      <nav class="toc" aria-label={m.enEstaPagina}>
        <p class="eyebrow">{m.enEstaPagina}</p>
        <ul role="list">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</SiteLayout>

<style>
  .docs-lang-note {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--rule);
    background: var(--panel);
    color: var(--ink-muted);
  }

  .doc-tools {
    --app-logo-size: 1.7rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-bottom: 1.4rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--rule);
    background: var(--panel);
  }
  .doc-tools-label {
    color: var(--phosphor);
    font: 0.62rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .doc-tools ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .doc-tools li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .docs {
    display: grid;
    /* One shrinkable column on phones: wide code blocks scroll inside their
       <pre> instead of widening the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  /* Phones: the page first, the documentation map after it. */
  @media (max-width: 899px) {
    .docs-nav {
      order: 2;
      padding-top: 1.5rem;
      border-top: 1px solid var(--rule);
    }

    .toc {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }

  @media (min-width: 1180px) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr) 12rem;
    }
  }

  .docs-nav,
  .toc {
    display: grid;
    gap: 1rem;
    align-content: start;
    font-size: 0.93rem;
  }

  @media (min-width: 900px) {
    .docs-nav,
    .toc {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }

  .docs-nav a,
  .toc a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .docs-nav a:hover,
  .toc a:hover {
    color: var(--ink);
  }

  .docs-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--signal);
    padding-left: 0.6rem;
  }

  .area-title {
    font-weight: 600;
    color: var(--ink);
  }

  .area ul,
  .toc ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    margin-top: 0.4rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--rule);
  }

  .docs-search {
    font-size: var(--step--1);
  }

  .prose {
    min-width: 0;
    max-width: 72ch;
  }

  .prose :global(:is(h1, h2, h3)) {
    scroll-margin-top: 10rem;
  }

  @media (min-width: 421px) and (max-width: 899px) {
    .prose :global(:is(h1, h2, h3)) {
      scroll-margin-top: 7rem;
    }
  }

  @media (min-width: 900px) {
    .prose :global(:is(h1, h2, h3)) {
      scroll-margin-top: 5rem;
    }
  }

  .prose :global(h1) {
    font-size: var(--step-3);
    margin-bottom: 1rem;
  }

  .prose :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: var(--step-2);
    margin: 2.25rem 0 0.75rem;
  }

  .prose :global(h2)::before {
    width: 1.1rem;
    height: 2px;
    flex: none;
    background: var(--signal);
    content: '';
    transform: translateY(-0.28em);
  }

  .prose :global(h3) {
    font-size: var(--step-1);
    margin: 1.75rem 0 0.5rem;
  }

  .prose :global(:is(p, ul, ol, pre, table, blockquote)) {
    margin-bottom: 1rem;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.4rem;
  }

  .prose :global(li + li) {
    margin-top: 0.3rem;
  }

  .prose :global(blockquote) {
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--phosphor);
    background: var(--panel);
    border-radius: 0 10px 10px 0;
    color: var(--ink-muted);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
  }

  .prose :global(img) {
    border-radius: 10px;
    border: 1px solid var(--rule);
    box-shadow: var(--elevation);
  }

  .doc-foot {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
</style>
