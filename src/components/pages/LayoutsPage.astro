---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localizePath, type Locale } from '../../i18n/ui';
import LayoutDiagram from '../../components/LayoutDiagram.astro';
import CaptureFigure from '../../components/CaptureFigure.astro';
import CaptureGallery from '../../components/CaptureGallery.astro';
import { layouts } from '../../data/product';
import { messages } from '../../i18n/messages/layouts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const styleNames: Record<string, string> = m.styleNames;
const groupLine = (g: { start: string[]; center: string[]; end: string[] }) =>
  [g.start, g.center, g.end]
    .filter((x) => x.length)
    .map((x) => x.join(', '))
    .join(' · ');

const selected = m.selected;
---

<SiteLayout title={m.layoutsHorneroos} description={m.layoutsDeLaShellDe(layouts.length)}>
  <section class="intro section">
    <p class="plate-id">
      <strong>Catálogo de formas</strong>
      <span>{layouts.length} layouts</span>
    </p>
    <h1>Layouts</h1>
    <p>{m.poneLaShellSobreUn}</p>
    <div class="intro-actions">
      <a class="cta primary" href={L('/showroom')}>
        {m.miraComoAnda}
      </a>
      <span>
        {m.cambiaDesdeElSelectorDe}
        <kbd>Super</kbd> + <kbd>Shift</kbd> + <kbd>B</kbd>
      </span>
    </div>
  </section>

  <section class="section gallery" aria-label={m.layoutsDestacadosEnElEscritorio}>
    {selected.map((entry, index) => {
      const layout = layouts.find((item) => item.id === entry.id);
      return (
        <article class:list={['layout-showcase', `showcase-${index + 1}`]} id={entry.id}>
          <CaptureFigure
            slot={entry.slot}
            locale={locale}
            eager={index < 2}
            sizes="(min-width: 1180px) 680px, (min-width: 900px) 50vw, calc(100vw - 2rem)"
          />
          <div class="showcase-copy">
            <h2>{layout?.name}</h2>
            <p>{entry.text}</p>
            <a href={`#catalog-${entry.id}`} class="text-link">
              {m.detallesDelLayout}
            </a>
          </div>
        </article>
      );
    })}
  </section>

  <section class="section catalog" id="all-layouts">
    <div class="catalog-heading">
      <div>
        <h2>{m.losLayouts(layouts.length)}</h2>
      </div>
      <p>{m.todosLosLayoutsSalenDe}</p>
    </div>
    <ul class="layout-grid" role="list">
      {layouts.map((layout) => (
        <li class="layout-card" id={`catalog-${layout.id}`}>
          <LayoutDiagram bars={layout.bars} name={layout.name} />
          <div class="layout-title">
            <h3>{layout.name}</h3>
            <span>
              {layout.bars.length} {layout.bars.length === 1 ? m.superficie : m.superficies}
            </span>
          </div>
          <p>{layout.description}</p>
          <details>
            <summary>{m.verComoSeOrdena}</summary>
            <dl class="bars">
              {layout.bars.map((bar) => (
                <>
                  <dt>
                    {bar.edge} · {styleNames[bar.style] ?? bar.style}
                    {bar.clear && m.transparente}
                  </dt>
                  <dd>{groupLine(bar.groups) || m.sinModulos}</dd>
                </>
              ))}
            </dl>
          </details>
        </li>
      ))}
    </ul>
  </section>

  <CaptureGallery
    route="/layouts"
    locale={locale}
    exclude={['CAP-LAYOUT-01', 'CAP-LAYOUT-02', 'CAP-LAYOUT-04', 'CAP-LAYOUT-05', 'CAP-LAYOUT-11', 'CAP-LAYOUT-12']}
  />
</SiteLayout>

<style>
  .intro {
    padding-block: clamp(1rem, 4vw, 4rem) 2rem;
  }
  .intro h1 {
    margin-top: 0.65rem;
    font-size: clamp(3rem, 2rem + 5vw, 6.4rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .intro h1 em {
    color: var(--signal);
    font-style: normal;
  }
  .intro > p:not(.eyebrow) {
    max-width: 57ch;
    margin-top: 1.1rem;
    font-size: var(--step-1);
    color: var(--ink-muted);
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.4rem;
  }
  .intro-actions > span {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  kbd {
    padding: 0.05em 0.4em;
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    border-radius: 5px;
  }
  .gallery {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .layout-showcase {
    display: grid;
    align-items: center;
    gap: 1.3rem;
  }
  .layout-showcase :global(.capture-figure) {
    width: 100%;
    min-width: 0;
  }
  .showcase-copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.55rem;
  }
  .showcase-copy h2 {
    font-size: var(--step-2);
  }
  .showcase-copy > p:not(.eyebrow) {
    max-width: 37ch;
    color: var(--ink-muted);
  }
  .text-link {
    margin-top: 0.5rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .text-link:hover {
    color: var(--signal);
  }
  .catalog {
    padding-top: clamp(2rem, 4vw, 4rem);
    border-top: 1px solid var(--rule);
  }
  .catalog-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  .catalog-heading h2 {
    margin-top: 0.35rem;
  }
  .catalog-heading > p {
    max-width: 48ch;
    color: var(--ink-muted);
  }
  .layout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 1rem;
    list-style: none;
  }
  .layout-card {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    scroll-margin-top: 7rem;
  }
  .layout-card:target {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  .layout-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .layout-title h3 {
    font-size: 1.15rem;
  }
  .layout-title span {
    color: var(--ink-muted);
    font: 0.67rem var(--font-mono);
    white-space: nowrap;
  }
  .layout-card > p {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .layout-card details {
    border-top: 1px solid var(--rule);
    padding-top: 0.55rem;
    color: var(--ink-muted);
    font-size: 0.83rem;
  }
  .layout-card summary {
    color: var(--ink);
    cursor: pointer;
    font-weight: 600;
  }
  .layout-card summary::marker {
    color: var(--phosphor);
  }
  .bars {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.7rem;
  }
  .bars dt {
    margin-top: 0.35rem;
    color: var(--phosphor);
    font: 0.69rem var(--font-mono);
    text-transform: uppercase;
  }
  .bars dd {
    overflow-wrap: anywhere;
  }
  @media (min-width: 900px) {
    .layout-showcase {
      grid-template-columns: minmax(0, 1.35fr) minmax(230px, 0.65fr);
    }
    .layout-showcase:nth-child(even) {
      grid-template-columns: minmax(230px, 0.65fr) minmax(0, 1.35fr);
    }
    .layout-showcase:nth-child(even) :global(.frame) {
      grid-column: 2;
    }
    .layout-showcase:nth-child(even) .showcase-copy {
      grid-column: 1;
      grid-row: 1;
      padding-left: clamp(0rem, 3vw, 3rem);
    }
  }
  @media (max-width: 640px) {
    .catalog-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.6rem;
    }
    .intro-actions {
      align-items: start;
      flex-direction: column;
    }
  }
</style>

<style>
  /* Per-page direction: layouts as mechanical shape specimens. */
  .layout-card {
    border-radius: 2px;
  }
  .layout-title {
    font-family: var(--font-display);
  }
  .catalog-heading {
    border-bottom: 3px solid var(--signal);
    padding-bottom: 0.6rem;
  }
</style>
