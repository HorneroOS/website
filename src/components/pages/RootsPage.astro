---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StoryTimeline from '../../components/StoryTimeline.astro';
import poster199x from '../../assets/brand/hornero-199x-poster.jpg';
import { story } from '../../data/story';
import { pins, releases, themes, short } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/roots';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const shell = pins.shell;
const config = pins.config;
const hornero = pins.hornero;
const currentRelease = releases.find((release) => release.status === 'tagged');
---

<SiteLayout
  socialImage="/og/roots.png"
  socialImageAlt={m.laLineaDeTiempoDe}
  title={m.raicesHorneroos}
  description={m.comoHorneroPasoDeUna}
>
  <section class="intro section">
    <p class="plate-id">
      <strong>Archivo 2018 — hoy</strong>
      <span>Las raíces del proyecto</span>
    </p>
    <h1>{m.raices}</h1>
    <p>{m.horneroEmpezoComoUnaConfiguracion}</p>
  </section>

  <section class="section timeline-section" id="timeline" aria-labelledby="timeline-title">
    <div class="timeline-head">
      <h2 id="timeline-title">{m.lineaDeTiempo}</h2>
      <p>{m.dosHistoriasRecorrenEstaPagina}</p>
    </div>
    <StoryTimeline entries={story} variant="ledger" label={m.lineaDeTiempoDeHorneroos} locale={locale} />
  </section>

  <section class="section identity" aria-labelledby="identity-title">
    <figure class="poster">
      <img
        src={poster199x.src}
        width={poster199x.width}
        height={poster199x.height}
        loading="lazy"
        decoding="async"
        alt={m.ilustracionDeUnHorneroY}
      />
      <figcaption>{m.arteDeHornero199xIlustracion}</figcaption>
    </figure>
    <div class="identity-copy">
      <h2 id="identity-title">{m.laEstetica199x}</h2>
      <p>
        {m.hornero199xTomaElementosDe}
        <a href={L('/wallpapers')}>{m.paginaDeFondos}</a>.
      </p>
      <p>
        <a href={L('/docs/development/design-language/')}>{m.leeElLenguajeDeDiseno}</a>
      </p>
    </div>
  </section>

  <section class="section map-section" id="repositories" aria-labelledby="repositories-title">
    <div>
      <h2 id="repositories-title">{m.repositoriosPrincipales}</h2>
      <p>
        {m.losComponentesDelProductoViven}
        <a href="https://github.com/HorneroOS/.github/blob/main/governance/docs/repository-map.md">
          {m.mapaCompletoDeLaOrganizacion}
        </a>{' '}
        {m.tambienCubreDocsWebsiteQa}
      </p>
    </div>
    <div class="repo-list">
      <a href={`${shell.repo}/tree/${shell.sha}`}>
        <span class="repo-mark">01</span>
        <span>
          <strong>Shell</strong>
          <small>{m.runtimeQuickshellPresetsDeLayout}</small>
        </span>
        <code>{short(shell.sha)}</code>
      </a>
      <a href={`${config.repo}/tree/${config.sha}`}>
        <span class="repo-mark">02</span>
        <span>
          <strong>Config</strong>
          <small>{m.packsDeAparienciaDefaultsAssets}</small>
        </span>
        <code>{short(config.sha)}</code>
      </a>
      <a href={`${hornero.repo}/tree/${hornero.sha}`}>
        <span class="repo-mark">03</span>
        <span>
          <strong>Hornero</strong>
          <small>{m.cliNativaComposicionesDeReleases}</small>
        </span>
        <code>{short(hornero.sha)}</code>
      </a>
      <a href="https://github.com/HorneroOS/greeter">
        <span class="repo-mark">04</span>
        <span>
          <strong>Greeter</strong>
          <small>{m.laPantallaDeLoginSddm}</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="https://github.com/HorneroOS/installer">
        <span class="repo-mark">05</span>
        <span>
          <strong>Installer</strong>
          <small>{m.instaladorProvisorioYPerfilDe}</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="https://github.com/HorneroOS/qa">
        <span class="repo-mark">06</span>
        <span>
          <strong>QA</strong>
          <small>{m.recorridosEnMaquinasVirtualesY}</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="section contributor-guide" id="contribute" aria-labelledby="contributor-guide-title">
    <div>
      <h2 id="contributor-guide-title">{m.referenciasParaContribuir}</h2>
      <p>{m.elLenguajeDeDisenoDefine}</p>
    </div>
    <nav aria-label={m.referenciasParaContribuir}>
      <a href={L('/docs/development/design-language/')}>
        <span>{m.politicaDeProducto}</span>
        <strong>
          {m.lenguajeDeDisenoDeHorneroos} <span aria-hidden="true">↗</span>
        </strong>
      </a>
      <a href="https://github.com/HorneroOS/.github/blob/main/governance/docs/repository-map.md">
        <span>{m.responsables}</span>
        <strong>
          {m.mapaDeRepositorios} <span aria-hidden="true">↗</span>
        </strong>
      </a>
      <a href="https://github.com/HorneroOS/.github/blob/main/CONTRIBUTING.md">
        <span>{m.flujoDeTrabajo}</span>
        <strong>
          {m.guiaDeContribucion} <span aria-hidden="true">↗</span>
        </strong>
      </a>
    </nav>
  </section>

  <section class="section lineage" id="community">
    <h2>{m.creditos}</h2>
    <div class="lineage-grid">
      <article>
        <h3>{m.linajeDelCodigo}</h3>
        <p>
          {m.laShellQuickshellEstaAdaptada}
          <a href="https://github.com/caelestia-dots/shell">Caelestia Shell</a>.{m.elAutorUpstreamLaLicencia}
        </p>
      </article>
      <article>
        <h3>{m.referenciasDeDiseno}</h3>
        <p>
          <a href="https://github.com/Ryoku-dev/ryoku">Ryoku</a> {m.sistemaOperativo}
          <a href="https://github.com/duxlabs-dev/dux-shell">Dux Modular Shell</a>{' '}
          {m.shellDeEscritorioAntesDankmaterialshell}
          <a href="https://github.com/omacom/omarchy">Omarchy</a> {m.sistemaOperativoSonProyectosQue}
        </p>
      </article>
      <article>
        <h3>{m.laDireccionDeHornero}</h3>
        <p>{m.tomamosPreguntasDeEsosProyectos}</p>
      </article>
      <article>
        <h3>{m.lasPersonasDetrasDeHorneroos}</h3>
        <p>
          <a href="https://github.com/ulises-jeremias">Ulises Jeremías</a> {m.esElMaintainerPrincipalDe}{' '}
          <a href="https://github.com/PandaFoss">Panda Foss</a> {m.contribuyeAHorneroosYEs}
          <a href="https://gitlab.com/anarchyinstaller/installer">Anarchy Linux</a>. {m.pandaVaALiderarEl}
          <a href={L('/install')}>{m.calamares}</a> {m.sigueSiendoProvisorioHastaQue}
          <a href="https://github.com/HorneroOS">{m.organizacionHorneroos}</a>.
        </p>
      </article>
    </div>
    <p class="source-line">
      {m.fuentesVerificadasEnShell}{' '}
      <a href={`${shell.repo}/commit/${shell.sha}`}>
        <code>{short(shell.sha)}</code>
      </a>
      , Config{' '}
      <a href={`${config.repo}/commit/${config.sha}`}>
        <code>{short(config.sha)}</code>
      </a>{' '}
      {m.yHornero}{' '}
      <a href={`${hornero.repo}/commit/${hornero.sha}`}>
        <code>{short(hornero.sha)}</code>
      </a>
      . {m.lasFuentesFijadasDefinen} {themes.length} {m.packsDeTemas}
      {currentRelease && (
        <>
          {' '}
          {m.eIncluyenLaComposicionEtiquetada} <a href={L(`/releases#${currentRelease.name}`)}>{currentRelease.name}</a>
        </>
      )}
      .
    </p>
  </section>
</SiteLayout>

<style>
  .intro {
    padding-block: clamp(1rem, 4vw, 4rem) 1.5rem;
  }
  .intro h1 {
    margin-top: 0.7rem;
    font-size: clamp(3rem, 2rem + 5vw, 6.2rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .intro h1 em {
    color: var(--signal);
    font-style: normal;
  }
  .intro > p:last-child {
    max-width: 59ch;
    margin-top: 1.2rem;
    color: var(--ink-muted);
    font-size: var(--step-1);
  }
  .timeline-section > h2,
  .map-section h2,
  .contributor-guide h2,
  .lineage > h2 {
    margin-top: 0.4rem;
  }
  .repo-mark {
    color: var(--phosphor);
    font: 0.75rem var(--font-mono);
  }
  .map-section {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.3rem, 4vw, 2.6rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .map-section > div:first-child > p:last-child {
    margin-top: 0.55rem;
    color: var(--ink-muted);
  }
  .repo-list {
    display: grid;
  }
  .repo-list > a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.9rem 0.1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }
  .repo-list strong,
  .repo-list small {
    display: block;
  }
  .repo-list small {
    margin-top: 0.12rem;
    color: var(--ink-muted);
  }
  .repo-list code {
    color: var(--phosphor);
  }
  .repo-list a:hover strong {
    color: var(--signal);
  }
  .contributor-guide {
    display: grid;
    gap: 1.5rem;
    padding-inline-start: clamp(1rem, 3vw, 2rem);
    border-inline-start: 2px solid var(--cue);
  }
  .contributor-guide > div > p:last-child {
    max-width: 58ch;
    margin-top: 0.55rem;
    color: var(--ink-muted);
  }
  .contributor-guide nav {
    display: grid;
    border-top: 1px solid var(--rule);
  }
  .contributor-guide nav a {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0.1rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .contributor-guide nav a > span {
    color: var(--phosphor);
    font: 0.68rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .contributor-guide nav a strong {
    color: var(--ink);
  }
  .contributor-guide nav a:hover strong {
    color: var(--signal);
  }
  .lineage-grid {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }
  .lineage-grid article {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .lineage-grid p {
    margin-top: 0.35rem;
    color: var(--ink-muted);
  }
  .source-line {
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
    font-size: 0.82rem;
  }
  @media (min-width: 900px) {
    .map-section {
      grid-template-columns: 0.7fr 1.3fr;
      align-items: start;
    }
    .contributor-guide {
      grid-template-columns: 0.7fr 1.3fr;
      align-items: start;
    }
    .lineage-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .timeline-head {
    display: grid;
    gap: 1rem clamp(1.5rem, 5vw, 5rem);
    margin-bottom: 1.5rem;
  }
  .timeline-head h2 {
    font-size: clamp(1.9rem, 1.2rem + 2.8vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .timeline-head p {
    max-width: 58ch;
    color: var(--ink-muted);
  }
  .identity {
    display: grid;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }
  .poster {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--panel);
  }
  .poster img {
    width: 100%;
    height: auto;
  }
  .poster figcaption {
    padding: 0.6rem 0.8rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
    font: 0.68rem var(--font-mono);
    font-stretch: 87.5%;
  }
  .identity-copy {
    display: grid;
    gap: 1rem;
  }
  .identity-copy h2 {
    font-size: clamp(1.7rem, 1.2rem + 2vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .identity-copy p {
    max-width: 50ch;
    color: var(--ink-muted);
  }
  @media (min-width: 900px) {
    .timeline-head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
    }
    .identity {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>

<style>
  /* Per-page direction: roots as an archival timeline. */
  .repo-mark {
    font-family: var(--font-mono);
  }
  .lineage-grid > * {
    border-radius: 2px;
  }
</style>
