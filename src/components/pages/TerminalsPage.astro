---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { terminalCatalogue } from '../../data/product';
import CaptureFigure from '../../components/CaptureFigure.astro';
import CaptureGallery from '../../components/CaptureGallery.astro';
import AppLogo from '../../components/AppLogo.astro';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/terminals';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const terminals = terminalCatalogue.integrations;
const defaultTerminal = terminals.find((terminal) => terminal.id === terminalCatalogue.default);
const exampleTerminal = terminals.find((terminal) => terminal.id !== defaultTerminal?.id) ?? terminals[0];
const alternativeTerminalIds = terminals
  .filter((terminal) => terminal.id !== exampleTerminal?.id)
  .map((terminal) => terminal.id);
const terminalNames = terminals.map((terminal) => terminal.name).join(', ');
const displayPath = (path: string) => path.replaceAll('{config}', '~/.config').replaceAll('{cache}', '~/.cache');
---

<SiteLayout title={m.terminalesHorneroos(terminalNames)} description={m.elegiEntreEnAjustesDe(terminalNames)}>
  <section class="terminal-intro section" aria-labelledby="terminal-title">
    <div class="terminal-heading">
      <h1 id="terminal-title">{m.terminales}</h1>
      <p class="lede">{m.puedenSeguirLaAparienciaDe(terminalNames)}</p>
      <div class="terminal-actions">
        <a class="cta primary" href={L('/docs/applications/terminal/')}>
          {m.leeLaGuiaDeTerminales} <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={L('/themes')}>
          {m.exploraLasAparienciasDeHornero}
        </a>
      </div>
    </div>
    <aside class="terminal-note" aria-label={m.comoFuncionaLaSeleccionDe}>
      <strong>{m.terminalPorDefecto}</strong>
      <p>
        {m.ajustesListaLosEmuladoresSoportados} {defaultTerminal?.name ?? m.laTerminalPorDefecto}{' '}
        {m.esLaEleccionDeFabrica}
      </p>
      {exampleTerminal && (
        <code class="command">horneroctl config default-apps set terminal {exampleTerminal.id} --yes</code>
      )}
      {exampleTerminal && alternativeTerminalIds.length > 0 && (
        <small>
          {m.reemplaza} <code>{exampleTerminal.id}</code> {m.por}{' '}
          {alternativeTerminalIds.map((id, index) => (
            <>
              {index > 0 && m.o}
              <code>{id}</code>
            </>
          ))}
          .
        </small>
      )}
    </aside>
  </section>

  <section class="terminal-proof section" aria-labelledby="terminal-proof-title">
    <div class="terminal-capture">
      <CaptureFigure slot="CAP-TERM-06" locale={locale} />
    </div>
    <div class="proof-copy">
      <h2 id="terminal-proof-title">{m.kittyConLaPaletaDe}</h2>
      <p>{m.kittyConservaSuConfiguracionNativa}</p>
      <a class="text-link" href={L('/themes')}>
        {m.miraComoLasAparienciasSe}
      </a>
    </div>
  </section>

  <section class="terminal-field section" aria-labelledby="terminal-field-title">
    <div class="field-heading">
      <div>
        <h2 id="terminal-field-title">
          {terminals.length} {m.terminalesSoportadas}
        </h2>
      </div>
      <p>{m.horneroRespetaLasConvencionesPropias}</p>
    </div>
    <div class="terminal-list">
      {terminals.map((terminal) => (
        <article class="terminal-entry" id={terminal.id}>
          <div class="terminal-entry-heading">
            <AppLogo id={terminal.id} />
            <div>
              <h3>{terminal.name}</h3>
              <span class="terminal-role">
                {terminal.role === 'default' ? m.eleccionDeFabrica : m.alternativaSoportada}
              </span>
            </div>
          </div>
          <p>{terminal.detail}</p>
          <div class="terminal-config" role="group" aria-label={m.ejemploDeConfiguracionDe(terminal.name)}>
            <div class="terminal-package">
              <span class="config-label">{m.instalaDesdeLosRepositoriosDe}</span>
              <code>sudo pacman -S --needed {terminal.package}</code>
            </div>
            <div class="terminal-factory-config">
              <span class="config-label">{m.configuracionDeFabrica}</span>
              <code>{terminal.configExample}</code>
            </div>
          </div>
          <dl class="terminal-output">
            <div>
              <dt>{m.archivoDeConfiguracion}</dt>
              <dd>
                <code>{displayPath(terminal.configPath)}</code>
              </dd>
            </div>
            <div>
              <dt>{m.paletaGenerada}</dt>
              <dd>
                <code>{terminal.palette}</code>
              </dd>
            </div>
            <div>
              <dt>{m.escritaEn}</dt>
              <dd>
                <code>{displayPath(terminal.palettePath)}</code>
              </dd>
            </div>
          </dl>
          <p class="terminal-footnote">{terminal.note}</p>
        </article>
      ))}
    </div>
    <aside class="preview-strip" aria-label={m.previsualizacionesDeImagenesConYazi}>
      <AppLogo id="yazi" />
      <p>
        <strong>{m.previsualizacionesDeImagenes}</strong> {m.yaziMuestraImagenesDentroDe}
      </p>
    </aside>
  </section>

  <section class="terminal-flow section" aria-labelledby="terminal-flow-title">
    <div class="flow-mark" aria-hidden="true">
      <span>01</span>
      <i></i>
      <span>02</span>
      <i></i>
      <span>03</span>
    </div>
    <div>
      <h2 id="terminal-flow-title">{m.configuracion}</h2>
      <ol class="flow-steps">
        <li>
          <strong>{m.instalaUnaTerminal}</strong>
          <span>
            {defaultTerminal?.name ?? m.laTerminalPorDefecto} {m.esLaEleccionDeFabrica2}
          </span>
        </li>
        <li>
          <strong>{m.seleccionalaEnAjustes}</strong>
          <span>{m.elCentroDeControlMarca}</span>
        </li>
        <li>
          <strong>{m.cambiaLaApariencia}</strong>
          <span>{m.horneroEscribePaletasNativasNuevas(terminals.length)}</span>
        </li>
      </ol>
      <p class="terminal-caveat">{m.estaPaginaDescribeLaIntegracion}</p>
    </div>
  </section>

  <CaptureGallery route="/terminals" locale={locale} exclude={['CAP-TERM-06']} />
</SiteLayout>

<style>
  .terminal-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-block-start: 0;
    padding-block: clamp(1.25rem, 3vw, 2.5rem);
  }
  .terminal-heading h1 {
    max-width: 14ch;
    margin-top: 1rem;
    font-size: clamp(3.5rem, 6.6vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.078em;
  }
  .terminal-heading h1 em {
    color: var(--signal);
    font-style: normal;
  }
  .terminal-heading .lede {
    max-width: 56ch;
    margin-top: 1.2rem;
  }
  .terminal-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .terminal-note {
    display: grid;
    gap: 0.85rem;
    padding: 1.2rem 0 0 1.2rem;
    border-top: 2px solid var(--cue);
    border-left: 1px solid var(--rule);
  }
  .config-label {
    color: var(--phosphor);
    font: 0.65rem var(--font-mono);
    letter-spacing: 0.08em;
  }
  .terminal-note strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .terminal-note p,
  .terminal-note small {
    color: var(--ink-muted);
    line-height: 1.55;
  }
  .command {
    padding: 0.7rem;
    overflow-wrap: anywhere;
    border: 1px solid var(--rule);
    background: var(--panel);
    color: var(--ink);
    font-size: 0.78rem;
  }
  .terminal-proof {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .terminal-capture {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
    margin: 0;
  }
  .proof-copy {
    max-width: 42rem;
  }
  .proof-copy h2 {
    max-width: 12ch;
    margin-top: 0.5rem;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }
  .proof-copy > p:not(.eyebrow) {
    margin-top: 1rem;
    color: var(--ink-muted);
    line-height: 1.65;
  }
  .proof-copy .text-link {
    display: inline-flex;
    margin-top: 1.1rem;
  }
  .terminal-field {
    padding-block: clamp(2rem, 6vw, 5rem);
    border-block: 1px solid var(--rule);
  }
  .field-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.4rem;
  }
  .field-heading h2,
  .terminal-flow h2 {
    margin-top: 0.4rem;
  }
  .field-heading > p {
    max-width: 45ch;
    color: var(--ink-muted);
  }
  .terminal-list {
    border-top: 1px solid var(--rule);
  }
  .terminal-entry {
    display: grid;
    grid-template-columns: 0.8fr 1fr 1.2fr;
    gap: 1rem 2rem;
    align-items: start;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .terminal-entry-heading {
    --app-logo-size: 2.6rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .preview-strip {
    --app-logo-size: 3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.4rem;
    padding: 1rem 0.2rem;
    border-top: 1px solid var(--rule);
  }
  .preview-strip p {
    max-width: 75ch;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .preview-strip strong {
    color: var(--ink);
    font-family: var(--font-display);
  }
  .terminal-entry h3 {
    font-size: 1.6rem;
  }
  .terminal-role {
    display: block;
    margin-top: 0.1rem;
    color: var(--ink-muted);
    font: 0.64rem var(--font-mono);
    text-transform: uppercase;
  }
  .terminal-entry > p {
    max-width: 38ch;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .terminal-config {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
    padding: 0.75rem;
    border-left: 2px solid var(--signal);
    background: var(--panel);
  }
  .terminal-package,
  .terminal-factory-config {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }
  .terminal-config code {
    overflow-wrap: anywhere;
    color: var(--ink);
    font-size: 0.77rem;
  }
  .terminal-output {
    grid-column: 2 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0;
  }
  .terminal-output div {
    display: grid;
    gap: 0.2rem;
  }
  .terminal-output dt {
    color: var(--phosphor);
    font: 0.62rem var(--font-mono);
    text-transform: uppercase;
  }
  .terminal-output dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.77rem;
    overflow-wrap: anywhere;
  }
  .terminal-footnote {
    grid-column: 2 / -1;
    max-width: 80ch;
    font-size: 0.78rem !important;
  }
  .terminal-flow {
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    gap: clamp(2rem, 9vw, 8rem);
    padding-block: clamp(3rem, 9vw, 8rem);
  }
  .flow-mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--phosphor);
    font: 0.68rem var(--font-mono);
  }
  .flow-mark i {
    width: min(7vw, 5rem);
    height: 1px;
    background: var(--rule);
  }
  .flow-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 0;
    margin-top: 1.4rem;
    list-style: none;
    counter-reset: step;
  }
  .flow-steps li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    min-height: 8rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--cue);
  }
  .flow-steps strong {
    font-family: var(--font-display);
  }
  .flow-steps span {
    color: var(--ink-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .terminal-caveat {
    max-width: 72ch;
    margin-top: 1.2rem;
    color: var(--ink-muted);
    font-size: 0.78rem;
  }
  @media (max-width: 800px) {
    .terminal-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .terminal-note {
      max-width: 34rem;
    }
    .terminal-proof {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .terminal-capture {
      max-width: 48rem;
    }
    .field-heading {
      align-items: start;
      flex-direction: column;
    }
    .terminal-entry {
      grid-template-columns: 0.65fr 1fr;
    }
    .terminal-config {
      grid-column: 2;
    }
    .terminal-output,
    .terminal-footnote {
      grid-column: 2;
    }
    .terminal-flow {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
  @media (max-width: 520px) {
    .terminal-heading h1 {
      font-size: clamp(2.7rem, 12vw, 4.3rem);
    }
    .terminal-actions {
      align-items: start;
      flex-direction: column;
    }
    .terminal-entry {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .terminal-config,
    .terminal-output,
    .terminal-footnote {
      grid-column: 1;
    }
    .flow-steps {
      grid-template-columns: 1fr;
    }
    .flow-steps li {
      min-height: auto;
    }
  }
</style>
