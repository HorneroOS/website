---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaptureGallery from '../../components/CaptureGallery.astro';
import { candidate, editions, latestTagged, releases } from '../../data/product';
import { download, downloadTag, packageRelease, packageTag } from '../../data/download';
import { features } from '../../data/features';
import StageBadge from '../StageBadge.astro';

import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/install';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const packages = m.packages;
const packageVersion = packageRelease?.version;
const packageRecord = packageVersion ? releases.find((r) => r.version === packageVersion) : undefined;
const packaged = features.filter((f) => f.stage === 'packaged');
const unreleased = features.filter((f) => f.stage === 'unreleased');
const planned = features.filter((f) => f.stage === 'planned');
const statusName = m.plannedPlanificadoExperimentalExperimentalPrevie as Record<
  'planned' | 'experimental' | 'preview' | 'supported',
  string
>;
---

<SiteLayout
  socialImage="/og/install.png"
  socialImageAlt={m.descargaHorneroosTresPasosDescargar}
  title={m.descargaHorneroosIsoActualFirmada}
  description={m.descargaHorneroosUnaIsoX86}
>
  <section class="section">
    <p class="plate-id">
      <strong>{m.descarga}</strong>
      <span>{downloadTag}</span>
      <span>x86_64 · {download.iso.sizeLabel}</span>
    </p>
    <h1>{m.descargaHorneroos}</h1>
    <p class="lede">{m.unaIsoX8664Instala}</p>
    <p class="cta-row download-row">
      <a class="cta primary" href={download.iso.url}>
        {m.descargarLaIsoActual(download.iso.sizeLabel)}
      </a>
      <a class="cta secondary" href={L('/install/arch')}>
        {m.yaUsasArchInstalaLos}
      </a>
      <a class="cta secondary" href={L('/editions')}>
        {m.comparaLasEdiciones}
      </a>
    </p>
    <p>
      {m.tambienAnunciadaEnLa} <a href={download.releaseUrl}>{m.paginaDeLaRelease(downloadTag)}</a>.{' '}
      {m.verificaCadaCopiaConEl} <a href={download.checksumUrl}>{m.checksumSha256}</a> {m.yLa}{' '}
      <a href={download.signatureUrl}>{m.firmaGpgDesacoplada}</a>:
    </p>
    <ul role="list" class="packages">
      <li>
        <code>{download.iso.name}</code>
        <span>{m.laImagenDeInstalacionActual}</span>
      </li>
      <li>
        <code>SHA-256</code>
        <span>{download.iso.sha256}</span>
      </li>
      <li>
        <code>{m.firma}</code>
        <span>
          {m.releasesKey(download.keyFingerprint)}
          <code>{download.keyPath}</code>)
        </span>
      </li>
    </ul>
    {packageRelease && (
      <div class="package-release" aria-labelledby="pkg-release-title">
        <h2 id="pkg-release-title">{m.paquetesMasNuevosQueLa(packageRelease.version)}</h2>
        <p>{m.laIsoDeArribaSigue(downloadTag, packageTag, packageRecord ? ` (${packageRecord.date})` : '')}</p>
        <ul role="list" class="packages">
          {packageRelease.packages.map((p) => (
            <li>
              <a href={`https://aur.archlinux.org/packages/${p.name}`}>
                <code>{p.name}</code>
              </a>
              <span>{p.version}</span>
            </li>
          ))}
        </ul>
        <p>
          <a href={packageRelease.recordUrl}>{m.registroDeLaRelease}</a> ·{' '}
          <a href={packageRelease.checklistUrl}>{m.checklistYEvidencia}</a> ·{' '}
          <a href={L(`/releases#${packageTag}`)}>{m.enElHistorialDeReleases}</a>
        </p>
      </div>
    )}
    <p>
      {m.lasReleasesHastaAhoraSon}{' '}
      {latestTagged && (
        <>
          {m.laUltimaEtiquetadaEs} <a href={L(`/releases#${latestTagged.name}`)}>{latestTagged.version}</a>
          {candidate && (
            <>
              {m.y}
              <a href={L(`/releases#${candidate.name}`)}>{candidate.version}</a> {m.seEstaPreparando}
            </>
          )}
          .
        </>
      )}
    </p>
  </section>

  <section class="section journey" aria-labelledby="journey-title">
    <h2 id="journey-title">{m.delArchivoAlEscritorioY}</h2>
    <ol class="journey-steps" role="list">
      <li>
        <span class="journey-n" aria-hidden="true">
          01
        </span>
        <h3>{m.verifica}</h3>
        <p>{m.antesDeGrabarLaIso}</p>
        <pre tabindex="0"><code>sha256sum {download.iso.name}
gpg --verify {download.iso.name}.sig</code></pre>
      </li>
      <li>
        <span class="journey-n" aria-hidden="true">
          02
        </span>
        <h3>{m.instala}</h3>
        <p>{m.elegiLaEdicionLasEspecializaciones}</p>
      </li>
      <li id="update">
        <span class="journey-n" aria-hidden="true">
          03
        </span>
        <h3>{m.actualiza}</h3>
        <p>{m.despuesDeInstalarLasNovedades}</p>
        <pre tabindex="0"><code>horneroctl config snapshot create --yes
horneroctl package check
yay -Syu</code></pre>
        <p>{m.horneroctlPackageUpgradeCorrePacman}</p>
        <p>
          <a href={L('/docs/desktop/updates-and-rollback/')}>{m.leeLaGuiaDeActualizaciones}</a>
        </p>
        <p>
          {m.guiasOficiales}
          <a href={L('/docs/getting-started/install-step-by-step/')}>{m.instalacionPasoAPaso}</a>
          {', '}
          <a href={L('/docs/applications/post-install-first-steps/')}>{m.primerosPasosTrasInstalar}</a>
          {m.y2}
          <a href={L('/docs/troubleshooting/by-symptom/')}>{m.problemasPorSintoma}</a>.
        </p>
        {packageRelease && <p>{m.laActualizacionEnElLugar(packageTag)}</p>}
      </li>
    </ol>
    <h3>{m.loQueTodaviaNoEsta}</h3>
    <p class="journey-note">
      {m.laIsoEsLaUltima(downloadTag)} {packaged.length > 0 && m.loLanzadoComoPaquetesSe}
      {m.loQueEstaEnMain}
    </p>
    <ul class="journey-next" role="list">
      {[...packaged, ...unreleased, ...planned].map((f) => (
        <li>
          <StageBadge stage={f.stage} locale={locale} />
          <strong>{f.title[locale]}</strong>
        </li>
      ))}
    </ul>
  </section>

  <CaptureGallery
    route="/install"
    locale={locale}
    id="install-captures"
    heading={m.comoSeVeInstalarHorneroos}
    intro={m.todaviaNoPublicamosCapturasDel}
  />

  <section class="section readiness" aria-labelledby="readiness-title">
    <h2 id="readiness-title">{m.comoEstaLaInstalacion}</h2>
    <dl class="readiness-ledger">
      <div class="state-available">
        <dt>{m.imagenDeInstalacion}</dt>
        <dd>
          <span class="state">{downloadTag}</span> {m.currentIsoNote(downloadTag)}
        </dd>
      </div>
      <div class="state-provisional">
        <dt>{m.instalador}</dt>
        <dd>
          <span class="state">{m.provisorio}</span> {m.laBuildDeCalamaresPaso}
        </dd>
      </div>
      <div class="state-available">
        <dt>{m.paquetesDeEscritorio}</dt>
        <dd>
          <span class="state">{m.disponible}</span> {m.cuatroPaquetesDeAurPara}
        </dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <h2>{m.queExisteHoy}</h2>
    <p>{m.hoyHorneroosSeInstalaDe}</p>
    <ul role="list" class="packages">
      {packages.map((p) => (
        <li>
          <a href={`https://aur.archlinux.org/packages/${p.name}`}>
            <code>{p.name}</code>
          </a>
          <span>{p.what}</span>
        </li>
      ))}
    </ul>
    <p>{m.elPaqueteDelGreeterEs}</p>
  </section>

  <section class="section">
    <h2>{m.estadoDeLasEdiciones}</h2>
    <p>{m.lasEdicionesCompartenUnSolo}</p>
    <ul class="edition-status" role="list">
      {editions.map((edition) => (
        <li>
          <strong>{edition.title}</strong>
          <span class:list={['status-pill', `status-${edition.maturity}`]}>{statusName[edition.maturity]}</span>
        </li>
      ))}
    </ul>
    <p>
      {m.desktopEsLaEdicionBase}
      <strong>{statusName.preview}</strong>
      {m.laEvidenciaDeHardwareDe}
      <code>hornero-qa studio-gate</code> {m.todaviaEstaPendienteAsiQue}{' '}
      <a href={L('/editions')}>{m.comoEncajanLasEdiciones}</a>
    </p>
  </section>

  <section class="section">
    <h2>{m.pruebasYReportes}</h2>
    <p>{m.siAlgoSaleMalEn}</p>
    <p>
      <a href="https://github.com/HorneroOS/installer/issues/new/choose">{m.reportarUnProblemaDeInstalacion}</a> ·{' '}
      <a href={download.releaseUrl}>{m.notasDeLaReleaseY}</a>
    </p>
  </section>

  <section class="section">
    <h2>{m.elInstalador}</h2>
    <p>
      {m.laBuildDeCalamaresEn}
      <a href="https://github.com/HorneroOS/installer">HorneroOS/installer</a>
      {m.esUnPuenteProvisorioPara}
      <a href="https://github.com/PandaFoss">Panda Foss</a>
      {m.estaDesarrollandoElInstaladorA}
    </p>
    <p>
      {m.quienesContribuyenPuedenSeguirEl}
      <a href={L('/docs/development/design-language/')}>{m.lenguajeDeDisenoDeHorneroos}</a>
      {m.queApuntaALasFuentes}
    </p>
    <p>
      {m.paraSeguirLasComposicionesEtiquetadas}
      <a href={L('/releases')}>Releases</a>
      {m.oLa}
      <a href="https://github.com/HorneroOS">{m.organizacionHorneroos}</a>
      {m.enGithub}
    </p>
  </section>
</SiteLayout>

<style>
  .package-release {
    margin-block: 1.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--phosphor);
    border-radius: var(--radius);
    max-width: var(--measure);
  }

  .package-release h2 {
    font-size: var(--step-1);
  }

  .packages {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .packages li {
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .packages code,
  .packages span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .packages span {
    color: var(--ink-muted);
  }

  .edition-status {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    max-width: 58rem;
    margin-block: 1rem;
    list-style: none;
  }

  .edition-status li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--panel);
  }

  .status-pill {
    flex: none;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
    color: var(--ink-muted);
    font: 0.66rem var(--font-mono);
    text-transform: uppercase;
  }

  .status-preview {
    border-color: var(--signal);
    color: var(--ink);
  }
  .status-experimental {
    border-color: var(--cue);
    color: var(--cue);
  }

  @media (max-width: 520px) {
    .packages li {
      grid-template-columns: 1fr;
    }

    .edition-status {
      grid-template-columns: 1fr;
    }
  }
  .readiness-ledger {
    max-width: 58rem;
    border-top: 1px solid var(--rule);
  }
  .readiness-ledger > div {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 4fr);
    gap: 0.4rem 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .readiness-ledger dt {
    font: 700 1.1rem var(--font-display);
  }
  .readiness-ledger dd {
    color: var(--ink-muted);
  }
  .state {
    display: inline-block;
    margin-right: 0.7rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--rule);
    color: var(--ink);
    font: 600 0.7rem var(--font-mono);
    font-stretch: 87.5%;
    text-transform: uppercase;
  }
  .state-none {
    border-bottom-style: dashed;
  }
  .state-none .state {
    border-style: dashed;
    color: var(--ink-muted);
  }
  .state-provisional .state {
    border-color: var(--cue);
    color: var(--cue);
  }
  .state-available .state {
    border-color: var(--signal);
    color: var(--signal);
  }
  @media (max-width: 560px) {
    .readiness-ledger > div {
      grid-template-columns: 1fr;
    }
  }

  /* Per-page direction: install as an honest status board. */
  .edition-status {
    border: 1px solid var(--rule);
  }
  .packages > * {
    border-radius: 2px;
  }

  .journey-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .journey-steps li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule-strong);
  }

  .journey-steps p,
  .journey-note {
    color: var(--ink-muted);
  }

  .journey-steps pre {
    overflow-x: auto;
    padding: 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
    background: var(--sunken);
    font-size: 0.78rem;
  }

  .journey-n {
    color: var(--signal);
    font: 500 0.72rem var(--font-mono);
    letter-spacing: 0.08em;
  }

  .journey-next {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .journey-next li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  @media (max-width: 900px) {
    .journey-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
