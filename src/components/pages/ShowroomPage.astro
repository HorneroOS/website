---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaptureFigure from '../CaptureFigure.astro';
import { localizePath, type Locale } from '../../i18n/ui';
import { captureSessions, captureSlots, priorityOrder, slotCounts } from '../../data/captures';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);
const counts = slotCounts();
const shotList = 'https://github.com/HorneroOS/website/blob/main/docs/CAPTURE-SHOT-LIST.md';
const sessions = captureSessions
  .map((session) => ({
    ...session,
    slots: captureSlots
      .filter((slot) => slot.session === session.id)
      .sort((a, b) => priorityOrder.indexOf(a.priority) - priorityOrder.indexOf(b.priority) || a.id.localeCompare(b.id)),
  }))
  .filter((session) => session.slots.length > 0);
const priorityLabel: Record<string, string> = isEs
  ? { P0: 'Imprescindible para el lanzamiento', P1: 'Importante', P2: 'Complementaria' }
  : { P0: 'Launch-critical', P1: 'Important', P2: 'Nice to have' };
---

<SiteLayout
  socialImage="/og/showroom.png"
  socialImageAlt={isEs ? 'Tarjeta de marca de HorneroOS con la cuenta de capturas tomadas y pendientes por prioridad.' : 'HorneroOS brand card with the count of captured and pending captures by priority.'}
  title="Showroom | HorneroOS"
  description={isEs ? `El muro de capturas de HorneroOS: ${counts.captured} de ${counts.total} imágenes del escritorio ya salen de un host real, con su proporción, tema y modo; el resto sigue pendiente y dice qué falta tomar.` : `The HorneroOS capture wall: ${counts.captured} of ${counts.total} desktop images already come from a real host, with their aspect, theme and mode; the rest stay pending and say what is left to take.`}
>
  <section class="showcase-hero section" id="capture-ledger">
    <div class="hero-copy">
      <p class="plate-id"><strong>{isEs ? 'Muro de capturas' : 'Capture wall'}</strong><span>{counts.captured} / {counts.total} {isEs ? 'listas' : 'ready'}</span></p>
      <h1>Showroom</h1>
      <p>
        {isEs ? `Las imágenes de escritorio en estos espacios salen de capturas de un host real (${counts.captured} de ${counts.total} ya tomadas) o quedan como espacios reservados que dicen qué falta tomar, cómo y con qué proporción. Los diagramas, las ilustraciones y las fotos de fondos en otras páginas están etiquetados como lo que son, junto a cada imagen.` : `Desktop images in these slots come from captures on a real host (${counts.captured} of ${counts.total} taken so far) or stay as placeholders that say what is left to take, how, and at what aspect ratio. Diagrams, illustrations and wallpaper photographs on other pages are labelled as what they are, next to each image.`}
      </p>
      <p>
        <a class="text-link" href={shotList}>{isEs ? 'Leé la lista completa de capturas' : 'Read the full shot list'} <span aria-hidden="true">↗</span></a>
        · <a class="text-link" href={L('/wallpapers')}>{isEs ? 'Los fondos con licencia' : 'The licensed wallpapers'}</a>
      </p>
      <ul class="tally" role="list" aria-label={isEs ? 'Capturas por prioridad' : 'Captures by priority'}>
        {
          priorityOrder.map((p) => (
            <li data-priority={p}>
              <b>{counts[p]}</b>
              <span>{p} · {priorityLabel[p]}</span>
            </li>
          ))
        }
      </ul>
      <nav class="hero-links" aria-label={isEs ? 'Sesiones de captura' : 'Capture sessions'}>
        {sessions.map((session) => <a href={`#session-${session.id.toLowerCase()}`}>{session.id} · {session.title[locale]}</a>)}
      </nav>
    </div>
  </section>

  {
    sessions.map((session) => (
      <section class="section session" id={`session-${session.id.toLowerCase()}`} aria-labelledby={`title-${session.id.toLowerCase()}`}>
        <header class="session-head">
          <h2 id={`title-${session.id.toLowerCase()}`}>
            <span>{session.id}</span> {session.title[locale]}
          </h2>
          <p>{session.slots.length} {isEs ? 'capturas' : 'captures'}</p>
        </header>
        <div class="wall">
          {session.slots.map((slot) => (
            <div class="cell" data-wide={slot.width / slot.height >= 2 ? 'true' : undefined} id={slot.id.toLowerCase()}>
              <CaptureFigure slot={slot.id} locale={locale} />
            </div>
          ))}
        </div>
      </section>
    ))
  }
</SiteLayout>

<style>
  .showcase-hero {
    padding-block: clamp(1rem, 4vw, 3.5rem) 1rem;
  }

  .hero-copy {
    display: grid;
    gap: 1rem;
    max-width: 72ch;
  }

  .hero-copy h1 {
    margin: 0;
  }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.6rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tally li {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--rule-strong);
    border-left: 3px solid var(--signal);
    border-radius: var(--radius-small);
    background: var(--panel);
  }

  .tally b {
    font: 700 var(--step-2) var(--font-display);
  }

  .tally span {
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
    letter-spacing: 0.04em;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font: 500 0.78rem var(--font-mono);
  }

  .session {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--rule);
  }

  .session-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-bottom: 1.2rem;
  }

  .session-head h2 span {
    margin-right: 0.5rem;
    color: var(--signal);
    font-family: var(--font-mono);
  }

  .session-head p {
    margin: 0;
    color: var(--ink-muted);
    font: 500 0.78rem var(--font-mono);
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.6rem 1.2rem;
  }

  .cell {
    min-width: 0;
  }

  .cell[data-wide='true'] {
    grid-column: 1 / -1;
  }
</style>
