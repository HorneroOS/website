---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaptureFigure from '../CaptureFigure.astro';
import { localizePath, type Locale } from '../../i18n/ui';
import { editorial, getSlot, showroomGroups, slotCounts } from '../../data/captures';
import { messages } from '../../i18n/messages/showroom';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const counts = slotCounts();
const groups = showroomGroups();
const curationDoc = 'https://github.com/HorneroOS/website/blob/main/docs/IMAGE_CURATION.md';
---

<SiteLayout
  socialImage="/og/showroom.png"
  socialImageAlt={m.tarjetaDeMarcaDeHorneroos}
  title="Showroom | HorneroOS"
  description={m.elShowroomDeHorneroosCapturas(counts.public)}
>
  <section class="showcase-hero section" id="capture-ledger">
    <div class="hero-copy">
      <p class="plate-id">
        <strong>{m.capturasSeleccionadas}</strong>
        <span>
          {counts.public} {m.enPublico}
        </span>
      </p>
      <h1>Showroom</h1>
      <p>{m.unaSeleccionCuradaDeCapturas(counts.public)}</p>
      <p>{editorial.provenance[locale]}</p>
      <p>
        <a class="text-link" href={curationDoc}>
          {m.comoSeCuroEstaSeleccion} <span aria-hidden="true">↗</span>
        </a>
        ·{' '}
        <a class="text-link" href={L('/wallpapers')}>
          {m.losFondosConLicencia}
        </a>
      </p>
      <nav class="hero-links" aria-label={m.gruposDelShowroom}>
        {groups.map((group, i) => (
          <a href={`#group-${i + 1}`}>{group.group[locale]}</a>
        ))}
      </nav>
    </div>
  </section>

  {groups.map((group, i) => (
    <section class="section session" id={`group-${i + 1}`} aria-labelledby={`title-group-${i + 1}`}>
      <header class="session-head">
        <h2 id={`title-group-${i + 1}`}>{group.group[locale]}</h2>
        <p>
          {group.slots.length} {m.capturas}
        </p>
      </header>
      <div class="wall">
        {group.slots.map((sid) => {
          const slot = getSlot(sid);
          return (
            <div class="cell" data-wide={slot.width / slot.height >= 2 ? 'true' : undefined} id={sid.toLowerCase()}>
              <CaptureFigure slot={sid} locale={locale} caption={group.captions?.[sid]?.[locale]} />
            </div>
          );
        })}
      </div>
    </section>
  ))}
</SiteLayout>

<style>
  .showcase-hero {
    padding-block: clamp(1rem, 4vw, 3.5rem) 1rem;
  }

  .hero-copy {
    display: grid;
    gap: 1rem;
    max-width: 72ch;
  }

  .hero-copy h1 {
    margin: 0;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font: 500 0.78rem var(--font-mono);
  }

  .session {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--rule);
  }

  .session-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-bottom: 1.2rem;
  }

  .session-head p {
    margin: 0;
    color: var(--ink-muted);
    font: 500 0.78rem var(--font-mono);
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.6rem 1.2rem;
  }

  .cell {
    min-width: 0;
  }

  .cell[data-wide='true'] {
    grid-column: 1 / -1;
  }
</style>
