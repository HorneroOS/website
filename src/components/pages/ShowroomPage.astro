---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);
import ArchFrame from '../../components/ArchFrame.astro';
import { wallpapers } from '../../data/product';

const shots = await getCollection('showroom');
const shot = (id: string) => {
  const capture = shots.find((item) => item.id === id);
  if (!capture) throw new Error(`Showroom capture not found: ${id}`);
  return capture;
};
const atmospheres = [
  shot('neon-city'),
  shot('vapor-roadtrip'),
  shot('morning-lake'),
  shot('pampa'),
  shot('hornero-light'),
];
const topologies = [shot('hornero-left'), shot('cockpit-clear'), shot('horizon'), shot('islands'), shot('dock-bottom')];
const liveWorkstation = shot('live-workstation');
const dashboardExtensions = shot('dashboard-extensions');
const terminalTools = shot('terminal-tools');
const quickToggles = shot('quick-toggles');
const wallpaperPicker = shot('wallpaper-picker');
const beagle = wallpapers.find((wallpaper) => wallpaper.id === 'fin-del-mundo');
if (!beagle) throw new Error('The Beagle Channel photograph is missing from the pinned wallpaper catalogue');
const ledger = [...shots].sort((x, y) => x.data.order - y.data.order);
---

<SiteLayout
  socialImage="/og/showroom.png"
  socialImageAlt={isEs ? "btop y el gestor de archivos yazi en un escritorio Hornero en vivo sobre una foto del Canal Beagle, junto al texto 'Capturas del escritorio Hornero'." : "btop and the yazi file manager on a live Hornero desktop over a photograph of the Beagle Channel, beside the line 'Hornero desktop captures'."}
  title={isEs ? 'Showroom | HorneroOS' : 'Showroom | HorneroOS'}
  description={isEs ? 'Capturas del escritorio Hornero con su fuente, resolución, fecha y, cuando quedó registrado, el tema: layouts, temas, Ajustes y una sesión de trabajo.' : 'Hornero desktop captures with their source, resolution, date and, when recorded, theme: layouts, themes, Settings and a working session.'}
>
  <section class="showcase-hero section">
    <div class="hero-copy">
      <p class="plate-id"><strong>Archivo de capturas reales</strong><span>ARG / 199X</span><span>QA · procedencia en cada ficha</span></p>
      <h1>{isEs ? 'Capturas del escritorio Hornero' : 'Hornero desktop captures'}</h1>
      <p>
        {isEs ? 'Una misma shell con distintos fondos y layouts, más los Ajustes que los cambian. Cada captura indica su fuente, resolución, fecha y, cuando quedó registrado, el tema.' : 'One shell on different wallpapers and layouts, plus the Settings that change them. Each capture lists its source, resolution, date and, when recorded, theme.'}
      </p>
      <p class="capture-era-note">
        {isEs ? 'Las capturas del 3 de octubre de 2026 usan arte de fondo anterior a los actuales Hornero Originals fotográficos; sus layouts y controles son los de esa fecha. Mirá ' : 'The captures from 3 October 2026 use wallpaper artwork that predates the current photographic Hornero Originals; their layouts and controls are as of that date. See '}{' '}
        <a href={L('/wallpapers')}>{isEs ? 'la colección argentina con licencia' : 'the licensed Argentina collection'}</a> {isEs ? 'para ver los fondos actuales.' : 'for the current wallpapers.'}
      </p>
      <nav class="hero-links" aria-label={isEs ? 'Explorar la vidriera' : 'Explore the showcase'}>
        <a href="#visual-worlds">
          {isEs ? 'Mundos visuales' : 'Visual worlds'}
        </a>
        <a href="#layouts">
          Layouts
        </a>
        <a href="#control-center">
          {isEs ? 'Ajustes' : 'Settings'}
        </a>
      </nav>
    </div>
    <div class="hero-shot" id="dashboard" tabindex="-1">
      <ArchFrame
        src={shot('dashboard').data.image}
        alt={shot('dashboard').data.alt}
        eager
        provenance={shot('dashboard').data.provenance}
        sizes="(min-width: 1180px) 64vw, 100vw"
        widths={[640, 960, 1280, 1600]}
      />
      <p class="image-note">
        <span>Dashboard</span> {isEs ? 'Cinco pestañas, el Companion y el fondo en un mismo escritorio.' : 'Five tabs, the Companion and the wallpaper on one desktop.'}
      </p>
    </div>
  </section>

  <section class="section session-section" id="live-session" aria-labelledby="session-title">
    <div class="section-heading">
      <div>
        <h2 id="session-title">{isEs ? 'Cuatro capturas, una mañana' : 'Four captures, one morning'}</h2>
      </div>
      <p>
        {isEs ? 'Hechas en una sesión en vivo el 25 de octubre de 2026, entre las 04:28 y las 04:35. El fondo es una foto del Canal Beagle, en Tierra del Fuego, de ' : 'Taken in one live session on 25 October 2026, between 04:28 and 04:35. The wallpaper is a photograph of the Beagle Channel in Tierra del Fuego by '}{' '}
        <a href={beagle.sourcePage}>{beagle.photographer}</a>, <a href={beagle.licenseUrl}>{beagle.license}</a>. {isEs ? 'Son capturas de un host de desarrollo, no imágenes de aceptación del instalador ni de una release.' : 'They are development-host captures, not installer or release acceptance images.'}
      </p>
    </div>
    <div class="session-grid">
      <article id="dashboard-extensions" tabindex="-1" class="session-lead">
        <ArchFrame
          src={dashboardExtensions.data.image}
          alt={dashboardExtensions.data.alt}
          provenance={dashboardExtensions.data.provenance}
          sizes="(min-width: 1180px) 1100px, calc(100vw - 2rem)"
          widths={[640, 960, 1280, 1600, 1918]}
        />
        <div class="story-caption">
          <h3>{isEs ? 'El Dashboard' : 'The Dashboard'}</h3>
          <p>{isEs ? 'Medios, Rendimiento, Clima, Espacios de trabajo y Extensiones tienen sus propias pestañas junto a la vista general.' : 'Media, Performance, Weather, Workspaces and Extensions have their own tabs beside the overview.'}</p>
        </div>
      </article>
      <article id="terminal-tools" tabindex="-1" class="session-wide">
        <ArchFrame
          src={terminalTools.data.image}
          alt={terminalTools.data.alt}
          provenance={terminalTools.data.provenance}
          sizes="(min-width: 1100px) 62vw, calc(100vw - 2rem)"
          widths={[640, 960, 1280, 1600]}
        />
        <div class="story-caption">
          <h3>btop and yazi</h3>
          <p>{isEs ? 'Programas de terminal comunes. yazi está previsualizando una carpeta de fondos.' : 'Ordinary terminal programs. yazi is previewing a wallpaper folder.'}</p>
        </div>
      </article>
      <article id="quick-toggles" tabindex="-1" class="session-narrow">
        <ArchFrame
          src={quickToggles.data.image}
          alt={quickToggles.data.alt}
          provenance={quickToggles.data.provenance}
          sizes="(min-width: 1100px) 34vw, calc(100vw - 2rem)"
          widths={[640, 960, 1280]}
        />
        <div class="story-caption">
          <h3>{isEs ? 'Ajustes rápidos' : 'Quick settings'}</h3>
          <p>{isEs ? 'Wi-Fi, Bluetooth, micrófono, ajustes y notificaciones, con Keep Awake y el grabador de pantalla.' : 'Wi-Fi, Bluetooth, microphone, settings and notifications, with Keep Awake and the screen recorder.'}</p>
        </div>
      </article>
      <article id="wallpaper-picker" tabindex="-1" class="session-lead">
        <ArchFrame
          src={wallpaperPicker.data.image}
          alt={wallpaperPicker.data.alt}
          provenance={wallpaperPicker.data.provenance}
          sizes="(min-width: 1180px) 1100px, calc(100vw - 2rem)"
          widths={[640, 960, 1280, 1600, 1918]}
        />
        <div class="story-caption">
          <h3>{isEs ? <>Escribí <code>&gt;wallpaper</code> en el lanzador.</> : <>Type <code>&gt;wallpaper</code> in the launcher.</>}</h3>
          <p>
            {isEs ? 'Las miniaturas se previsualizan en todo el escritorio antes de que apliques una. Los fondos de esta captura vienen de la carpeta personal de quien contribuyó. No vienen con HorneroOS.' : 'Thumbnails preview across the whole desktop before you apply one. The wallpapers in this capture come from the contributor’s own folder. They are not shipped with HorneroOS.'}
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="section work-session-section" aria-labelledby="work-session-title">
    <div class="section-heading">
      <div>
        <h2 id="work-session-title">{isEs ? 'Una sesión de desarrollo del 23 de octubre' : 'A development session on 23 October'}</h2>
      </div>
      <p>
        {isEs ? 'Una captura aportada por un colaborador de una estación de trabajo en vivo, con el monitor del sistema y los ajustes rápidos abiertos. No es una captura del instalador ni evidencia de aceptación de una release.' : 'A contributor-provided capture of a live workstation with the system monitor and quick settings open. It is not an installer screenshot or release acceptance evidence.'}
      </p>
    </div>
    <ArchFrame
      src={liveWorkstation.data.image}
      alt={liveWorkstation.data.alt}
      provenance={liveWorkstation.data.provenance}
      sizes="(min-width: 1180px) 76vw, 100vw"
      widths={[640, 960, 1280, 1918]}
    />
  </section>
  <section class="section atmosphere-section" id="visual-worlds" aria-labelledby="worlds-title">
    <div class="section-intro">
      <h2 id="worlds-title">{isEs ? 'La misma shell, distintos fondos' : 'Same shell, different wallpapers'}</h2>
      <p>
        {isEs ? 'Capturas de desarrollo fechadas, con el riel vertical a la vista mientras cambia el fondo. La generación de paleta puede derivar un esquema de color del fondo que elijas. Los Argentina Originals actuales usan las fotos con atribución de la colección de fondos.' : 'Dated development captures with the vertical rail in view while the wallpaper changes. Palette generation can derive a color scheme from the wallpaper you choose. The current Argentina Originals use the attributed photographs in the wallpaper collection.'}
      </p>
      <a class="text-link" href={L('/themes')}>
        {isEs ? 'Explorá todos los temas' : 'Browse all themes'}
      </a>
    </div>
    <div class="atmosphere-grid">
      {atmospheres.map((s, i) => (
        <article id={s.id} tabindex="-1" class:list={['atmosphere-card', `atmosphere-${i + 1}`]}>
          <ArchFrame
            src={s.data.image}
            alt={s.data.alt}
            provenance={s.data.provenance}
            sizes="(min-width: 1050px) 45vw, (min-width: 700px) 50vw, calc(100vw - 2rem)"
            widths={[480, 720, 960, 1280]}
          />
          <div class="story-caption">
            <span>{s.data.provenance.theme ?? (isEs ? 'Colores del fondo' : 'Wallpaper colors')}</span>
            <h3>{s.data.title}</h3>
            <p>{s.data.provenance.context}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="section-tail">
      {isEs ? 'Las vistas previas del arte y la colección completa de fondos están en ' : 'Artwork previews and the complete wallpaper collection live in '}<a href={L('/themes#hornero-originals')}>{isEs ? 'Temas' : 'Themes'}</a>.{isEs ? '' : ''}
    </p>
  </section>

  <section class="section topology-section" id="layouts" aria-labelledby="layouts-title">
    <div class="section-heading">
      <div>
        <h2 id="layouts-title">Layouts</h2>
      </div>
      <p>
        {isEs ? 'Un riel lateral, barras de a dos, una barra superior ancha, islas separadas o un dock inferior. Los layouts cambian dónde va cada cosa; los controles compartidos y el lenguaje visual quedan igual.' : 'A side rail, paired bars, a wide top bar, separate islands or a bottom dock. Layouts change where things sit; the shared controls and visual language stay the same.'}
      </p>
    </div>
    <div class="topology-grid">
      {topologies.map((s, i) => (
        <article id={s.id} tabindex="-1" class:list={['topology-card', `topology-${i + 1}`]}>
          <ArchFrame
            src={s.data.image}
            alt={s.data.alt}
            provenance={s.data.provenance}
            sizes="(min-width: 1100px) 32vw, (min-width: 700px) 48vw, calc(100vw - 2rem)"
            widths={[480, 720, 960, 1280]}
          />
          <h3>{s.data.title}</h3>
        </article>
      ))}
    </div>
    <a class="text-link section-cta" href={L('/layouts')}>
      {isEs ? 'Mirá la colección de layouts' : 'See the layout collection'}
    </a>
  </section>

  <section class="section controls-section" id="control-center" aria-labelledby="controls-title">
    <div class="section-heading">
      <div>
        <h2 id="controls-title">{isEs ? 'Ajustes' : 'Settings'}</h2>
      </div>
      <p>
        {isEs ? 'La búsqueda del Centro de control salta al ajuste que escribís. Apariencia agrupa aspectos, fondo, colores y vistas previas en un solo panel.' : 'Control Center search jumps to the setting you type. Appearance groups looks, wallpaper, colors and previews in one pane.'}
      </p>
    </div>
    <div class="controls-grid">
      <article class="control-feature" id="appearance-search" tabindex="-1">
        <ArchFrame
          src={shot('appearance-search').data.image}
          alt={shot('appearance-search').data.alt}
          provenance={shot('appearance-search').data.provenance}
          sizes="(min-width: 1100px) 58vw, 100vw"
          widths={[520, 800, 1080, 1280]}
        />
        <div class="story-caption">
          <h3>{isEs ? 'Búsqueda en Ajustes' : 'Settings search'}</h3>
          <p>{isEs ? 'Buscar “wallpaper” te lleva a los controles de Apariencia para eso.' : 'Searching “wallpaper” lands on the Appearance controls for it.'}</p>
        </div>
      </article>
      <article class="control-secondary" id="layout-picker" tabindex="-1">
        <ArchFrame
          src={shot('layout-picker').data.image}
          alt={shot('layout-picker').data.alt}
          provenance={shot('layout-picker').data.provenance}
          sizes="(min-width: 1100px) 32vw, (min-width: 700px) 48vw, calc(100vw - 2rem)"
          widths={[480, 720, 960]}
        />
        <div class="story-caption">
          <h3>{isEs ? 'Selector de layouts' : 'Layout Picker'}</h3>
          <p>{isEs ? 'Cada layout se previsualiza como un mapa de topología antes de que lo apliques.' : 'Each layout is previewed as a topology map before you apply it.'}</p>
        </div>
      </article>
    </div>
    <p class="capture-note">
      {isEs ? 'Cada captura se muestra con su fecha y su fuente. Los sidecars de QA registran el escenario y las revisiones de paquetes; la imagen de búsqueda en Ajustes es una captura de revisión visual de la búsqueda ya fusionada. No todas las capturas vienen de la misma build.' : 'Each capture is shown with its date and source. QA sidecars record the scenario and package revisions; the Settings search image is a visual review capture of the merged search implementation. The captures do not all come from the same build.'}
    </p>
  </section>

  <section class="section ledger-section" id="capture-ledger" aria-labelledby="ledger-title">
    <div class="section-heading">
      <div>
        <h2 id="ledger-title">{isEs ? 'Registro de capturas' : 'Capture ledger'}</h2>
      </div>
      <p>
        {isEs ? 'Qué produjo cada imagen, el tema que muestra y cuándo se hizo. No todas las capturas vienen de la misma build.' : 'What produced each picture, the theme it shows and when it was taken. The captures do not all come from the same build.'}
      </p>
    </div>
    <div class="table-scroll" tabindex="0" role="region" aria-label={isEs ? 'Registro de capturas' : 'Capture ledger'}>
      <table>
        <caption>{ledger.length} {isEs ? 'capturas en este sitio' : 'captures on this site'}</caption>
        <thead>
          <tr><th scope="col">{isEs ? 'Captura' : 'Capture'}</th><th scope="col">{isEs ? 'Fuente' : 'Source'}</th><th scope="col">{isEs ? 'Tema' : 'Theme'}</th><th scope="col">{isEs ? 'Resolución' : 'Resolution'}</th><th scope="col">{isEs ? 'Fecha' : 'Date'}</th></tr>
        </thead>
        <tbody>
          {ledger.map((s) => (
            <tr>
              <th scope="row">{s.data.title}</th>
              <td>{s.data.provenance.source}</td>
              <td>{s.data.provenance.theme ?? (isEs ? 'Sin registro' : 'Not recorded')}</td>
              <td>{s.data.provenance.resolution ?? (isEs ? 'Sin registro' : 'Not recorded')}</td>
              <td><time datetime={s.data.provenance.date}>{s.data.provenance.date}</time></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</SiteLayout>

<style>
  :global(main.app) {
    padding-top: 0.75rem;
  }
  .showcase-hero {
    display: grid;
    grid-template-columns: minmax(19rem, 0.9fr) minmax(0, 1.35fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2rem, 6vw, 5.5rem) clamp(3rem, 7vw, 6rem);
  }
  .hero-copy {
    max-width: 34rem;
  }
  h1 {
    font-size: clamp(3.2rem, 4.6vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  h1 em,
  .section-intro h2 em {
    color: var(--clay);
    font-style: normal;
  }
  .hero-copy > p:not(.eyebrow) {
    max-width: 31rem;
    color: var(--muted);
    font-size: var(--step-1);
  }
  .hero-copy > .capture-era-note {
    max-width: 34rem;
    padding: 0.8rem 0.9rem;
    border-inline-start: 2px solid var(--secondary);
    background: color-mix(in oklab, var(--surface) 62%, transparent);
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .capture-era-note a {
    color: var(--text);
    text-decoration-color: var(--accent);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.6rem;
  }
  .hero-links a {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.92rem;
    text-decoration: none;
  }
  .hero-links a:hover {
    border-color: var(--clay);
    color: var(--clay);
  }
  .hero-shot {
    min-width: 0;
  }
  .hero-shot :global(.frame-arch .frame-shot) {
    border-radius: 42% 42% var(--radius) var(--radius) / 12% 12% var(--radius) var(--radius);
  }
  .image-note,
  .story-caption > span {
    color: var(--muted);
    font: 0.72rem/1.45 var(--font-data);
    letter-spacing: 0.02em;
  }
  .image-note {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }
  .image-note span {
    color: var(--clay);
    white-space: nowrap;
  }
  .atmosphere-section {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-block: 1px solid var(--line);
  }
  .section-intro {
    max-width: 55rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .section-intro h2,
  .section-heading h2 {
    font-size: clamp(2.25rem, 4.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .section-intro > p:not(.eyebrow) {
    max-width: 46rem;
    color: var(--muted);
    font-size: var(--step-1);
  }
  .text-link {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--clay);
    font-weight: 600;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .atmosphere-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3.5rem) clamp(1rem, 3vw, 2.5rem);
  }
  .atmosphere-card {
    min-width: 0;
  }
  .atmosphere-2,
  .atmosphere-4 {
    margin-top: 4rem;
  }
  .atmosphere-card :global(.frame-shot) {
    aspect-ratio: 16 / 10;
  }
  .atmosphere-card :global(.frame-shot img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story-caption {
    margin-top: 1rem;
  }
  .story-caption > span {
    color: var(--clay);
  }
  .story-caption h3,
  .topology-card h3 {
    margin: 0.25rem 0;
    font-size: var(--step-2);
  }
  .story-caption p {
    max-width: 38rem;
    margin: 0.35rem 0;
    color: var(--muted);
  }
  .section-tail {
    margin-top: 2rem;
    color: var(--muted);
  }
  .section-tail a {
    color: var(--ink);
  }
  .topology-section,
  .controls-section,
  .work-session-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: 2.25rem;
  }
  .section-heading h2 {
    margin-bottom: 0;
  }
  .section-heading > p {
    max-width: 40rem;
    margin: 0;
    color: var(--muted);
  }
  .topology-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.3rem;
  }
  .topology-card {
    min-width: 0;
    grid-column: span 2;
  }
  .topology-1,
  .topology-2 {
    grid-column: span 3;
  }
  .topology-card :global(.frame-shot) {
    aspect-ratio: 16 / 10;
  }
  .topology-card :global(.frame-shot img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .topology-card h3 {
    margin-top: 0.65rem;
    font-size: var(--step-1);
  }
  .section-cta {
    margin-top: 1.6rem;
  }
  .controls-section {
    background: color-mix(in oklab, var(--surface) 55%, transparent);
  }
  .controls-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.8fr);
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .control-feature,
  .control-secondary {
    min-width: 0;
  }
  .controls-grid :global(.frame-shot) {
    aspect-ratio: 16 / 10;
  }
  .controls-grid :global(.frame-shot img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .control-secondary {
    margin-top: 4rem;
  }
  .capture-note {
    max-width: 66rem;
    margin: 2.5rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  @media (max-width: 900px) {
    .showcase-hero {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .hero-copy {
      max-width: 45rem;
    }
    .hero-shot {
      padding-inline: 0.25rem;
    }
    .section-heading {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.6rem;
    }
    .topology-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .topology-card,
    .topology-1,
    .topology-2 {
      grid-column: auto;
    }
    .topology-1 {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 620px) {
