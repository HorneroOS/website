---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaptureFigure from '../../components/CaptureFigure.astro';
import CaptureGallery from '../../components/CaptureGallery.astro';
import AppLogo from '../../components/AppLogo.astro';
import { extensionCatalogue, pins, commitUrl } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/extensions';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const plugins = extensionCatalogue.plugins;
const repo = pins.plugins.repo;
const catalogueUrl = commitUrl(repo, extensionCatalogue.generatedFrom);
const sourcePinUrl = commitUrl(repo, pins.plugins.sha);
const cliSourceUrl = commitUrl(pins.hornero.repo, pins.hornero.sha);
const categories = [...new Set(plugins.map((plugin) => plugin.category))].sort();
const placements = [...new Set(plugins.map((plugin) => plugin.placement))].sort();
const trusts = [...new Set(plugins.map((plugin) => plugin.trust))].sort();
const processSummary = (commands: string[]) => (commands.length ? commands.join(', ') : m.ningunoDeclarado);
const networkSummary = (hosts: string[]) => (hosts.length ? hosts.join(', ') : m.ningunoDeclarado);
const settingsSummary = (settings: (typeof plugins)[number]['settings']) =>
  Object.entries(settings).map(([name, setting]) => ({ name, ...setting }));
---

<SiteLayout
  socialImage="/og/extensions.png"
  socialImageAlt={m.lasExtensionesOficialesDeHorneroos}
  title={m.extensionesHorneroos}
  description={m.elCatalogoOficialDeExtensiones}
>
  <section class="extension-intro section" aria-labelledby="extensions-title">
    <div class="intro-copy">
      <p class="plate-id">
        <strong>Extensiones Hornero</strong>
        <span>{m.catalogoOficial}</span>
      </p>
      <h1 id="extensions-title">{m.extensiones}</h1>
      <p class="lede">
        {m.extensionesPropiasParaHorneroShell}
        <a href={repo}>HorneroOS/plugins</a>. {m.elCentroDeControlY}
        <code>horneroctl</code> {m.lasInstalanComoDatosDe}
      </p>
      <div class="intro-links">
        <a class="cta primary" href="#catalogue">
          {m.exploraLasExtensionesOficiales(plugins.length)}
        </a>
        <a class="text-link" href={`${repo}/blob/${pins.plugins.sha}/docs/CONTRIBUTING.md`}>
          {m.leeLaGuiaParaContribuir}
        </a>
      </div>
    </div>

    <aside class="catalogue-stamp" aria-label={m.procedenciaDelCatalogo}>
      <p class="stamp-heading">
        <span>{m.horneroMesaDePlugins}</span>
        <span>{m.oficial}</span>
      </p>
      <p class="stamp-count">
        <strong>{String(plugins.length).padStart(2, '0')}</strong>
        <span>
          {m.extensiones2}
          <br />
          {m.enElCatalogo}
        </span>
      </p>
      <dl>
        <div>
          <dt>{m.snapshotDelCatalogo}</dt>
          <dd>
            <a href={catalogueUrl}>
              <code>{extensionCatalogue.generatedFrom}</code>
            </a>
          </dd>
        </div>
        <div>
          <dt>{m.pinDeCodigoDelSitio}</dt>
          <dd>
            <a href={sourcePinUrl}>
              <code>{pins.plugins.sha}</code>
            </a>
          </dd>
        </div>
        <div>
          <dt>{m.integridad}</dt>
          <dd>
            {m.sha256VerificadoPor}
            <code>horneroctl</code>
          </dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="trust-strip section" aria-labelledby="trust-title">
    <div class="trust-mark" aria-hidden="true">
      !
    </div>
    <div>
      <h2 id="trust-title">{m.lasExtensionesCorrenConTus}</h2>
      <p>{m.elQmlDeLosPlugins}</p>
    </div>
    <a class="text-link" href={`${repo}/blob/${pins.plugins.sha}/docs/SECURITY.md`}>
      {m.leeElModeloDeSeguridad}
    </a>
  </section>

  <section class="where-section section" aria-labelledby="where-title">
    <div class="where-copy">
      <h2 id="where-title">{m.dondeAparecenLasExtensiones}</h2>
      <p>{m.unaExtensionConUbicacionEn}</p>
    </div>
    <CaptureFigure slot="CAP-EXT-04" locale={locale} />
  </section>

  <section class="extension-where section" aria-labelledby="devpulse-title">
    <div class="section-heading">
      <h2 id="devpulse-title">{m.devPulseTitulo}</h2>
      <p>{m.devPulseTexto}</p>
    </div>
  </section>

  <section class="extension-catalogue section" id="catalogue" aria-labelledby="catalogue-title">
    <div class="section-heading">
      <div>
        <h2 id="catalogue-title">{m.catalogoOficialPaquetes(plugins.length)}</h2>
      </div>
      <p>{m.cadaTarjetaMuestraDondeAparece}</p>
    </div>

    <div class="catalogue-controls" data-catalogue-controls data-locale={locale} hidden>
      <label class="catalogue-search">
        <span>{m.buscarExtensiones}</span>
        <input type="search" data-catalogue-search placeholder={m.nombreFuncionOUbicacion} autocomplete="off" />
      </label>
      <label class="catalogue-category">
        <span>{m.categoria}</span>
        <select data-catalogue-category>
          <option value="all">{m.todasLasCategorias}</option>
          {categories.map((category) => (
            <option value={category}>{category}</option>
          ))}
        </select>
      </label>
      <label class="catalogue-placement">
        <span>{m.ubicacion}</span>
        <select data-catalogue-placement>
          <option value="all">{m.todasLasUbicaciones}</option>
          {placements.map((placement) => (
            <option value={placement}>{placement}</option>
          ))}
        </select>
      </label>
      <label class="catalogue-trust">
        <span>{m.confianza}</span>
        <select data-catalogue-trust>
          <option value="all">{m.todosLosNiveles}</option>
          {trusts.map((trust) => (
            <option value={trust}>{trust}</option>
          ))}
        </select>
      </label>
      <p class="catalogue-result-count" data-catalogue-count aria-live="polite" aria-atomic="true">
        {plugins.length} {m.extensionesOficiales}
      </p>
    </div>

    <ul class="extension-grid" role="list">
      {plugins.map((plugin) => {
        const sourceUrl = `${repo}/tree/${pins.plugins.sha}/${plugin.path}`;
        const licenseUrl = `${repo}/blob/${pins.plugins.sha}/${plugin.path}/LICENSE`;
        const settings = settingsSummary(plugin.settings);
        const searchText = [
          plugin.id,
          plugin.name,
          plugin.version,
          plugin.description,
          plugin.author,
          plugin.category,
          plugin.placement,
          plugin.trust,
          ...plugin.surfaces,
          plugin.minShellVersion ?? '',
          ...plugin.processCommands,
          ...plugin.networkHosts,
        ]
          .join(' ')
          .toLocaleLowerCase();
        return (
          <li
            class="extension-card"
            data-extension-card
            data-category={plugin.category}
            data-placement={plugin.placement}
            data-trust={plugin.trust}
            data-search={searchText}
          >
            <article aria-labelledby={`${plugin.id}-title`}>
              <header class="card-heading">
                <span class="card-monogram">
                  <AppLogo id={plugin.id} name={plugin.name} />
                </span>
                <div>
                  <p class="extension-id">
                    <span>{plugin.trust}</span>
                    <code>{plugin.id}</code>
                  </p>
                  <h3 id={`${plugin.id}-title`}>{plugin.name}</h3>
                </div>
                <span class="placement-tag">{plugin.placement}</span>
              </header>
              <p class="card-version">
                <code>v{plugin.version}</code>
                <span>{plugin.category}</span>
                <span>{plugin.trust}</span>
              </p>
              <p class="card-description">{plugin.description}</p>

              <div
                class="placement"
                aria-label={
                  plugin.placement === 'bar'
                    ? m.viveEnLaBarra
                    : plugin.placement === 'desktop'
                      ? m.viveEnElEscritorio
                      : plugin.placement === 'background'
                        ? m.correEnSegundoPlano
                        : m.viveEnElDashboard
                }
              >
                <svg viewBox="0 0 160 52" role="presentation" aria-hidden="true" focusable="false">
                  {plugin.placement === 'bar' ? (
                    <>
                      <rect x="1" y="1" width="158" height="50" rx="3" class="slot-screen" />
                      <rect x="6" y="6" width="148" height="9" rx="2" class="slot-bar" />
                      <rect x="112" y="7.5" width="22" height="6" rx="1.5" class="slot-plugin" />
                    </>
                  ) : (
                    <>
                      <rect x="1" y="1" width="158" height="50" rx="3" class="slot-screen" />
                      <rect x="36" y="8" width="88" height="38" rx="3" class="slot-bar" />
                      <rect x="42" y="14" width="34" height="12" rx="2" class="slot-tile" />
                      <rect x="80" y="14" width="38" height="12" rx="2" class="slot-plugin" />
                      <rect x="42" y="30" width="76" height="10" rx="2" class="slot-tile" />
                    </>
                  )}
                </svg>
                <span>
                  {plugin.placement === 'bar'
                    ? m.viveEnLaBarra
                    : plugin.placement === 'desktop'
                      ? m.viveEnElEscritorio
                      : plugin.placement === 'background'
                        ? m.correEnSegundoPlano
                        : m.viveEnElDashboard}
                </span>
              </div>

              <ul class="declared" role="list" aria-label={m.declaradoPorElPluginNo}>
                <li>
                  {plugin.processCommands.length
                    ? `${m.declaraComandos}: ${plugin.processCommands.join(', ')}`
                    : m.sinComandosDeProcesoDeclarados}
                </li>
                <li>
                  {plugin.networkHosts.length
                    ? `${m.declaraHosts}: ${plugin.networkHosts.join(', ')}`
                    : m.sinHostsDeRedDeclarados}
                </li>
                <li>
                  {settings.length
                    ? `${settings.length} ${settings.length === 1 ? m.ajusteDeclarado : m.ajustesDeclarados} ${m.text}`.trim()
                    : m.sinAjustesDeclarados}
                </li>
                <li>
                  {plugin.surfaces.length
                    ? `${m.superficies}: ${plugin.surfaces.join(', ')}`
                    : m.sinSuperficiesExtraDeclaradas}
                </li>
                <li>
                  {plugin.minShellVersion
                    ? `Shell >= ${plugin.minShellVersion} (${m.declaradoNoVerificado})`
                    : m.compatibilidadConLaShellNo}
                </li>
              </ul>

              <details class="evidence">
                <summary>{m.instalacionChecksumYCodigo}</summary>
                <dl class="extension-facts">
                  <div>
                    <dt>{m.version}</dt>
                    <dd>{plugin.version}</dd>
                  </div>
                  <div>
                    <dt>{m.categoria}</dt>
                    <dd>{plugin.category}</dd>
                  </div>
                  <div>
                    <dt>{m.superficiesDeclaradas}</dt>
                    <dd>{plugin.surfaces.length ? plugin.surfaces.join(', ') : m.ningunaExtraDeclarada}</dd>
                  </div>
                  <div>
                    <dt>{m.compatibilidadDeclarada}</dt>
                    <dd>
                      {plugin.minShellVersion ? `Shell >= ${plugin.minShellVersion}` : m.noDeclarada}
                      {plugin.manifestSchema ? ` · manifest v${plugin.manifestSchema}` : ''}
                    </dd>
                  </div>
                  <div>
                    <dt>{m.autor}</dt>
                    <dd>{plugin.author}</dd>
                  </div>
                  <div>
                    <dt>{m.licencia}</dt>
                    <dd>
                      <a href={licenseUrl}>{plugin.license}</a>
                    </dd>
                  </div>
                  <div class="wide-fact">
                    <dt>{m.comandosDeProcesoDeclarados}</dt>
                    <dd>
                      <code>{processSummary(plugin.processCommands)}</code>
                    </dd>
                  </div>
                  <div class="wide-fact">
                    <dt>{m.hostsDeRedDeclarados}</dt>
                    <dd>
                      <code>{networkSummary(plugin.networkHosts)}</code>
                    </dd>
                  </div>
                  <div class="wide-fact">
                    <dt>{m.ajustesDeclarados2}</dt>
                    <dd>
                      {settings.length ? (
                        <ul class="settings-list" role="list">
                          {settings.map((setting) => (
                            <li>
                              <code>{setting.name}</code> · {setting.type}, {m.default}{' '}
                              <code>{String(setting.default)}</code>
                              {setting.options?.length ? (
                                <span>
                                  {' '}
                                  · {m.opciones}: {setting.options.join(', ')}
                                </span>
                              ) : null}
                              {setting.minimum !== undefined || setting.maximum !== undefined ? (
                                <span>
                                  {' '}
                                  · {setting.minimum ?? '…'}–{setting.maximum ?? '…'}
                                </span>
                              ) : null}
                              {setting.description ? <span> — {setting.description}</span> : null}
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <span>{m.ningunoDeclarado}</span>
                      )}
                    </dd>
                  </div>
                </dl>
                <div class="integrity-fact">
                  <span>{m.sha256DelPayload}</span>
                  <code>{plugin.sha256}</code>
                </div>
                <div class="card-actions">
                  <a class="text-link" href={sourceUrl}>
                    {m.codigoFijado} <span aria-hidden="true">↗</span>
                  </a>
                  <p class="install-via">
                    {m.instalacionRecomendadaAbriCentroDe}
                    <strong>{plugin.name}</strong>
                    {m.revisaSusCapacidadesDeclaradasE}
                  </p>
                  <p class="install-alt">{m.alternativaPorTerminal}</p>
                  <code class="install-command">
                    horneroctl plugin catalog install {plugin.id} --revision {pins.plugins.sha} --yes
                  </code>
                  <small class="install-requirement">
                    {m.requiere}
                    <a href={cliSourceUrl}>{m.horneroctlEnEstaRevision}</a> {m.oPosteriorPreview29NoSoporta}
                    <code>--revision</code>.
                  </small>
                </div>
              </details>
            </article>
          </li>
        );
      })}
    </ul>
    <p class="catalogue-empty" data-catalogue-empty hidden>
      {m.ningunaExtensionCoincideProbaCon}
    </p>
  </section>

  <section class="developer-section section" aria-labelledby="developer-title">
    <div>
      <h2 id="developer-title">{m.escribiUnaExtension}</h2>
    </div>
    <div class="developer-copy">
      <p>
        {m.lasSuperficiesYLaCompatibilidad}
        <code>HorneroOS/plugins</code>. {m.todaviaNoHayUnCatalogo}
      </p>
      <div class="developer-links">
        <a class="text-link" href={`${repo}/tree/${pins.plugins.sha}/templates/starter-plugin`}>
          {m.plantillaInicial}
        </a>
        <a class="text-link" href={`${repo}/blob/${pins.plugins.sha}/docs/CONTRIBUTING.md`}>
          {m.guiaDeContribucion}
        </a>
        <a class="text-link" href={`${repo}/blob/${pins.plugins.sha}/docs/SECURITY.md`}>
          {m.modeloDeSeguridad}
        </a>
      </div>
    </div>
  </section>

  <CaptureGallery route="/extensions" locale={locale} exclude={['CAP-EXT-04']} />
</SiteLayout>

<script>
  const controls = document.querySelector<HTMLElement>('[data-catalogue-controls]');
  const search = document.querySelector<HTMLInputElement>('[data-catalogue-search]');
  const category = document.querySelector<HTMLSelectElement>('[data-catalogue-category]');
  const placement = document.querySelector<HTMLSelectElement>('[data-catalogue-placement]');
  const trust = document.querySelector<HTMLSelectElement>('[data-catalogue-trust]');
  const count = document.querySelector<HTMLElement>('[data-catalogue-count]');
  const empty = document.querySelector<HTMLElement>('[data-catalogue-empty]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-extension-card]'));
  let announcementTimer: number | undefined;

  if (controls && search && category && placement && trust && count && empty && cards.length > 0) {
    const updateCatalogue = () => {
      const query = search.value.trim().toLocaleLowerCase();
      const selectedCategory = category.value;
      const selectedPlacement = placement.value;
      const selectedTrust = trust.value;
      let visible = 0;

      for (const card of cards) {
        const matchesQuery = (card.dataset.search ?? '').includes(query);
        const matchesCategory = selectedCategory === 'all' || card.dataset.category === selectedCategory;
        const matchesPlacement = selectedPlacement === 'all' || card.dataset.placement === selectedPlacement;
        const matchesTrust = selectedTrust === 'all' || card.dataset.trust === selectedTrust;
        const matches = matchesQuery && matchesCategory && matchesPlacement && matchesTrust;
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      window.clearTimeout(announcementTimer);
      announcementTimer = window.setTimeout(() => {
        count.textContent =
          controls.dataset.locale === 'es'
            ? `${visible} ${visible === 1 ? 'extensión encontrada' : 'extensiones encontradas'}`
            : `${visible} ${visible === 1 ? 'extension' : 'extensions'} found`;
      }, 300);
      empty.hidden = visible !== 0;
    };

    search.addEventListener('input', updateCatalogue);
    category.addEventListener('change', updateCatalogue);
    placement.addEventListener('change', updateCatalogue);
    trust.addEventListener('change', updateCatalogue);
    controls.hidden = false;
  }
</script>

<style>
  .extension-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.7fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }
  .intro-copy h1 {
    max-width: 13ch;
    margin-top: 1rem;
    font-size: clamp(3.4rem, 7vw, 6.4rem);
    line-height: 0.88;
    letter-spacing: -0.08em;
  }
  .intro-copy h1 em {
    color: var(--signal);
    font-style: normal;
  }
  .intro-copy .lede {
    max-width: 62ch;
    margin-top: 1.25rem;
  }
  .intro-links,
  .developer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .catalogue-stamp {
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-top: 3px solid var(--signal);
    background: var(--panel);
  }
  .stamp-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--phosphor);
    font: 0.67rem var(--font-mono);
    text-transform: uppercase;
  }
  .stamp-count {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block: 1.2rem;
  }
  .stamp-count strong {
    color: var(--signal);
    font: 5.5rem/0.85 var(--font-display);
    letter-spacing: -0.1em;
  }
  .stamp-count span {
    color: var(--ink-muted);
    font: 0.72rem var(--font-mono);
    line-height: 1.5;
    text-transform: uppercase;
  }
  .catalogue-stamp dl {
    display: grid;
    gap: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .catalogue-stamp dl div {
    display: grid;
    gap: 0.3rem;
  }
  .catalogue-stamp dt,
  .extension-facts dt,
  .integrity-fact > span {
    color: var(--phosphor);
    font: 0.64rem var(--font-mono);
    text-transform: uppercase;
  }
  .catalogue-stamp dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.78rem;
  }
  .catalogue-stamp code {
    font-size: 0.7rem;
  }
  .trust-strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-block: 1px solid var(--rule);
  }
  .trust-mark {
    display: grid;
    width: 2.4rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--signal);
    color: var(--signal);
    font: 1.4rem var(--font-mono);
  }
  .trust-strip h2 {
    margin-top: 0.2rem;
    font-size: clamp(1.45rem, 2.2vw, 2rem);
  }
  .trust-strip p:not(.eyebrow) {
    max-width: 78ch;
    margin-top: 0.45rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .trust-strip > a {
    max-width: 14rem;
  }
  .extension-catalogue {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .extension-catalogue .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.7fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.7rem;
  }
  .extension-catalogue .section-heading h2,
  .developer-section h2 {
    margin-top: 0.45rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: -0.055em;
  }
  .extension-catalogue .section-heading > p {
    max-width: 50ch;
    color: var(--ink-muted);
    line-height: 1.6;
  }
  .catalogue-controls {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) repeat(3, minmax(9rem, 0.4fr)) auto;
    align-items: end;
    gap: 1rem;
    margin-bottom: 1.2rem;
    padding: 1rem;
    border-block: 1px solid var(--rule);
    background: var(--panel);
  }
  .catalogue-controls[hidden],
  .extension-card[hidden],
  .catalogue-empty[hidden] {
    display: none;
  }
  .catalogue-controls label {
    display: grid;
    gap: 0.35rem;
  }
  .catalogue-controls label > span {
    color: var(--phosphor);
    font: 0.65rem var(--font-mono);
    text-transform: uppercase;
  }
  .catalogue-controls input,
  .catalogue-controls select {
    min-height: 2.8rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--base);
    color: var(--ink);
    font: inherit;
  }
  .catalogue-controls input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }
  .catalogue-result-count {
    align-self: center;
    color: var(--ink-muted);
    font: 0.68rem var(--font-mono);
    white-space: nowrap;
  }
  .catalogue-empty {
    padding: 2rem 1rem;
    border: 1px dashed var(--rule);
    color: var(--ink-muted);
    text-align: center;
  }
  .extension-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--rule);
    list-style: none;
  }
  .extension-card {
    min-width: 0;
    background: var(--base);
  }
  .extension-card article {
    height: 100%;
    padding: clamp(1.1rem, 2.3vw, 1.8rem);
  }
  .card-heading {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
  }
  .card-heading > div {
    flex: 1;
    min-width: 0;
  }
  .card-monogram {
    --app-logo-size: 2.2rem;
    flex: none;
    margin-top: 0.2rem;
  }
  @media (max-width: 440px) {
    .placement svg {
      width: 6.5rem;
    }
  }
  .extension-id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--phosphor);
