---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/not-found';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
---

<SiteLayout title={m.paginaNoEncontradaHorneroos} description={m.estaPaginaNoExiste} noindex>
  <section class="section lost">
    <div class="broadcast-plate">
      <p class="plate-id">
        <strong>Señal no encontrada</strong>
        <span>Error 404</span>
      </p>
      <div class="signal-bars" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </div>
      <h1>{m.paginaNoEncontrada}</h1>
      <p>{m.noHayNingunaPaginaEn}</p>
      <ul>
        <li>
          <a href={L('/')}>{m.inicio}</a>
        </li>
        <li>
          <a href={L('/showroom')}>Showroom</a>
        </li>
        <li>
          <a href={L('/roots')}>{m.raices}</a>
        </li>
        <li>
          <a href={L('/install')}>{m.instalar}</a>
        </li>
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .lost h1 {
    margin-block: 0.8rem 0.5rem;
  }
  .lost ul {
    margin-top: 0.8rem;
    padding-left: 1.25rem;
  }
  .lost li + li {
    margin-top: 0.35rem;
  }
</style>
