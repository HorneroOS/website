---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StageBadge from '../StageBadge.astro';
import ModeSchematic from '../ModeSchematic.astro';
import CaptureFigure from '../CaptureFigure.astro';
import CaptureGallery from '../CaptureGallery.astro';
import ReleaseChannelNote from '../ReleaseChannelNote.astro';
import { feature } from '../../data/features';
import { modes, type Motion, type BarDensity, type DesktopContent } from '../../data/modes';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/modes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);
const ledger = feature('experience-modes');

const motionName: Record<Motion, { es: string; en: string }> = {
  reduced: { es: 'Reducido', en: 'Reduced' },
  standard: { es: 'Estándar', en: 'Standard' },
  full: { es: 'Completo', en: 'Full' },
  off: { es: 'Apagado', en: 'Off' },
};
const barName: Record<BarDensity, { es: string; en: string }> = {
  icons: { es: 'Solo íconos', en: 'Icons only' },
  values: { es: 'Valores', en: 'Values' },
  labelled: { es: 'Con etiquetas', en: 'Labelled' },
};
const desktopName: Record<DesktopContent, { es: string; en: string }> = {
  empty: { es: 'Vacío', en: 'Empty' },
  widgets: { es: 'Tus widgets', en: 'Your widgets' },
  deck: { es: 'Deck de instrumentos', en: 'Instrument deck' },
};
const docs = ledger.evidence[0].href;
---

<SiteLayout
  socialImage="/og/modes.png"
  socialImageAlt={m.losCincoModosDeHorneroos}
  title={m.atmosferasModosDeExperienciaHorneroos}
  description={m.focusEverydaySignalGamingY}
>
  <section class="section modes-intro" aria-labelledby="modes-title">
    <p class="plate-id">
      <strong>{m.atmosferas}</strong>
      <span>{m.modosDeExperiencia}</span>
    </p>
    <h1 id="modes-title">{m.unEscritorioCincoClimas}</h1>
    <p class="lede">{m.unModoCambiaComoSe}</p>
    <p class="modes-status">
      <StageBadge stage={ledger.stage} locale={locale} />
      <ReleaseChannelNote feature={ledger} locale={locale} />
    </p>
  </section>

  <section class="section" aria-labelledby="five-title">
    <h2 id="five-title">{m.losCincoModos}</h2>
    <p class="section-copy">{m.cadaEsquemaDibujaLosCampos}</p>
    <ol class="mode-list" role="list">
      {modes.map((mode) => (
        <li class="mode-row" id={mode.id}>
          <div class="mode-copy">
            <p class="eyebrow">
              <b>{mode.channel}</b> · {m.layoutPreferido}: {mode.layout}
            </p>
            <h3>{mode.name}</h3>
            <p class="mode-line">{mode.line[locale]}</p>
            <ul class="mode-points">
              {mode.behaviours.map((b) => (
                <li>{b[locale]}</li>
              ))}
            </ul>
            <dl class="mode-fields">
              <div>
                <dt>{m.movimiento}</dt>
                <dd>{motionName[mode.motion][locale]}</dd>
              </div>
              <div>
                <dt>{m.barra}</dt>
                <dd>{barName[mode.bar][locale]}</dd>
              </div>
              <div>
                <dt>{m.escritorio}</dt>
                <dd>{desktopName[mode.desktop][locale]}</dd>
              </div>
            </dl>
          </div>
          <ModeSchematic mode={mode} locale={locale} />
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="compose-title">
    <h2 id="compose-title">{m.comoSeCombinan}</h2>
    <div class="table-scroll">
      <table>
        <caption class="sr-only">{m.cuatroEleccionesIndependientes}</caption>
        <thead>
          <tr>
            <th scope="col">{m.eleccion}</th>
            <th scope="col">{m.queDecide}</th>
            <th scope="col">{m.dondeSeCambia}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">
              <a href={L('/editions')}>{m.edicion}</a>
            </th>
            <td>{m.queSoftwareYCapacidadesHay}</td>
            <td>{m.laInstalacion}</td>
          </tr>
          <tr>
            <th scope="row">{m.modoDeExperiencia}</th>
            <td>{m.comoSeComportaElSistema}</td>
            <td>{m.ajustesExperienciaLauncherIndicadorDe}</td>
          </tr>
          <tr>
            <th scope="row">
              <a href={L('/layouts')}>Layout</a>
            </th>
            <td>{m.queBarrasYRielesExisten}</td>
            <td>{m.selectorDeLayouts}</td>
          </tr>
          <tr>
            <th scope="row">
              <a href={L('/themes')}>{m.tema}</a>
            </th>
            <td>{m.coloresYFondo}</td>
            <td>{m.apariencia}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="section-copy">{m.unModoSoloActivaCapacidades}</p>
  </section>

  <section class="section" aria-labelledby="captures-title">
    <h2 id="captures-title">{m.losCincoModosEnUn}</h2>
    <p class="section-copy">{m.capturasRealesDelMismoHost}</p>
    <div class="mode-captures">
      {['CAP-CC-04', 'CAP-MODE-01', 'CAP-DECK-01'].map((id) => (
        <CaptureFigure slot={id} locale={locale} />
      ))}
    </div>
  </section>

  <section class="section modes-end">
    <p class="section-copy">
      {m.cadaModoEsUnPaquete}
      <a class="text-link" href={docs}>
        {m.leeLaDocumentacionDeLos} <span aria-hidden="true">↗</span>
      </a>
      ·{' '}
      <a class="text-link" href={L('/chromatic')}>
        Hornero Chromatic
      </a>
    </p>
  </section>

  <CaptureGallery route="/modes" locale={locale} exclude={['CAP-CC-04', 'CAP-MODE-01', 'CAP-DECK-01']} />
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .section-copy {
    max-width: 68ch;
    color: var(--ink-muted);
  }

  .modes-intro h1 {
    max-width: 16ch;
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .modes-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1rem;
    max-width: 70ch;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .mode-list {
    display: grid;
    gap: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .mode-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: 1.5rem clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }

  .mode-copy {
    display: grid;
    gap: 0.6rem;
  }

  .mode-copy h3 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: -0.03em;
  }

  .mode-line {
    color: var(--ink);
    font-size: var(--step-1);
  }

  .mode-points {
    display: grid;
    gap: 0.35rem;
    max-width: 60ch;
    padding-left: 1.1rem;
    color: var(--ink-muted);
  }

  .mode-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.8rem;
    margin: 0.4rem 0 0;
  }

  .mode-fields dt {
    color: var(--ink-muted);
    font: 500 0.66rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mode-fields dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .mode-captures {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1.6rem 1.25rem;
  }

  @media (max-width: 900px) {
    .mode-row {
      grid-template-columns: 1fr;
    }

    .mode-captures {
      grid-template-columns: 1fr;
    }
  }
</style>
