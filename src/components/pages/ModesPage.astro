---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StageBadge from '../StageBadge.astro';
import ModeSchematic from '../ModeSchematic.astro';
import CaptureFigure from '../CaptureFigure.astro';
import { feature } from '../../data/features';
import { modes, type Motion, type BarDensity, type DesktopContent } from '../../data/modes';
import { localizePath, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEs = locale === 'es';
const L = (path: string) => localizePath(path, locale);
const ledger = feature('experience-modes');

const motionName: Record<Motion, { es: string; en: string }> = {
  reduced: { es: 'Reducido', en: 'Reduced' },
  standard: { es: 'Estándar', en: 'Standard' },
  full: { es: 'Completo', en: 'Full' },
  off: { es: 'Apagado', en: 'Off' },
};
const barName: Record<BarDensity, { es: string; en: string }> = {
  icons: { es: 'Solo íconos', en: 'Icons only' },
  values: { es: 'Valores', en: 'Values' },
  labelled: { es: 'Con etiquetas', en: 'Labelled' },
};
const desktopName: Record<DesktopContent, { es: string; en: string }> = {
  empty: { es: 'Vacío', en: 'Empty' },
  widgets: { es: 'Tus widgets', en: 'Your widgets' },
  deck: { es: 'Deck de instrumentos', en: 'Instrument deck' },
};
const docs = ledger.evidence[0].href;
---

<SiteLayout
  socialImage="/og/modes.png"
  socialImageAlt={isEs ? 'Los cinco modos de HorneroOS (Focus, Everyday, Signal, Gaming y Studio) listados como canales, con su estado en el registro del proyecto.' : 'The five HorneroOS modes (Focus, Everyday, Signal, Gaming and Studio) listed as channels, with their status in the project ledger.'}
  title={isEs ? 'Atmósferas: modos de experiencia | HorneroOS' : 'Atmospheres: experience modes | HorneroOS'}
  description={isEs ? 'Focus, Everyday, Signal, Gaming y Studio: cinco modos que cambian cómo se comporta el escritorio de HorneroOS sin tocar tu layout ni tu tema.' : 'Focus, Everyday, Signal, Gaming and Studio: five modes that change how the HorneroOS desktop behaves without touching your layout or theme.'}
>
  <section class="section modes-intro" aria-labelledby="modes-title">
    <p class="plate-id"><strong>{isEs ? 'Atmósferas' : 'Atmospheres'}</strong><span>{isEs ? 'Modos de experiencia' : 'Experience modes'}</span></p>
    <h1 id="modes-title">{isEs ? 'Un escritorio, cinco climas.' : 'One desktop, five atmospheres.'}</h1>
    <p class="lede">
      {isEs ? 'Un modo cambia cómo se comporta el escritorio ahora mismo: cuánto se mueve, qué tan densa es la barra, qué widgets hay y si las notificaciones te interrumpen. Nunca reemplaza tu layout ni tu tema.' : 'A mode changes how the desktop behaves right now: how much it moves, how dense the bar is, which widgets sit on the desktop and whether notifications interrupt you. It never replaces your layout or your theme.'}
    </p>
    <p class="modes-status">
      <StageBadge stage={ledger.stage} locale={locale} />
      <span>
        {isEs ? 'Los modos están en la rama main del shell desde noviembre de 2026. Las ISO Preview publicadas hasta ahora no los incluyen, y todavía no se validaron visualmente en una máquina virtual ni en un escritorio físico.' : 'Modes are on the shell’s main branch since November 2026. The Preview ISOs published so far do not include them, and they have not yet been validated visually in a virtual machine or on a physical desktop.'}
      </span>
    </p>
  </section>

  <section class="section" aria-labelledby="five-title">
    <h2 id="five-title">{isEs ? 'Los cinco modos' : 'The five modes'}</h2>
    <p class="section-copy">
      {isEs ? 'Cada esquema dibuja los campos del modo (movimiento, barra, escritorio) tal como los documenta el proyecto. Son dibujos, no capturas: las capturas reales de cada modo están pendientes.' : 'Each schematic draws the mode’s fields (motion, bar, desktop) as the project documents them. They are drawings, not screenshots: real captures of each mode are pending.'}
    </p>
    <ol class="mode-list" role="list">
      {
        modes.map((mode) => (
          <li class="mode-row" id={mode.id}>
            <div class="mode-copy">
              <p class="eyebrow"><b>{mode.channel}</b> · {isEs ? 'Layout preferido' : 'Preferred layout'}: {mode.layout}</p>
              <h3>{mode.name}</h3>
              <p class="mode-line">{mode.line[locale]}</p>
              <ul class="mode-points">
                {mode.behaviours.map((b) => <li>{b[locale]}</li>)}
              </ul>
              <dl class="mode-fields">
                <div><dt>{isEs ? 'Movimiento' : 'Motion'}</dt><dd>{motionName[mode.motion][locale]}</dd></div>
                <div><dt>{isEs ? 'Barra' : 'Bar'}</dt><dd>{barName[mode.bar][locale]}</dd></div>
                <div><dt>{isEs ? 'Escritorio' : 'Desktop'}</dt><dd>{desktopName[mode.desktop][locale]}</dd></div>
              </dl>
            </div>
            <ModeSchematic mode={mode} locale={locale} />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="compose-title">
    <h2 id="compose-title">{isEs ? 'Cómo se combinan' : 'How they compose'}</h2>
    <div class="table-scroll">
      <table>
        <caption class="sr-only">{isEs ? 'Cuatro elecciones independientes' : 'Four independent choices'}</caption>
        <thead>
          <tr><th scope="col">{isEs ? 'Elección' : 'Choice'}</th><th scope="col">{isEs ? 'Qué decide' : 'What it decides'}</th><th scope="col">{isEs ? 'Dónde se cambia' : 'Where you change it'}</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row"><a href={L('/editions')}>{isEs ? 'Edición' : 'Edition'}</a></th><td>{isEs ? 'Qué software y capacidades hay instalados' : 'Which software and capabilities are installed'}</td><td>{isEs ? 'La instalación' : 'Installation'}</td></tr>
          <tr><th scope="row">{isEs ? 'Modo de experiencia' : 'Experience mode'}</th><td>{isEs ? 'Cómo se comporta el sistema ahora' : 'How the system behaves right now'}</td><td>{isEs ? 'Ajustes → Experiencia, launcher, indicador de la barra' : 'Settings → Experience, launcher, bar indicator'}</td></tr>
          <tr><th scope="row"><a href={L('/layouts')}>Layout</a></th><td>{isEs ? 'Qué barras y rieles existen' : 'Which bars and rails exist'}</td><td>{isEs ? 'Selector de layouts' : 'Layout picker'}</td></tr>
          <tr><th scope="row"><a href={L('/themes')}>{isEs ? 'Tema' : 'Theme'}</a></th><td>{isEs ? 'Colores y fondo' : 'Colours and wallpaper'}</td><td>{isEs ? 'Apariencia' : 'Appearance'}</td></tr>
        </tbody>
      </table>
    </div>
    <p class="section-copy">
      {isEs ? 'Un modo solo activa capacidades que tu edición tiene instaladas: si falta una, el ajuste aparece como no disponible, nunca simulado. Cada modo nombra un layout preferido, pero cambiar de modo no reescribe tus barras salvo que actives “Aplicar el layout preferido al cambiar”. Dos reglas no se pueden anular: el brillo y las líneas de barrido siempre están apagados en Focus y Gaming, y Gaming nunca anima.' : 'A mode only switches on capabilities your edition has installed: a missing one shows as unavailable, never faked. Every mode names a preferred layout, but switching mode does not rewrite your bars unless you turn on “Apply preferred layout on switch”. Two guardrails cannot be overridden: glow and scanlines are always off in Focus and Gaming, and Gaming never animates.'}
    </p>
  </section>

  <section class="section" aria-labelledby="captures-title">
    <h2 id="captures-title">{isEs ? 'Capturas reales: pendientes' : 'Real captures: pending'}</h2>
    <p class="section-copy">
      {isEs ? 'Cuando QA publique capturas de cada modo en una máquina virtual o un escritorio real, reemplazan estos espacios. Hasta entonces, el sitio no dibuja un escritorio por ellas.' : 'When QA publishes captures of each mode from a virtual machine or a real desktop, they replace these slots. Until then the site does not draw a desktop in their place.'}
    </p>
    <div class="mode-captures">
      <CaptureFigure slot="mode-focus" locale={locale} />
      <CaptureFigure slot="mode-signal-deck" locale={locale} />
      <CaptureFigure slot="mode-gaming" locale={locale} />
    </div>
  </section>

  <section class="section modes-end">
    <p class="section-copy">
      {isEs ? 'Cada modo es un paquete de campos que podés inspeccionar y cambiar uno por uno.' : 'Each mode is a bundle of fields you can inspect and change one by one.'}
      <a class="text-link" href={docs}>{isEs ? 'Leé la documentación de los modos' : 'Read the modes documentation'} <span aria-hidden="true">↗</span></a>
      · <a class="text-link" href={L('/chromatic')}>Hornero Chromatic</a>
    </p>
  </section>
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .section-copy {
    max-width: 68ch;
    color: var(--ink-muted);
  }

  .modes-intro h1 {
    max-width: 16ch;
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .modes-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1rem;
    max-width: 70ch;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .mode-list {
    display: grid;
    gap: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .mode-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: 1.5rem clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }

  .mode-copy {
    display: grid;
    gap: 0.6rem;
  }

  .mode-copy h3 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: -0.03em;
  }

  .mode-line {
    color: var(--ink);
    font-size: var(--step-1);
  }

  .mode-points {
    display: grid;
    gap: 0.35rem;
    max-width: 60ch;
    padding-left: 1.1rem;
    color: var(--ink-muted);
  }

  .mode-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.8rem;
    margin: 0.4rem 0 0;
  }

  .mode-fields dt {
    color: var(--ink-muted);
    font: 500 0.66rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mode-fields dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .mode-captures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .mode-row {
      grid-template-columns: 1fr;
    }

    .mode-captures {
      grid-template-columns: 1fr;
    }
  }
</style>
