---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaptureFigure from '../CaptureFigure.astro';
import CaptureGallery from '../CaptureGallery.astro';
import AppLogo from '../../components/AppLogo.astro';
import MaturityMeter from '../../components/MaturityMeter.astro';
import { studioCatalogue, editions, pins, short } from '../../data/product';
import { localizePath, type Locale } from '../../i18n/ui';
import { messages } from '../../i18n/messages/studio';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const L = (path: string) => localizePath(path, locale);

const studio = editions.find((edition) => edition.id === 'studio');
if (!studio) throw new Error('Studio edition is missing from the pinned catalogue');

const appById = Object.fromEntries(studioCatalogue.applications.map((app) => [app.id, app]));
const appTitle = (id: string) => appById[id]?.title ?? id;
type StudioApp = (typeof studioCatalogue.applications)[number];
const statusTag = (app: StudioApp) => {
  if (app.availability === 'reference-only') return m.soloDeReferencia;
  if (app.licenseClass === 'proprietary') return m.propietarioAEleccion;
  if (app.experimental) return 'Experimental';
  if (app.licenseClass === 'open-source') return m.codigoAbierto;
  if (app.optional) return m.opcional;
  return m.catalogado;
};
type TagKind = 'reference' | 'proprietary' | 'experimental' | 'open' | 'optional' | 'catalogued';
const tagKind = (app: StudioApp): TagKind => {
  if (app.availability === 'reference-only') return 'reference';
  if (app.licenseClass === 'proprietary') return 'proprietary';
  if (app.experimental) return 'experimental';
  if (app.licenseClass === 'open-source') return 'open';
  if (app.optional) return 'optional';
  return 'catalogued';
};
// The hero lineup is editorial: the flagship tool of each creative field,
// always rendered from the generated catalogue, never hand-listed twice.
const heroLineup = ['ardour', 'obs-studio', 'blender', 'krita', 'godot']
  .map((id) => appById[id])
  .filter((app): app is StudioApp => Boolean(app));
const stats = m.stats(
  studioCatalogue.specializations.length,
  studioCatalogue.applications.length,
  studioCatalogue.audioModes.length,
);
---

<SiteLayout
  title={m.studioHaceAlgoRealHorneroos}
  socialImage="/og/studio.png"
  socialImageAlt={m.lasAplicacionesInsigniaDeHorneroos}
  description={m.horneroosStudioEsUnaEdicion}
>
  <section class="section intro">
    <p class="plate-id">
      <strong>CH 02</strong>
      <span>{m.edicionStudio}</span>
      <span>{m.estacionDeTrabajoCreativa}</span>
    </p>
    <div class="hero-head">
      <h1>
        Studio <span class="tagline">{m.haceAlgoReal}</span>
      </h1>
      <MaturityMeter maturity={studio.maturity} locale={locale} />
    </div>
    <p class="lede">{m.horneroosStudioEsUnaEdicion2}</p>

    <div class="lineup" aria-label={m.aplicacionesInsigniaDeStudio}>
      {heroLineup.map((app) => (
        <span class="lineup-item">
          <AppLogo id={app.id} name={app.title} />
          <span>{app.title}</span>
        </span>
      ))}
    </div>

    <p class="hero-ctas">
      <a class="cta primary" href={L('/install')}>
        {m.descargaLaIsoActual}
      </a>
      <a class="cta secondary" href="#apps-title">
        {m.verAplicaciones}
      </a>
    </p>
    <nav class="section-nav" aria-label={m.seccionesDeStudio}>
      <a href="#workloads-title">{m.especializaciones}</a>
      <a href="#apps-title">{m.aplicaciones}</a>
      <a href="#audio-title">{m.audioYRendimiento}</a>
      <a href="#today-title">{m.estado}</a>
    </nav>

    <dl class="stats">
      {stats.map((stat) => (
        <div>
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))}
    </dl>

    <p class="availability" role="note">
      <strong>{m.studioYaEstaDisponiblePara}</strong> {m.seInstalaDesdeLaMisma}
      <code>horneroctl studio doctor</code>
      {m.chequeaTuStackCreativoCuando}
      <a href={L('/install')}>{m.instalar}</a>
      {m.paraDescargarlaLimitacionConcretaLa}
    </p>
  </section>

  <section class="section" aria-label={m.unaSesionReal}>
    <CaptureFigure slot="CAP-MODE-05" locale={locale} />
  </section>

  <section class="section" aria-labelledby="workloads-title">
    <h2 id="workloads-title">{m.especializaciones}</h2>
    <p class="section-copy">
      {m.lasEspecializacionesYLasAplicaciones}
      <code>horneroctl studio selection</code>
      {m.yElCentroDeControl}
    </p>
    <ol class="tracks" role="list">
      {studioCatalogue.specializations.map((spec, index) => (
        <li class="track">
          <h3>
            <span class="track-index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            {spec.title}
          </h3>
          {spec.applications.length > 0 ? (
            <ul class="chips" role="list">
              {spec.applications.map((id) => (
                <li class="chip">
                  <AppLogo id={id} name={appTitle(id)} />
                  <span>{appTitle(id)}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">{m.empezaVacioYAgregaAplicaciones}</p>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="apps-title">
    <h2 id="apps-title">{m.aplicacionesFuentesYLicencias}</h2>
    <p class="section-copy">{m.esteCatalogoSeGeneraDesde(short(pins.hornero.sha))}</p>
    <ul class="app-grid" role="list">
      {studioCatalogue.applications.map((app) => (
        <li class="app-tile">
          <div class="app-head">
            <AppLogo id={app.id} name={app.title} />
            <h3>{app.title}</h3>
            <span class:list={['tag', `tag-${tagKind(app)}`]}>{statusTag(app)}</span>
          </div>
          <dl class="app-meta">
            <div>
              <dt>{m.paquetes}</dt>
              <dd>{app.packages.length > 0 ? app.packages.join(', ') : '—'}</dd>
            </div>
            <div>
              <dt>{m.fuente}</dt>
              <dd>{app.source ?? '—'}</dd>
            </div>
            <div>
              <dt>{m.licencia}</dt>
              <dd>{app.licenses.length > 0 ? app.licenses.join(', ') : m.verElPaquete}</dd>
            </div>
          </dl>
          {app.notes ? <p class="note">{app.notes}</p> : null}
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="audio-title">
    <h2 id="audio-title">{m.modosDeAudioYRendimiento}</h2>
    <p class="section-copy">{m.losModosDeAudioDe}</p>
    <ul class="modes" role="list">
      {studioCatalogue.audioModes.map((mode) => (
        <li class="mode">
          <strong>{mode.title}</strong>
          <span>{mode.isDefault ? m.predeterminadoTasaYQuantumDel : m.optInExplicitoReversible}</span>
          <span class="tag">{mode.isDefault ? m.predeterminado : m.aEleccion}</span>
        </li>
      ))}
      {studioCatalogue.performanceMode && (
        <li class="mode">
          <strong>{studioCatalogue.performanceMode.title}</strong>
          <span>{m.optInExplicitoViaPower}</span>
          <span class="tag">{m.aEleccion}</span>
        </li>
      )}
    </ul>
  </section>

  <section class="section" aria-labelledby="today-title">
    <h2 id="today-title">{m.estado}</h2>
    <div class="status-grid">
      <article>
        <h3>{m.enLosRepositorios}</h3>
        <ul>
          <li>{m.catalogoCanonicoDeEdicionesResolver}</li>
          <li>
            <code>horneroctl studio</code> {m.contratosDeSeleccionModoTrabajos}
          </li>
          <li>{m.panelStudioDelCentroDe}</li>
          <li>{m.politicasDePipewirePresetsY}</li>
        </ul>
        <p>
          <a href={L('/docs/applications/studio/')}>{m.documentacionDeStudio}</a> ·{' '}
          <a href={L('/docs/applications/studio-audio/')}>{m.configuracionYRecuperacionDeAudio}</a> ·{' '}
          <a href={L('/docs/applications/studio-getting-started/')}>{m.guiaDeInicio}</a> ·{' '}
          <a href={L('/docs/applications/studio-live-routing/')}>{m.ruteoDeAudioEnVivo}</a>
        </p>
      </article>
      <article>
        <h3>{m.todaviaNoDisponible}</h3>
        <ul>
          <li>{m.validacionDeHardwareLasInterfaces}</li>
          <li>{m.cualquierAfirmacionDeCertificacionDe}</li>
        </ul>
        <p>
          <a href="https://github.com/HorneroOS/hornero/issues/283">{m.seguiLaHojaDeRuta}</a>
        </p>
      </article>
    </div>
  </section>

  <CaptureGallery route="/studio" locale={locale} exclude={['CAP-MODE-05']} />
</SiteLayout>

<style>
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }
  .section-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 1rem;
    font-family: var(--font-mono, monospace);
    font-size: var(--step--1);
  }
  .track-index {
    display: block;
    color: var(--signal);
    font-family: var(--font-mono, monospace);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
  }
  .tag-proprietary {
    border-color: var(--signal);
    color: var(--signal);
  }
  .tag-reference {
    border-style: dashed;
  }
  .tag-experimental {
    border-color: var(--cue);
    color: var(--cue);
  }
  .app-tile {
    border-top: 3px solid var(--rule);
  }
  .app-tile:has(.tag-proprietary) {
    border-top-color: var(--signal);
  }
  .app-tile:has(.tag-reference) {
    border-top-style: dashed;
  }
  .lede {
    max-width: 54ch;
    font-size: var(--step-1);
  }
  .lineup {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.6rem;
    margin-top: 1.8rem;
    padding-block: 1rem;
    border-block: 1px solid var(--rule);
  }
  .lineup-item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    --app-logo-size: 2rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.4rem 0 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.15rem;
  }
  .stats dt {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-mono, monospace);
    font-size: var(--step-2, 1.6rem);
    font-weight: 700;
    color: var(--signal);
  }
  .availability {
    max-width: 66ch;
    margin-top: 1.6rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--phosphor);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .availability strong {
    color: var(--ink);
  }
  .section-copy {
    max-width: 66ch;
    color: var(--ink-muted);
  }
  .tracks {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .track {
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) 1fr;
    gap: 0.5rem 1.5rem;
    align-items: start;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .track:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .track h3 {
    margin: 0;
    font-size: var(--step-0);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-muted);
    --app-logo-size: 1.35rem;
  }
  .muted {
    margin: 0;
    color: var(--ink-muted);
  }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.9rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .app-tile {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .app-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.7rem;
    --app-logo-size: 2.6rem;
  }
  .app-head h3 {
    margin: 0;
    font-size: var(--step-0);
    flex: 1 1 8rem;
    min-width: 0;
  }
  .tag {
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--phosphor);
    border-radius: var(--radius-small);
    color: var(--phosphor);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .app-meta {
    display: grid;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    font-size: var(--step--1);
  }
  .app-meta div {
    display: grid;
    grid-template-columns: 5.2rem 1fr;
    gap: 0.5rem;
  }
  .app-meta dt {
    color: var(--ink-muted);
  }
  .app-meta dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .note {
    margin: 0.7rem 0 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .modes {
    display: grid;
    gap: 0.6rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .mode {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .mode span:not(.tag) {
    color: var(--ink-muted);
    flex: 1;
  }
  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0.9rem;
    margin-top: 1.2rem;
  }
  .status-grid article {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .status-grid h3 {
    margin-top: 0;
  }
  .status-grid ul {
    padding-left: 1.1rem;
    color: var(--ink-muted);
  }
  @media (max-width: 40rem) {
    .track {
      grid-template-columns: 1fr;
    }
  }
</style>
