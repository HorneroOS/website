---
/**
 * Honest label for showcase imagery. A slot without a host capture says so;
 * a filled slot says what kind of real capture it is. Nothing on the site is
 * a render, a mock-up or an older appearance (docs/CAPTURES.md).
 */
import type { Locale } from '../i18n/ui';
import { messages } from '../i18n/messages/capture-label';

interface Props {
  state: 'captured';
  kind?: 'screenshot' | 'clip' | 'photo';
  locale?: Locale;
}

const { state, kind = 'screenshot', locale = 'es' } = Astro.props;
const m = messages[locale];
const text =
  kind === 'photo' ? m.fotografiaReal : kind === 'clip' ? m.clipRealHorneroSignal : m.capturaRealHorneroSignal;
---

<span class="capture-label" data-state={state}>
  {text}
</span>
