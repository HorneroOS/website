---
/**
 * Honest label for product imagery. Captures taken before Hornero Signal
 * shipped say so until QA replaces them (docs/CAPTURES.md); Signal captures
 * get a "real capture" label; concept renders always say they are concepts.
 * Anything not explicitly a Signal capture is labelled as pre-Signal.
 */
import type { Locale } from '../i18n/ui';

interface Props {
  appearance: 'signal' | 'pre-signal' | 'concept';
  locale?: Locale;
}

const { appearance, locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const kind = appearance === 'signal' || appearance === 'concept' ? appearance : 'pre-signal';
const text = {
  signal: isEs ? 'Captura real · Hornero Signal' : 'Real capture · Hornero Signal',
  'pre-signal': isEs ? 'Preview — apariencia anterior' : 'Preview — previous appearance',
  concept: isEs ? 'Render conceptual — no es una captura' : 'Concept render — not a screenshot',
}[kind];
---

<span class="capture-label" data-appearance={kind}>{text}</span>
