---
/**
 * Honest appearance label for a real capture. Captures taken before Hornero
 * Signal shipped say so until QA replaces them (docs/CAPTURES.md); Signal
 * captures get a plain "real capture" label.
 */
import type { Locale } from '../i18n/ui';

interface Props {
  appearance: 'signal' | 'pre-signal';
  locale?: Locale;
}

const { appearance, locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const text =
  appearance === 'pre-signal'
    ? isEs
      ? 'Preview — apariencia anterior'
      : 'Preview — previous appearance'
    : isEs
      ? 'Captura real · Hornero Signal'
      : 'Real capture · Hornero Signal';
---

<span class="capture-label" data-appearance={appearance}>{text}</span>
