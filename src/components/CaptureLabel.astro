---
/**
 * Honest label for showcase imagery. A slot without a host capture says so;
 * a filled slot says what kind of real capture it is. Nothing on the site is
 * a render, a mock-up or an older appearance (docs/CAPTURES.md).
 */
import type { Locale } from '../i18n/ui';

interface Props {
  state: 'pending' | 'captured';
  kind?: 'screenshot' | 'clip' | 'photo';
  locale?: Locale;
}

const { state, kind = 'screenshot', locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const text =
  state === 'pending'
    ? isEs
      ? 'Pendiente — captura del host'
      : 'Pending — host capture'
    : kind === 'photo'
      ? isEs
        ? 'Fotografía real'
        : 'Real photograph'
      : kind === 'clip'
        ? isEs
          ? 'Clip real · Hornero Signal'
          : 'Real clip · Hornero Signal'
        : isEs
          ? 'Captura real · Hornero Signal'
          : 'Real capture · Hornero Signal';
---

<span class="capture-label" data-state={state}>{text}</span>
