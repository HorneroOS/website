---
/**
 * The same layout in Signal Night and Signal Day. Until both captures exist
 * the two pending plates sit side by side; once both slots are `captured` a
 * native range input wipes between the two real images.
 *
 * The wipe moves only the images. One caption sits under the pair, so the two
 * layers never put their own captions on top of each other while dragging.
 */
import CaptureFigure from './CaptureFigure.astro';
import CaptureLabel from './CaptureLabel.astro';
import { editorialCaption, getSlot } from '../data/captures';
import type { Locale } from '../i18n/ui';
import { messages } from '../i18n/messages/look-compare';

interface Props {
  dark: string;
  light: string;
  locale?: Locale;
  /** Caption shown once under the pair; defaults to the dark slot's caption. */
  caption?: string;
}

const { dark, light, locale = 'es', caption } = Astro.props;
const m = messages[locale];
const bothCaptured = getSlot(dark).status === 'captured' && getSlot(light).status === 'captured';
const captionText = caption ?? editorialCaption(dark, locale) ?? getSlot(dark).title[locale];
---

<figure class="look-compare" data-look-compare data-ready={bothCaptured ? 'true' : 'false'}>
  <div class="look-stage">
    <div class="look look-dark">
      <CaptureFigure slot={dark} locale={locale} showCaption={false} />
    </div>
    <div class="look look-light">
      <CaptureFigure slot={light} locale={locale} showCaption={false} />
    </div>
    <span class="look-divider" aria-hidden="true"></span>
    <label class="look-range" hidden>
      <span class="visually-hidden">{m.revelaSignalDaySobreSignal}</span>
      <input type="range" min="0" max="100" value="50" step="1" />
    </label>
  </div>
  <figcaption class="look-caption">
    <CaptureLabel state="captured" locale={locale} />
    <span class="look-caption-text">{captionText}</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-look-compare][data-ready="true"]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('input[type="range"]');
    const label = root.querySelector<HTMLElement>('.look-range');
    if (!range || !label) return;
    label.hidden = false;
    root.classList.add('is-live');
    const apply = () => root.style.setProperty('--reveal', `${range.value}%`);
    range.addEventListener('input', apply);
    apply();
  });
</script>

<style>
  .look-compare {
    display: grid;
    gap: 0.6rem;
    max-width: min(100%, 72rem);
    margin: 0 auto;
  }
  .look-stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .look {
    position: relative;
    min-width: 0;
  }

  .look-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.8rem;
    color: var(--ink-muted);
    font: 500 0.7rem/1.4 var(--font-mono);
    letter-spacing: 0.05em;
  }
  .look-caption-text {
    color: var(--ink);
  }

  /* Live: stack the captures and wipe the light one in from the right. */
  .look-compare.is-live {
    --reveal: 50%;
  }
  .is-live .look-stage {
    display: block;
  }
  .is-live .look-light {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--reveal));
  }
  .is-live .look-divider {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: var(--reveal);
    width: 2px;
    background: var(--signal);
    pointer-events: none;
  }
  .is-live .look-range {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
  }
  .is-live .look-range input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .is-live .look-range:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .look-compare:not(.is-live) .look-stage {
      grid-template-columns: 1fr;
    }
  }
</style>
