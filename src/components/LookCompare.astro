---
/**
 * The same Hornero Left layout, captured in Hornero Dark and Hornero Light from
 * the same QA image and the same pinned revisions. Without JavaScript the two
 * captures sit side by side; with it, a native range input wipes between them.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  dark: CollectionEntry<'showroom'>;
  light: CollectionEntry<'showroom'>;
}

const { dark, light } = Astro.props;
const sizes = '(min-width: 1100px) 1100px, calc(100vw - 2rem)';
---

<div class="look-compare" data-look-compare>
  <figure class="look look-dark">
    <Picture
      src={dark.data.image}
      alt={dark.data.alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
    <figcaption>Hornero Dark</figcaption>
  </figure>
  <figure class="look look-light">
    <Picture
      src={light.data.image}
      alt={light.data.alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
    <figcaption>Hornero Light</figcaption>
  </figure>
  <label class="look-range" hidden>
    <span class="visually-hidden">Reveal Hornero Light over Hornero Dark</span>
    <input type="range" min="0" max="100" value="50" step="1" />
  </label>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-look-compare]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('input[type="range"]');
    const label = root.querySelector<HTMLElement>('.look-range');
    if (!range || !label) return;
    label.hidden = false;
    root.classList.add('is-live');
    const apply = () => root.style.setProperty('--reveal', `${range.value}%`);
    range.addEventListener('input', apply);
    apply();
  });
</script>

<style>
  .look-compare { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .look { position: relative; margin: 0; min-width: 0; }
  .look :global(img) { width: 100%; height: auto; aspect-ratio: 8 / 5; border: 1px solid var(--line); background: var(--surface); }
  .look figcaption { position: absolute; bottom: 0.7rem; padding: 0.3rem 0.6rem; background: color-mix(in srgb, #05080f 78%, transparent); color: #fff; font: 600 0.72rem var(--font-data); font-stretch: 87.5%; }
  .look-dark figcaption { left: 0.7rem; }
  .look-light figcaption { right: 0.7rem; background: color-mix(in srgb, #fff 86%, transparent); color: #212121; }

  /* Live: stack the captures and wipe the light one in from the right. */
  .look-compare.is-live { display: block; --reveal: 50%; max-width: min(100%, 72rem); margin-inline: auto; }
  .is-live .look-light { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--reveal)); }
  .is-live .look-light figcaption { right: 0.7rem; }
  .is-live::after { position: absolute; top: 0; bottom: 0; left: var(--reveal); width: 2px; background: var(--accent); content: ''; pointer-events: none; }
  .look-range { position: absolute; inset: 0; z-index: 2; display: block; }
  .look-range input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .look-range:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 640px) { .look-compare:not(.is-live) { grid-template-columns: 1fr; } }
</style>
