---
/**
 * The same layout in Signal Night and Signal Day. Until both captures exist
 * the two pending plates sit side by side; once both slots are `captured` a
 * native range input wipes between the two real images.
 */
import CaptureFigure from './CaptureFigure.astro';
import { getSlot } from '../data/captures';
import type { Locale } from '../i18n/ui';

interface Props {
  dark: string;
  light: string;
  locale?: Locale;
}

const { dark, light, locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const bothCaptured = getSlot(dark).status === 'captured' && getSlot(light).status === 'captured';
---

<div class="look-compare" data-look-compare data-ready={bothCaptured ? 'true' : 'false'}>
  <div class="look look-dark">
    <CaptureFigure slot={dark} locale={locale} />
  </div>
  <div class="look look-light">
    <CaptureFigure slot={light} locale={locale} />
  </div>
  <label class="look-range" hidden>
    <span class="visually-hidden">{isEs ? 'Revelá Signal Day sobre Signal Night' : 'Reveal Signal Day over Signal Night'}</span>
    <input type="range" min="0" max="100" value="50" step="1" />
  </label>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-look-compare][data-ready="true"]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('input[type="range"]');
    const label = root.querySelector<HTMLElement>('.look-range');
    if (!range || !label) return;
    label.hidden = false;
    root.classList.add('is-live');
    const apply = () => root.style.setProperty('--reveal', `${range.value}%`);
    range.addEventListener('input', apply);
    apply();
  });
</script>

<style>
  .look-compare { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .look { position: relative; min-width: 0; }

  /* Live: stack the captures and wipe the light one in from the right. */
  .look-compare.is-live { display: block; --reveal: 50%; max-width: min(100%, 72rem); margin-inline: auto; }
  .is-live .look-light { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--reveal)); }
  .is-live::after { position: absolute; top: 0; bottom: 0; left: var(--reveal); width: 2px; background: var(--signal); content: ''; pointer-events: none; }
  .is-live .look-range { position: absolute; inset: 0; z-index: 2; display: block; }
  .is-live .look-range input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .is-live .look-range:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 640px) { .look-compare:not(.is-live) { grid-template-columns: 1fr; } }
</style>
