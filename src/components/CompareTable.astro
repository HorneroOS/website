---
// Comparison table with a native radio-group filter. Radios are keyboard
// and touch operable by default; without JavaScript every row stays
// visible, and the script only hides rows outside the chosen category.
import { compareRows, compareVerifiedOn, type CompareCategory } from '../data/why';
import type { Locale } from '../i18n/ui';
import { messages } from '../i18n/messages/compare-table';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const categoryLabel: Record<CompareCategory, string> = m.categoryLabel;
const filters = [
  { value: 'all', label: m.todo },
  { value: 'os', label: categoryLabel.os },
  { value: 'shell', label: categoryLabel.shell },
];
---

<div class="compare" data-compare>
  <fieldset class="compare-filter">
    <legend>{m.mostrarPorTipo}</legend>
    {filters.map((filter, index) => (
      <label>
        <input type="radio" name="compare-type" value={filter.value} checked={index === 0} data-compare-filter />
        <span>{filter.label}</span>
      </label>
    ))}
  </fieldset>
  <div class="table-scroll">
    <table>
      <caption>{m.sistemasOperativosYShellsVerificados(compareVerifiedOn)}</caption>
      <thead>
        <tr>
          <th scope="col">{m.proyecto}</th>
          <th scope="col">{m.tipo}</th>
          <th scope="col">{m.queEs}</th>
          <th scope="col">{m.instalacion}</th>
          <th scope="col">{m.relacionConHorneroos}</th>
        </tr>
      </thead>
      <tbody>
        {compareRows.map((row) => (
          <tr data-category={row.category}>
            <th scope="row">
              <a href={row.href}>{row.name}</a>
              <span class="compare-version">{typeof row.version === 'string' ? row.version : row.version[locale]}</span>
            </th>
            <td>{categoryLabel[row.category]}</td>
            <td>{row.what[locale]}</td>
            <td>{row.install[locale]}</td>
            <td>{row.note[locale]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="compare-note">{m.unaShellNoEsUn}</p>
</div>

<script is:inline>
  document.querySelectorAll('[data-compare]').forEach((block) => {
    const rows = [...block.querySelectorAll('tbody tr')];
    block.querySelectorAll('[data-compare-filter]').forEach((radio) => {
      radio.addEventListener('change', () => {
        rows.forEach((row) => {
          row.hidden = radio.value !== 'all' && row.dataset.category !== radio.value;
        });
      });
    });
  });
</script>

<style>
  .compare-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    margin: 0 0 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule);
  }

  .compare-filter legend {
    padding: 0 0.4rem;
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .compare-filter label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    cursor: pointer;
  }

  .compare-filter input:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .compare-version {
    display: block;
    color: var(--ink-muted);
    font: 500 0.72rem var(--font-mono);
  }

  .compare-note {
    max-width: 68ch;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
</style>
