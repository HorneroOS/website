---
/**
 * Source-backed project timeline. `rail` is the compact, scrollable homepage
 * strip; `ledger` is the full, vertical version on /roots. A dashed rule marks
 * the one stage git cannot confirm (the maintainer's account); every other
 * stage links to the commit or tag that dates it.
 */
import type { StoryEntry } from '../data/story';

import type { Locale } from '../i18n/ui';

interface Props {
  entries: StoryEntry[];
  variant?: 'rail' | 'ledger';
  label: string;
  locale?: Locale;
}

const { entries, variant = 'rail', label, locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const display = (date: string) => (/^\d{4}$/.test(date) ? date : date.replaceAll('-', '.'));
---

<div class:list={['story', `story-${variant}`]} role="region" aria-label={label} tabindex={variant === 'rail' ? 0 : undefined}>
  <ol>
    {
      entries.map((entry) => (
        <li class:list={[`evidence-${entry.evidence}`]} id={variant === 'ledger' ? `story-${entry.id}` : undefined}>
          <time datetime={entry.date}>{display(entry.date)}</time>
          <h3>{entry.title}</h3>
          <p>{entry.summary}</p>
          {entry.source ? (
            <a href={entry.source.href}>{entry.source.label} <span aria-hidden="true">↗</span></a>
          ) : (
            <span class="evidence-note">{isEs ? 'Relato del maintainer · ningún commit público es anterior a 2019' : 'Maintainer’s account · no public commit predates 2019'}</span>
          )}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .story ol { display: grid; margin: 0; padding: 0; list-style: none; }
  .story li { position: relative; display: grid; align-content: start; gap: 0.45rem; min-width: 0; }
  .story time { color: var(--accent); font: 600 0.8rem var(--font-data); font-stretch: 87.5%; letter-spacing: 0.04em; }
  .story h3 { font-size: 1.1rem; line-height: 1.2; }
  .story p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.55; }
  .story li > a { width: fit-content; color: var(--text); font-size: 0.82rem; text-decoration-color: var(--accent); }
  .story li > a:hover { color: var(--accent); }
  .evidence-note { color: var(--text-muted); font: 0.7rem var(--font-data); font-stretch: 87.5%; }

  /* Rail: a horizontal strip that scrolls on narrow screens. */
  .story-rail { overflow-x: auto; padding-bottom: 1rem; scroll-snap-type: x proximity; scrollbar-color: var(--line) transparent; }
  .story-rail ol { grid-auto-flow: column; grid-auto-columns: 16.5rem; gap: 0; width: max-content; }
  .story-rail li { padding: 1.6rem 1.4rem 0 0; scroll-snap-align: start; }
  /* The node and the line to the next stage; dashed when git cannot confirm it. */
  .story-rail li::before { position: absolute; top: 0; left: 0; right: 0; border-top: 2px solid var(--highlight); content: ''; }
  .story-rail li.evidence-maintainer::before { border-top-style: dashed; border-top-color: var(--secondary); }
  .story-rail li::after { position: absolute; top: -0.32rem; left: 0; width: 0.62rem; height: 0.62rem; background: var(--accent); content: ''; transform: rotate(45deg); }
  .story-rail li.evidence-maintainer::after { background: var(--bg); border: 2px solid var(--secondary); }

  /* Ledger: dated rows with the source on the right. */
  .story-ledger ol { border-top: 1px solid var(--line); }
  .story-ledger li { grid-template-columns: 8.5rem minmax(0, 1fr); column-gap: clamp(1rem, 3vw, 2.5rem); padding-block: 1.4rem; border-bottom: 1px solid var(--line); }
  .story-ledger li.evidence-maintainer { border-bottom-style: dashed; }
  .story-ledger time { grid-row: 1 / span 3; padding-top: 0.2rem; }
  .story-ledger h3, .story-ledger p, .story-ledger li > a, .story-ledger .evidence-note { grid-column: 2; max-width: 62ch; }
  .story-ledger h3 { font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem); }
  @media (max-width: 560px) {
    .story-ledger li { grid-template-columns: 1fr; }
    .story-ledger time { grid-row: auto; }
    .story-ledger h3, .story-ledger p, .story-ledger li > a, .story-ledger .evidence-note { grid-column: 1; }
  }
</style>
