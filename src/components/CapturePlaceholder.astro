---
/**
 * Honest stand-in for a capture slot that has no authentic image yet. It is a
 * labelled schematic, never a drawn desktop: it names the slot and the brief
 * QA is working from. Slots are declared in src/data/captures.ts.
 */
import { captureSlots, type CaptureSlotId } from '../data/captures';
import type { Locale } from '../i18n/ui';

interface Props {
  slot: CaptureSlotId;
  locale?: Locale;
}

const { slot, locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const brief = captureSlots[slot].wanted;
---

<figure class="capture-placeholder" data-slot={slot}>
  <div class="capture-placeholder-frame" role="img" aria-label={isEs ? `Espacio reservado para una captura real: ${slot}` : `Placeholder for a real capture: ${slot}`}>
    <svg viewBox="0 0 160 90" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
      <rect x="1" y="1" width="158" height="88" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 2" />
      <path d="M1 1 159 89M159 1 1 89" stroke="currentColor" stroke-width="0.25" opacity="0.5" />
    </svg>
    <p class="capture-placeholder-title">{isEs ? 'Captura real pendiente' : 'Real capture pending'}</p>
  </div>
  <figcaption>
    <span class="capture-label" data-appearance="placeholder">{isEs ? 'Espacio reservado — no es una captura' : 'Placeholder — not a screenshot'}</span>
    <span class="capture-placeholder-slot"><code>{slot}</code></span>
    <span class="capture-placeholder-brief">{brief}</span>
  </figcaption>
</figure>
