---
/**
 * Where a ledger feature can be had today, in one sentence derived from the
 * feature stage and src/data/download.json. Pages never type "on main" or
 * "released" themselves.
 */
import type { Feature } from '../data/features';
import { download, packageRelease } from '../data/download';
import { localizePath, type Locale } from '../i18n/ui';
import { messages } from '../i18n/messages/release-channel-note';

interface Props {
  feature: Feature;
  locale: Locale;
  /** The package that carries the feature (default hornero-shell). */
  pkg?: string;
}
const { feature, locale, pkg = 'hornero-shell' } = Astro.props;
const m = messages[locale];
const carried = packageRelease?.packages.find((p) => p.name === pkg);
const install = localizePath('/install', locale);
---

{feature.stage === 'packaged' && packageRelease && (
  <span>
    {m.lanzadoComoPaquetesEnLa(packageRelease.version, carried ? ` (${pkg} ${carried.version})` : '', download.version)}{' '}
    <a href={`${install}#update`}>{m.comoActualizar}</a>
  </span>
)}
{feature.stage === 'released' && <span>{m.incluidoEnLaIsoActual(download.version)}</span>}
{feature.stage === 'unreleased' && <span>{m.estaEnLaRamaMain}</span>}
{feature.stage === 'experimental' && <span>{m.experimentalPuedeCambiarODesaparecer}</span>}
{feature.stage === 'planned' && <span>{m.planificadoTodaviaNoExiste}</span>}
