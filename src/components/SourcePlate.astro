---
/** Names the pinned commit a data-driven page was generated from. */
import { pins, short } from '../data/product';

interface Props {
  source: 'shell' | 'config' | 'hornero';
  path: string;
  locale?: 'es' | 'en';
}

const { source, path, locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const pin = pins[source];
---

<p class="source">
  {isEs ? 'Los datos de esta lista se generan desde' : 'The data in this list is generated from'}{' '}
  <a href={`${pin.repo}/tree/${pin.sha}/${path}`}>
    <code>
      HorneroOS/{source}/{path}
    </code>
  </a>{' '}
  {isEs ? 'en el commit' : 'at commit'}{' '}
  <a href={`${pin.repo}/commit/${pin.sha}`}>
    <code>{short(pin.sha)}</code>
  </a>
  . {isEs ? 'Nada de esta lista está escrito a mano.' : 'Nothing in this list is typed by hand.'}
</p>

<style>
  .source {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
