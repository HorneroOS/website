---
interface Props {
  title: string;
  description?: string;
  /** Exclude the page from search results (and omit its canonical URL). */
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  /** Optional schema.org JSON-LD object for this page. */
  structuredData?: Record<string, unknown>;
}

import condensedWoff2 from '@fontsource/ibm-plex-sans-condensed/files/ibm-plex-sans-condensed-latin-700-normal.woff2';
import sansWoff2 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2';
import monoWoff2 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2';

import { delocalizePath, localizePath, localeFromPath } from '../i18n/ui';

const { title, description, noindex = false, socialImage, socialImageAlt, structuredData } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const locale = localeFromPath(Astro.url.pathname);
const basePath = delocalizePath(Astro.url.pathname);
const altEs = new URL(localizePath(basePath, 'es'), site);
const altEn = new URL(localizePath(basePath, 'en'), site);

// Social previews are a first impression, so every page gets a designed
// 1200x630 card (scripts/build-og.mjs) built from real captures. A page can pass
// its own card from /og/. The licensed Buenos Aires photographs stay in the
// greeter and wallpaper galleries, where their credits live next to them.
const defaultAlt =
  'HorneroOS live desktop hero capture: Signal Night Hyprland and Quickshell workspace with the pixel-art hornero terminal, telemetry bar, and Argentine retrofuturistic styling.';
const socialUrlValue = new URL(socialImage ?? '/og/default.png', site).toString();
const socialAltValue = socialImageAlt ?? defaultAlt;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Preload the three Hornero Signal faces that paint first: Plex Sans Condensed (headings), Plex Sans (body) and Plex Mono (eyebrows, readouts). -->
<link rel="preload" href={condensedWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin />
<!-- Favicon: HorneroOS/config@5df8300 assets/brand/favicon.svg (MIT) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
{
  !noindex && basePath !== '/404' && (
    <>
      <link rel="alternate" hreflang="es" href={altEs} />
      <link rel="alternate" hreflang="en" href={altEn} />
      <link rel="alternate" hreflang="x-default" href={altEn} />
    </>
  )
}
<meta name="theme-color" content="#141b24" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#eef2f7" media="(prefers-color-scheme: light)" />
<script is:inline>
  (() => {
    // Resolve preferred locale without cookies or loops:
    // 1. An explicit choice saved in localStorage always wins.
    // 2. On a first visit to a non-/en/ URL in a human browser whose language
    //    list prefers English ahead of Spanish, route once to /en/.
    try {
      const path = location.pathname;
      const inEn = path === '/en' || path.startsWith('/en/');
      const current = inEn ? 'en' : 'es';
      const saved = localStorage.getItem('hornero-lang');
      let preferred = saved === 'es' || saved === 'en' ? saved : null;
      if (!preferred && !inEn && !navigator.webdriver) {
        const langs =
          Array.isArray(navigator.languages) && navigator.languages.length
            ? navigator.languages
            : navigator.language
              ? [navigator.language]
              : [];
        for (const lang of langs) {
          const code = String(lang).toLowerCase().split('-')[0];
          if (code === 'es' || code === 'en') {
            preferred = code;
            break;
          }
        }
      }
      if (!preferred || preferred === current) return;
      const base = inEn ? (path === '/en' ? '/' : path.slice(3)) : path;
      const target = preferred === 'en' ? (base === '/' ? '/en/' : `/en${base}`) : base;
      if (target === path) return;
      location.replace(target + location.search + location.hash);
    } catch {
      // Storage or navigator unavailable; the URL locale stands.
    }
  })();
</script>
<script is:inline>
  (() => {
    const key = 'hornero-color-mode';
    const valid = ['system', 'light', 'dark'];
    // Follow the visitor's system appearance (Signal Night or Signal Day) unless
    // they picked one explicitly with the colour-mode switch.
    let preference = 'system';
    try {
      const saved = localStorage.getItem(key);
      if (valid.includes(saved)) preference = saved;
    } catch {
      // Storage can be disabled; follow the system appearance.
    }

    const mode =
      preference === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : preference;
    document.documentElement.dataset.colorPreference = preference;
    document.documentElement.dataset.colorMode = mode;
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
      meta.content = mode === 'light' ? '#eef2f7' : '#141b24';
    });

    // CRT / phosphor mode: defaults to 'on' unless reduced motion is requested
    // or the visitor turned it off explicitly.
    let crt = 'on';
    try {
      const savedCrt = localStorage.getItem('hornero-crt');
      if (savedCrt === 'on' || savedCrt === 'off') crt = savedCrt;
    } catch {
      // Storage unavailable; keep default.
    }
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) crt = 'off';
    document.documentElement.dataset.crt = crt;
  })();
</script>
<title>{title}</title>
{description && <meta name="description" content={description} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="HorneroOS" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialUrlValue} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={socialAltValue} />
<meta property="og:locale" content={locale === 'es' ? 'es_AR' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_AR'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialUrlValue} />
<meta name="twitter:image:alt" content={socialAltValue} />
{structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
