---
import { getImage } from 'astro:assets';
import socialSource from '../../assets/screenshots/certified/hornero-light.png';

interface Props {
  title: string;
  description?: string;
  /** Exclude the page from search results (and omit its canonical URL). */
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
}

const { title, description, noindex = false, socialImage, socialImageAlt } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);

// Social preview: a QA-captured Hornero Light desktop, re-encoded at build time.
const social = await getImage({ src: socialSource, width: 1200, format: 'jpg', quality: 80 });
const socialUrl = new URL(social.src, site);
const socialAlt = 'Hornero OS desktop running Hornero Light';
const socialUrlValue = socialImage ? new URL(socialImage, site).toString() : socialUrl.toString();
const socialAltValue = socialImageAlt ?? socialAlt;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Favicon: HorneroOS/config@5df8300 assets/brand/favicon.svg (MIT) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="theme-color" content="#0a1016" />
<script is:inline>
  (() => {
    const key = 'hornero-color-mode';
    const valid = ['system', 'light', 'dark'];
    // Hornero's nocturnal signal palette is the site's first impression; visitors
    // can still opt into their OS theme or switch to the daylight palette below.
    let preference = 'dark';
    try {
      const saved = localStorage.getItem(key);
      if (valid.includes(saved)) preference = saved;
    } catch {
      // Storage can be disabled; keep the branded dark default.
    }

    const mode =
      preference === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : preference;
    document.documentElement.dataset.colorPreference = preference;
    document.documentElement.dataset.colorMode = mode;
    const themeColor = document.querySelector('meta[name="theme-color"]');
    if (themeColor) themeColor.content = mode === 'light' ? '#f0eee7' : '#0a1016';
  })();
</script>
<title>{title}</title>
{description && <meta name="description" content={description} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Hornero OS" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialUrlValue} />
{!socialImage && <meta property="og:image:width" content={String(social.attributes.width)} />}
{!socialImage && <meta property="og:image:height" content={String(social.attributes.height)} />}
<meta property="og:image:alt" content={socialAltValue} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialUrlValue} />
<meta name="twitter:image:alt" content={socialAltValue} />
