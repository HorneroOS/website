---
interface Props {
  title: string;
  description?: string;
  /** Exclude the page from search results (and omit its canonical URL). */
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
}

import bricolageWoff2 from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2';
import rubikWoff2 from '@fontsource-variable/rubik/files/rubik-latin-wght-normal.woff2';
import martianWoff2 from '@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2';

const { title, description, noindex = false, socialImage, socialImageAlt } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);

// Social previews are a first impression, so every page gets a designed
// 1200x630 card (scripts/build-og.mjs) built from real captures. A page can pass
// its own card from /og/. The licensed Buenos Aires photographs stay in the
// greeter and wallpaper galleries, where their credits live next to them.
const defaultAlt =
  "The HorneroOS Dashboard on a live desktop over a photograph of the Beagle Channel, beside the line 'A Linux desktop, lived in since 2018'.";
const socialUrlValue = new URL(socialImage ?? '/og/default.png', site).toString();
const socialAltValue = socialImageAlt ?? defaultAlt;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Preload the three latin faces (display, UI, and the mono used in captions) so hero text paints without waiting on CSS discovery and captions never reflow when the mono face swaps in. -->
<link rel="preload" href={bricolageWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={rubikWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={martianWoff2} as="font" type="font/woff2" crossorigin />
<!-- Favicon: HorneroOS/config@5df8300 assets/brand/favicon.svg (MIT) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="theme-color" content="#0b1018" />
<script is:inline>
  (() => {
    const key = 'hornero-color-mode';
    const valid = ['system', 'light', 'dark'];
    // Hornero 199X nighttime broadcast is the site's first impression; visitors
    // can still opt into their OS theme or switch to the daylight edition below.
    let preference = 'dark';
    try {
      const saved = localStorage.getItem(key);
      if (valid.includes(saved)) preference = saved;
    } catch {
      // Storage can be disabled; keep the branded dark default.
    }

    const mode =
      preference === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : preference;
    document.documentElement.dataset.colorPreference = preference;
    document.documentElement.dataset.colorMode = mode;
    const themeColor = document.querySelector('meta[name="theme-color"]');
    if (themeColor) themeColor.content = mode === 'light' ? '#eff0ee' : '#0b1018';
  })();
</script>
<title>{title}</title>
{description && <meta name="description" content={description} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Hornero OS" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialUrlValue} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={socialAltValue} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialUrlValue} />
<meta name="twitter:image:alt" content={socialAltValue} />
