---
import { getImage } from 'astro:assets';
import socialSource from '../../assets/screenshots/desktop-neon.png';

interface Props {
  title: string;
  description?: string;
  /** Exclude the page from search results (and omit its canonical URL). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);

// Social preview: the real Neon City capture (1280x720), re-encoded as JPEG
// at build time. No mockups — see AGENTS.md "Website follows product".
const social = await getImage({ src: socialSource, width: 1200, format: 'jpg', quality: 80 });
const socialUrl = new URL(social.src, site);
const socialAlt = 'Hornero OS desktop, Neon City theme';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Favicon: HorneroOS/config@5df8300 assets/brand/favicon.svg (MIT) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="theme-color" content="#0a0d18" />
<title>{title}</title>
{description && <meta name="description" content={description} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Hornero OS" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialUrl} />
<meta property="og:image:width" content={String(social.attributes.width)} />
<meta property="og:image:height" content={String(social.attributes.height)} />
<meta property="og:image:alt" content={socialAlt} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialUrl} />
<meta name="twitter:image:alt" content={socialAlt} />
