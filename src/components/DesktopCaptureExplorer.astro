---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import KilnStamp from './KilnStamp.astro';

interface Props {
  captures: CollectionEntry<'showroom'>[];
  layoutCount: number;
}

const { captures, layoutCount } = Astro.props;
const selections = [
  { id: 'cockpit-clear', label: 'Cockpit Clear', group: 'Layout' },
  { id: 'islands', label: 'Islands', group: 'Layout' },
  { id: 'dock-bottom', label: 'Dock Bottom', group: 'Layout' },
  { id: 'layout-picker', label: 'Layout Picker', group: 'Control Center' },
  { id: 'appearance-search', label: 'Settings search', group: 'Control Center' },
];

const views = await Promise.all(
  selections.map(async (selection) => {
    const capture = captures.find((item) => item.id === selection.id);
    if (!capture) throw new Error(`Desktop capture is missing from the showroom collection: ${selection.id}`);

    const variants = await Promise.all(
      [480, 800, 1280].map((width) => getImage({ src: capture.data.image, width, format: 'webp', quality: 78 })),
    );

    return {
      ...selection,
      ...capture.data,
      src: variants[1]?.src ?? variants[0]?.src,
      srcset: variants.map((variant) => `${variant.src} ${variant.options.width}w`).join(', '),
    };
  }),
);

const firstView = views[0];
if (!firstView?.src) throw new Error('The desktop capture explorer has no initial image.');
---

<section class="section desktop-capture-explorer" aria-labelledby="capture-explorer-title" data-capture-explorer>
  <header class="explorer-heading">
    <div>
      <h2 id="capture-explorer-title">{layoutCount} layouts, one shell</h2>
    </div>
    <p>
      A layout moves the bar, the dock and the controls; the desktop underneath stays the same. Each frame is a capture
      from a Hornero QA run or visual review. Pick one to compare.
    </p>
  </header>

  <div class="explorer-layout">
    <div class="capture-stage" id="capture-panel" role="tabpanel" aria-label={firstView.title} tabindex="0">
      <div class="stage-heading" aria-hidden="true">
        <span>HORNERO / DESKTOP</span>
        <span data-capture-group>{firstView.group}</span>
      </div>
      <div class="capture-screen">
        <img
          data-capture-image
          src={firstView.src}
          srcset={firstView.srcset}
          sizes="(min-width: 1160px) 66vw, (min-width: 720px) 60vw, 100vw"
          alt={firstView.alt}
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="capture-caption-wrap">
        <div class="capture-caption">
          <p class="capture-kicker" data-capture-group-caption>
            {firstView.group}
          </p>
          <h3 data-capture-title>{firstView.title}</h3>
          <p class="capture-context" data-capture-context>
            {firstView.provenance.context}
          </p>
        </div>
        <div class="capture-provenance" data-capture-provenance>
          <KilnStamp {...firstView.provenance} />
        </div>
      </div>
    </div>

    <div class="capture-navigation" role="group" aria-label="Choose a real Hornero capture">
      <p class="navigation-label">Choose a capture</p>
      <ul aria-label="Choose a real Hornero capture">
        {views.map((view, index) => (
          <li>
            <button
              type="button"
              role="tab"
              id={`capture-tab-${view.id}`}
              aria-controls="capture-panel"
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              hidden
              data-capture-choice
              data-capture-id={view.id}
              data-capture-group={view.group}
              data-capture-title={view.title}
              data-capture-context={view.provenance.context ?? ''}
              data-capture-alt={view.alt}
              data-capture-src={view.src}
              data-capture-srcset={view.srcset}
            >
              <span class="choice-label">{view.label}</span>
              <span class="choice-group">{view.group}</span>
              <span class="choice-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
            <a class="capture-fallback-link" href={`/showroom#${view.id}`}>
              Open {view.label} in the capture archive <span aria-hidden="true">↗</span>
            </a>
            <template data-capture-provenance-template={view.id}>
              <KilnStamp {...view.provenance} />
            </template>
          </li>
        ))}
      </ul>
      <p class="navigation-note">
        Selecting a layout swaps the capture and its source record.
      </p>
      <a class="text-link" href="/layouts">
        Explore all {layoutCount} layouts
      </a>
      <a class="text-link archive-link" href="/showroom">
        Browse the full capture archive
      </a>
    </div>
    <p class="capture-announcement" aria-live="polite" data-capture-announcement></p>
  </div>
</section>

<script>
  const explorer = document.querySelector<HTMLElement>('[data-capture-explorer]');

  if (explorer) {
    const image = explorer.querySelector<HTMLImageElement>('[data-capture-image]');
    const title = explorer.querySelector<HTMLElement>('[data-capture-title]');
    const group = explorer.querySelector<HTMLElement>('[data-capture-group]');
    const captionGroup = explorer.querySelector<HTMLElement>('[data-capture-group-caption]');
    const context = explorer.querySelector<HTMLElement>('[data-capture-context]');
    const provenance = explorer.querySelector<HTMLElement>('[data-capture-provenance]');
    const announcement = explorer.querySelector<HTMLElement>('[data-capture-announcement]');
    const panel = explorer.querySelector<HTMLElement>('#capture-panel');
    const navigation = explorer.querySelector<HTMLElement>('.capture-navigation');
    const choices = [...explorer.querySelectorAll<HTMLButtonElement>('[data-capture-choice]')];
    let selectionRequest = 0;

    const selectCapture = async (choice: HTMLButtonElement) => {
      if (!image || !title || !group || !captionGroup || !context || !provenance || !announcement || !panel) return;

      const id = choice.dataset.captureId;
      const source = choice.dataset.captureSrc;
      const sourceSet = choice.dataset.captureSrcset;
      const nextTitle = choice.dataset.captureTitle;
      const nextGroup = choice.dataset.captureGroup;
      const nextAlt = choice.dataset.captureAlt;
      if (!id || !source || !sourceSet || !nextTitle || !nextGroup || !nextAlt) return;

      const template = explorer.querySelector<HTMLTemplateElement>(
        `template[data-capture-provenance-template="${CSS.escape(id)}"]`,
      );
      if (!template) return;

      const request = ++selectionRequest;
      const incoming = new Image();
      incoming.sizes = image.sizes;
      incoming.srcset = sourceSet;
      incoming.src = source;

      try {
        await incoming.decode();
      } catch {
        if (request === selectionRequest)
          announcement.textContent = `${nextTitle} could not be loaded. The current capture remains visible.`;
        return;
      }

      if (request !== selectionRequest) return;

      image.srcset = sourceSet;
      image.src = source;
      image.alt = nextAlt;
      image.classList.remove('capture-arrive');
      requestAnimationFrame(() => image.classList.add('capture-arrive'));
      title.textContent = nextTitle;
      group.textContent = nextGroup;
      captionGroup.textContent = nextGroup;
      context.textContent = choice.dataset.captureContext ?? '';
      provenance.replaceChildren(template.content.cloneNode(true));
      announcement.textContent = `${nextTitle} capture selected. ${choice.dataset.captureContext ?? ''}`;
      panel.setAttribute('aria-labelledby', choice.id);

      choices.forEach((item) => {
        const selected = item === choice;
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
    };

    choices.forEach((choice) => {
      choice.addEventListener('click', () => selectCapture(choice));
      choice.addEventListener('keydown', (event) => {
        const currentIndex = choices.indexOf(choice);
        let nextIndex: number | undefined;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (currentIndex + 1) % choices.length;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
          nextIndex = (currentIndex - 1 + choices.length) % choices.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = choices.length - 1;
        if (nextIndex === undefined) return;

        event.preventDefault();
        const nextChoice = choices[nextIndex];
        if (!nextChoice) return;
        selectCapture(nextChoice);
        nextChoice.focus();
      });
    });

    if (
      navigation &&
      choices.length &&
      image &&
      title &&
      group &&
      captionGroup &&
      context &&
      provenance &&
      announcement &&
      panel
    ) {
      const tabList = navigation.querySelector('ul');
      tabList?.setAttribute('role', 'tablist');
      tabList?.querySelectorAll('li').forEach((item) => item.setAttribute('role', 'presentation'));
      navigation.querySelectorAll<HTMLAnchorElement>('.capture-fallback-link').forEach((link) => link.remove());
      choices.forEach((choice) => (choice.hidden = false));
      panel.removeAttribute('aria-label');
      const selectedChoice = choices.find((choice) => choice.getAttribute('aria-selected') === 'true');
      if (selectedChoice) panel.setAttribute('aria-labelledby', selectedChoice.id);
      navigation.dataset.enhanced = 'true';
    }
  }
</script>

<style>
  .desktop-capture-explorer {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(3rem, 7vw, 6rem);
    border-block: 1px solid var(--line);
    scroll-margin-top: 8rem;
  }

  .explorer-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.62fr);
    align-items: end;
    gap: clamp(1.5rem, 5vw, 5rem);
  }

  .explorer-heading h2 {
    max-width: 14ch;
    margin-top: 0.45rem;
    font-size: clamp(2.1rem, 4vw, 3.7rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .explorer-heading > p {
    max-width: 40ch;
    color: var(--text-muted);
    font-size: var(--step-0);
  }

  .explorer-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(15rem, 0.58fr);
    align-items: start;
    gap: clamp(1.2rem, 3vw, 2.5rem);
  }

  .capture-stage {
    min-width: 0;
    padding: 0.65rem;
    border: 1px solid var(--line);
    border-top-color: color-mix(in srgb, var(--highlight) 58%, var(--line));
    background: var(--surface);
    box-shadow: 0.55rem 0.55rem 0 color-mix(in srgb, var(--highlight) 14%, transparent);
  }

  .stage-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0.35rem 0.65rem;
    color: var(--text-muted);
    font: 0.64rem var(--font-data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stage-heading span:first-child {
    color: var(--highlight);
  }

  .capture-screen {
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--night);
    border: 1px solid var(--line);
  }

  .capture-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .capture-screen img.capture-arrive {
    animation: capture-arrive 180ms ease-out both;
  }

  .capture-stage .capture-caption-wrap {
    display: grid;
    gap: 0.8rem;
    padding: 1rem 0.4rem 0.35rem;
  }

  .capture-kicker,
  .navigation-label {
    color: var(--secondary);
    font: 0.65rem var(--font-data);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .capture-caption h3 {
    margin-top: 0.2rem;
    font-size: clamp(1.25rem, 2.1vw, 1.7rem);
    line-height: 1.15;
  }

  .capture-context {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .capture-provenance :global(.stamp) {
    background: var(--bg);
  }

  .capture-navigation {
    min-width: 0;
    padding-top: 0.25rem;
  }

  .capture-navigation ul {
    display: grid;
    margin-top: 0.6rem;
    list-style: none;
  }

  .capture-navigation li {
    border-top: 1px solid var(--line);
  }

  .capture-navigation li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .capture-navigation button[data-capture-choice] {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.18rem 0.65rem;
    align-items: center;
    min-height: 4.35rem;
    padding: 0.72rem 0.4rem;
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    transition:
      color 160ms ease,
      padding 160ms ease,
      background-color 160ms ease;
  }

  .capture-navigation button[data-capture-choice]::before {
    position: absolute;
    inset-block: 0.6rem;
    left: -0.66rem;
    width: 2px;
    background: var(--highlight);
    content: '';
    opacity: 0;
    transform: scaleY(0.6);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .choice-label {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 650;
    line-height: 1.15;
  }

  .choice-group {
    grid-column: 1;
    color: var(--text-muted);
    font: 0.61rem var(--font-data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .choice-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--secondary);
    font-size: 1.1rem;
    opacity: 0.45;
    transform: translate(-0.2rem, 0.2rem);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .capture-navigation button[data-capture-choice]:hover,
  .capture-navigation button[data-capture-choice][aria-selected='true'] {
    color: var(--text);
    background: color-mix(in srgb, var(--highlight) 5%, transparent);
  }

  .capture-navigation button[data-capture-choice][aria-selected='true'] {
    padding-left: 0.7rem;
  }

  .capture-navigation button[data-capture-choice][aria-selected='true']::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .capture-navigation button[data-capture-choice]:hover .choice-arrow,
  .capture-navigation button[data-capture-choice][aria-selected='true'] .choice-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .capture-navigation button[data-capture-choice]:focus-visible {
    z-index: 1;
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .navigation-note {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .capture-fallback-link {
    display: inline-flex;
    margin: 0.15rem 0 0.65rem 0.4rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .capture-navigation[data-enhanced='true'] .capture-fallback-link {
    display: none;
  }

  .capture-navigation:not([data-enhanced='true']) button[data-capture-choice] {
    display: none;
  }

  .capture-navigation > .text-link {
    display: flex;
    width: fit-content;
    margin-top: 1.2rem;
    font-size: 0.9rem;
  }

  .capture-navigation > .archive-link {
    margin-top: 0.55rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .capture-announcement {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes capture-arrive {
    from {
      opacity: 0.68;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 860px) {
    .explorer-heading {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .explorer-heading > p {
      max-width: 58ch;
    }
    .explorer-layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(13rem, 0.7fr);
    }
  }

  @media (max-width: 680px) {
    .explorer-layout {
      grid-template-columns: 1fr;
    }
    .capture-navigation ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .capture-navigation li:nth-child(odd) {
      border-right: 1px solid var(--line);
    }
    .capture-navigation li:nth-last-child(2):nth-child(odd) {
      border-bottom: 1px solid var(--line);
    }
    .capture-navigation li:last-child {
      border-bottom: 0;
    }
    .capture-navigation button[data-capture-choice] {
      min-height: 4.15rem;
      padding-inline: 0.55rem;
    }
    .capture-navigation button[data-capture-choice]::before {
      left: 0;
    }
    .capture-navigation button[data-capture-choice][aria-selected='true'] {
      padding-left: 0.8rem;
    }
  }

  @media (max-width: 390px) {
    .capture-stage {
      padding: 0.4rem;
    }
    .capture-navigation ul {
      grid-template-columns: 1fr;
    }
    .capture-navigation li:nth-child(odd) {
      border-right: 0;
    }
    .capture-navigation li:last-child {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capture-screen img.capture-arrive {
      animation: none;
    }
    .capture-navigation button[data-capture-choice],
    .capture-navigation button[data-capture-choice]::before,
    .choice-arrow {
      transition: none;
    }
  }
</style>
