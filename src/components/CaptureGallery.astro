---
/**
 * Editorial sections for a route (src/data/editorial.json, render:gallery).
 * Inventory never auto-renders: only curated placements appear, each with its
 * human caption, plus one provenance line for the page.
 */
import { editorial, editorialForPage, getSlot } from '../data/captures';
import CaptureFigure from './CaptureFigure.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  route: string;
  locale?: Locale;
  /** Slot ids the page already renders in its own layout. */
  exclude?: string[];
  heading?: string;
  intro?: string;
  id?: string;
}

const { route, locale = 'es', exclude = [], heading, intro, id } = Astro.props;
const isEs = locale === 'es';
const sections = editorialForPage(route)
  .filter((section) => section.render === 'gallery')
  .map((section) => ({ ...section, slots: section.slots.filter((sid) => !exclude.includes(sid)) }))
  .filter((section) => section.slots.length > 0);
const title = heading ?? (isEs ? 'Capturas seleccionadas' : 'Selected captures');
const lead = intro ?? editorial.provenance[locale];
---

{
  sections.length > 0 && (
    <section class="section capture-gallery" id={id} aria-labelledby={`${id ?? 'capture-gallery'}-title`}>
      <header class="section-head">
        <h2 id={`${id ?? 'capture-gallery'}-title`}>{title}</h2>
        <p>{lead}</p>
      </header>
      {sections.map((section) => (
        <div class:list={['capture-grid', `is-${section.format}`]}>
          {section.slots.map((sid) => {
            const slot = getSlot(sid);
            return (
              <div class="capture-cell" data-wide={slot.width / slot.height >= 2 ? 'true' : undefined}>
                <CaptureFigure slot={sid} locale={locale} caption={section.captions?.[sid]?.[locale] ?? section.caption[locale]} crop={section.crop} eager={section.eager} />
              </div>
            );
          })}
        </div>
      ))}
    </section>
  )
}

<style>
  .capture-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1.6rem 1.4rem;
    margin-top: 1.4rem;
  }

  .capture-cell {
    min-width: 0;
  }

  .capture-cell[data-wide='true'] {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .capture-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .capture-grid.is-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
