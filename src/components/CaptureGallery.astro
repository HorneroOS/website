---
/**
 * Every slot declared for a route in src/data/capture-slots.json that the
 * page does not place by hand, as a grid of CaptureFigure plates. Captures
 * fill themselves in once their slot is flipped to `captured`.
 */
import { slotsForPage } from '../data/captures';
import CaptureFigure from './CaptureFigure.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  route: string;
  locale?: Locale;
  /** Slot ids the page already renders in its own layout. */
  exclude?: string[];
  heading?: string;
  intro?: string;
  id?: string;
}

const { route, locale = 'es', exclude = [], heading, intro, id } = Astro.props;
const isEs = locale === 'es';
const slots = slotsForPage(route).filter((slot) => !exclude.includes(slot.id));
const title = heading ?? (isEs ? 'Capturas previstas para esta página' : 'Captures planned for this page');
const lead =
  intro ??
  (isEs
    ? 'Las imágenes de HorneroOS salen de capturas reales del host. Hasta que cada una esté lista, el espacio reservado dice qué va a mostrar y cómo se va a tomar.'
    : 'HorneroOS imagery comes from real host captures. Until each one is ready, its placeholder says what it will show and how it will be taken.');
---

{
  slots.length > 0 && (
    <section class="section capture-gallery" id={id} aria-labelledby={`${id ?? 'capture-gallery'}-title`}>
      <header class="section-head">
        <h2 id={`${id ?? 'capture-gallery'}-title`}>{title}</h2>
        <p>{lead}</p>
      </header>
      <div class="capture-grid">
        {slots.map((slot) => (
          <div class="capture-cell" data-wide={slot.width / slot.height >= 2 ? 'true' : undefined}>
            <CaptureFigure slot={slot.id} locale={locale} />
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .capture-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1.6rem 1.4rem;
    margin-top: 1.4rem;
  }

  .capture-cell {
    min-width: 0;
  }

  .capture-cell[data-wide='true'] {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .capture-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
