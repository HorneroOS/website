---
/**
 * A real capture framed by the hornero's oven-nest arch, with its
 * provenance plate. `variant="plain"` keeps every corner visible (galleries,
 * layout pages) where cropping would hide product UI.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import KilnStamp, { type Provenance } from './KilnStamp.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  provenance: Provenance;
  variant?: 'arch' | 'plain';
  eager?: boolean;
  sizes?: string;
  widths?: number[];
}

const {
  src,
  alt,
  provenance,
  variant = 'plain',
  eager = false,
  sizes = '(min-width: 1180px) 1100px, calc(100vw - 2rem)',
  widths = [480, 800, 1280],
} = Astro.props;
---

<figure class:list={['frame', `frame-${variant}`]}>
  <div class="frame-shot">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  </div>
  <figcaption>
    <KilnStamp {...provenance} />
  </figcaption>
</figure>

<style>
  .frame {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  .frame-shot {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .frame-arch .frame-shot {
    /* A shallow vault over a flat sill: the nest's opening. */
    border-radius: 50% 50% var(--radius) var(--radius) / 16% 16% var(--radius) var(--radius);
    border-color: color-mix(in oklab, var(--clay) 45%, var(--line));
    box-shadow:
      0 0 0 6px var(--surface),
      0 0 0 7px var(--line);
  }

  .frame-shot :global(img) {
    width: 100%;
    height: auto;
  }
</style>
