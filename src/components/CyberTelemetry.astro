---
import PixelArt from './PixelArt.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ariaLabel =
  locale === 'es'
    ? 'Telemetría retro del sistema HorneroOS'
    : 'HorneroOS retro system telemetry';

const items = [
  { key: 'SYS', value: 'HORNERO-OS', tone: 'phosphor' },
  { key: 'CLI', value: 'V 0.5.2 <5ms', tone: 'signal' },
  { key: 'BOOT', value: 'BTRFS-TRIAL ARMED', tone: 'cue' },
  { key: 'AI', value: 'app-models.slice 20%', tone: 'phosphor' },
  { key: 'PLUGINS', value: '35 SIGNED', tone: 'signal' },
] as const;
---

<aside class="cyber-telemetry" aria-label={ariaLabel}>
  <div class="cyber-telemetry-companion" aria-hidden="true">
    <PixelArt kind="hornero" size={30} />
  </div>
  <ul class="cyber-telemetry-list" role="list">
    {
      items.map((item) => (
        <li class="cyber-pill" data-tone={item.tone}>
          <span class="cyber-led" aria-hidden="true" />
          <span class="cyber-key">{item.key}</span>
          <span class="cyber-sep" aria-hidden="true">
            //
          </span>
          <span class="cyber-val">{item.value}</span>
        </li>
      ))
    }
    <li class="cyber-cursor-item" aria-hidden="true">
      <span class="cyber-cursor">_</span>
    </li>
  </ul>
  <div class="cyber-telemetry-companion cyber-mate-slot" aria-hidden="true">
    <PixelArt kind="mate" size={20} />
  </div>
</aside>

<style>
  .cyber-telemetry {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.9rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-small);
    background: color-mix(in srgb, var(--sunken) 88%, var(--panel));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--ink) 6%, transparent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.3;
    letter-spacing: 0.05em;
  }

  .cyber-telemetry::before,
  .cyber-telemetry::after {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 0 solid var(--signal);
    content: '';
    pointer-events: none;
  }

  .cyber-telemetry::before {
    top: -1px;
    left: -1px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .cyber-telemetry::after {
    right: -1px;
    bottom: -1px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--cue);
  }

  .cyber-telemetry-companion {
    display: inline-flex;
    align-items: center;
    flex: none;
  }

  .cyber-mate-slot {
    margin-left: auto;
  }

  .cyber-telemetry-list {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.85rem;
    list-style: none;
  }

  .cyber-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
  }

  .cyber-led {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    flex: none;
    background: var(--phosphor);
    box-shadow: 0 0 4px color-mix(in srgb, var(--phosphor) 40%, transparent);
  }

  .cyber-pill[data-tone='signal'] .cyber-led {
    background: var(--signal);
    box-shadow: 0 0 4px color-mix(in srgb, var(--signal) 40%, transparent);
  }

  .cyber-pill[data-tone='cue'] .cyber-led {
    background: var(--cue);
    box-shadow: 0 0 4px color-mix(in srgb, var(--cue) 40%, transparent);
  }

  :global(:root[data-color-mode='light']) .cyber-led {
    box-shadow: none;
  }

  .cyber-key {
    color: var(--ink-muted);
    font-weight: 500;
  }

  .cyber-sep {
    color: var(--ink-faint);
  }

  .cyber-val {
    color: var(--ink);
    font-weight: 500;
  }

  .cyber-cursor-item {
    display: inline-flex;
    align-items: center;
  }

  .cyber-cursor {
    display: inline-block;
    color: var(--signal);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cyber-pill[data-tone='phosphor'] .cyber-led {
      animation: cyber-led-pulse 2.4s ease-in-out infinite;
    }

    .cyber-cursor {
      animation: cyber-cursor-blink 1.05s steps(2, end) infinite;
    }
  }

  @keyframes cyber-led-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @keyframes cyber-cursor-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .cyber-mate-slot {
      display: none;
    }
  }
</style>
