---
/**
 * The one component for every place the site shows what the distro looks
 * like. Placements come from src/data/editorial.json; the slot record in
 * src/data/capture-slots.json carries provenance and alt text.
 *
 * Only `captured` slots render. A pending (deferred) or archived slot id is
 * a build error: there are no public placeholder plates (docs/IMAGE_CURATION.md).
 * Crops are CSS framing of the original asset — never new files.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { editorialCaption, getSlot, type Crop } from '../data/captures';
import CaptureLabel from './CaptureLabel.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  slot: string;
  locale?: Locale;
  eager?: boolean;
  sizes?: string;
  /** Human editorial caption; falls back to the slot title. */
  caption?: string;
  crop?: Crop;
}

const { slot: slotId, locale = 'es', eager = false, sizes = '(min-width: 1100px) 1000px, calc(100vw - 2rem)', caption, crop } = Astro.props;
const slot = getSlot(slotId);
if (slot.status !== 'captured' || !slot.file) {
  throw new Error(`Capture slot ${slot.id} is ${slot.status}: only captured slots placed in src/data/editorial.json may render publicly`);
}
if (slot.docsOnly) {
  throw new Error(`Capture slot ${slot.id} is docs-only and must not be placed on the website`);
}

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/captures/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const resolveImage = (file: string | null | undefined): ImageMetadata | undefined => {
  if (!file) return undefined;
  const hit = Object.entries(images).find(([path]) => path.endsWith(`/${file}`));
  return hit?.[1].default;
};
const isClip = slot.kind === 'clip';
const image = !isClip ? resolveImage(slot.file) : undefined;
const poster = isClip ? resolveImage(slot.poster) : undefined;
if (!isClip && !image) throw new Error(`Capture slot ${slot.id} is captured but src/assets/captures/${slot.file} is missing`);
if (isClip && !poster) throw new Error(`Capture slot ${slot.id} is a clip but its poster ${slot.poster} is missing`);

const alt = slot.alt[locale];
// Human editorial caption everywhere; provenance (incl. capture date) lives
// in the page-level line and the slot record, not repeated under each figure.
const captionText = caption ?? editorialCaption(slot.id, locale) ?? slot.title[locale];
---

<figure
  class:list={['capture-figure', { 'is-clip': isClip }]}
  data-capture-slot={slot.id}
  data-status="captured"
  data-priority={slot.priority}
  data-kind={slot.kind}
  data-crop={crop}
  style={`--cap-ratio:${slot.width} / ${slot.height}`}
>
  <div class:list={['capture-frame', 'ticked', { 'is-cropped': !!crop }]}>
    {
      isClip ? (
        <video
          class="capture-media"
          width={slot.width}
          height={slot.height}
          poster={poster!.src}
          muted
          loop
          playsinline
          autoplay
          preload="metadata"
          aria-label={alt}
          data-capture-clip
        >
          <source src={`/captures/${slot.file!.replace(/\.[^.]+$/, '')}.webm`} type="video/webm" />
          <source src={`/captures/${slot.file!.replace(/\.[^.]+$/, '')}.mp4`} type="video/mp4" />
        </video>
      ) : (
        <Picture
          class="capture-media"
          src={image!}
          alt={alt}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
        />
      )
    }
  </div>
  <figcaption>
    <CaptureLabel state="captured" kind={slot.kind} locale={locale} />
    <span class="capture-caption">{captionText}</span>
    {slot.credit && <span class="capture-meta">{slot.credit[locale]}</span>}
  </figcaption>
</figure>

<script>
  // Clips never autoplay for people who asked for reduced motion: show the
  // poster and give them controls instead.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('video[data-capture-clip]').forEach((video) => {
      video.removeAttribute('autoplay');
      video.pause();
      video.controls = true;
    });
  }
</script>

<style>
  .capture-figure {
    container-type: inline-size;
    container-name: capture;
    display: grid;
    gap: 0.6rem;
    margin: 0;
    min-width: 0;
  }

  .capture-frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--cap-ratio);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--sunken);
    overflow: visible;
  }

  .capture-frame.is-cropped {
    overflow: hidden;
  }

  .capture-frame :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .capture-frame :global(.capture-media) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius);
    object-fit: cover;
  }

  /* Editorial crops: CSS framing of the original asset, never a new file. */
  .capture-figure[data-crop='top'] .capture-frame {
    aspect-ratio: 16 / 7;
  }
  .capture-figure[data-crop='top'] :global(.capture-media) {
    object-position: top;
  }
  .capture-figure[data-crop='bottom'] .capture-frame {
    aspect-ratio: 16 / 7;
  }
  .capture-figure[data-crop='bottom'] :global(.capture-media) {
    object-position: bottom;
  }
  .capture-figure[data-crop='br-quadrant'] .capture-frame,
  .capture-figure[data-crop='panel'] .capture-frame {
    aspect-ratio: 4 / 3;
  }
  .capture-figure[data-crop='br-quadrant'] :global(.capture-media),
  .capture-figure[data-crop='panel'] :global(.capture-media) {
    transform: scale(2.1);
    transform-origin: bottom right;
  }

  .capture-figure figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.8rem;
    color: var(--ink-muted);
    font: 500 0.7rem/1.4 var(--font-mono);
    letter-spacing: 0.05em;
  }

  .capture-caption {
    color: var(--ink);
  }
</style>
