---
import '@fontsource-variable/rubik';
import '@fontsource-variable/martian-mono/wdth.css';
import '@fontsource-variable/bricolage-grotesque';
import BaseHead from '../components/BaseHead.astro';
// Bird marks: HorneroOS/config assets/brand (MIT). logo-dark.svg @5df8300,
// logo-light.svg @39c2bd8. Dark surfaces get the cream bird, light ones the adobe bird.
import LogoDark from '../assets/brand/logo-dark.svg';
import LogoLight from '../assets/brand/logo-light.svg';
import '../styles/global.css';
import { story } from '../data/story';

const firstPublicCommit = story.find((entry) => entry.id === 'dotfiles')?.source?.href;

interface Props {
  title: string;
  description?: string;
  socialImage?: string;
  socialImageAlt?: string;
  noindex?: boolean;
}

interface NavLink {
  href: string;
  label: string;
}

interface NavGroup {
  label: string;
  links: NavLink[];
}

type NavItem = ({ kind: 'link' } & NavLink) | ({ kind: 'group' } & NavGroup);

const { title, description, noindex, socialImage, socialImageAlt } = Astro.props;
// Grouped by what a visitor is trying to do: see it, compare editions, extend it,
// learn the story, read the docs, get it.
const nav: NavItem[] = [
  {
    kind: 'group',
    label: 'Desktop',
    links: [
      { href: '/showroom', label: 'Showroom' },
      { href: '/layouts', label: 'Layouts' },
      { href: '/themes', label: 'Themes' },
      { href: '/wallpapers', label: 'Wallpapers' },
      { href: '/greeter', label: 'Greeter' },
      { href: '/terminals', label: 'Terminals' },
      { href: '/companion', label: 'Companion' },
    ],
  },
  { kind: 'link', href: '/editions', label: 'Editions' },
  { kind: 'link', href: '/studio', label: 'Studio' },
  { kind: 'link', href: '/extensions', label: 'Extensions' },
  {
    kind: 'group',
    label: 'Story',
    links: [
      { href: '/roots', label: 'Roots' },
      { href: '/releases', label: 'Releases' },
      { href: '/docs/development/design-language/', label: 'Design language' },
    ],
  },
  { kind: 'link', href: '/docs/', label: 'Docs' },
  { kind: 'link', href: '/search/', label: 'Search' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return current === h || (h !== '/' && current.startsWith(`${h}/`));
};
const groupCurrent = (group: NavGroup) => group.links.some((l) => isCurrent(l.href));
const repos = [
  { href: 'https://github.com/HorneroOS', label: 'GitHub' },
  { href: '/roots#repositories', label: 'Project map' },
  { href: '/docs/development/design-language/', label: 'Design language' },
  { href: 'https://github.com/HorneroOS/.github/blob/main/CONTRIBUTING.md', label: 'Contribute' },
  { href: '/search/', label: 'Search' },
  { href: 'https://github.com/HorneroOS/website/issues', label: 'Report a site issue' },
];
// Community links. The star count is not fetched at runtime: this site loads no
// third-party resources, so the star link is a plain link.
const community = {
  org: 'https://github.com/HorneroOS',
  star: 'https://github.com/HorneroOS/hornero',
  bug: 'https://github.com/HorneroOS/hornero/issues/new/choose',
  siteIssue: 'https://github.com/HorneroOS/website/issues/new/choose',
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      noindex={noindex}
      socialImage={socialImage}
      socialImageAlt={socialImageAlt}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-nav">
      <a href="/" class="brand">
        <LogoDark class="brand-mark mark-on-dark" width="32" height="32" aria-hidden="true" focusable="false" />
        <LogoLight class="brand-mark mark-on-light" width="32" height="32" aria-hidden="true" focusable="false" />
        <span class="brand-copy">
          <span>
            Hornero <span class="os">OS</span>
          </span>
          <small>ARG / 199X · La Plata — Buenos Aires</small>
        </span>
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) =>
            item.kind === 'link' ? (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ) : (
              <li class="nav-more-item">
                <details class="nav-menu nav-more">
                  <summary class={groupCurrent(item) ? 'more-current' : undefined}>
                    {item.label} <span aria-hidden="true">⌄</span>
                  </summary>
                  <ul aria-label={item.label}>
                    {item.links.map((l) => (
                      <li>
                        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ),
          )}
          <li>
            <a href="/install" class="nav-install" aria-current={isCurrent('/install') ? 'page' : undefined}>
              Get HorneroOS
            </a>
          </li>
        </ul>
      </nav>
      <details class="mobile-menu">
        <summary>
          <span>Menu</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none">
            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          </svg>
        </summary>
        <nav aria-label="Mobile main">
          <ul>
            {nav.map((item) =>
              item.kind === 'link' ? (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ) : (
                <li class="mobile-group">
                  <p>{item.label}</p>
                  <ul aria-label={item.label}>
                    {item.links.map((l) => (
                      <li>
                        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ),
            )}
            <li>
              <a href="/install" class="nav-install" aria-current={isCurrent('/install') ? 'page' : undefined}>
                Get HorneroOS
              </a>
            </li>
          </ul>
          <ul class="mobile-community" aria-label="HorneroOS on GitHub">
            <li><a href={community.star}>Star on GitHub</a></li>
            <li><a href={community.org}>HorneroOS organization</a></li>
            <li><a href={community.bug}>Report a bug</a></li>
            <li><a href={community.siteIssue}>Report a site issue</a></li>
          </ul>
        </nav>
      </details>
      <ul class="community" aria-label="HorneroOS on GitHub">
        <li>
          <a href={community.org} class="community-org" aria-label="HorneroOS organization on GitHub">
            <svg aria-hidden="true" viewBox="0 0 16 16" width="18" height="18" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.96 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.83 1.27.83 2.15 0 3.08-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
          </a>
        </li>
        <li>
          <a href={community.star} class="community-star" aria-label="Star HorneroOS on GitHub">
            <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" focusable="false">
              <path
                fill="currentColor"
                d="M8 .25a.75.75 0 0 1 .67.42l1.88 3.8 4.2.61a.75.75 0 0 1 .41 1.28l-3.04 2.96.72 4.18a.75.75 0 0 1-1.09.79L8 12.35l-3.75 1.97a.75.75 0 0 1-1.09-.79l.72-4.18L1.84 6.36a.75.75 0 0 1 .41-1.28l4.2-.61 1.88-3.8A.75.75 0 0 1 8 .25Z"
              />
            </svg>
            <span>Star</span>
          </a>
        </li>
      </ul>
      <fieldset class="color-switch" data-color-switch>
        <legend>Color mode</legend>
        <label>
          <input type="radio" name="color-theme" value="system" />
          <span>
            <svg aria-hidden="true" viewBox="0 0 16 16" focusable="false">
              <rect x="1.5" y="2" width="13" height="9" rx="1.5" />
              <path d="M5.5 14h5M8 11v3M8 3v7" />
            </svg>
            <b class="mode-name">System</b>
          </span>
        </label>
        <label>
          <input type="radio" name="color-theme" value="light" />
          <span>
            <svg aria-hidden="true" viewBox="0 0 16 16" focusable="false">
              <circle cx="8" cy="8" r="3" />
              <path d="M8 1v1.5M8 13.5V15M1 8h1.5m11 0H15M3.05 3.05l1.06 1.06m7.78 7.78 1.06 1.06m0-9.9-1.06 1.06m-7.78 7.78-1.06 1.06" />
            </svg>
            <b class="mode-name">Light</b>
          </span>
        </label>
        <label>
          <input type="radio" name="color-theme" value="dark" checked />
          <span>
            <svg aria-hidden="true" viewBox="0 0 16 16" focusable="false">
              <path d="M12.8 10.3A5.7 5.7 0 0 1 5.7 3.2a5.8 5.8 0 1 0 7.1 7.1Z" />
              <path d="m11.8 2 .35 1.05L13.2 3.4l-1.05.35L11.8 4.8l-.35-1.05L10.4 3.4l1.05-.35L11.8 2Z" />
            </svg>
            <b class="mode-name">Dark</b>
          </span>
        </label>
      </fieldset>
    </header>
    <main id="main" class="app" tabindex="-1" data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <section class="involved" aria-labelledby="involved-title">
        <h2 id="involved-title">Get involved</h2>
        <ul>
          <li>
            <a href={community.star}>
              <strong>Star HorneroOS</strong>
              <span>Follow the desktop repository. Stars show the project to other people looking for it.</span>
            </a>
          </li>
          <li>
            <a href={community.org}>
              <strong>Browse the organization</strong>
              <span>Shell, configuration, installer, plugins, docs, QA and this website.</span>
            </a>
          </li>
          <li>
            <a href={community.bug}>
              <strong>Report a bug</strong>
              <span>Name the ISO (preview22), your firmware (UEFI or BIOS) and the step where it failed.</span>
            </a>
          </li>
          <li>
            <a href={community.siteIssue}>
              <strong>Report a site issue</strong>
              <span>Something wrong on this website: a broken link, a wrong date, a layout problem.</span>
            </a>
          </li>
        </ul>
      </section>
      <nav aria-label="Project">
        <ul>
          {repos.map((r) => (
            <li>
              <a href={r.href}>{r.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="fine">
        The desktop behind HorneroOS has been in daily use since 2018, by the maintainer’s account
        (<a href="/roots#timeline">history</a>), and its configuration has been public since 2019
        ({firstPublicCommit ? <a href={firstPublicCommit}>first commit</a> : 'first commit'}). Hornero 199X is an art
        direction: a future imagined in Argentina in the 1990s, drawn with today’s open-source tools. It is not a historical product. This site sets no cookies, runs no analytics and loads no
        third-party resources. Your color choice stays in this browser. Every screenshot is labelled with its source.
      </p>
    </footer>
    <script is:inline>
      (() => {
        const menus = [...document.querySelectorAll('.nav-menu, .mobile-menu')];
        const closeAll = (except) => menus.forEach((menu) => {
          if (menu !== except && menu.open) menu.open = false;
        });
        menus.forEach((menu) => menu.addEventListener('toggle', () => menu.open && closeAll(menu)));
        document.addEventListener('pointerdown', (event) => {
          menus.forEach((menu) => {
            if (menu.open && !menu.contains(event.target)) menu.open = false;
          });
        });
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          const open = menus.find((menu) => menu.open);
          if (!open) return;
          open.open = false;
          open.querySelector('summary')?.focus();
        });

        const key = 'hornero-color-mode';
        const media = matchMedia('(prefers-color-scheme: light)');
        const controls = [...document.querySelectorAll('[data-color-switch] input')];
        let preference = document.documentElement.dataset.colorPreference || 'dark';

        const apply = (next, persist = true) => {
          preference = next;
          const mode = next === 'system' ? (media.matches ? 'light' : 'dark') : next;
          document.documentElement.dataset.colorPreference = next;
          document.documentElement.dataset.colorMode = mode;
          const themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) {
            themeColor.content = getComputedStyle(document.documentElement)
              .getPropertyValue('--browser-theme-color')
              .trim();
          }
          controls.forEach((control) => {
            control.checked = control.value === next;
          });
          if (persist) {
            try {
              localStorage.setItem(key, next);
            } catch {
              // Keep the selection for this page even when storage is unavailable.
            }
          }
        };

        controls.forEach((control) => {
          control.addEventListener('change', () => apply(control.value));
        });
        media.addEventListener('change', () => {
          if (preference === 'system') apply('system', false);
        });
        window.addEventListener('storage', (event) => {
          if (event.key === key || event.key === null) {
            const next = ['system', 'light', 'dark'].includes(event.newValue) ? event.newValue : 'dark';
            apply(next, false);
          }
        });
        apply(preference, false);
      })();
    </script>
  </body>
</html>
