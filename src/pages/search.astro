---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Search — Hornero OS" description="Search the Hornero OS site and documentation." noindex>
  <section class="section">
    <h1>Search</h1>
    <p>
      Searches this site and the documentation. The index is built with the site and runs in your browser: nothing you
      type leaves this page.
    </p>
    <div id="search" class="search" data-pagefind-ignore></div>
    <noscript>
      <p>
        Search needs JavaScript. Browse the <a href="/docs/">documentation</a> instead.
      </p>
    </noscript>
  </section>
</SiteLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (!('PagefindUI' in window)) {
      document.getElementById('search').textContent =
        'The search index is generated by the production build (npm run build).';
      return;
    }
    new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false });
  });
</script>

<style is:global>
  .search {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--surface);
    --pagefind-ui-font: var(--font-ui);
    --pagefind-ui-border-radius: 10px;
    margin-top: 1.5rem;
    max-width: 72ch;
  }
</style>
