---
import SiteLayout from '../layouts/SiteLayout.astro';
import { greeterSceneCatalogue, greeterScenes } from '../data/product';

const videoScenes = greeterScenes.filter((scene) => scene.kind === 'video');
const firstScene = videoScenes[0];
const moods = [
  { id: 'auto', label: 'Local time' },
  { id: 'day', label: 'Day' },
  { id: 'golden-hour', label: 'Golden hour' },
  { id: 'night', label: 'Night' },
];
const title = 'HorneroOS Greeter | Argentina, before the desktop';
const description =
  'Explore HorneroOS’s offline SDDM greeter: a cinematic welcome shaped by Argentine landscapes and the light of the hour.';
---

<SiteLayout
  title={title}
  description={description}
  socialImage="/media/greeter/ar-er-el-palmar-golden-hour.webp"
  socialImageAlt="Palms and grasslands of El Palmar National Park in the HorneroOS greeter preview"
>
  <div class="greeter-page">
    <div class="greeter-hero">
      <header class="greeter-intro">
        <p class="eyebrow">
          <span aria-hidden="true">01 / 04</span> HORNEROS GREETER
        </p>
        <h1>
          A little of Argentina
          <br />
          <em>before the desktop.</em>
        </h1>
        <p class="intro-copy">
          A quiet welcome, carried by the landscapes and city lights of Argentina. The real greeter changes its local
          background with the hour and keeps every frame on your computer.
        </p>
      </header>

      <section class="experience" aria-label="Interactive HorneroOS greeter preview">
        <p class="preview-label">
          <span aria-hidden="true">◉</span> Browser recreation · interactive preview · no credentials collected
        </p>
        <div
          class="screen"
          id="greeter-preview"
          data-day-start={greeterSceneCatalogue.dayparts.dayStart}
          data-day-end={greeterSceneCatalogue.dayparts.dayEnd}
          data-golden-start={greeterSceneCatalogue.dayparts.goldenHourStart}
          data-golden-end={greeterSceneCatalogue.dayparts.goldenHourEnd}
        >
          <img class="screen-poster" src={firstScene.poster} alt="" width="1280" height="720" fetchpriority="high" />
          <img
            class="screen-poster screen-poster-alt"
            src={firstScene.poster}
            alt=""
            width="1280"
            height="720"
            aria-hidden="true"
          />
          <video
            class="screen-video"
            muted
            playsinline
            loop
            preload="none"
            poster={firstScene.poster}
            aria-hidden="true"
          ></video>
          <div class="screen-shade" aria-hidden="true"></div>
          <div class="screen-top" aria-hidden="true">
            <div class="session-tools">
              <span class="session-select">
                Hyprland <i>⌄</i>
              </span>
              <span class="layout-select">
                EN <i>⌄</i>
              </span>
            </div>
            <div class="power-tools">
              <span title="Reboot">↻</span>
              <span title="Shut down">⏻</span>
            </div>
          </div>
          <div class="login-scene">
            <div class="clock-block" aria-live="off">
              <time class="clock" id="preview-clock">
                --:--
              </time>
              <span class="date" id="preview-date">
                Local time
              </span>
            </div>
            <div class="login-card" aria-label="Non-interactive sample login appearance">
              <div class="sample-row">
                <span>Username</span>
                <span class="sample-field">sample-user</span>
              </div>
              <div class="sample-row">
                <span>Password</span>
                <span class="sample-field password-field">
                  •••••••• <i>›</i>
                </span>
              </div>
            </div>
          </div>
          <img
            class="screen-brand"
            src="/media/greeter/hornero-symbolic.svg"
            alt=""
            aria-hidden="true"
            width="30"
            height="30"
          />
          <div class="scene-label">
            <span class="scene-pip"></span>
            <span id="scene-location">
              {firstScene.place} · {firstScene.province}
            </span>
          </div>
          <span class="screen-edge" aria-hidden="true"></span>
        </div>

        <div class="preview-controls">
          <div class="mood-control" role="group" aria-label="Choose greeter time of day">
            {moods.map((mood) => (
              <button
                type="button"
                class:list={['mood-button', mood.id === 'auto' && 'is-active']}
                data-mood={mood.id}
                aria-pressed={mood.id === 'auto'}
              >
                {mood.label}
              </button>
            ))}
          </div>
          <div class="scene-control">
            <div class="scene-copy">
              <span class="control-kicker" id="mood-status">
                FOLLOWING YOUR LOCAL TIME
              </span>
              <strong id="scene-title">{firstScene.title}</strong>
              <small id="scene-credit">
                {firstScene.creator} · {firstScene.license}
              </small>
            </div>
            <button
              type="button"
              class="icon-button"
              id="play-toggle"
              aria-label="Pause landscape playback"
              title="Pause landscape playback"
            >
              <span aria-hidden="true">Ⅱ</span>
            </button>
            <button type="button" class="next-button" id="next-scene">
              <span class="next-label">Next landscape</span>
              <span aria-hidden="true">↗</span>
            </button>
          </div>
        </div>
        <p class="experience-caption">
          <span>HORNEROOS SDDM GREETER</span>
          <span>SCENE SELECTED FROM {videoScenes.length} LOCAL VIDEO CLIPS + STILL FALLBACKS</span>
        </p>
      </section>
    </div>

    <section class="mood-story" aria-labelledby="moods-heading">
      <div class="section-head">
        <p class="eyebrow">THE LIGHT CHANGES</p>
        <h2 id="moods-heading">Argentina, hour by hour.</h2>
        <p>
          Use the time controls above to move between the moods. Auto follows your clock; no location permission is
          needed.
        </p>
      </div>
      <div class="mood-rail">
        {greeterScenes
          .filter((scene) => scene.kind === 'still')
          .map((scene) => (
            <button
              type="button"
              class="mood-card"
              data-mood-card={scene.daypart}
              aria-label={`Preview ${scene.daypart}: ${scene.place}`}
            >
              <img src={scene.poster} alt="" loading="lazy" width="1280" height="720" />
              <span class="mood-card-copy">
                <small>
                  {scene.daypart === 'golden-hour'
                    ? '17:00—20:00 · CONFIGURED LOCAL WINDOW'
                    : 'AFTER DARK · CONFIGURED FALLBACK'}
                </small>
                <strong>{scene.place}</strong>
                <span>{scene.title} · Open in the greeter</span>
              </span>
              <span class="mood-card-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        <button
          type="button"
          class="mood-card"
          data-mood-card="day"
          aria-label={`Preview daytime: ${firstScene.place}`}
        >
          <img src={firstScene.poster} alt="" loading="lazy" width="1280" height="720" />
          <span class="mood-card-copy">
            <small>07:00—19:00 · RANDOM LOCAL VIDEO</small>
            <strong>Daylight across Argentina</strong>
            <span>{firstScene.title} and other curated landscape clips.</span>
          </span>
          <span class="mood-card-arrow" aria-hidden="true">
            ↗
          </span>
        </button>
      </div>
    </section>

    <section class="scene-section" aria-labelledby="scenes-heading">
      <div class="scene-section-head">
        <div>
          <p class="eyebrow">A SMALL, EDITED COLLECTION</p>
          <h2 id="scenes-heading">Places with room to breathe.</h2>
        </div>
        <p>
          Each clip is checked for composition, readability behind the login panel, playback and redistribution rights.
          The daytime videos are local; the other moods use licensed stills until suitable video clears the same bar.
        </p>
      </div>
      <div class="scene-grid">
        {greeterScenes.map((scene) => (
          <article class:list={['scene-card', scene.kind === 'still' && 'still-scene']}>
            <button
              type="button"
              class="scene-image"
              data-select-scene={scene.id}
              aria-label={`Show ${scene.title} in the preview`}
            >
              <img
                src={scene.poster}
                alt={`${scene.place}, ${scene.province}`}
                loading="lazy"
                width="1280"
                height="720"
              />
              {scene.kind === 'video' && <span class="film-mark">MOTION</span>}
            </button>
            <div class="scene-meta">
              <span>
                {scene.province} <i aria-hidden="true">·</i> {scene.region}
              </span>
              <span>
                {scene.daypart === 'golden-hour'
                  ? 'GOLDEN HOUR STILL'
                  : scene.daypart === 'night'
                    ? 'NIGHT STILL'
                    : 'DAYTIME VIDEO'}
              </span>
            </div>
            <h3>{scene.title}</h3>
            <p>{scene.description}</p>
            <div class="credit-line">
              <span>{scene.creator}</span>
              <span>
                <a href={scene.licenseUrl} target="_blank" rel="noreferrer">
                  {scene.license}
                </a>{' '}
                ·{' '}
                <a href={scene.sourceUrl} target="_blank" rel="noreferrer">
                  Source ↗
                </a>
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="quiet-design" aria-labelledby="quiet-heading">
      <div class="quiet-number" aria-hidden="true">
        02
      </div>
      <div>
        <p class="eyebrow">BUILT FOR THE MOMENT BEFORE</p>
        <h2 id="quiet-heading">Atmosphere, with the login still in focus.</h2>
      </div>
      <ul>
        <li>
          <strong>Readable first.</strong>
          <span>Stable dark overlays keep the clock and login controls clear as scenes change.</span>
        </li>
        <li>
          <strong>Offline at login.</strong>
          <span>
            Video and still backgrounds are installed locally. Authentication never waits for a network stream.
          </span>
        </li>
        <li>
          <strong>Calm transitions.</strong>
          <span>
            Randomized clips avoid immediate repeats, preload the next scene and crossfade; a local still remains
            underneath.
          </span>
        </li>
        <li>
          <strong>Useful if media fails.</strong>
          <span>
            Missing or undecodable videos leave the static background in place. The greeter remains a login screen, not
            a player.
          </span>
        </li>
      </ul>
    </section>

    <section class="technical" aria-labelledby="technical-heading">
      <div>
        <p class="eyebrow">UNDER THE SURFACE</p>
        <h2 id="technical-heading">Local media. Qt6. SDDM.</h2>
        <p>
          The real Hornero greeter is a Qt6/QML SDDM theme. A separately installed media pack contains H.264 clips; the
          theme includes its fallback stills. A generated local catalog drives randomized, day-aware playback without
          login-time network access.
        </p>
      </div>
      <div class="tech-facts">
        <p>
          <span>LOGIN MANAGER</span>
          <strong>SDDM · Qt6</strong>
        </p>
        <p>
          <span>PLAYBACK</span>
          <strong>Local H.264, muted</strong>
        </p>
        <p>
          <span>DAYPART WINDOWS</span>
          <strong>07:00–19:00 · 17:00–20:00 golden</strong>
        </p>
        <p>
          <span>PROJECT STATUS</span>
          <strong>HorneroOS development preview</strong>
        </p>
      </div>
    </section>

    <section class="get-greeter">
      <div>
        <p class="eyebrow">PART OF THE HORNEROS DESKTOP</p>
        <h2>See where the desktop begins.</h2>
        <p>
          This page recreates the greeter in your browser; it does not authenticate and never collects credentials. The
          real theme and media pack are open source. HorneroOS remains a development preview.
        </p>
      </div>
      <div class="get-links">
        <a class="cta primary" href="https://github.com/HorneroOS/greeter">
          Explore the greeter source <span aria-hidden="true">↗</span>
        </a>
        <a href="/install">
          Check installation status <span aria-hidden="true">→</span>
        </a>
        <a href="https://github.com/HorneroOS/greeter/tree/main/media">
          Media provenance and manifests <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <script
    id="greeter-scene-data"
    type="application/json"
    set:html={JSON.stringify({ scenes: greeterScenes, dayparts: greeterSceneCatalogue.dayparts }).replaceAll(
      '<',
      '\\u003c',
    )}
  />
  <script>
    type Scene = {
      id: string;
      title: string;
      place: string;
      province: string;
      daypart: string;
      kind: 'video' | 'still';
      preview: string | null;
      poster: string;
      creator: string;
      license: string;
    };
    const root = document.querySelector<HTMLElement>('#greeter-preview');
    const dataNode = document.querySelector<HTMLScriptElement>('#greeter-scene-data');
    const scenes = dataNode ? (JSON.parse(dataNode.textContent || '{}').scenes as Scene[]) : [];
    const windows = root
      ? {
          dayStart: Number(root.dataset.dayStart),
          dayEnd: Number(root.dataset.dayEnd),
          goldenStart: Number(root.dataset.goldenStart),
          goldenEnd: Number(root.dataset.goldenEnd),
        }
      : null;
    const video = document.querySelector<HTMLVideoElement>('.screen-video');
    const posters = [...document.querySelectorAll<HTMLImageElement>('.screen-poster')];
    const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData ?? false;
    let mode = 'auto';
    let current: Scene | null = null;
    let playing = !prefersReduced.matches && !saveData;
    let previewVisible = false;
    let posterTransition = 0;
    const clock = document.querySelector<HTMLElement>('#preview-clock');
    const date = document.querySelector<HTMLElement>('#preview-date');
    const status = document.querySelector<HTMLElement>('#mood-status');
    const textNodes = {
      title: document.querySelector<HTMLElement>('#scene-title'),
      credit: document.querySelector<HTMLElement>('#scene-credit'),
      location: document.querySelector<HTMLElement>('#scene-location'),
    };
    const nextButton = document.querySelector<HTMLButtonElement>('#next-scene');
    const updateNextButton = (activeMood: string) => {
      if (!nextButton) return;
      const hasAlternatives = scenes.filter((scene) => scene.daypart === activeMood).length > 1;
      const moodName = activeMood.replace('-', ' ');
      nextButton.disabled = !hasAlternatives;
      nextButton.setAttribute(
        'aria-label',
        hasAlternatives ? 'Show another landscape' : `Only one landscape is available for ${moodName}`,
      );
      const label = nextButton.querySelector<HTMLElement>('.next-label');
      if (label) label.textContent = hasAlternatives ? 'Next landscape' : 'Only scene';
    };
    const hourMood = (hour: number) => {
      if (!windows) return 'day';
      if (hour >= windows.goldenStart && hour < windows.goldenEnd) return 'golden-hour';
      if (hour >= windows.dayStart && hour < windows.dayEnd) return 'day';
      return 'night';
    };
    const mood = () => (mode === 'auto' ? hourMood(new Date().getHours()) : mode);
    const choose = (activeMood: string, preferred?: Scene) => {
      const available = scenes.filter((scene) => scene.daypart === activeMood);
      if (!available.length) return;
      updateNextButton(activeMood);
      const pool = available.filter((scene) => scene.id !== current?.id);
      const next = preferred ?? pool[Math.floor(Math.random() * Math.max(pool.length, 1))] ?? available[0];
      current = next;
      const posterCurrent = posters[0];
      const posterBack = posters[1];
      if (posterBack && posterCurrent && posterBack.src !== new URL(next.poster, location.href).href) {
        window.clearTimeout(posterTransition);
        posterBack.classList.remove('is-visible');
        posterBack.src = next.poster;
        requestAnimationFrame(() => posterBack.classList.add('is-visible'));
        posterTransition = window.setTimeout(() => {
          posterCurrent.src = next.poster;
          posterBack.classList.remove('is-visible');
        }, 820);
      }
      if (textNodes.title) textNodes.title.textContent = next.title;
      if (textNodes.credit) textNodes.credit.textContent = `${next.creator} · ${next.license}`;
      if (textNodes.location) textNodes.location.textContent = `${next.place} · ${next.province}`;
      if (status)
        status.textContent =
          mode === 'auto'
            ? `FOLLOWING LOCAL TIME · ${activeMood.toUpperCase().replace('-', ' ')}`
            : `MANUAL MOOD · ${activeMood.toUpperCase().replace('-', ' ')}`;
      if (video) {
        video.pause();
        video.classList.remove('is-ready');
        video.removeAttribute('src');
        video.load();
        if (next.kind === 'video' && next.preview) {
          video.poster = next.poster;
          video.src = next.preview;
          if (playing && previewVisible && !document.hidden)
            void video.play().catch(() => {
              playing = false;
            });
        }
      }
      document.querySelectorAll<HTMLButtonElement>('.mood-button').forEach((button) => {
        const active = button.dataset.mood === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      document
        .querySelectorAll<HTMLElement>('[data-mood-card]')
        .forEach((card) => card.classList.toggle('is-selected', card.dataset.moodCard === activeMood));
    };
    const updateClock = () => {
      const now = new Date();
      if (clock)
        clock.textContent = new Intl.DateTimeFormat(undefined, {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        }).format(now);
      if (date)
        date.textContent = new Intl.DateTimeFormat(undefined, {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        }).format(now);
      if (mode === 'auto' && current?.daypart !== hourMood(now.getHours())) choose(hourMood(now.getHours()));
    };
    document.querySelectorAll<HTMLButtonElement>('.mood-button').forEach((button) =>
      button.addEventListener('click', () => {
        mode = button.dataset.mood || 'auto';
        choose(mood());
      }),
    );
    document.querySelector<HTMLButtonElement>('#next-scene')?.addEventListener('click', () => choose(mood()));
    document.querySelectorAll<HTMLButtonElement>('[data-select-scene]').forEach((button) =>
      button.addEventListener('click', () => {
        const scene = scenes.find((item) => item.id === button.dataset.selectScene);
        if (!scene) return;
        mode = scene.daypart;
        choose(mode, scene);
        document
          .querySelector('#greeter-preview')
          ?.scrollIntoView({ behavior: prefersReduced.matches ? 'auto' : 'smooth', block: 'center' });
      }),
    );
    document.querySelectorAll<HTMLButtonElement>('[data-mood-card]').forEach((button) =>
      button.addEventListener('click', () => {
        mode = button.dataset.moodCard || 'auto';
        choose(mode);
        document
          .querySelector('#greeter-preview')
          ?.scrollIntoView({ behavior: prefersReduced.matches ? 'auto' : 'smooth', block: 'center' });
      }),
    );
    const playButton = document.querySelector<HTMLButtonElement>('#play-toggle');
    const setPlaying = (value: boolean) => {
      playing = value;
      if (video && playing && previewVisible && current?.kind === 'video')
        void video.play().catch(() => {
          playing = false;
        });
      else video?.pause();
      if (playButton) {
        playButton.innerHTML = playing ? '<span aria-hidden="true">Ⅱ</span>' : '<span aria-hidden="true">▶</span>';
        playButton.setAttribute('aria-label', playing ? 'Pause landscape playback' : 'Play landscape playback');
      }
    };
    playButton?.addEventListener('click', () => setPlaying(!playing));
    video?.addEventListener('canplay', () => video.classList.add('is-ready'));
    prefersReduced.addEventListener('change', (event) => {
      if (event.matches) setPlaying(false);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video?.pause();
      else if (previewVisible && playing && current?.kind === 'video') void video?.play().catch(() => {});
    });
    if (root && 'IntersectionObserver' in window)
      new IntersectionObserver(([entry]) => {
        previewVisible = entry.isIntersecting;
        if (!previewVisible) video?.pause();
        else if (playing && current?.kind === 'video') void video?.play().catch(() => {});
      }).observe(root);
    updateClock();
    setInterval(updateClock, 30_000);
    choose(mood());
    if (saveData || prefersReduced.matches) setPlaying(false);
  </script>
</SiteLayout>

<style>
  .greeter-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(4rem, 8vw, 8.5rem);
    padding-bottom: clamp(4rem, 9vw, 9rem);
  }
  .greeter-hero {
    display: grid;
    grid-template-columns: minmax(18rem, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    width: min(100%, 1600px);
    margin-inline: auto;
  }
  .greeter-intro {
    min-width: 0;
    max-width: 78rem;
    margin-inline: auto;
    width: 100%;
    padding: 0;
  }
  .eyebrow {
    color: var(--highlight);
    font: 700 0.7rem/1.4 var(--font-data);
    letter-spacing: 0.13em;
  }
  .eyebrow span {
    color: var(--secondary);
    margin-right: 0.8rem;
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-ui);
    letter-spacing: -0.045em;
  }
  .greeter-intro h1 {
    margin-top: 1.1rem;
    max-width: 12ch;
    font-size: clamp(3rem, 4.4vw, 4.5rem);
    line-height: 0.98;
    font-weight: 560;
  }
  .greeter-intro h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .intro-copy {
    max-width: 57ch;
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.5vw, 1.24rem);
    line-height: 1.65;
    color: var(--text-muted);
  }
  .demo-note {
    margin-top: 1.4rem;
    color: var(--text);
    font: 600 0.78rem/1.5 var(--font-data);
  }
  .demo-note span {
    color: var(--secondary);
    padding-right: 0.45rem;
  }
  .experience {
    container-type: inline-size;
    min-width: 0;
    width: min(100%, 1480px);
    margin-inline: auto;
  }
  .preview-label {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font: 600 0.68rem/1.45 var(--font-data);
    letter-spacing: 0.02em;
  }
  .preview-label span {
    color: var(--secondary);
    padding-right: 0.35rem;
  }
  .screen {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    min-width: 0;
    aspect-ratio: 16 / 9;
    border: 1px solid color-mix(in oklab, var(--highlight) 35%, var(--line));
    border-radius: 18px;
    background: #111824;
    box-shadow: 0 28px 90px rgb(0 0 0 / 0.3);
    color: #fff;
  }
  .screen-poster,
  .screen-video,
  .screen-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .screen-poster,
  .screen-video {
    object-fit: cover;
  }
  .screen-poster {
    z-index: 0;
    opacity: 1;
    transition: opacity 0.75s ease;
  }
  .screen-poster-alt {
    opacity: 0;
  }
  .screen-poster-alt.is-visible {
    opacity: 1;
  }
  .screen-video {
    z-index: 1;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .screen-video.is-ready {
    opacity: 1;
  }
  .screen-shade {
    z-index: 2;
    background:
      linear-gradient(90deg, rgb(5 10 18 / 0.52), transparent 67%),
      linear-gradient(0deg, rgb(4 8 16 / 0.65), transparent 36%), rgb(4 8 16 / 0.18);
  }
  .screen-top,
  .screen-brand,
  .scene-label,
  .login-scene {
    position: absolute;
    z-index: 2;
  }
