---
import SiteLayout from '../layouts/SiteLayout.astro';
import { wallpapers } from '../data/product';

const filters = [
  { id: 'all', label: 'All scenes' },
  { id: 'urban-night', label: 'Urban night' },
  { id: 'blue-hour', label: 'Blue hour' },
  { id: 'wetlands', label: 'Wetlands' },
  { id: 'grassland', label: 'Grassland' },
  { id: 'glacier', label: 'Glacier' },
  { id: 'mineral', label: 'Mineral light' },
];
---

<SiteLayout
  title="Wallpapers — Hornero OS"
  description="Photographic Hornero Originals from Argentina, with verified locations, photographers, source links, and Creative Commons licenses."
>
  <main class="wallpapers-page">
    <header class="wallpaper-intro">
      <p class="eyebrow">Hornero Originals · Argentina</p>
      <h1>Places, seen<br /><em>in their own light.</em></h1>
      <p>
        A wallpaper can set the whole desktop’s atmosphere. This collection pairs Hornero’s regional themes with
        photographs made in Argentina: the southern channel at blue hour, wetlands under open sky, a city in amber light.
      </p>
      <p class="collection-facts">
        <span>{wallpapers.length} photographs</span><span>6 Hornero looks</span><span>CC BY / CC BY-SA</span>
      </p>
    </header>

    <section class="gallery" aria-labelledby="gallery-heading">
      <div class="gallery-heading">
        <div>
          <p class="eyebrow">The scene shapes the palette</p>
          <h2 id="gallery-heading">A visual atlas</h2>
        </div>
        <p>Each photograph is also the real default scene for its matching Hornero theme.</p>
      </div>
      <div class="filters" role="group" aria-label="Filter wallpapers by atmosphere">
        {filters.map((filter, index) => (
          <button type="button" data-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>
            {filter.label}
          </button>
        ))}
      </div>
      <ul class="wallpaper-grid" role="list">
        {wallpapers.map((wallpaper, index) => (
          <li id={wallpaper.id} class:list={['wallpaper-card', `wallpaper-card-${index + 1}`]} data-tags={wallpaper.aestheticTags.join(' ')}>
            <a class="wallpaper-image" href={wallpaper.preview} aria-label={`Open full preview: ${wallpaper.title}`}>
              <picture>
                <source
                  srcset={`${wallpaper.previewSmall} 720w, ${wallpaper.preview} 1280w`}
                  sizes="(min-width: 1100px) 48vw, (min-width: 680px) 48vw, calc(100vw - 2rem)"
                  type="image/webp"
                />
                <img
                  src={wallpaper.preview}
                  alt={wallpaper.previewAlt}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <span>Open image <span aria-hidden="true">↗</span></span>
            </a>
            <div class="wallpaper-caption">
              <div class="wallpaper-title">
                <div><p>{wallpaper.place}</p><h3>{wallpaper.title}</h3></div>
                <a class="theme-link" href={`/themes#${wallpaper.themeId}`}>View {wallpaper.themeId} theme</a>
              </div>
              <dl class="credits">
                <div><dt>Photographer</dt><dd>{wallpaper.photographer}</dd></div>
                <div><dt>License</dt><dd><a href={wallpaper.licenseUrl}>{wallpaper.license}</a></dd></div>
              </dl>
              <a class="source-link" href={wallpaper.sourcePage}>Source and full attribution</a>
            </div>
          </li>
        ))}
      </ul>
      <p class="no-results" hidden>No scenes match that filter.</p>
    </section>

    <section class="photo-note" aria-labelledby="photo-note-title">
      <p class="eyebrow">Photographs, not generated landscapes</p>
      <h2 id="photo-note-title">The geography is real.<br /><em>The interpretation is Hornero’s.</em></h2>
      <p>
        These are licensed, location-verified photographs, cropped and resized for desktop use. The source image,
        photographer, license, and modification are recorded in the product package. No buildings, skies, lights, or
        landscape details were generated or reconstructed.
      </p>
      <div class="note-links">
        <a href="https://github.com/HorneroOS/config/blob/main/docs/WALLPAPERS.md">How wallpapers are selected and packaged</a>
        <a href="https://github.com/HorneroOS/config/blob/main/profiles/themes/WALLPAPER-CREDITS.md">All photo credits and licenses</a>
        <a href="/themes">Explore every Hornero look</a>
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.wallpaper-card')];
  const empty = document.querySelector<HTMLElement>('.no-results');
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const tag = button.dataset.filter;
      let visible = 0;
      for (const card of cards) {
        const show = tag === 'all' || (card.dataset.tags ?? '').split(' ').includes(tag ?? '');
        card.hidden = !show;
        visible += Number(show);
      }
      buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      if (empty) empty.hidden = visible !== 0;
    });
  }
</script>

<style>
  .wallpapers-page { max-width: 88rem; margin: auto; padding: clamp(1.5rem, 4vw, 4rem) clamp(1rem, 4vw, 3.5rem) 5rem; }
  .wallpaper-intro { max-width: 68rem; padding-block: clamp(2rem, 7vw, 6rem); }
  .eyebrow { color: var(--accent); font: 0.72rem var(--font-data); letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { margin: 1rem 0 1.5rem; font-size: clamp(3rem, 8vw, 7rem); line-height: 0.95; letter-spacing: -0.07em; }
  h1 em, h2 em { color: var(--accent); font-weight: 400; }
  .wallpaper-intro > p:not(.eyebrow):not(.collection-facts) { max-width: 42rem; color: var(--muted); font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.7; }
  .collection-facts { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2rem; }
  .collection-facts span { padding: 0.55rem 0.8rem; border: 1px solid var(--line); border-radius: 999px; font: 0.68rem var(--font-data); }
  .gallery { border-top: 1px solid var(--line); padding-top: clamp(2rem, 5vw, 4rem); }
  .gallery-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  h2 { margin: 0.6rem 0; font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1; letter-spacing: -0.06em; }
  .gallery-heading > p { max-width: 27rem; color: var(--muted); }
  .filters { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.8rem 0 2rem; }
  .filters button { color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 0.6rem 0.9rem; cursor: pointer; font: 0.7rem var(--font-data); }
  .filters button[aria-pressed="true"] { color: var(--surface); background: var(--accent); border-color: var(--accent); }
  .filters button:focus-visible, a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .wallpaper-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap: 1.1rem; }
  .wallpaper-card { grid-column: span 3; min-width: 0; border: 1px solid var(--line); background: var(--surface); }
  .wallpaper-card:nth-child(3n + 1) { grid-column: span 4; }
  .wallpaper-card:nth-child(3n + 2) { grid-column: span 2; }
  .wallpaper-image { display: block; position: relative; overflow: hidden; background: #101114; aspect-ratio: 16 / 9; }
  .wallpaper-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 350ms ease; }
  .wallpaper-image:hover img { transform: scale(1.025); }
  .wallpaper-image > span { position: absolute; right: 0.8rem; bottom: 0.8rem; padding: 0.45rem 0.65rem; color: white; background: #090a0dcc; font: 0.65rem var(--font-data); }
  .wallpaper-caption { padding: clamp(1rem, 2vw, 1.4rem); }
  .wallpaper-title { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; }
  .wallpaper-title p, .wallpaper-title h3 { margin: 0; }
  .wallpaper-title p { color: var(--muted); font: 0.67rem var(--font-data); }
  .wallpaper-title h3 { margin-top: 0.45rem; font-size: clamp(1.3rem, 2vw, 1.8rem); letter-spacing: -0.04em; }
  .theme-link, .source-link, .credits a, .note-links a { color: var(--ink); text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  .theme-link { font-size: 0.78rem; }
  .credits { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin: 1.2rem 0 0.75rem; }
  .credits div { display: flex; gap: 0.5rem; font-size: 0.76rem; }
  .credits dt { color: var(--muted); }
  .credits dd { margin: 0; }
  .source-link { font-size: 0.75rem; }
  .photo-note { margin-top: clamp(4rem, 9vw, 8rem); padding: clamp(1.4rem, 4vw, 3rem); border: 1px solid var(--line); background: var(--surface); }
  .photo-note > p:not(.eyebrow) { max-width: 46rem; color: var(--muted); line-height: 1.7; }
  .note-links { display: flex; flex-wrap: wrap; gap: 0.8rem 1.5rem; margin-top: 1.5rem; font-size: 0.82rem; }
  .no-results { color: var(--muted); }
  @media (max-width: 700px) { .gallery-heading { display: block; } .wallpaper-grid { display: block; } .wallpaper-card + .wallpaper-card { margin-top: 1rem; } .wallpaper-title { display: block; } .theme-link { display: inline-block; margin-top: 0.75rem; } }
  @media (prefers-reduced-motion: reduce) { .wallpaper-image img { transition: none; } }
</style>
