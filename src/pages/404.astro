---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found — Hornero OS" description="This page does not exist." noindex>
  <section class="section lost">
    <div class="broadcast-plate">
      <p class="plate-id"><strong>Señal no encontrada</strong><span>ARG / 199X</span><span>Error 404</span></p>
      <div class="signal-bars" aria-hidden="true"><i></i><i></i><i></i></div>
      <h1>Page not found</h1>
      <p>There is no transmission at this address. Try one of these instead:</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/showroom">Showroom</a></li>
        <li><a href="/roots">Roots</a></li>
        <li><a href="/install">Install</a></li>
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .lost h1 { margin-block: 0.8rem 0.5rem; }
  .lost ul { margin-top: 0.8rem; padding-left: 1.25rem; }
  .lost li + li { margin-top: 0.35rem; }
</style>
