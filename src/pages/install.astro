---
import SiteLayout from '../layouts/SiteLayout.astro';
import { candidate, editions, latestTagged } from '../data/product';

const packages = [
  { name: 'horneroctl-bin', what: 'the system CLI (native binary)' },
  { name: 'hornero-shell', what: 'the Quickshell desktop shell and its layout presets' },
  { name: 'hornero-config', what: 'the desktop defaults and theme packs' },
  { name: 'hornero-greeter', what: 'the SDDM login screen' },
];
const preview = (v: string) => /preview(\d+)$/.exec(v)?.[1];
const statusName = {
  planned: 'Planned',
  experimental: 'Experimental',
  preview: 'Preview',
  supported: 'Supported',
} as const;
---

<SiteLayout
  socialImage="/og/install.png"
  socialImageAlt="HorneroOS Preview ISO: one image with Desktop and Studio Preview editions."
  title="Install | HorneroOS"
  description="The first HorneroOS Preview ISO is published: one x86_64 image with Desktop and Studio Preview editions, signed and checksum-verified. Arch packages remain available."
>
  <section class="section">
    <p class="plate-id"><strong>Estado real de instalación</strong><span>ARG / 199X</span><span>Primera ISO Preview</span></p>
    <h1>The first HorneroOS Preview ISO is here</h1>
    <p class="lede">
      One x86_64 ISO installs HorneroOS Desktop or the Studio Preview edition with selectable creative
      specializations. It passed the disposable-VM installation matrix (UEFI and BIOS, encrypted and unencrypted)
      and is published as a signed GitHub pre-release. This is a preview, not a stable release.
    </p>
    <p>
      <a href="https://apvhgc6x8t0o0dzm.public.blob.vercel-storage.com/iso/horneroos-2026.10-preview22-x86_64.iso">
        Download the Preview ISO (2.6 GB)
      </a>{' '}
      — also announced on the{' '}
      <a href="https://github.com/HorneroOS/hornero/releases/tag/v0.2.0-preview22">v0.2.0-preview22 release page</a>.
      Verify every copy with the{' '}
      <a href="https://apvhgc6x8t0o0dzm.public.blob.vercel-storage.com/iso/horneroos-2026.10-preview22-x86_64.iso.sha256">SHA-256 checksum</a>{' '}
      and the{' '}
      <a href="https://apvhgc6x8t0o0dzm.public.blob.vercel-storage.com/iso/horneroos-2026.10-preview22-x86_64.iso.sig">detached GPG signature</a>:
    </p>
    <ul role="list" class="packages">
      <li><code>horneroos-2026.10-preview22-x86_64.iso</code><span>the install image (Desktop + Studio Preview)</span></li>
      <li><code>SHA-256</code><span>38ec76d7c9c10ea3e956b2c9f2d8d420e3d09b61899dc453a2858622d7e90bd2</span></li>
      <li><code>Signature</code><span>HorneroOS releases key FCFBEE43925AB5429362278AE59EAB44AA2498DC; verify with the public key in the hornero repository (<code>packaging/keys/hornero-release.pub.asc</code>)</span></li>
    </ul>
    <p>
      Releases so far are compositions: exact shell and config commits tested together.{' '}
      {latestTagged && (
        <>
          The latest tagged one is{' '}
          <a href={`/releases#${latestTagged.name}`}>Development Preview {preview(latestTagged.version)}</a>
          {candidate && (
            <>
              , and <a href={`/releases#${candidate.name}`}>Development Preview {preview(candidate.version)}</a> is
              being prepared
            </>
          )}
          .
        </>
      )}
    </p>
  </section>

  <section class="section readiness" aria-labelledby="readiness-title">
    <h2 id="readiness-title">Where installation stands</h2>
    <dl class="readiness-ledger">
      <div class="state-available">
        <dt>Install image</dt>
        <dd><span class="state">Preview</span> First ISO published as a signed pre-release (v0.2.0-preview22), verified in guest and on host; a tampered copy fails checksum and signature verification.</dd>
      </div>
      <div class="state-provisional">
        <dt>Installer</dt>
        <dd><span class="state">Provisional</span> The Calamares build passed the VM install matrix (Desktop and Studio, UEFI/BIOS, encrypted/unencrypted). Panda Foss's custom installer remains the future official path.</dd>
      </div>
      <div class="state-available">
        <dt>Desktop packages</dt>
        <dd><span class="state">Available</span> Four AUR packages, for people who already run Arch Linux.</dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <h2>What exists today</h2>
    <p>
      The Desktop preview ships as Arch User Repository packages for people who already run Arch Linux. They are the
      components of a Wayland-first desktop, not a turnkey HorneroOS installation. Hyprland is the supported
      compositor and Niri is experimental. Quickshell is the shell runtime, not the operating system itself.
    </p>
    <ul role="list" class="packages">
      {packages.map((p) => (
        <li>
          <a href={`https://aur.archlinux.org/packages/${p.name}`}>
            <code>{p.name}</code>
          </a>
          <span>{p.what}</span>
        </li>
      ))}
    </ul>
    <p>
      The greeter package is optional and needs SDDM with Qt 6 Multimedia. Other compositors are not supported unless
      the edition catalogue and acceptance evidence say so.
    </p>
  </section>

  <section class="section">
    <h2>Edition readiness</h2>
    <p>
      Editions share one composition model. The maturity levels reflect what has been tested; they do not mean every
      edition can be installed.
    </p>
    <ul class="edition-status" role="list">
      {editions.map((edition) => (
        <li>
          <strong>{edition.title}</strong>
          <span class:list={['status-pill', `status-${edition.maturity}`]}>{statusName[edition.maturity]}</span>
        </li>
      ))}
    </ul>
    <p>
      Desktop is the current preview. Studio installs from the same Preview ISO as a candidate edition with
      selectable specializations and passed its VM install matrix; it is a <strong>Preview</strong> edition. The{' '}
      <code>hornero-qa studio-gate</code> hardware evidence is still pending, so VM results are not
      physical-hardware proof and Studio is not Supported yet. Server and
      Agents have composition definitions but no bootable image yet. Niri remains experimental within Desktop.{' '}
      <a href="/editions">How the editions fit together.</a>
    </p>
  </section>

  <section class="section">
    <h2>Testing and reports</h2>
    <p>
      The Preview ISO was tested in virtual machines, with UEFI and BIOS firmware. Reports from physical hardware are
      the next step, and they are the most useful thing you can send. Include the ISO name, your firmware type, whether
      the disk is encrypted, and the step where it failed.
    </p>
    <p>
      <a href="https://github.com/HorneroOS/hornero/issues/new">Report an install problem</a> ·{' '}
      <a href="https://github.com/HorneroOS/hornero/releases/tag/v0.2.0-preview22">Release notes and checksums</a>
    </p>
  </section>

  <section class="section">
    <h2>The installer</h2>
    <p>
      The Calamares build in <a href="https://github.com/HorneroOS/installer">HorneroOS/installer</a> is a provisional
      bridge for testing compositions and install flows. <a href="https://github.com/PandaFoss">Panda Foss</a> is
      developing the custom HorneroOS installer that is meant to become the official path, and will own it. The
      Calamares build is not that installer and stays provisional until the custom one is ready to publish and passes
      acceptance. It uses the edition and compositor contract instead of defining its own package model. Its ISO and
      install flow passed UEFI and BIOS acceptance in disposable virtual machines for the Preview ISO above.
    </p>
    <p>
      Contributors can follow the <a href="/docs/development/design-language/">HorneroOS design language</a>, which
      points to the authoritative design sources for the desktop, website, greeter and installer.
    </p>
    <p>
      To follow tagged compositions, see <a href="/releases">Releases</a> or the{' '}
      <a href="https://github.com/HorneroOS">HorneroOS organization</a> on GitHub.
    </p>
  </section>
</SiteLayout>

<style>
  .packages {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .packages li {
    display: grid;
    grid-template-columns: minmax(10rem, max-content) 1fr;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .packages span {
    color: var(--text-muted);
  }

  .edition-status {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    max-width: 58rem;
    margin-block: 1rem;
    list-style: none;
  }

  .edition-status li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .status-pill {
    flex: none;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font: 0.66rem var(--font-data);
    text-transform: uppercase;
  }

  .status-preview {
    border-color: var(--accent);
    color: var(--text);
  }
  .status-experimental {
    border-color: var(--highlight);
    color: var(--highlight);
  }

  @media (max-width: 520px) {
    .packages li {
      grid-template-columns: 1fr;
    }

    .edition-status {
      grid-template-columns: 1fr;
    }
  }
  .readiness-ledger { max-width: 58rem; border-top: 1px solid var(--line); }
  .readiness-ledger > div { display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(0, 4fr); gap: 0.4rem 1.5rem; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .readiness-ledger dt { font: 700 1.1rem var(--font-display); }
  .readiness-ledger dd { color: var(--text-muted); }
  .state { display: inline-block; margin-right: 0.7rem; padding: 0.1rem 0.5rem; border: 1px solid var(--line); color: var(--text); font: 600 0.7rem var(--font-data); font-stretch: 87.5%; text-transform: uppercase; }
  .state-none { border-bottom-style: dashed; }
  .state-none .state { border-style: dashed; color: var(--text-muted); }
  .state-provisional .state { border-color: var(--highlight); color: var(--highlight); }
  .state-available .state { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 560px) { .readiness-ledger > div { grid-template-columns: 1fr; } }
</style>

<style>
  /* 199X per-page direction: install as an honest status board. */
  .edition-status { border: 1px solid var(--line); box-shadow: 8px 8px 0 color-mix(in srgb, var(--accent) 16%, transparent); }
  .packages > * { border-radius: 2px; }
</style>
