---
import SiteLayout from '../layouts/SiteLayout.astro';
import { candidate, editions, latestTagged } from '../data/product';

const packages = [
  { name: 'horneroctl-bin', what: 'the system CLI (native binary)' },
  { name: 'hornero-shell', what: 'the Quickshell desktop shell and its layout presets' },
  { name: 'hornero-config', what: 'the desktop defaults and theme packs' },
  { name: 'hornero-greeter', what: 'the SDDM login screen' },
];
const preview = (v: string) => /preview(\d+)$/.exec(v)?.[1];
const statusName = {
  planned: 'Planned',
  experimental: 'Experimental',
  preview: 'Preview',
  supported: 'Supported',
} as const;
---

<SiteLayout
  title="Install — Hornero OS"
  description="HorneroOS Desktop is available as Arch packages. The provisional Calamares installer has not completed VM acceptance, and no install image is published."
>
  <section class="section">
    <p class="eyebrow">Status</p>
    <h1>No published install image</h1>
    <p class="lede">
      HorneroOS has no published ISO. A provisional Calamares installer is in development, but it has not completed
      virtual-machine installation acceptance and is not a supported general install path.
    </p>
    <p>
      Releases so far are compositions: exact shell and config commits tested together.{' '}
      {latestTagged && (
        <>
          The latest tagged one is{' '}
          <a href={`/releases#${latestTagged.name}`}>Development Preview {preview(latestTagged.version)}</a>
          {candidate && (
            <>
              , and <a href={`/releases#${candidate.name}`}>Development Preview {preview(candidate.version)}</a> is
              being prepared
            </>
          )}
          .
        </>
      )}
    </p>
  </section>

  <section class="section">
    <h2>What exists today</h2>
    <p>
      The Desktop preview is distributed as Arch User Repository packages for people who already run Arch Linux. Those
      packages are components of a Wayland-first desktop, not a turnkey HorneroOS installation. Hyprland is its
      supported default compositor; Niri is experimental. Quickshell is the current shell runtime, not the identity of
      the operating system.
    </p>
    <ul role="list" class="packages">
      {packages.map((p) => (
        <li>
          <a href={`https://aur.archlinux.org/packages/${p.name}`}>
            <code>{p.name}</code>
          </a>
          <span>{p.what}</span>
        </li>
      ))}
    </ul>
    <p>
      The greeter package is optional and requires SDDM with Qt 6 Multimedia. Other compositors are not advertised as
      supported unless the edition catalogue and acceptance evidence say so.
    </p>
  </section>

  <section class="section">
    <h2>One family, distinct readiness</h2>
    <p>
      Profiles share one composition model. Their names and maturity levels reflect what has been tested, not a promise
      that each profile can already be installed.
    </p>
    <ul class="edition-status" role="list">
      {editions.map((edition) => (
        <li>
          <strong>{edition.title}</strong>
          <span class:list={['status-pill', `status-${edition.maturity}`]}>{statusName[edition.maturity]}</span>
        </li>
      ))}
    </ul>
    <p>
      Desktop is the current preview. Server, Agents and Studio have composition definitions but no bootable image or
      acceptance-complete runtime yet. Niri remains experimental within Desktop.{' '}
      <a href="/editions">Read about how the profiles fit together.</a>
    </p>
  </section>

  <section class="section">
    <h2>Install work follows product truth</h2>
    <p>
      The provisional Calamares work lives in{' '}
      <a href="https://github.com/HorneroOS/installer">HorneroOS/installer</a>. It consumes the edition and compositor
      contract rather than defining a separate package model. Its ISO and install flow remain uncertified until UEFI and
      BIOS installs pass in a disposable virtual machine. No ISO download is available from this page.
    </p>
    <p>
      To follow tagged compositions, see <a href="/releases">Releases</a> or the{' '}
      <a href="https://github.com/HorneroOS">HorneroOS organisation</a> on GitHub.
    </p>
  </section>
</SiteLayout>

<style>
  .packages {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .packages li {
    display: grid;
    grid-template-columns: minmax(10rem, max-content) 1fr;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .packages span {
    color: var(--text-muted);
  }

  .edition-status {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    max-width: 58rem;
    margin-block: 1rem;
    list-style: none;
  }

  .edition-status li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .status-pill {
    flex: none;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font: 0.66rem var(--font-data);
    text-transform: uppercase;
  }

  .status-preview {
    border-color: var(--accent);
    color: var(--text);
  }
  .status-experimental {
    border-color: var(--highlight);
    color: var(--highlight);
  }

  @media (max-width: 520px) {
    .packages li {
      grid-template-columns: 1fr;
    }

    .edition-status {
      grid-template-columns: 1fr;
    }
  }
</style>
