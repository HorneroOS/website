---
import SiteLayout from '../layouts/SiteLayout.astro';
import { terminalCatalogue } from '../data/product';
import KilnStamp from '../components/KilnStamp.astro';
import AppLogo from '../components/AppLogo.astro';

const terminals = terminalCatalogue.integrations;
const defaultTerminal = terminals.find((terminal) => terminal.id === terminalCatalogue.default);
const exampleTerminal = terminals.find((terminal) => terminal.id !== defaultTerminal?.id) ?? terminals[0];
const alternativeTerminalIds = terminals.filter((terminal) => terminal.id !== exampleTerminal?.id).map((terminal) => terminal.id);
const terminalNames = terminals.map((terminal) => terminal.name).join(', ');
const displayPath = (path: string) => path.replaceAll('{config}', '~/.config').replaceAll('{cache}', '~/.cache');
---

<SiteLayout
  title={`Terminals — ${terminalNames} | HorneroOS`}
  description={`Choose among ${terminalNames} in Hornero Settings. Each terminal receives the Hornero palette in its own native format.`}
>
  <section class="terminal-intro section" aria-labelledby="terminal-title">
    <div class="terminal-heading">
      <h1 id="terminal-title">Terminals</h1>
      <p class="lede">
        {terminalNames} can follow the Hornero appearance. Hornero writes the colors in each terminal’s native format.
        Install the emulators you want, then choose which one Hornero opens.
      </p>
      <div class="terminal-actions">
        <a class="cta primary" href="/docs/applications/terminal/">Read the terminal guide <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/themes">Explore Hornero appearances</a>
      </div>
    </div>
    <aside class="terminal-note" aria-label="How terminal selection works">
      <strong>Default terminal</strong>
      <p>Settings lists the supported emulators, marks which are installed and lets you pick only an installed one. {defaultTerminal?.name ?? 'The default terminal'} is the factory choice.</p>
      {exampleTerminal && <code class="command">horneroctl config default-apps set terminal {exampleTerminal.id} --yes</code>}
      {exampleTerminal && alternativeTerminalIds.length > 0 && <small>Replace <code>{exampleTerminal.id}</code> with {alternativeTerminalIds.map((id, index) => <>{index > 0 && ' or '}<code>{id}</code></>)}.</small>}
    </aside>
  </section>

  <section class="terminal-proof section" aria-labelledby="terminal-proof-title">
    <figure class="terminal-capture">
      <div class="capture-screen">
        <img
          src="/images/apps/kitty-appearance.webp"
          alt="Kitty on Hornero showing the available appearance themes and the generated dark color palette."
          width="1100"
          height="720"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>
        <KilnStamp
          source="Hornero development host"
          context="Kitty · appearance CLI"
          theme="Dark"
          resolution="1100 × 720"
          date="2026-10-04"
        />
      </figcaption>
    </figure>
    <div class="proof-copy">
      <h2 id="terminal-proof-title">Kitty with the Hornero palette</h2>
      <p>
        Kitty keeps its native configuration and receives Hornero’s generated colors in Kitty’s own format. The same
        appearance engine writes the matching output for Alacritty and Ghostty when they are installed.
      </p>
      <a class="text-link" href="/themes">See how appearances carry across the desktop</a>
    </div>
  </section>

  <section class="terminal-field section" aria-labelledby="terminal-field-title">
    <div class="field-heading">
      <div>
        <h2 id="terminal-field-title">{terminals.length} supported terminals</h2>
      </div>
      <p>Hornero keeps each terminal’s own conventions. The palette from your wallpaper is translated into each native format instead of one generic theme file.</p>
    </div>
    <div class="terminal-list">
      {terminals.map((terminal) => (
        <article class="terminal-entry" id={terminal.id}>
          <div class="terminal-entry-heading">
            <AppLogo id={terminal.id} />
            <div><h3>{terminal.name}</h3><span class="terminal-role">{terminal.role === 'default' ? 'Factory choice' : 'Supported alternative'}</span></div>
          </div>
          <p>{terminal.detail}</p>
          <div class="terminal-config" role="group" aria-label={`${terminal.name} configuration example`}>
            <div class="terminal-package">
              <span class="config-label">Install from the Arch repositories</span>
              <code>sudo pacman -S --needed {terminal.package}</code>
            </div>
            <div class="terminal-factory-config">
              <span class="config-label">Factory config</span>
              <code>{terminal.configExample}</code>
            </div>
          </div>
          <dl class="terminal-output">
            <div><dt>Config file</dt><dd><code>{displayPath(terminal.configPath)}</code></dd></div>
            <div><dt>Generated palette</dt><dd><code>{terminal.palette}</code></dd></div>
            <div><dt>Written under</dt><dd><code>{displayPath(terminal.palettePath)}</code></dd></div>
          </dl>
          <p class="terminal-footnote">{terminal.note}</p>
        </article>
      ))}
    </div>
    <aside class="preview-strip" aria-label="Image previews with Yazi">
      <AppLogo id="yazi" />
      <p>
        <strong>Image previews.</strong> Yazi shows images inside the terminal, through Kitty’s graphics protocol or, under
        Alacritty where configured, the Wayland adapter through Überzug++.
      </p>
    </aside>
  </section>

  <section class="terminal-flow section" aria-labelledby="terminal-flow-title">
    <div class="flow-mark" aria-hidden="true"><span>01</span><i></i><span>02</span><i></i><span>03</span></div>
    <div>
      <h2 id="terminal-flow-title">Setup</h2>
      <ol class="flow-steps">
        <li><strong>Install a terminal</strong><span>{defaultTerminal?.name ?? 'The default terminal'} is the factory choice. The other listed emulators are optional packages.</span></li>
        <li><strong>Select it in Settings</strong><span>Control Center marks installed choices and does not let you select a terminal that is not installed.</span></li>
        <li><strong>Change appearance</strong><span>Hornero writes fresh native palettes for all {terminals.length} integrations; the active terminal reads its own file.</span></li>
      </ol>
      <p class="terminal-caveat">This page describes the current Arch package integration. Terminal packages are separate from Hornero Shell, so installing Hornero does not require every emulator.</p>
    </div>
  </section>
</SiteLayout>

<style>
  .terminal-intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; margin-block-start: 0; padding-block: clamp(1.25rem, 3vw, 2.5rem); }
  .terminal-heading h1 { max-width: 14ch; margin-top: 1rem; font-size: clamp(3.5rem, 6.6vw, 6rem); line-height: 0.9; letter-spacing: -0.078em; }
  .terminal-heading h1 em { color: var(--accent); font-style: normal; }
  .terminal-heading .lede { max-width: 56ch; margin-top: 1.2rem; }
  .terminal-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.5rem; }
  .terminal-note { display: grid; gap: 0.85rem; padding: 1.2rem 0 0 1.2rem; border-top: 2px solid var(--highlight); border-left: 1px solid var(--line); }
  .config-label { color: var(--secondary); font: 0.65rem var(--font-data); letter-spacing: 0.08em; }
  .terminal-note strong { font-family: var(--font-display); font-size: 1.3rem; }
  .terminal-note p, .terminal-note small { color: var(--text-muted); line-height: 1.55; }
  .command { padding: 0.7rem; overflow-wrap: anywhere; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: 0.78rem; }
  .terminal-proof { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); align-items: center; gap: clamp(2rem, 7vw, 7rem); padding-block: clamp(2rem, 5vw, 4rem); }
  .terminal-capture { display: grid; gap: 0.65rem; min-width: 0; margin: 0; }
  .capture-screen { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: #131518; box-shadow: 0 14px 36px rgb(0 0 0 / 0.18); }
  .capture-screen img { display: block; width: 100%; height: auto; }
  .proof-copy { max-width: 42rem; }
  .proof-copy h2 { max-width: 12ch; margin-top: 0.5rem; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -0.055em; }
  .proof-copy > p:not(.eyebrow) { margin-top: 1rem; color: var(--text-muted); line-height: 1.65; }
  .proof-copy .text-link { display: inline-flex; margin-top: 1.1rem; }
  .terminal-field { padding-block: clamp(2rem, 6vw, 5rem); border-block: 1px solid var(--line); }
  .field-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.4rem; }
  .field-heading h2, .terminal-flow h2 { margin-top: 0.4rem; }
  .field-heading > p { max-width: 45ch; color: var(--text-muted); }
  .terminal-list { border-top: 1px solid var(--line); }
  .terminal-entry { display: grid; grid-template-columns: 0.8fr 1fr 1.2fr; gap: 1rem 2rem; align-items: start; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .terminal-entry-heading { --app-logo-size: 2.6rem; display: flex; align-items: center; gap: 0.8rem; }
  .preview-strip { --app-logo-size: 3rem; display: flex; align-items: center; gap: 1rem; margin-top: 1.4rem; padding: 1rem 0.2rem; border-top: 1px solid var(--line); }
  .preview-strip p { max-width: 75ch; color: var(--text-muted); font-size: 0.88rem; line-height: 1.55; }
  .preview-strip strong { color: var(--text); font-family: var(--font-display); }
  .terminal-entry h3 { font-size: 1.6rem; }
  .terminal-role { display: block; margin-top: 0.1rem; color: var(--text-muted); font: 0.64rem var(--font-data); text-transform: uppercase; }
  .terminal-entry > p { max-width: 38ch; color: var(--text-muted); font-size: 0.9rem; }
  .terminal-config { display: grid; gap: 0.9rem; min-width: 0; padding: 0.75rem; border-left: 2px solid var(--accent); background: var(--surface); }
  .terminal-package, .terminal-factory-config { display: grid; gap: 0.45rem; min-width: 0; }
  .terminal-config code { overflow-wrap: anywhere; color: var(--text); font-size: 0.77rem; }
  .terminal-output { grid-column: 2 / -1; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0; }
  .terminal-output div { display: grid; gap: 0.2rem; }
  .terminal-output dt { color: var(--secondary); font: 0.62rem var(--font-data); text-transform: uppercase; }
  .terminal-output dd { margin: 0; color: var(--text); font-size: 0.77rem; overflow-wrap: anywhere; }
  .terminal-footnote { grid-column: 2 / -1; max-width: 80ch; font-size: 0.78rem !important; }
  .terminal-flow { display: grid; grid-template-columns: 0.55fr 1fr; gap: clamp(2rem, 9vw, 8rem); padding-block: clamp(3rem, 9vw, 8rem); }
  .flow-mark { display: flex; align-items: center; gap: 0.75rem; color: var(--secondary); font: 0.68rem var(--font-data); }
  .flow-mark i { width: min(7vw, 5rem); height: 1px; background: var(--line); }
  .flow-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 0; margin-top: 1.4rem; list-style: none; counter-reset: step; }
  .flow-steps li { display: grid; align-content: start; gap: 0.6rem; min-height: 8rem; padding-top: 0.8rem; border-top: 1px solid var(--highlight); }
  .flow-steps strong { font-family: var(--font-display); }
  .flow-steps span { color: var(--text-muted); font-size: 0.82rem; line-height: 1.5; }
  .terminal-caveat { max-width: 72ch; margin-top: 1.2rem; color: var(--text-muted); font-size: 0.78rem; }
  @media (max-width: 800px) {
    .terminal-intro { grid-template-columns: 1fr; align-items: start; }
    .terminal-note { max-width: 34rem; }
    .terminal-proof { grid-template-columns: 1fr; gap: 1.5rem; }
    .terminal-capture { max-width: 48rem; }
    .field-heading { align-items: start; flex-direction: column; }
    .terminal-entry { grid-template-columns: 0.65fr 1fr; }
    .terminal-config { grid-column: 2; }
    .terminal-output, .terminal-footnote { grid-column: 2; }
    .terminal-flow { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 520px) {
    .terminal-heading h1 { font-size: clamp(2.7rem, 12vw, 4.3rem); }
    .terminal-actions { align-items: start; flex-direction: column; }
    .terminal-entry { grid-template-columns: 1fr; gap: 0.8rem; }
    .terminal-config, .terminal-output, .terminal-footnote { grid-column: 1; }
    .flow-steps { grid-template-columns: 1fr; }
    .flow-steps li { min-height: auto; }
  }
</style>
