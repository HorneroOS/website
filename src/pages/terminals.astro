---
import SiteLayout from '../layouts/SiteLayout.astro';

const terminals = [
  {
    id: 'kitty',
    name: 'Kitty',
    role: 'Factory choice',
    detail: 'GPU-accelerated, with the Kitty graphics protocol used by Yazi previews.',
    config: 'include ~/.cache/hornero/smart-colors/colors-kitty.conf',
    palette: 'colors-kitty.conf',
    path: '~/.cache/hornero/smart-colors/',
    note: 'A static Hornero Dark or Light palette keeps the terminal readable before the first generated scheme.',
  },
  {
    id: 'alacritty',
    name: 'Alacritty',
    role: 'Supported alternative',
    detail: 'A compact TOML configuration with live reload; Yazi image previews use the Wayland adapter through Überzug++ where configured.',
    config: 'import = ["hornero-dark.toml", "hornero-colors.toml"]',
    palette: 'hornero-colors.toml',
    path: '~/.config/alacritty/',
    note: 'The packaged dark/light fallback and generated color file are imported separately, so wallpaper colors can update without replacing your base config.',
  },
  {
    id: 'ghostty',
    name: 'Ghostty',
    role: 'Supported alternative',
    detail: 'A native Ghostty theme with a stable name that Hornero can refresh when appearance changes.',
    config: 'theme = Hornero Dynamic',
    palette: 'Hornero Dynamic',
    path: '~/.config/ghostty/themes/',
    note: 'A packaged system fallback is available before Hornero writes the user-level wallpaper palette.',
  },
];
---

<SiteLayout
  title="Terminals — Kitty, Alacritty and Ghostty | HorneroOS"
  description="Choose an installed Kitty, Alacritty or Ghostty terminal in Hornero Settings. One Hornero appearance is rendered in each terminal's native palette format."
>
  <section class="terminal-intro section" aria-labelledby="terminal-title">
    <div class="terminal-heading">
      <p class="eyebrow">One appearance · native terminal configs</p>
      <h1 id="terminal-title">Your terminal.<br /><em>Still in tune.</em></h1>
      <p class="lede">
        Kitty, Alacritty and Ghostty can follow the same Hornero appearance. The desktop generates a palette in each
        terminal’s own format and leaves your chosen emulator yours to select.
      </p>
      <div class="terminal-actions">
        <a class="cta primary" href="/docs/applications/terminal/">Read the terminal guide <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/themes">Explore Hornero appearances <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <aside class="terminal-note" aria-label="How terminal selection works">
      <span class="note-index">SYSTEM / DEFAULT APPS</span>
      <strong>Choose from what is installed.</strong>
      <p>Settings lists the supported emulators present on your system. Select one there or set it with <code>horneroctl</code>.</p>
      <code class="command">horneroctl config default-apps set terminal ghostty --yes</code>
      <small>Replace <code>ghostty</code> with <code>kitty</code> or <code>alacritty</code>.</small>
    </aside>
  </section>

  <section class="terminal-field section" aria-labelledby="terminal-field-title">
    <div class="field-heading">
      <div>
        <p class="eyebrow">Three emulators, one color source</p>
        <h2 id="terminal-field-title">Native where it matters.</h2>
      </div>
      <p>Hornero keeps each terminal’s conventions intact. Your selected wallpaper palette is translated to the native format rather than forcing every emulator through one generic theme file.</p>
    </div>
    <div class="terminal-list">
      {terminals.map((terminal, index) => (
        <article class="terminal-entry" id={terminal.id}>
          <div class="terminal-entry-heading">
            <span class="terminal-number">0{index + 1}</span>
            <div><h3>{terminal.name}</h3><span class="terminal-role">{terminal.role}</span></div>
          </div>
          <p>{terminal.detail}</p>
          <div class="terminal-config" aria-label={`${terminal.name} configuration example`}>
            <span class="config-label">FACTORY CONFIG</span>
            <code>{terminal.config}</code>
          </div>
          <dl class="terminal-output">
            <div><dt>Generated palette</dt><dd><code>{terminal.palette}</code></dd></div>
            <div><dt>Written under</dt><dd><code>{terminal.path}</code></dd></div>
          </dl>
          <p class="terminal-footnote">{terminal.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="terminal-flow section" aria-labelledby="terminal-flow-title">
    <div class="flow-mark" aria-hidden="true"><span>01</span><i></i><span>02</span><i></i><span>03</span></div>
    <div>
      <p class="eyebrow">A practical workflow</p>
      <h2 id="terminal-flow-title">Install. Choose. Apply a look.</h2>
      <ol class="flow-steps">
        <li><strong>Install a terminal</strong><span>Kitty is the factory choice. Alacritty and Ghostty remain optional packages.</span></li>
        <li><strong>Select it in Settings</strong><span>Control Center shows only supported terminals that are actually installed.</span></li>
        <li><strong>Change appearance</strong><span>Hornero writes fresh native palettes for all three integrations; the active terminal reads its own file.</span></li>
      </ol>
      <p class="terminal-caveat">This page describes the current Arch package integration. Terminal packages are separate from Hornero Shell; installing Hornero does not require installing every emulator.</p>
    </div>
  </section>
</SiteLayout>

<style>
  .terminal-intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; margin-block-start: 0; padding-block: clamp(1.25rem, 3vw, 2.5rem); }
  .terminal-heading h1 { max-width: 14ch; margin-top: 1rem; font-size: clamp(3.5rem, 6.6vw, 6rem); line-height: 0.9; letter-spacing: -0.078em; }
  .terminal-heading h1 em { color: var(--accent); font-style: normal; }
  .terminal-heading .lede { max-width: 56ch; margin-top: 1.2rem; }
  .terminal-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.5rem; }
  .terminal-note { display: grid; gap: 0.85rem; padding: 1.2rem 0 0 1.2rem; border-top: 2px solid var(--highlight); border-left: 1px solid var(--line); }
  .note-index, .config-label { color: var(--secondary); font: 0.65rem var(--font-data); letter-spacing: 0.08em; }
  .terminal-note strong { font-family: var(--font-display); font-size: 1.3rem; }
  .terminal-note p, .terminal-note small { color: var(--text-muted); line-height: 1.55; }
  .command { padding: 0.7rem; overflow-wrap: anywhere; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: 0.78rem; }
  .terminal-field { padding-block: clamp(2rem, 6vw, 5rem); border-block: 1px solid var(--line); }
  .field-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.4rem; }
  .field-heading h2, .terminal-flow h2 { margin-top: 0.4rem; }
  .field-heading > p { max-width: 45ch; color: var(--text-muted); }
  .terminal-list { border-top: 1px solid var(--line); }
  .terminal-entry { display: grid; grid-template-columns: 0.8fr 1fr 1.2fr; gap: 1rem 2rem; align-items: start; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .terminal-entry-heading { display: flex; align-items: start; gap: 0.8rem; }
  .terminal-number { padding-top: 0.25rem; color: var(--highlight); font: 0.72rem var(--font-data); }
  .terminal-entry h3 { font-size: 1.6rem; }
  .terminal-role { display: block; margin-top: 0.1rem; color: var(--text-muted); font: 0.64rem var(--font-data); text-transform: uppercase; }
  .terminal-entry > p { max-width: 38ch; color: var(--text-muted); font-size: 0.9rem; }
  .terminal-config { display: grid; gap: 0.6rem; min-width: 0; padding: 0.75rem; border-left: 2px solid var(--accent); background: var(--surface); }
  .terminal-config code { overflow-wrap: anywhere; color: var(--text); font-size: 0.77rem; }
  .terminal-output { grid-column: 2 / -1; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0; }
  .terminal-output div { display: grid; gap: 0.2rem; }
  .terminal-output dt { color: var(--secondary); font: 0.62rem var(--font-data); text-transform: uppercase; }
  .terminal-output dd { margin: 0; color: var(--text); font-size: 0.77rem; overflow-wrap: anywhere; }
  .terminal-footnote { grid-column: 2 / -1; max-width: 80ch; font-size: 0.78rem !important; }
  .terminal-flow { display: grid; grid-template-columns: 0.55fr 1fr; gap: clamp(2rem, 9vw, 8rem); padding-block: clamp(3rem, 9vw, 8rem); }
  .flow-mark { display: flex; align-items: center; gap: 0.75rem; color: var(--secondary); font: 0.68rem var(--font-data); }
  .flow-mark i { width: min(7vw, 5rem); height: 1px; background: var(--line); }
  .flow-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 0; margin-top: 1.4rem; list-style: none; counter-reset: step; }
  .flow-steps li { display: grid; align-content: start; gap: 0.6rem; min-height: 8rem; padding-top: 0.8rem; border-top: 1px solid var(--highlight); }
  .flow-steps strong { font-family: var(--font-display); }
  .flow-steps span { color: var(--text-muted); font-size: 0.82rem; line-height: 1.5; }
  .terminal-caveat { max-width: 72ch; margin-top: 1.2rem; color: var(--text-muted); font-size: 0.78rem; }
  @media (max-width: 800px) {
    .terminal-intro { grid-template-columns: 1fr; align-items: start; }
    .terminal-note { max-width: 34rem; }
    .field-heading { align-items: start; flex-direction: column; }
    .terminal-entry { grid-template-columns: 0.65fr 1fr; }
    .terminal-config { grid-column: 2; }
    .terminal-output, .terminal-footnote { grid-column: 2; }
    .terminal-flow { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 520px) {
    .terminal-heading h1 { font-size: clamp(2.7rem, 12vw, 4.3rem); }
    .terminal-actions { align-items: start; flex-direction: column; }
    .terminal-entry { grid-template-columns: 1fr; gap: 0.8rem; }
    .terminal-config, .terminal-output, .terminal-footnote { grid-column: 1; }
    .flow-steps { grid-template-columns: 1fr; }
    .flow-steps li { min-height: auto; }
  }
</style>
