---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pins, short } from '../data/product';

// Real companion frames from HorneroOS/shell assets/companion at the shell
// pin (checked out by the build); labels come from its manifest.json.
const frames = import.meta.glob<ImageMetadata>('../../.cache/product-src/shell/assets/companion/frames/*.png', {
  eager: true,
  import: 'default',
});
const frame = (name: string) => {
  const hit = Object.entries(frames).find(([path]) => path.endsWith(`/${name}.png`));
  if (!hit) throw new Error(`companion frame ${name} missing at the shell pin`);
  return hit[1];
};
const manifest = Object.values(
  import.meta.glob<{ skins: Record<string, { label: string }> }>(
    '../../.cache/product-src/shell/assets/companion/manifest.json',
    { eager: true, import: 'default' },
  ),
)[0];
if (!manifest) throw new Error('companion manifest missing at the shell pin');

const poses = [
  { id: 'idle', text: 'Resting: wings folded, a slow bob.' },
  { id: 'walk', text: 'Greeting: a wing raised, beak open.' },
  { id: 'fly', text: 'Flying in when summoned or moved.' },
];
const skinOrder = ['default', 'argentina', 'blue-gold', 'red', 'gaucho'].filter((s) => manifest.skins[s]);
const shell = pins.shell;
const assets = `${shell.repo}/tree/${shell.sha}/assets/companion`;
---

<SiteLayout
  title="Companion | HorneroOS"
  description="The Companion is a small hornero that lives on the HorneroOS desktop. It rests, greets you and flies in when called, and takes no input."
>
  <section class="section">
    <p class="plate-id"><strong>Compañero Hornero</strong><span>ARG / 199X</span><span>Parte del shell</span></p>
    <h1>Companion</h1>
    <p class="lede">
      A small hornero that lives on your desktop. It rests, greets you and flies in when you call it. It does not take
      focus or clicks away from the windows you are using.
    </p>
    <ul class="poses" role="list">
      {poses.map((p) => (
        <li>
          <Image
            src={frame(`default-${p.id}`)}
            alt={`The hornero companion, ${p.id} pose`}
            height={200}
            densities={[1, 2]}
          />
          <p>
            <strong>{p.id}</strong> {p.text}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2>Behavior</h2>
    <ul>
      <li>It sleeps after ten minutes of quiet; any interaction wakes it.</li>
      <li>Drag it anywhere. It remembers the spot on each monitor.</li>
      <li>
        It hides by itself on the lock screen, over fullscreen windows, in game mode and while Settings is open, and
        comes back afterwards.
      </li>
      <li>It sits on its own layer without keyboard focus, so it does not take clicks or typing from other windows.</li>
      <li>With reduced motion turned on, its hops and flights become simple cuts.</li>
      <li>When switched off, every timer and surface is unloaded.</li>
    </ul>
  </section>

  <section class="section">
    <h2>Characters</h2>
    <ul class="skins" role="list">
      {skinOrder.map((s) => (
        <li>
          <Image
            src={frame(`${s}-idle`)}
            alt={`The ${manifest.skins[s].label} companion`}
            height={140}
            densities={[1, 2]}
          />
          <span>{manifest.skins[s].label}</span>
        </li>
      ))}
    </ul>
    <p>
      Pick one in Control Center › Companion, along with its size, the edge it peeks from, tips and the speech-bubble
      theme. The same controls work from a terminal:
    </p>
    <pre><code>qs ipc call companion summon
qs ipc call companion setSkin gaucho
qs ipc call companion say "Back in five minutes" 5000</code></pre>
  </section>

  <section class="section optional-band" aria-labelledby="assistant-title">
    <h2 id="assistant-title">Optional assistant (experimental, off by default)</h2>
    <p>
      The companion is presentation only. An optional, experimental assistant can sit behind it:{' '}
      <a href="https://github.com/NousResearch/hermes-agent">Hermes Agent</a> by Nous Research, reached through{' '}
      <code>horneroctl assistant</code>. It is <strong>disabled by default</strong> and never runs as root. The desktop
      works the same with it off or not installed.
    </p>
    <p>Enable it from a terminal:</p>
    <pre><code>horneroctl assistant enable
horneroctl assistant status
horneroctl assistant ask "what updates are available?"</code></pre>
    <p>
      Ask from the desktop with <code>qs ipc call companion ask "…"</code>, or from the launcher by typing{' '}
      <code>&gt;ai</code> followed by your question. While a run is in progress the companion shows its
      <em>thinking</em> state. The answer, or an error line if the run fails, appears in its speech bubble.
    </p>
    <ul>
      <li>System information comes from a read-only tool allowlist. The assistant cannot run arbitrary commands.</li>
      <li>
        When a run needs approval or an answer, the companion shows the request and waits. You answer with
        <code>qs ipc call companion approve &lt;run-id&gt; approve|deny</code>. Nothing is approved automatically.
      </li>
      <li>The gateway listens on loopback only, behind a per-user key the shell cannot read.</li>
    </ul>
    <p>
      This is an early version. Answers arrive in the companion’s speech bubble; a conversation window, sessions and
      voice are not built yet.
    </p>
  </section>

  <section class="section">
    <h2>Limits</h2>
    <p>
      The companion takes no input and makes no decisions. Its <em>listening</em> and <em>thinking</em> states are
      animations driven over IPC. The assistant behind them is optional, experimental and off until you enable it.
    </p>
    <p class="source">
      Frames from{' '}
      <a href={assets}>
        <code>HorneroOS/shell/assets/companion</code>
      </a>{' '}
      at commit{' '}
      <a href={`${shell.repo}/commit/${shell.sha}`}>
        <code>{short(shell.sha)}</code>
      </a>
      , the assets the shell draws.
    </p>
  </section>
</SiteLayout>

<style>
  .poses,
  .skins {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .poses {
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    margin-top: 2rem;
  }

  .skins {
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  }

  .poses li,
  .skins li {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: var(--radius);
    background: radial-gradient(circle at 50% 70%, var(--surface), transparent 70%);
    border: 1px solid var(--line);
    text-align: center;
  }

  .poses img {
    height: 260px;
    width: auto;
  }

  .skins img {
    height: 170px;
    width: auto;
  }

  .poses p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .poses strong {
    display: block;
    color: var(--text);
    font-family: var(--font-data);
    font-stretch: 87.5%;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
  }

  .source {
    font-size: var(--step--1);
  }

  pre {
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 600px) {
    pre {
      font-size: 0.72rem;
    }
  }
  .optional-band { padding: clamp(1.1rem, 3vw, 2rem); border: 1px dashed var(--secondary); }
</style>

<style>
  /* 199X per-page direction: the companion as a character specimen plate. */
  .poses > *, .skins > * { border-radius: 2px; box-shadow: 6px 6px 0 color-mix(in srgb, var(--secondary) 16%, transparent); }
  .source { border-top: 3px solid var(--accent); padding-top: 0.6rem; }
</style>
