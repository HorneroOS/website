---
import SiteLayout from '../layouts/SiteLayout.astro';
import { extensionCatalogue, pins } from '../data/product';

const plugins = extensionCatalogue.plugins;
const repo = pins.plugins.repo;
---

<SiteLayout
  title="Extensions — the HorneroOS marketplace | HorneroOS"
  description="Official Hornero Shell extensions: hash-verified, pinned by revision, reviewed by maintainers. Browse the catalogue and install from the Control Center or horneroctl."
>
  <section class="section">
    <p class="plate-id"><strong>Extensiones Hornero</strong><span>ARG / 199X</span><span>Marketplace oficial</span></p>
    <p class="eyebrow">Official extensions marketplace</p>
    <h1>Extensions</h1>
    <p class="lede">
      First-party extensions for Hornero Shell, published in
      <a href={repo}>HorneroOS/plugins</a> and pinned into this page from the catalogue at build time
      (revision <code>{extensionCatalogue.generatedFrom.slice(0, 8)}</code>). Every payload is SHA-256
      verified by <code>horneroctl</code> before it is copied anywhere.
    </p>
    <p>
      <strong>Trust, stated plainly:</strong> QML extensions run with your user's permissions — Hornero
      Shell does not sandbox them. Official extensions are reviewed by maintainers and declare their
      capabilities up front; enabling always asks for your explicit confirmation.
    </p>
    <p>
      Install from Control Center → Extensions, or:
      <code class="command">horneroctl plugin catalog install hornero-pomodoro --yes</code>
    </p>
  </section>

  <section class="section" aria-label="Catalogue">
    <ul role="list" class="extension-grid">
      {
        plugins.map((p) => (
          <li class="extension-card">
            <p class="plate-id">
              <strong>{p.id}</strong>
              <span>{p.trust}</span>
              <span>{p.category}</span>
            </p>
            <h2>{p.name}</h2>
            <p>{p.description}</p>
            <dl>
              <div>
                <dt>Version</dt>
                <dd>{p.version}</dd>
              </div>
              <div>
                <dt>Placement</dt>
                <dd>{p.placement}</dd>
              </div>
              <div>
                <dt>License</dt>
                <dd>{p.license}</dd>
              </div>
              <div>
                <dt>Processes</dt>
                <dd>{p.processCommands.length ? p.processCommands.join(', ') : 'none'}</dd>
              </div>
              <div>
                <dt>Network</dt>
                <dd>{p.networkHosts.length ? p.networkHosts.join(', ') : 'none'}</dd>
              </div>
              <div>
                <dt>SHA-256</dt>
                <dd>
                  <code>{p.sha256.slice(0, 12)}…</code>
                </dd>
              </div>
            </dl>
            <code class="command">horneroctl plugin catalog install {p.id} --yes</code>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Write your own</h2>
    <p>
      Copy the starter template, declare your capabilities honestly, and validate locally before
      opening a pull request. Community extensions will be listed separately and labelled unreviewed —
      never silently promoted.
    </p>
    <p>
      <a class="text-link" href={`${repo}/tree/main/templates/starter-plugin`}>
        Starter template <span aria-hidden="true">→</span>
      </a>
      {' · '}
      <a class="text-link" href={`${repo}/blob/main/docs/SECURITY.md`}>
        Security model <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</SiteLayout>

<style>
  .extension-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    padding: 0;
    list-style: none;
  }
  .extension-card {
    border: 1px solid var(--line, #444);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .extension-card dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
  }
  .extension-card dt {
    font-weight: 600;
  }
  .extension-card dd {
    margin: 0;
  }
</style>
