---
import SiteLayout from '../layouts/SiteLayout.astro';
import { editions, editionCatalogue } from '../data/product';

const maturityLabels = {
  planned: 'Planned',
  experimental: 'Experimental',
  preview: 'Desktop preview',
  supported: 'Supported',
} as const;
const copy = {
  desktop: {
    headline: 'A complete Wayland desktop',
    body: 'Hornero Shell brings layouts, themes, settings, launcher, dashboard and session controls into one desktop experience.',
    href: '/showroom',
    link: 'Explore the desktop',
  },
  server: {
    headline: 'A lean headless foundation',
    body: 'A remotely operated system for homelabs, virtual machines and self-hosted services, without a graphical session.',
    href: 'https://github.com/HorneroOS/hornero/tree/main/editions',
    link: 'Read the composition model',
  },
  agents: {
    headline: 'Infrastructure for agent workloads',
    body: 'A server-derived environment designed around isolated identities, constrained services and inspectable agent lifecycles.',
    href: 'https://github.com/HorneroOS/hornero/tree/main/editions',
    link: 'Read the composition model',
  },
  studio: {
    headline: 'A considered creative workstation',
    body: 'Desktop foundations for audio, video and visual work, with hardware-aware workflows rather than a package bundle.',
    href: 'https://github.com/HorneroOS/hornero/tree/main/editions',
    link: 'Read the composition model',
  },
} as const;
const familyOrder = ['desktop', 'server', 'agents', 'studio'];
const byId = Object.fromEntries(editions.map((edition) => [edition.id, edition]));
const cards = familyOrder.map((id) => {
  const edition = byId[id];
  if (!edition) throw new Error(`Edition ${id} is missing from the pinned catalogue`);
  const compositorIds = edition.compositor?.supported ?? [];
  const compositors = compositorIds.map((backend) => {
    const details = editionCatalogue.compositors.find((item) => item.id === backend);
    return { id: backend, maturity: details?.maturity ?? 'planned' };
  });
  return { ...edition, ...copy[id as keyof typeof copy], compositors };
});
const statusLabel = (maturity: keyof typeof maturityLabels) => maturityLabels[maturity];
const roleLabel = {
  desktop: 'Wayland desktop',
  server: 'Headless systems',
  'agent-host': 'Secure agent hosting',
  'creative-workstation': 'Creative production',
} as const;
---

<SiteLayout
  title="Editions — one HorneroOS, composed for different work"
  description="HorneroOS shares one foundation across Desktop, Server, Agents and Studio. Each profile has a distinct role and an explicit development state."
>
  <section class="intro section">
    <p class="eyebrow">One foundation · distinct roles</p>
    <h1>
      One system.
      <br />
      <em>Four ways to use it.</em>
    </h1>
    <p class="lede">
      HorneroOS is composed from a shared base and focused capabilities. Desktop, Server, Agents and Studio are
      connected profiles, not separate distributions maintained in parallel.
    </p>
    <p class="availability">
      The product model is defined; maturity varies by profile. There is no installable ISO or guided installer yet.{' '}
      <a href="/install">See what can be installed today.</a>
    </p>
  </section>

  <section class="family section" aria-labelledby="family-title">
    <h2 id="family-title" class="sr-only">
      HorneroOS edition composition
    </h2>
    <div class="foundation">
      <span class="foundation-mark" aria-hidden="true">
        H
      </span>
      <div>
        <strong>HorneroOS Base</strong>
        <span>Common system foundation</span>
      </div>
      <span class="foundation-note">Shared across editions</span>
    </div>
    <div class="branch-line" aria-hidden="true"></div>
    <div class="edition-grid">
      {cards.map((edition) => (
        <article class:list={['edition-card', `edition-${edition.id}`, `maturity-${edition.maturity}`]}>
          <div class="edition-meta">
            <span class="edition-role">{roleLabel[edition.role as keyof typeof roleLabel] ?? edition.role}</span>
            <span class="maturity">{statusLabel(edition.maturity)}</span>
          </div>
          <h2>{edition.title.replace('HorneroOS ', '')}</h2>
          <h3>{edition.headline}</h3>
          <p>{edition.body}</p>
          {edition.extends && <p class="extends">Builds on {byId[edition.extends]?.title.replace('HorneroOS ', '')}</p>}
          {edition.compositors.length > 0 && (
            <div class="backend-list" aria-label="Desktop compositor options">
              <span class="backend-heading">Wayland compositor</span>
              {edition.compositors.map((backend) => (
                <span class="backend">
                  <strong>
                    {backend.id === 'hyprland' ? 'Hyprland' : backend.id === 'niri' ? 'Niri' : backend.id}
                  </strong>
                  <small>{statusLabel(backend.maturity as keyof typeof maturityLabels)}</small>
                </span>
              ))}
            </div>
          )}
          <a class="edition-link" href={edition.href}>
            {edition.link}
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section composition-note">
    <p class="eyebrow">Shared architecture</p>
    <h2>Capabilities compose. Product truth stays together.</h2>
    <p>
      Studio builds on Desktop; Agents builds on Server. The compositor belongs to Desktop as a backend choice. Hyprland
      is the validated default, while Niri is experimental and retains clearly documented capability gaps.
    </p>
    <p>
      The edition and compositor states on this page come from the pinned Hornero composition catalogue. The same model
      is designed for CLI introspection, installation and acceptance tooling; those image and installer paths are not
      yet released.
    </p>
  </section>
</SiteLayout>

<style>
  .intro.section {
    margin-top: 0;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(1rem, 3vw, 2.5rem);
  }
  .intro h1 {
    max-width: 15ch;
    margin-block: 0.55rem 1rem;
    font-size: clamp(2.8rem, 2.1rem + 5vw, 5.7rem);
  }
  .intro h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .lede {
    max-width: 52ch;
    font-size: var(--step-1);
  }
  .availability {
    max-width: 64ch;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .family {
    padding-top: 0;
  }
  .foundation {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    margin-inline: auto;
    padding: 0.9rem 1.15rem;
    border: 1px solid var(--secondary);
    border-radius: var(--arch);
    background: var(--surface);
  }
  .foundation-mark {
    display: grid;
    width: 2.5rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 800;
  }
  .foundation strong,
  .foundation div span {
    display: block;
  }
  .foundation div span,
  .foundation-note {
    color: var(--text-muted);
    font-size: 0.76rem;
  }
  .foundation-note {
    padding-left: 0.9rem;
    border-left: 1px solid var(--line);
    font-size: 0.7rem;
  }
  .branch-line {
    width: 1px;
    height: 2.2rem;
    margin: auto;
    background: var(--secondary);
  }
  .edition-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .edition-card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1rem, 1.8vw, 1.5rem);
    border: 1px solid var(--line);
    border-top: 3px solid var(--secondary);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .edition-card::before {
    position: absolute;
    top: -2.25rem;
    left: 50%;
    width: 1px;
    height: 2.1rem;
    background: var(--secondary);
    content: '';
  }
  .edition-desktop {
    border-top-color: var(--accent);
  }
  .edition-server {
    border-top-color: #7daab4;
  }
  .edition-agents {
    border-top-color: #a68bd0;
  }
  .edition-studio {
    border-top-color: #8eab72;
  }
  .edition-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem;
    align-items: center;
  }
  .edition-role,
  .maturity {
    font: 0.67rem var(--font-data);
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }
  .edition-role {
    color: var(--text-muted);
  }
  .maturity {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
  }
  .maturity-preview {
    border-color: var(--accent);
  }
  .edition-card > h2 {
    margin-block: 1rem 0.3rem;
    font-size: clamp(1.25rem, 1.15rem + 0.6vw, 1.8rem);
  }
  .edition-card > h3 {
    color: var(--secondary);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .edition-card > p {
    margin-top: 0.8rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .edition-card .extends {
    margin-top: 0.45rem;
    color: var(--text);
    font-size: 0.77rem;
  }
  .backend-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .backend-heading {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: 0.74rem;
  }
  .backend {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.45rem;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .backend strong {
    font-size: 0.83rem;
  }
  .backend small {
    color: var(--text-muted);
    font-size: 0.68rem;
  }
  .edition-link {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.2rem;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .edition-link:hover {
    color: var(--accent);
  }
  .composition-note {
    max-width: 82ch;
    margin-inline: auto;
  }
  .composition-note h2 {
    margin-block: 0.5rem 1rem;
  }
  .composition-note p:not(.eyebrow) {
    margin-top: 0.7rem;
    color: var(--text-muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 980px) {
    .edition-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 580px) {
    .foundation {
      width: 100%;
    }
    .foundation-note {
      margin-left: auto;
      font-size: 0.62rem;
    }
    .edition-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .edition-card {
      padding: 1.2rem;
    }
    .edition-card::before {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .edition-link {
      transition: none;
    }
  }
</style>
