---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Picture } from 'astro:assets';
import ArchFrame from '../components/ArchFrame.astro';
import { themes } from '../data/product';
import lightShot from '../../assets/screenshots/certified/hornero-light.png';
import neonCityShot from '../../assets/screenshots/curated/neon-city.webp';
import vaporRoadtripShot from '../../assets/screenshots/curated/vapor-roadtrip.webp';
import morningLakeShot from '../../assets/screenshots/curated/morning-lake.webp';
import patagoniaWallpaper from '../../assets/screenshots/wallpapers/patagonia-glacier-01.jpg';
import finDelMundoWallpaper from '../../assets/screenshots/wallpapers/beagle-blue-hour-01.jpg';
import variantSample from '../data/product/palette-variants.json';

const flagship = themes.filter((theme) => theme.official);
const recipes = themes.filter((theme) => !theme.official);
const modes = (mode: string) => (mode === 'light' ? 'Light' : 'Dark');
const provenance = (theme: string, source: string, pins: Record<string, string>) => ({
  source,
  context: 'Hornero QA · package-only theme run',
  pins,
  resolution: '1280×800',
  theme,
  date: '2026-10-03',
});
const lightProof = provenance('Hornero Light', 'Hornero QA', {
  shell: '98a5de2',
  config: '96b6870',
  horneroctl: '9c15172',
});
const wallpaperProof = {
  source: 'Hornero host capture',
  context: 'Live Arch + Hyprland host · empty workspace',
  resolution: '1920×1080',
  theme: 'Custom · dark · expressive colors',
  date: '2026-10-03',
};
const wallpaperScenes = [
  {
    name: 'Neon City',
    id: 'neon-city-wallpaper',
    note: 'Cyan glass, amber transit and rain-lit towers.',
    image: neonCityShot,
    alt: 'Real Hornero desktop capture with a cyan and amber cyberpunk skyline behind the shell rail.',
  },
  {
    name: 'Vapor Dreams',
    id: 'vapor-roadtrip-wallpaper',
    note: 'Coral stone and lavender dusk on an open road.',
    image: vaporRoadtripShot,
    alt: 'Real Hornero desktop capture with coral desert cliffs and a lavender synthwave sky behind the shell rail.',
  },
  {
    name: 'Soft Morning',
    id: 'morning-lake-wallpaper',
    note: 'Cool peaks, pale sky and a mint-tinted rail.',
    image: morningLakeShot,
    alt: 'Real Hornero desktop capture with a pale sunrise over snow and cloud behind a mint-accented shell rail.',
  },
];
const paletteVariants = variantSample.variants;
const landscapeArtworks = [
  {
    name: 'Patagonia',
    image: patagoniaWallpaper,
    alt: 'Original HorneroOS wallpaper artwork of a Patagonian glacier, basalt peaks, and blue glacial water at dusk.',
    note: 'Glacier blue, dark basalt and a narrow copper horizon.',
  },
  {
    name: 'Fin del Mundo',
    image: finDelMundoWallpaper,
    alt: 'Original HorneroOS wallpaper artwork of the Beagle Channel, southern forest, and muted harbor light at blue hour.',
    note: 'Southern forest, Beagle Channel water and harbor light.',
  },
];
---

<SiteLayout
  title={`Themes — ${themes.length} ways to shape Hornero OS`}
  description="Start with a Hornero look or choose a color recipe that follows its wallpaper. Real captures, clear dependency notes and one place to personalize the desktop."
>
  <section class="intro section">
    <div class="intro-copy-column">
      <p class="eyebrow">Personalize the whole desktop</p>
      <h1>
        Choose a feeling.
        <br />
        <em>Make it yours.</em>
      </h1>
      <p class="intro-copy">
        A look is more than a wallpaper. Hornero coordinates shell colors, GTK apps and icons, then lets you fine-tune the
        pieces when you want to.
      </p>
      <div class="intro-meta">
        <span>{flagship.length} Hornero looks</span>
        <span>{recipes.length} color recipes</span>
        <span>{themes.length} starting points</span>
      </div>
    </div>
    <div class="intro-preview">
      <ArchFrame
        src={neonCityShot}
        alt="Live Hornero desktop capture with a cyan and amber cyberpunk skyline behind its shell rail."
        provenance={wallpaperProof}
        sizes="(min-width: 900px) 50vw, calc(100vw - 2rem)"
        widths={[480, 720, 1080, 1280]}
      />
      <p><span>Live desktop capture</span><strong>Neon City</strong></p>
    </div>
  </section>

  <section class="section featured" aria-labelledby="hornero-looks">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Designed for Hornero</p>
        <h2 id="hornero-looks">The Hornero looks</h2>
      </div>
      <p>Distinct palettes with their own light, texture and character.</p>
    </div>
    <div class="flagship-grid">
      {flagship.map((theme) => (
        <article
          class="flagship"
          id={theme.id}
          style={`--theme-bg:${theme.palette.background};--theme-surface:${theme.palette.surface};--theme-text:${theme.palette.text};--theme-primary:${theme.palette.primary};--theme-secondary:${theme.palette.secondary};--theme-accent:${theme.palette.accent}`}
        >
          <div class="flagship-top">
            <span class="mode-tag">{modes(theme.mode)}</span>
            <span class="swatch-row" aria-label="Theme color accents">
              <i></i>
              <i></i>
              <i></i>
            </span>
          </div>
          <div class="flagship-copy">
            <h3>{theme.name}</h3>
            <p>
              {theme.id === 'hornero-dark'
                ? 'Kiln-dark surfaces, ember orange and warm clay.'
                : theme.id === 'hornero-light'
                  ? 'Morning paper, fired clay and clear warm light.'
                  : 'Moonlit grassland greens, olive and muted gold.'}
            </p>
          </div>
          <div class="palette-strip" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <small>Shell · GTK · icons · {theme.mode} mode</small>
        </article>
      ))}
    </div>
    <div class="proof-pair">
      <article class="proof-shot">
        <div>
          <p class="eyebrow">Light, in use</p>
          <h3>Hornero Light</h3>
          <p>Warm morning color carried from the rail to the desktop.</p>
        </div>
        <ArchFrame
          src={lightShot}
          alt="Hornero Light running on a sunlit Patagonian landscape, with the side rail and confirmation that the theme applied."
          provenance={lightProof}
          sizes="(min-width: 1000px) 600px, calc(100vw - 2rem)"
          widths={[480, 720, 1080, 1280]}
        />
      </article>
    </div>
  </section>

  <section class="section recipes-section" id="more-packs">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A palette for every mood</p>
        <h2>Color recipes</h2>
      </div>
      <p>Start with a scene, then decide how much color the shell should draw from it.</p>
    </div>
    <ul class="recipe-grid" role="list">
      {recipes.map((theme) => (
        <li class="recipe" id={theme.id}>
          <div class="recipe-head">
            <span class="mode-tag">{modes(theme.mode)}</span>
            <span class="recipe-kind">Color recipe</span>
          </div>
          <h3>{theme.name}</h3>
          <p>{theme.description}</p>
        </li>
      ))}
    </ul>
    <div class="recipe-note" id="wallpaper-colors">
      <span aria-hidden="true">✳</span>
      <p>
        <strong>One wallpaper, your colors.</strong> Hornero can derive coordinated shell colors from the active
        wallpaper. Choose a generation style or save a palette in Appearance; GTK and icon themes remain separate parts
        of the look.
      </p>
    </div>
  </section>

  <section class="section variants-section" id="palette-variants" aria-labelledby="palette-variants-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Shape the color, keep the scene</p>
        <h2 id="palette-variants-title">Seven ways to read a wallpaper.</h2>
      </div>
      <p>These are palette-generation styles, not extra themes. Pick one in Appearance to change the shell’s color character while keeping your wallpaper.</p>
    </div>
    <ul class="variant-grid" role="list">
      {paletteVariants.map((variant) => (
        <li class="variant-card" data-variant={variant.id}>
          <span class="variant-swatches" aria-hidden="true" style={`--swatch-a:${variant.colors[0]};--swatch-b:${variant.colors[1]};--swatch-c:${variant.colors[2]}`}>
            <i></i><i></i><i></i>
          </span>
          <strong>{variant.name}</strong>
          <span>{variant.mood}</span>
        </li>
      ))}
    </ul>
    <p class="variant-footnote">All seven sample palettes were generated in dark mode from the same Neon City wallpaper with Hornero Config’s Material 3 generator. They are real outputs for that image; another wallpaper or light mode produces different colors. <a href="/docs/desktop/appearance/">Read how wallpaper colors work</a>.</p>
  </section>

  <section class="section wallpaper-section" id="wallpaper-scenes" aria-labelledby="wallpaper-scenes-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A wallpaper changes the atmosphere</p>
        <h2 id="wallpaper-scenes-title">The same desktop, reimagined by its wallpaper.</h2>
      </div>
      <p>Explore the collection through real captures: electric city light, a synthwave road and a quiet Patagonian dawn.</p>
    </div>
    <div class="wallpaper-scenes">
      {wallpaperScenes.map((scene) => (
        <article class="wallpaper-scene" id={scene.id}>
          <ArchFrame
            src={scene.image}
            alt={scene.alt}
            provenance={wallpaperProof}
            sizes="(min-width: 1180px) 370px, (min-width: 720px) 42vw, calc(100vw - 2rem)"
            widths={[360, 480, 720, 960]}
          />
          <h3>{scene.name}</h3>
          <p>{scene.note}</p>
        </article>
      ))}
    </div>
    <p class="capture-note">
      These are captures from a live development host running Arch and Hyprland, not a Hornero ISO. See the full
      <a href="/showroom">Showroom and capture provenance</a>.
    </p>
  </section>

  <section class="section landscape-art" aria-labelledby="landscape-art-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">New wallpaper artworks</p>
        <h2 id="landscape-art-title">From the southern edge.</h2>
      </div>
      <p>Two original scenes take different routes through Patagonia and Tierra del Fuego—without turning either into a souvenir.</p>
    </div>
    <div class="landscape-grid">
      {landscapeArtworks.map((artwork) => (
        <article class="landscape-card">
          <Picture
            src={artwork.image}
            alt={artwork.alt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 720, 1080, 1440]}
            sizes="(min-width: 900px) 46vw, calc(100vw - 2rem)"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h3>{artwork.name}</h3>
            <p>{artwork.note}</p>
          </div>
          <small>Wallpaper artwork · included in the public workstation collection</small>
        </article>
      ))}
    </div>
    <p class="artwork-note">
      These are original generated wallpaper artworks, not documentary photographs or desktop captures. The wallpaper files are maintained in the public
      <a href="https://github.com/ulises-jeremias/dotfiles/tree/main/home/dot_local/share/hornero/wallpapers">dotfiles wallpaper collection</a>;
      Hornero Config owns the theme catalogue and palette behavior.
    </p>
  </section>

  <section class="section practical">
    <div>
      <p class="eyebrow">The useful details</p>
      <h2>Everything in step.</h2>
      <p>
        Applying a Hornero look updates its coordinated shell and desktop appearance. Recipe packs may call for
        third-party GTK or icon themes; Hornero does not download them silently. If an optional look is missing, your
        desktop can still use its shell palette and explain what is unavailable.
      </p>
    </div>
    <div class="try-panel">
      <span class="mode-tag">From the desktop</span>
      <strong>Settings → Appearance</strong>
      <span>Preview a look, apply it, then refine mode, wallpaper and colors.</span>
      <a class="cta primary" href="/showroom">
        See the desktop
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  :global(main.app) {
    padding-top: 1.5rem;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(0.5rem, 2vw, 2rem) 1rem;
    margin-block-start: 0.75rem;
  }
  .intro > * + * {
    margin-top: 0;
  }
  .intro-preview {
    position: relative;
    min-width: 0;
  }
  .intro-preview :global(.frame) {
    width: 100%;
  }
  .intro-preview :global(.frame-shot) :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .intro-preview > p {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.6rem;
    color: var(--text-muted);
    font: 0.7rem var(--font-data);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .intro-preview strong {
    color: var(--text);
    font-weight: 600;
  }
  .intro h1 {
    margin-top: 0.7rem;
    font-size: clamp(3rem, 3.65vw, 4.3rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .intro h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .intro-copy {
    max-width: 54ch;
    margin-top: 1.2rem;
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .intro-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }
  .intro-meta span,
  .mode-tag {
    display: inline-flex;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font: 0.72rem var(--font-data);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.3rem;
  }
  .section-heading h2 {
    margin-top: 0.35rem;
  }
  .section-heading > p {
    max-width: 43ch;
    color: var(--text-muted);
  }
  .flagship-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .flagship {
    min-height: 230px;
    display: flex;
    flex-direction: column;
    padding: 1.3rem;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--theme-text) 17%, transparent);
    border-radius: var(--radius);
    color: var(--theme-text);
    background:
      radial-gradient(
        ellipse at 92% 0%,
        color-mix(in oklab, var(--theme-primary) 25%, var(--theme-bg)),
        transparent 56%
      ),
      var(--theme-bg);
  }
  .flagship-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .flagship .mode-tag {
    border-color: color-mix(in oklab, var(--theme-text) 22%, transparent);
    color: var(--theme-text);
  }
  .swatch-row {
    display: flex;
    gap: 0.35rem;
  }
  .swatch-row i {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--theme-primary);
  }
  .swatch-row i:nth-child(1) {
    background: var(--theme-primary);
  }
  .swatch-row i:nth-child(2) {
    background: var(--theme-secondary);
  }
  .swatch-row i:nth-child(3) {
    background: var(--theme-accent);
  }
  .flagship-copy {
    margin-top: auto;
    padding-top: 2.4rem;
  }
  .flagship h3 {
    font-size: 1.6rem;
  }
  .flagship-copy p {
    max-width: 31ch;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    opacity: 0.78;
  }
  .palette-strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    height: 0.38rem;
    overflow: hidden;
    margin-block: 1.3rem 0.65rem;
    border-radius: 9px;
  }
  .palette-strip i:nth-child(1) {
    background: var(--theme-bg);
  }
  .palette-strip i:nth-child(2) {
    background: var(--theme-surface);
  }
  .palette-strip i:nth-child(3) {
    background: var(--theme-primary);
  }
  .palette-strip i:nth-child(4) {
    background: var(--theme-secondary);
  }
  .palette-strip i:nth-child(5) {
    background: var(--theme-accent);
  }
  .flagship > small {
    opacity: 0.68;
    font: 0.66rem var(--font-data);
  }
  .proof-pair {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }
  .proof-shot {
    display: grid;
    gap: 1rem;
    align-items: center;
  }
  .proof-shot > div:first-child {
    display: grid;
    gap: 0.35rem;
    align-content: center;
  }
  .proof-shot h3 {
    font-size: var(--step-2);
  }
  .proof-shot p:not(.eyebrow) {
    max-width: 38ch;
    color: var(--text-muted);
  }
  .proof-shot :global(.frame) {
    width: 100%;
    min-width: 0;
  }
  .proof-shot :global(.frame-shot) :global(img) {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
  }
  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
    gap: 0.75rem;
    list-style: none;
  }
  .recipe {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-height: 155px;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .recipe-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .recipe .mode-tag {
    padding: 0.2rem 0.45rem;
    font-size: 0.62rem;
  }
  .recipe-kind {
    color: var(--text-muted);
    font: 0.62rem var(--font-data);
  }
  .recipe h3 {
    font-size: 1.12rem;
  }
  .recipe p {
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .recipe-note {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    max-width: 72ch;
    margin-top: 1.4rem;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--secondary);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .recipe-note > span {
    color: var(--secondary);
    font-size: 1.2rem;
  }
  .recipe-note p {
    color: var(--text-muted);
  }
  .recipe-note strong {
    color: var(--text);
  }
  .variant-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .variant-card {
    display: grid;
    gap: 0.4rem;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .variant-card > span:last-child,
  .variant-footnote {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .variant-swatches {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 0.25rem;
  }
  .variant-swatches i {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--swatch-a);
  }
  .variant-swatches i:nth-child(2) { background: var(--swatch-b); }
  .variant-swatches i:nth-child(3) { background: var(--swatch-c); }
  .variant-footnote { margin-top: 0.9rem; }
  .variant-footnote a { color: var(--text); }
  .wallpaper-scenes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1rem;
  }
  .wallpaper-scene {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    min-width: 0;
  }
  .wallpaper-scene :global(.frame) {
    width: 100%;
  }
  .wallpaper-scene :global(.frame-shot) :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .wallpaper-scene h3 {
    font-size: 1.15rem;
  }
  .wallpaper-scene > p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .capture-note {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .capture-note a {
    color: var(--text);
  }
  .landscape-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .landscape-card {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }
  .landscape-card :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .landscape-card h3 {
    font-size: 1.2rem;
  }
  .landscape-card p,
  .landscape-card small,
  .artwork-note {
    color: var(--text-muted);
  }
  .landscape-card small,
  .artwork-note {
    font-size: 0.82rem;
  }
  .artwork-note a {
    color: var(--text);
  }
  .practical {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.3rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .practical h2 {
    margin-block: 0.4rem 0.7rem;
  }
  .practical > div:first-child > p:last-child {
    max-width: 59ch;
    color: var(--text-muted);
  }
  .try-panel {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
    padding: 1.2rem;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .try-panel > span:not(.mode-tag) {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  @media (min-width: 920px) {
    .proof-shot {
      grid-template-columns: 0.65fr 1fr;
      gap: 2rem;
    }
    .proof-shot:nth-child(2) {
      grid-template-columns: 1fr 0.65fr;
    }
    .proof-shot:nth-child(2) > div:first-child {
      grid-column: 2;
      grid-row: 1;
    }
    .proof-shot:nth-child(2) .frame {
      grid-column: 1;
      grid-row: 1;
    }
    .practical {
