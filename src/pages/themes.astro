---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import ArchFrame from '../components/ArchFrame.astro';
import ThemePaletteStudy from '../components/ThemePaletteStudy.astro';
import AppLogo from '../components/AppLogo.astro';
import { paletteApplications, themes, wallpapers } from '../data/product';
import variantSample from '../data/product/palette-variants.json';

const originals = themes.filter((theme) => theme.collection === 'hornero-originals');
const paletteRoles = ['background', 'surface', 'text', 'primary', 'secondary', 'accent'] as const;
const paletteStudies = originals.filter(
  (theme) => theme.paletteModel === 'semantic' && paletteRoles.every((role) => theme.palette[role]),
);
const otherLooks = themes.filter((theme) => theme.collection !== 'hornero-originals');
const photosByTheme = new Map(wallpapers.map((wallpaper) => [wallpaper.themeId, wallpaper]));
const wallpaperMedia = {
  gruvbox: (await import('../../assets/screenshots/theme-wallpapers/gruvbox.webp')).default,
  landscape: (await import('../../assets/screenshots/theme-wallpapers/landscape.webp')).default,
  monochrome: (await import('../../assets/screenshots/theme-wallpapers/monochrome.webp')).default,
  'neon-city': (await import('../../assets/screenshots/theme-wallpapers/neon-city.webp')).default,
  'soft-morning': (await import('../../assets/screenshots/theme-wallpapers/soft-morning.webp')).default,
  'vapor-dreams': (await import('../../assets/screenshots/theme-wallpapers/vapor-dreams.webp')).default,
  'warm-sunset': (await import('../../assets/screenshots/theme-wallpapers/warm-sunset.webp')).default,
};
const modes = (mode: string) => (mode === 'light' ? 'Light' : 'Dark');
const buenosAires = wallpapers.find((wallpaper) => wallpaper.id === 'buenos-aires-nocturno');
if (!buenosAires) throw new Error('Buenos Aires Original is missing from the pinned wallpaper catalogue');
const paletteVariants = variantSample.variants;
const showroom = await getCollection('showroom');
const desktopCaptures = ['hornero-light', 'pampa', 'neon-city', 'vapor-roadtrip', 'morning-lake'].map((id) => {
  const capture = showroom.find((item) => item.id === id);
  if (!capture) throw new Error(`Showroom capture not found: ${id}`);
  return capture;
});
---

<SiteLayout
  title={`Themes — ${themes.length} coordinated looks for Hornero OS`}
  description="Explore Hornero Originals and a broad collection of natural, minimal, cyberpunk, synthwave and classic looks. Each appearance coordinates the desktop and can be shaped with wallpaper color variants."
>
  <section class="intro section">
    <div class="intro-copy-column">
      <p class="plate-id"><strong>Catálogo de apariencias</strong><span>ARG / 199X</span><span>Temas · paletas · fondos</span></p>
      <p class="eyebrow">Personalize the whole desktop</p>
      <h1>
        Choose a feeling.
        <br />
        <em>Make it yours.</em>
      </h1>
      <p class="intro-copy">
        A look is more than a wallpaper. Hornero coordinates shell colors, GTK apps and icons, then lets you fine-tune
        the pieces when you want to.
      </p>
      <div class="intro-meta">
        <span>{themes.length} coordinated looks</span>
        <span>{originals.length} Hornero Originals</span>
        <span>7 palette-generation styles</span>
      </div>
    </div>
    <div class="intro-preview">
      <img
        src={buenosAires.previewSmall}
        srcset={`${buenosAires.previewSmall} 720w, ${buenosAires.preview} 1280w`}
        sizes="(min-width: 900px) 50vw, calc(100vw - 2rem)"
        alt={buenosAires.previewAlt}
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
      />
      <p>
        <span>{buenosAires.place}</span>
        <strong>{buenosAires.title}</strong>
        <small>Photograph by {buenosAires.photographer} · <a href={buenosAires.licenseUrl}>{buenosAires.license}</a></small>
      </p>
    </div>
  </section>

  <section class="section desktop-gallery" aria-labelledby="desktop-gallery-title">
    <div class="section-heading">
      <div>
        <p class="chapter"><b>A</b><span>Del papel al escritorio — Looks on a running desktop</span></p>
        <p class="eyebrow">Looks on a running desktop</p>
        <h2 id="desktop-gallery-title">From scene to whole system.</h2>
      </div>
      <p>
        Choose a real capture to see how each look carries into the Shell. Each frame keeps its source and capture
        details; these are separate product captures, not a simulated live desktop.
      </p>
    </div>
    <fieldset class="capture-switcher">
      <legend>Explore real Hornero desktop captures</legend>
      {desktopCaptures.map((capture, i) => {
        const captureId = `capture-${capture.id}`;
        return (
          <>
            <input
              class="capture-radio"
              type="radio"
              name="desktop-capture"
              id={`${captureId}-choice`}
              value={capture.id}
              checked={i === 0}
            />
            <label class="capture-tab" for={`${captureId}-choice`}>
              <span class="capture-index">0{i + 1}</span>
              <span class="capture-tab-copy">
                <strong>{capture.data.title}</strong>
                <small>{capture.data.provenance.theme ?? 'Custom appearance'}</small>
              </span>
              <span class="capture-arrow" aria-hidden="true">↗</span>
            </label>
          </>
        );
      })}
      <div class="capture-stage">
        {desktopCaptures.map((capture) => {
          const captureId = `capture-${capture.id}`;
          return (
            <article class="capture-slide" id={`${captureId}-panel`} aria-label={capture.data.title}>
              <ArchFrame
                src={capture.data.image}
                alt={capture.data.alt}
                provenance={capture.data.provenance}
                sizes="(min-width: 1100px) 68vw, calc(100vw - 2rem)"
                widths={[480, 800, 1280, 1600]}
              />
              <div class="capture-slide-copy">
                <h3>{capture.data.title}</h3>
                <p aria-hidden="true">{capture.data.alt}</p>
              </div>
            </article>
          );
        })}
      </div>
    </fieldset>
    <p class="capture-footnote">
      Keyboard users can move between captures with the arrow keys. <a href="/showroom">Browse the complete desktop showcase</a>.
    </p>
  </section>

  <ThemePaletteStudy themes={paletteStudies} />

  <section class="section collection-section" aria-labelledby="looks-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">One desktop, many visual worlds</p>
        <h2 id="looks-title">A look for the way you work.</h2>
      </div>
      <p>
        Hornero Originals sit alongside classic, natural, minimal, cyberpunk and synthwave directions. Every card is a
        complete appearance choice; each image is the scene associated with a look, not a desktop screenshot. Nine
        Hornero Originals use attributed photography covering every Argentine region.
      </p>
    </div>
    <div class="collection-label" id="hornero-originals">
      <div>
        <span class="collection-index">01</span>
        <h3>Hornero Originals</h3>
      </div>
      <p>First-party looks shaped by Hornero’s visual identity and the places, materials and light that inspire it.</p>
    </div>
    <ul class="look-grid" role="list">
      {originals.map((theme) => (
        <li class="look-card" id={theme.id}>
          <div class="look-art">
            {photosByTheme.has(theme.id) ? (
              <a class="look-photo" href={`/wallpapers#${theme.id}`} aria-label={`View ${theme.name} photograph and credits`}>
                <img
                  src={photosByTheme.get(theme.id)!.previewSmall}
                  srcset={`${photosByTheme.get(theme.id)!.previewSmall} 720w, ${photosByTheme.get(theme.id)!.preview} 1280w`}
                  sizes="(min-width: 1100px) 28vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
                  alt={photosByTheme.get(theme.id)!.previewAlt}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : theme.palette ? (
              <div
                class="palette-study"
                style={`--palette-background:${theme.palette.background};--palette-surface:${theme.palette.surface};--palette-text:${theme.palette.text};--palette-primary:${theme.palette.primary};--palette-secondary:${theme.palette.secondary};--palette-accent:${theme.palette.accent}`}
                role="img"
                aria-label={`${theme.name} color palette: background ${theme.palette.background}, primary ${theme.palette.primary}, secondary ${theme.palette.secondary}, accent ${theme.palette.accent}`}
              >
                <div class="palette-arch" aria-hidden="true"><span></span></div>
                <div class="palette-swatches" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <span class="palette-caption" aria-hidden="true">Color study · {theme.mode}</span>
              </div>
            ) : (
              <div class="artwork-unavailable">
                <span aria-hidden="true">◌</span>
                <span>Choose a wallpaper</span>
              </div>
            )}
            <span class="look-mode">{modes(theme.mode)}</span>
            <span class="look-category">Hornero Original</span>
          </div>
          <div class="look-copy">
            <h4>{theme.name}</h4>
            <p>{theme.description}</p>
            {photosByTheme.get(theme.id) ? (
              <p class="look-credit">
                {photosByTheme.get(theme.id)!.photographer} · <a href={photosByTheme.get(theme.id)!.licenseUrl}>{photosByTheme.get(theme.id)!.license}</a>
              </p>
            ) : (
              <p class="look-credit">Color palette from Hornero Config · pair with any wallpaper</p>
            )}
          </div>
        </li>
      ))}
    </ul>
    <div class="collection-label other-label" id="more-looks">
      <div>
        <span class="collection-index">02</span>
        <h3>The wider collection</h3>
      </div>
      <p>Distinct directions, chosen for how they feel across the Shell—not ranked by how they are implemented.</p>
    </div>
    <ul class="look-grid" role="list">
      {otherLooks.map((theme) => (
        <li class="look-card" id={theme.id}>
          <div class="look-art">
            {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? (
              <Picture
                src={wallpaperMedia[theme.id as keyof typeof wallpaperMedia]}
                alt={`${['pampa', 'patagonia', 'fin-del-mundo', 'quebrada', 'ibera', 'buenos-aires-nocturno'].includes(theme.id) ? 'Photograph' : 'Wallpaper preview'} for ${theme.name}.`}
                formats={['webp']}
                fallbackFormat="webp"
                widths={[520, 800]}
                sizes="(min-width: 1100px) 28vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="artwork-unavailable">
                <span aria-hidden="true">◌</span>
                <span>Pair with your wallpaper</span>
              </div>
            )}
            <span class="look-mode">{modes(theme.mode)}</span>
            <span class="look-category">
              {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? 'Wallpaper look' : 'Wallpaper-led'}
            </span>
          </div>
          <div class="look-copy">
            <h4>{theme.name}</h4>
            <p>{theme.description}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="artwork-note">
      These cards show the scene associated with a look, not a photograph of the running desktop. The nine Argentina-inspired Hornero Originals use verified, attributed photography; other optional media remains a separate user collection. Browse the{' '}
      <a href="/wallpapers">photographic wallpaper collection</a> for locations, photographers and licenses.{' '}
      <a href="/showroom">See verified desktop captures in the Showroom</a>.
    </p>
  </section>

  <section class="section variants-section" id="palette-variants" aria-labelledby="palette-variants-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Color is part of the look</p>
        <h2 id="palette-variants-title">Seven palette-generation styles.</h2>
      </div>
      <p>
        Choose a style to change how Hornero reads the wallpaper and shapes Shell colors. Keep the same scene while
        moving from restrained tones to a more expressive palette.
      </p>
    </div>
    <ul class="variant-grid" role="list">
      {paletteVariants.map((variant) => (
        <li class="variant-card" data-variant={variant.id}>
          <span
            class="variant-swatches"
            aria-hidden="true"
            style={`--swatch-a:${variant.colors[0]};--swatch-b:${variant.colors[1]};--swatch-c:${variant.colors[2]}`}
          >
            <i></i>
            <i></i>
            <i></i>
          </span>
          <strong>{variant.name}</strong>
          <span>{variant.mood}</span>
        </li>
      ))}
    </ul>
    <p class="variant-footnote">
      All seven sample palettes were generated in dark mode from the same Neon City wallpaper with Hornero Config’s
      Material 3 generator. They are real outputs for that image; another wallpaper or light mode produces different
      colors. <a href="/docs/desktop/appearance/">Read how wallpaper colors work</a>.
    </p>
  </section>

  <section class="section terminals-section" aria-labelledby="terminals-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">One palette, in your tools</p>
        <h2 id="terminals-title">Your terminal keeps the same color story.</h2>
      </div>
      <p>
        Hornero writes the active wallpaper palette in each terminal's native format. Kitty is the included default;
        Alacritty and Ghostty are optional alternatives.
      </p>
    </div>
    <div class="terminal-grid">
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name"><AppLogo id="kitty" /><h3>Kitty</h3></span>
          <span>Included default</span>
        </div>
        <p>The packaged config includes the palette generated for your current appearance.</p>
        <pre><code>include ~/.cache/hornero/smart-colors/colors-kitty.conf</code></pre>
      </article>
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name"><AppLogo id="alacritty" /><h3>Alacritty</h3></span>
          <span>Optional</span>
        </div>
        <p>A native TOML import keeps the static Hornero colors as a fallback.</p>
        <pre><code>import = ["hornero-dark.toml", "hornero-colors.toml"]</code></pre>
      </article>
      <article class="terminal-card">
        <div class="terminal-card-heading">
          <span class="terminal-card-name"><AppLogo id="ghostty" /><h3>Ghostty</h3></span>
          <span>Optional</span>
        </div>
        <p>The stable theme name points to a generated palette, with a packaged fallback.</p>
        <pre><code>theme = Hornero Dynamic</code></pre>
      </article>
    </div>
    <p class="terminal-note">
      Choose an installed terminal in <strong>Settings → Terminal</strong> or with
      <code>horneroctl config default-apps set terminal ghostty --yes</code>.
      <a href="/docs/applications/terminal">Read the terminal guide</a> for setup and appearance details.
    </p>
    <aside class="native-tool-note" aria-label="Other applications with native Hornero color themes">
      <span class="native-tool-label">Beyond the prompt</span>
      <div class="native-tool-body">
        <p>Hornero Config can generate native wallpaper-derived themes for these tools. Their curated configurations select <code>Hornero Dynamic</code>; these applications remain optional Arch packages.</p>
        <ul class="native-tool-list" role="list">
          {paletteApplications.map((application) => (
            <li><AppLogo id={application.id} /><span><strong>{application.name}</strong><small>{application.category}</small></span></li>
          ))}
        </ul>
      </div>
    </aside>
  </section>

  <section class="section practical">
    <div>
      <p class="eyebrow">The useful details</p>
      <h2>Everything in step.</h2>
      <p>
        A look brings the Shell, GTK policy, icons and wallpaper together. Some packs reference optional GTK or icon
        styles; Hornero checks availability and never downloads them silently. Palette-generation style and light/dark
        mode can be refined in Appearance.
      </p>
    </div>
    <div class="try-panel">
      <span class="mode-tag">From the desktop</span>
      <strong>Settings → Appearance</strong>
      <span>Preview a look, apply it, then refine mode, wallpaper and colors.</span>
      <a class="cta primary" href="/showroom">
        See the desktop
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  :global(main.app) {
    padding-top: 1.5rem;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(0.5rem, 2vw, 2rem) 1rem;
    margin-block-start: 0.75rem;
  }
  .intro > * + * {
    margin-top: 0;
  }
  .intro-preview {
    position: relative;
    min-width: 0;
  }
  .intro-preview :global(picture) {
    display: block;
    width: 100%;
  }
  .intro-preview img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--highlight) 45%, var(--line));
    box-shadow: 0.7rem 0.7rem 0 -0.1rem var(--bg), 0.7rem 0.7rem 0 var(--highlight);
  }
  .desktop-gallery {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-block: 1px solid var(--line);
  }
  .desktop-gallery .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .desktop-gallery .section-heading h2 {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .desktop-gallery .section-heading > p {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
  }
  .capture-switcher {
    position: relative;
    display: grid;
    grid-template-columns: minmax(13rem, 0.32fr) minmax(0, 1fr);
    grid-template-rows: auto repeat(5, minmax(4.5rem, auto));
    align-items: stretch;
    gap: 0.4rem 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .capture-switcher legend {
    grid-column: 1 / -1;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font: 0.72rem var(--font-data);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .capture-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .capture-tab {
    display: grid;
    min-width: 0;
    grid-column: 1;
    grid-template-columns: 2rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }
  .capture-tab:hover,
  .capture-radio:checked + .capture-tab {
    color: var(--ink);
    border-color: var(--highlight);
    background: color-mix(in srgb, var(--highlight) 8%, transparent);
  }
  .capture-radio:focus-visible + .capture-tab {
    outline: 2px solid var(--highlight);
    outline-offset: 2px;
  }
  .capture-index {
    color: var(--text-muted);
    font: 0.68rem var(--font-data);
  }
  .capture-tab-copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .capture-tab-copy strong {
    font-size: 0.88rem;
    line-height: 1.25;
  }
  .capture-tab-copy small {
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.25;
  }
  .capture-arrow {
    opacity: 0;
    transform: translate(-0.2rem, 0.2rem);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .capture-radio:checked + .capture-tab .capture-arrow,
  .capture-tab:hover .capture-arrow {
    opacity: 1;
    transform: none;
  }
  .capture-stage {
    grid-column: 2;
    grid-row: 2 / span 5;
    min-width: 0;
  }
  .capture-slide {
    display: none;
    margin: 0;
    animation: capture-arrive 260ms ease both;
  }
  .capture-slide :global(.frame-shot) {
    aspect-ratio: 16 / 10;
  }
  .capture-slide :global(.frame-shot img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .capture-slide-copy {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.7rem;
  }
  .capture-slide-copy h3 {
    margin: 0;
    font-size: var(--step-1);
  }
  .capture-slide-copy p {
    max-width: 52ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
  }
  #capture-hornero-light-choice:checked ~ .capture-stage #capture-hornero-light-panel,
  #capture-pampa-choice:checked ~ .capture-stage #capture-pampa-panel,
  #capture-neon-city-choice:checked ~ .capture-stage #capture-neon-city-panel,
  #capture-vapor-roadtrip-choice:checked ~ .capture-stage #capture-vapor-roadtrip-panel,
  #capture-morning-lake-choice:checked ~ .capture-stage #capture-morning-lake-panel {
    display: block;
  }
  @keyframes capture-arrive {
    from { opacity: 0.65; }
    to { opacity: 1; }
  }
  .capture-footnote {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .capture-footnote a {
    color: var(--ink);
  }
  .intro-preview > p {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.2rem 1rem;
    margin-top: 0.6rem;
    color: var(--text-muted);
    font: 0.7rem var(--font-data);
    letter-spacing: 0.02em;
  }
  .intro-preview strong {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .intro-preview small { grid-column: 1 / -1; color: var(--text-muted); font: 0.68rem/1.45 var(--font-data); }
  .intro-preview small a { color: var(--text); text-decoration-color: var(--accent); }
  .intro h1 {
    margin-top: 0.7rem;
    font-size: clamp(3rem, 3.65vw, 4.3rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .intro h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .intro-copy {
    max-width: 54ch;
    margin-top: 1.2rem;
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .intro-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }
  .intro-meta span,
  .mode-tag {
    display: inline-flex;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font: 0.72rem var(--font-data);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.3rem;
  }
  .section-heading h2 {
    margin-top: 0.35rem;
  }
  .section-heading > p {
    max-width: 43ch;
    color: var(--text-muted);
  }
  .collection-label {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin: 2rem 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
