---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import ArchFrame from '../components/ArchFrame.astro';
import { themes } from '../data/product';
import neonCityShot from '../../assets/screenshots/curated/neon-city.webp';
import variantSample from '../data/product/palette-variants.json';

const originals = themes.filter((theme) => theme.collection === 'hornero-originals');
const otherLooks = themes.filter((theme) => theme.collection !== 'hornero-originals');
const wallpaperMedia = {
  'hornero-dark': (await import('../../assets/screenshots/theme-wallpapers/hornero-dark.webp')).default,
  'hornero-light': (await import('../../assets/screenshots/theme-wallpapers/hornero-light.webp')).default,
  pampa: (await import('../../assets/screenshots/theme-wallpapers/pampa.webp')).default,
  patagonia: (await import('../../assets/screenshots/theme-wallpapers/patagonia.webp')).default,
  'fin-del-mundo': (await import('../../assets/screenshots/theme-wallpapers/fin-del-mundo.webp')).default,
  quebrada: (await import('../../assets/screenshots/theme-wallpapers/quebrada.webp')).default,
  ibera: (await import('../../assets/screenshots/theme-wallpapers/ibera.webp')).default,
  'buenos-aires-nocturno': (await import('../../assets/screenshots/theme-wallpapers/buenos-aires-nocturno.webp'))
    .default,
  gruvbox: (await import('../../assets/screenshots/theme-wallpapers/gruvbox.webp')).default,
  landscape: (await import('../../assets/screenshots/theme-wallpapers/landscape.webp')).default,
  monochrome: (await import('../../assets/screenshots/theme-wallpapers/monochrome.webp')).default,
  'neon-city': (await import('../../assets/screenshots/theme-wallpapers/neon-city.webp')).default,
  'soft-morning': (await import('../../assets/screenshots/theme-wallpapers/soft-morning.webp')).default,
  'vapor-dreams': (await import('../../assets/screenshots/theme-wallpapers/vapor-dreams.webp')).default,
  'warm-sunset': (await import('../../assets/screenshots/theme-wallpapers/warm-sunset.webp')).default,
};
const modes = (mode: string) => (mode === 'light' ? 'Light' : 'Dark');
const wallpaperProof = {
  source: 'Hornero host capture',
  context: 'Live Arch + Hyprland host · empty workspace',
  resolution: '1920×1080',
  theme: 'Custom · dark · expressive colors',
  date: '2026-10-03',
};
const paletteVariants = variantSample.variants;
const showroom = await getCollection('showroom');
const desktopCaptures = ['hornero-light', 'pampa', 'neon-city', 'vapor-roadtrip', 'morning-lake'].map((id) => {
  const capture = showroom.find((item) => item.id === id);
  if (!capture) throw new Error(`Showroom capture not found: ${id}`);
  return capture;
});
---

<SiteLayout
  title={`Themes — ${themes.length} coordinated looks for Hornero OS`}
  description="Explore Hornero Originals and a broad collection of natural, minimal, cyberpunk, synthwave and classic looks. Each appearance coordinates the desktop and can be shaped with wallpaper color variants."
>
  <section class="intro section">
    <div class="intro-copy-column">
      <p class="eyebrow">Personalize the whole desktop</p>
      <h1>
        Choose a feeling.
        <br />
        <em>Make it yours.</em>
      </h1>
      <p class="intro-copy">
        A look is more than a wallpaper. Hornero coordinates shell colors, GTK apps and icons, then lets you fine-tune
        the pieces when you want to.
      </p>
      <div class="intro-meta">
        <span>{themes.length} coordinated looks</span>
        <span>{originals.length} Hornero Originals</span>
        <span>7 palette-generation styles</span>
      </div>
    </div>
    <div class="intro-preview">
      <ArchFrame
        src={neonCityShot}
        alt="Live Hornero desktop capture with a cyan and amber cyberpunk skyline behind its shell rail."
        eager
        provenance={wallpaperProof}
        sizes="(min-width: 900px) 50vw, calc(100vw - 2rem)"
        widths={[480, 720, 1080, 1280]}
      />
      <p>
        <span>Live desktop capture</span>
        <strong>Neon City</strong>
      </p>
    </div>
  </section>

  <section class="section desktop-gallery" aria-labelledby="desktop-gallery-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Looks on a running desktop</p>
        <h2 id="desktop-gallery-title">From scene to whole system.</h2>
      </div>
      <p>
        Wallpapers set a mood; the real desktop shows how bars, colors and controls meet it. These captures span a light
        first-party look, an Argentine grassland palette, a neon city and a synthwave road.
      </p>
    </div>
    <div class="desktop-capture-grid">
      {desktopCaptures.map((capture, i) => (
        <article class:list={['desktop-capture', `capture-${i + 1}`]}>
          <ArchFrame
            src={capture.data.image}
            alt={capture.data.alt}
            provenance={capture.data.provenance}
            sizes="(min-width: 1100px) 32vw, (min-width: 700px) 48vw, calc(100vw - 2rem)"
            widths={[480, 720, 960, 1280]}
          />
          <h3>{capture.data.title}</h3>
        </article>
      ))}
    </div>
    <p class="capture-footnote">
      The capture plates carry their own source and date. The wallpaper cards below show artwork; this gallery shows the
      Shell running over selected scenes. <a href="/showroom">Browse the complete desktop showcase</a>.
    </p>
  </section>

  <section class="section collection-section" aria-labelledby="looks-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">One desktop, many visual worlds</p>
        <h2 id="looks-title">A look for the way you work.</h2>
      </div>
      <p>
        Hornero Originals sit alongside classic, natural, minimal, cyberpunk and synthwave directions. Every card is a
        complete appearance choice; the artwork is a wallpaper preview, not a desktop screenshot.
      </p>
    </div>
    <div class="collection-label" id="hornero-originals">
      <div>
        <span class="collection-index">01</span>
        <h3>Hornero Originals</h3>
      </div>
      <p>First-party looks shaped by Hornero’s visual identity and the places, materials and light that inspire it.</p>
    </div>
    <ul class="look-grid" role="list">
      {originals.map((theme) => (
        <li class="look-card" id={theme.id}>
          <div class="look-art">
            {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? (
              <Picture
                src={wallpaperMedia[theme.id as keyof typeof wallpaperMedia]}
                alt={`Wallpaper artwork associated with the ${theme.name} appearance.`}
                formats={['webp']}
                fallbackFormat="webp"
                widths={[520, 800]}
                sizes="(min-width: 1100px) 28vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="artwork-unavailable">
                <span aria-hidden="true">◌</span>
                <span>Choose a wallpaper</span>
              </div>
            )}
            <span class="look-mode">{modes(theme.mode)}</span>
            <span class="look-category">Hornero Original</span>
          </div>
          <div class="look-copy">
            <h4>{theme.name}</h4>
            <p>{theme.description}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="collection-label other-label" id="more-looks">
      <div>
        <span class="collection-index">02</span>
        <h3>The wider collection</h3>
      </div>
      <p>Distinct directions, chosen for how they feel across the Shell—not ranked by how they are implemented.</p>
    </div>
    <ul class="look-grid" role="list">
      {otherLooks.map((theme) => (
        <li class="look-card" id={theme.id}>
          <div class="look-art">
            {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? (
              <Picture
                src={wallpaperMedia[theme.id as keyof typeof wallpaperMedia]}
                alt={`Wallpaper artwork associated with the ${theme.name} appearance.`}
                formats={['webp']}
                fallbackFormat="webp"
                widths={[520, 800]}
                sizes="(min-width: 1100px) 28vw, (min-width: 720px) 44vw, calc(100vw - 2rem)"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="artwork-unavailable">
                <span aria-hidden="true">◌</span>
                <span>Pair with your wallpaper</span>
              </div>
            )}
            <span class="look-mode">{modes(theme.mode)}</span>
            <span class="look-category">
              {wallpaperMedia[theme.id as keyof typeof wallpaperMedia] ? 'Wallpaper look' : 'Wallpaper-led'}
            </span>
          </div>
          <div class="look-copy">
            <h4>{theme.name}</h4>
            <p>{theme.description}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="artwork-note">
      Wallpaper previews are original Hornero artwork or media from the public{' '}
      <a href="https://github.com/ulises-jeremias/dotfiles/tree/main/home/dot_local/share/hornero/wallpapers">
        Hornero wallpaper collection
      </a>
      . They show the scene associated with a look, not a photograph of the running desktop.{' '}
      <a href="/showroom">See verified desktop captures in the Showroom</a>.
    </p>
  </section>

  <section class="section variants-section" id="palette-variants" aria-labelledby="palette-variants-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Color is part of the look</p>
        <h2 id="palette-variants-title">Seven palette-generation styles.</h2>
      </div>
      <p>
        Choose a style to change how Hornero reads the wallpaper and shapes Shell colors. Keep the same scene while
        moving from restrained tones to a more expressive palette.
      </p>
    </div>
    <ul class="variant-grid" role="list">
      {paletteVariants.map((variant) => (
        <li class="variant-card" data-variant={variant.id}>
          <span
            class="variant-swatches"
            aria-hidden="true"
            style={`--swatch-a:${variant.colors[0]};--swatch-b:${variant.colors[1]};--swatch-c:${variant.colors[2]}`}
          >
            <i></i>
            <i></i>
            <i></i>
          </span>
          <strong>{variant.name}</strong>
          <span>{variant.mood}</span>
        </li>
      ))}
    </ul>
    <p class="variant-footnote">
      All seven sample palettes were generated in dark mode from the same Neon City wallpaper with Hornero Config’s
      Material 3 generator. They are real outputs for that image; another wallpaper or light mode produces different
      colors. <a href="/docs/desktop/appearance/">Read how wallpaper colors work</a>.
    </p>
  </section>

  <section class="section practical">
    <div>
      <p class="eyebrow">The useful details</p>
      <h2>Everything in step.</h2>
      <p>
        A look brings the Shell, GTK policy, icons and wallpaper together. Some packs reference optional GTK or icon
        styles; Hornero checks availability and never downloads them silently. Palette-generation style and light/dark
        mode can be refined in Appearance.
      </p>
    </div>
    <div class="try-panel">
      <span class="mode-tag">From the desktop</span>
      <strong>Settings → Appearance</strong>
      <span>Preview a look, apply it, then refine mode, wallpaper and colors.</span>
      <a class="cta primary" href="/showroom">
        See the desktop
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  :global(main.app) {
    padding-top: 1.5rem;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(0.5rem, 2vw, 2rem) 1rem;
    margin-block-start: 0.75rem;
  }
  .intro > * + * {
    margin-top: 0;
  }
  .intro-preview {
    position: relative;
    min-width: 0;
  }
  .intro-preview :global(.frame) {
    width: 100%;
  }
  .intro-preview :global(.frame-shot) :global(img) {
    display: block;
    width: 100%;
    /* Preserve the full 16:9 desktop capture, including its vertical rail. */
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .desktop-gallery {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-block: 1px solid var(--line);
  }
  .desktop-gallery .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .desktop-gallery .section-heading h2 {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .desktop-gallery .section-heading > p {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
  }
  .desktop-capture-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .desktop-capture {
    min-width: 0;
    grid-column: span 2;
  }
  .desktop-capture.capture-1,
  .desktop-capture.capture-2 {
    grid-column: span 3;
  }
  .desktop-capture :global(.frame-shot) {
    aspect-ratio: 16 / 10;
  }
  .desktop-capture :global(.frame-shot img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .desktop-capture h3 {
    margin: 0.65rem 0 0;
    font-size: var(--step-1);
  }
  .capture-footnote {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .capture-footnote a {
    color: var(--ink);
  }
  .intro-preview > p {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.6rem;
    color: var(--text-muted);
    font: 0.7rem var(--font-data);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .intro-preview strong {
    color: var(--text);
    font-weight: 600;
  }
  .intro h1 {
    margin-top: 0.7rem;
    font-size: clamp(3rem, 3.65vw, 4.3rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .intro h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .intro-copy {
    max-width: 54ch;
    margin-top: 1.2rem;
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .intro-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }
  .intro-meta span,
  .mode-tag {
    display: inline-flex;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font: 0.72rem var(--font-data);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.3rem;
  }
  .section-heading h2 {
    margin-top: 0.35rem;
  }
  .section-heading > p {
    max-width: 43ch;
    color: var(--text-muted);
  }
  .collection-label {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin: 2rem 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .collection-label > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .collection-index {
    color: var(--accent);
    font: 0.72rem var(--font-data);
  }
  .collection-label h3 {
    font-size: 1.35rem;
  }
  .collection-label > p {
    max-width: 48ch;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .look-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .look-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }
  .look-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 50%, var(--line));
  }
  .look-art {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 28%, var(--surface)), var(--surface));
  }
  .look-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }
  .look-card:hover .look-art :global(img) {
    transform: scale(1.025);
  }
  .look-mode,
  .look-category {
    position: absolute;
    bottom: 0.55rem;
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.2rem 0.48rem;
    border: 1px solid color-mix(in oklab, white 24%, transparent);
    border-radius: 999px;
    color: white;
    background: color-mix(in oklab, #111 74%, transparent);
    backdrop-filter: blur(8px);
    font: 0.62rem var(--font-data);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .look-mode {
    left: 0.55rem;
  }
  .look-category {
    right: 0.55rem;
  }
  .artwork-unavailable {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.45rem;
    height: 100%;
    color: var(--text-muted);
    font: 0.72rem var(--font-data);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .artwork-unavailable span:first-child {
    color: var(--accent);
    font-size: 1.5rem;
  }
  .look-copy {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 0.9rem 1rem;
  }
  .look-copy h4 {
    font-size: 1rem;
    line-height: 1.2;
  }
  .look-copy p {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .artwork-note {
    margin-top: 1.2rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .artwork-note a {
    color: var(--text);
  }
  .variant-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .variant-card {
    display: grid;
    gap: 0.4rem;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .variant-card > span:last-child,
  .variant-footnote {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .variant-swatches {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 0.25rem;
  }
  .variant-swatches i {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--swatch-a);
  }
  .variant-swatches i:nth-child(2) {
    background: var(--swatch-b);
  }
  .variant-swatches i:nth-child(3) {
    background: var(--swatch-c);
  }
  .variant-footnote {
    margin-top: 0.9rem;
  }
  .variant-footnote a {
    color: var(--text);
  }
  .wallpaper-scenes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1rem;
  }
  .wallpaper-scene {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    min-width: 0;
  }
  .wallpaper-scene :global(.frame) {
    width: 100%;
  }
  .wallpaper-scene :global(.frame-shot) :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .wallpaper-scene h3 {
    font-size: 1.15rem;
  }
  .wallpaper-scene > p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .capture-note {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .capture-note a {
    color: var(--text);
  }
  .landscape-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .landscape-card {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }
  .landscape-card :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .landscape-card h3 {
    font-size: 1.2rem;
  }
  .landscape-card p,
  .landscape-card small,
  .artwork-note {
    color: var(--text-muted);
  }
  .landscape-card small,
  .artwork-note {
    font-size: 0.82rem;
  }
  .artwork-note a {
    color: var(--text);
  }
  .practical {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.3rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .practical h2 {
    margin-block: 0.4rem 0.7rem;
  }
  .practical > div:first-child > p:last-child {
    max-width: 59ch;
    color: var(--text-muted);
  }
  .try-panel {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
    padding: 1.2rem;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .try-panel > span:not(.mode-tag) {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  @media (min-width: 920px) {
    .proof-shot {
      grid-template-columns: 0.65fr 1fr;
      gap: 2rem;
    }
    .proof-shot:nth-child(2) {
      grid-template-columns: 1fr 0.65fr;
    }
    .proof-shot:nth-child(2) > div:first-child {
      grid-column: 2;
      grid-row: 1;
    }
    .proof-shot:nth-child(2) .frame {
      grid-column: 1;
      grid-row: 1;
    }
    .practical {
      grid-template-columns: 1fr minmax(270px, 0.55fr);
    }
  }
  @media (max-width: 720px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    .intro-preview {
      order: -1;
    }
    .intro h1 {
      font-size: clamp(2.55rem, 10vw, 3.4rem);
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.5rem;
    }
    .look-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }
    .collection-label {
      align-items: start;
