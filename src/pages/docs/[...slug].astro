---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { docsAreas } from '../../data/docs-nav';
import { pins, short } from '../../data/product';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = await getCollection('docs');

type Heading = { depth: number; text: string };
const titleOf = (e: CollectionEntry<'docs'>) =>
  (e.rendered?.metadata?.headings as Heading[] | undefined)?.find((h) => h.depth === 1)?.text ?? e.id;
const hrefOf = (id: string) => (id === 'index' ? '/docs/' : `/docs/${id}/`);
const title = titleOf(entry);

// Meta description: the first prose line, stripped of Markdown syntax.
const firstLine =
  (entry.body ?? '')
    .split('\n')
    .map((l) => l.trim())
    .find((l) => l && !/^(#|>|\||-|\*|```|!\[)/.test(l)) ?? '';
const description = firstLine
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[`*_]/g, '')
  .slice(0, 180);

const sourcePath = (entry.filePath ?? '').replace(/^\.?\/?\.cache\/product-src\/docs\//, '');
const docsPin = pins.docs;
const toc = headings.filter((h) => h.depth === 2);

const areas = docsAreas.map((a) => ({
  ...a,
  index: all.find((e) => e.id === a.id),
  pages: all.filter((e) => e.id.startsWith(`${a.id}/`)).sort((x, y) => titleOf(x).localeCompare(titleOf(y))),
}));
const current = entry.id;
---

<SiteLayout title={`${title} — Hornero OS docs`} description={description || `${title}, Hornero OS documentation.`}>
  <div class="docs">
    <nav class="docs-nav" aria-label="Documentation">
      <a href="/docs/" aria-current={current === 'index' ? 'page' : undefined} class="docs-home">
        Overview
      </a>
      {areas.map((a) => (
        <div class="area">
          {a.index ? (
            <a href={hrefOf(a.id)} aria-current={current === a.id ? 'page' : undefined} class="area-title">
              {a.label}
            </a>
          ) : (
            <span class="area-title">{a.label}</span>
          )}
          {a.pages.length > 0 && (
            <ul role="list">
              {a.pages.map((p) => (
                <li>
                  <a href={hrefOf(p.id)} aria-current={current === p.id ? 'page' : undefined}>
                    {titleOf(p)}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
      <a href="/search/" class="docs-search">
        Search the site
      </a>
    </nav>

    <article class="prose">
      <Content />
      <footer class="doc-foot">
        <p>
          From{' '}
          <a href={`${docsPin.repo}/blob/${docsPin.sha}/${sourcePath}`}>
            <code>HorneroOS/docs/{sourcePath}</code>
          </a>
          at commit{' '}
          <a href={`${docsPin.repo}/commit/${docsPin.sha}`}>
            <code>{short(docsPin.sha)}</code>
          </a>
          .<a href={`${docsPin.repo}/edit/main/${sourcePath}`}>Suggest a change on GitHub</a>.
        </p>
      </footer>
    </article>

    {toc.length > 1 && (
      <nav class="toc" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ul role="list">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</SiteLayout>

<style>
  .docs {
    display: grid;
    /* One shrinkable column on phones: wide code blocks scroll inside their
       <pre> instead of widening the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  /* Phones: the page first, the documentation map after it. */
  @media (max-width: 899px) {
    .docs-nav {
      order: 2;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }

    .toc {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }

  @media (min-width: 1180px) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr) 12rem;
    }
  }

  .docs-nav,
  .toc {
    display: grid;
    gap: 1rem;
    align-content: start;
    font-size: 0.93rem;
  }

  @media (min-width: 900px) {
    .docs-nav,
    .toc {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }

  .docs-nav a,
  .toc a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .docs-nav a:hover,
  .toc a:hover {
    color: var(--text);
  }

  .docs-nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--accent);
    padding-left: 0.6rem;
  }

  .area-title {
    font-weight: 600;
    color: var(--text);
  }

  .area ul,
  .toc ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    margin-top: 0.4rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--line);
  }

  .docs-search {
    font-size: var(--step--1);
  }

  .prose {
    min-width: 0;
    max-width: 72ch;
  }

  .prose :global(h1) {
    font-size: var(--step-3);
    margin-bottom: 1rem;
  }

  .prose :global(h2) {
    font-size: var(--step-2);
    margin: 2.25rem 0 0.75rem;
  }

  .prose :global(h3) {
    font-size: var(--step-1);
    margin: 1.75rem 0 0.5rem;
  }

  .prose :global(:is(p, ul, ol, pre, table, blockquote)) {
    margin-bottom: 1rem;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.4rem;
  }

  .prose :global(li + li) {
    margin-top: 0.3rem;
  }

  .prose :global(blockquote) {
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--secondary);
    background: var(--surface);
    border-radius: 0 10px 10px 0;
    color: var(--text-muted);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
  }

  .prose :global(img) {
    border-radius: 10px;
    border: 1px solid var(--line);
  }

  .doc-foot {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
