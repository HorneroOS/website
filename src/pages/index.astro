---
import { Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import heroShot from '../../assets/screenshots/desktop-neon.png';

const title = 'Hornero OS — an Arch Linux desktop with Argentine soul';
const description =
  'Hornero OS: a Wayland/Hyprland desktop with a Quickshell shell, a native system CLI, and 15 curated themes. Built in the open.';

const pillars = [
  {
    title: 'Quickshell desktop shell',
    text: 'Bar, launcher, dashboard, notifications and session controls — one QML shell on Wayland, with 15 layout presets, including dual, island, dock and clear (transparent) bars.',
  },
  {
    title: 'horneroctl system CLI',
    text: 'One front door for presets, appearance, shell lifecycle, snapshots and health. Non-interactive, scriptable, tested.',
  },
  {
    title: '15 curated themes',
    text: 'From Hornero Dark to Neon City and Pampa — token-driven packs with an offline-first catalogue, cyberpunk included.',
  },
  {
    title: 'SDDM greeter',
    text: 'An SDDM theme with offline Argentine landscapes, day/golden-hour/night rotation, zero network.',
  },
];
---

<SiteLayout title={title} description={description}>
  <section class="hero">
    <h1>
      An Arch Linux desktop <span class="neon">with Argentine soul</span>
    </h1>
    <p>
      Hornero OS is a Wayland desktop built around Hyprland and Quickshell, developed in the open. From pampa calm to
      neon-city nights.
    </p>
    <div class="cta-row">
      <a href="/install" class="cta primary">
        Install
      </a>
      <a href="/showroom" class="cta secondary">
        See it running
      </a>
    </div>
    <div class="hero-shot">
      <Picture
        src={heroShot}
        alt="Hornero OS desktop, Neon City theme"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1100px) 1036px, calc(100vw - 2rem)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <h2>One system, four parts</h2>
    <div class="cards">
      {pillars.map((p) => (
        <div class="card">
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Where it comes from</h2>
    <p>
      HorneroOS grew out of the <code class="inline">ulises-jeremias/dotfiles</code> repository and the Quickshell
      projects it learned from, and is now a system of its own: CLI, shell, config, and an installer contract.{' '}
      <a href="/roots">Read where each piece comes from and how it compares</a>.
    </p>
  </section>
</SiteLayout>
