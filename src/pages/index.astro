---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArchFrame from '../components/ArchFrame.astro';
import { Picture } from 'astro:assets';
import heroShot from '../../assets/screenshots/certified/hornero-light.png';
import cockpit from '../../assets/screenshots/certified/cockpit-clear.png';
import islands from '../../assets/screenshots/certified/islands.png';
import dock from '../../assets/screenshots/certified/dock-bottom.png';
import neonCity from '../../assets/screenshots/curated/neon-city.webp';
import vaporRoadtrip from '../../assets/screenshots/curated/vapor-roadtrip.webp';
import morningLake from '../../assets/screenshots/curated/morning-lake.webp';
import { editionCatalogue, editions, layouts, themes } from '../data/product';

const heroProvenance = {
  source: 'Hornero QA',
  context: 'Package-only flagship theme run',
  pins: { shell: '98a5de2', config: '96b6870', horneroctl: '9c15172' },
  resolution: '1280×800',
  theme: 'Hornero Light',
  date: '2026-10-03',
};
const layoutShots = [
  { name: 'Cockpit Clear', note: 'One calm line, edge to edge.', src: cockpit, href: '/layouts#cockpit-clear' },
  { name: 'Islands', note: 'Separate surfaces, one shell.', src: islands, href: '/layouts#islands' },
  { name: 'Dock Bottom', note: 'A dock that leaves the sky open.', src: dock, href: '/layouts#dock-bottom' },
];
const wallpaperShots = [
  {
    name: 'Neon City',
    note: 'Electric cyan and amber, after dark.',
    src: neonCity,
    alt: 'Hornero desktop with the Neon City cyberpunk skyline behind its left rail.',
  },
  {
    name: 'Vapor Dreams',
    note: 'Coral cliffs under a synthwave sky.',
    src: vaporRoadtrip,
    alt: 'Hornero desktop with a coral synthwave road and dusk-purple sky behind its left rail.',
  },
  {
    name: 'Soft Morning',
    note: 'A cool alpine dawn above cloud.',
    src: morningLake,
    alt: 'Hornero desktop with a pale alpine sunrise above cloud behind its left rail.',
  },
];
const editionOrder = ['desktop', 'server', 'agents', 'studio'];
const editionById = Object.fromEntries(editions.map((edition) => [edition.id, edition]));
const maturityNames = { planned: 'Planned', experimental: 'Experimental', preview: 'Preview', supported: 'Supported' };
const family = editionOrder.map((id) => {
  const edition = editionById[id];
  if (!edition) throw new Error(`Edition ${id} is missing from the pinned catalogue`);
  return {
    ...edition,
    name: edition.title.replace('HorneroOS ', ''),
    status: maturityNames[edition.maturity],
    compositors: (edition.compositor?.supported ?? []).map((backend) => ({
      id: backend,
      maturity: editionCatalogue.compositors.find((item) => item.id === backend)?.maturity ?? 'planned',
    })),
  };
});
const title = 'HorneroOS | An operating system family shaped by daily use';
const description = `An Arch-based operating system family evolved from a Linux setup used daily since 2018. Explore the Wayland-first Desktop preview, ${layouts.length} layouts and ${themes.length} coordinated looks.`;
---

<SiteLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span> Arch Linux · daily use since 2018
      </p>
      <h1>
        Eight years of Linux. <em>HorneroOS.</em>
      </h1>
      <p class="lede">
        HorneroOS is an Arch-based operating system family grown from Ulises Jeremías’s battle-tested Linux setup, used
        daily since 2018—well before the current AI OS trend. Desktop is Wayland-first; Server, Agents and Studio share its
        foundation.
      </p>
      <p class="heritage">
        Follow the work in Ulises’s{' '}
        <a href="https://github.com/ulises-jeremias/dotfiles">public dotfiles</a>.{' '}
        <a href="https://github.com/ulises-jeremias">Ulises Jeremías</a> is the principal maintainer.{' '}
        <a href="https://github.com/PandaFoss">Panda Foss</a> contributes to HorneroOS, is one of the maintainers of{' '}
        <a href="https://gitlab.com/anarchyinstaller/installer">Anarchy Linux</a>, and will lead HorneroOS’s future custom installer.{' '}
        Both are part of the <a href="https://github.com/HorneroOS">HorneroOS organization</a>.
      </p>
      <div class="hero-facts" aria-label="Hornero at a glance">
        <span>
          <strong>{layouts.length}</strong> layouts
        </span>
        <span>
          <strong>{themes.length}</strong> looks
        </span>
        <span>
          <strong>1</strong> shell
        </span>
      </div>
      <div class="cta-row">
        <a href="/showroom" class="cta primary">
          Explore the desktop <span aria-hidden="true">↗</span>
        </a>
        <a href="/install" class="cta secondary">
          Try Hornero
        </a>
      </div>
      <p class="release-note">
        Development preview · no published ISO; the Calamares installer is provisional until Panda Foss’s custom version is ready{' '}
        <a href="/install">See install status</a>
      </p>
    </div>
    <ArchFrame
      src={heroShot}
      alt="Hornero Light running with a slim side rail over a sunlit Patagonian landscape; a shell notification confirms the theme was applied."
      variant="arch"
      eager
      sizes="(min-width: 1180px) 720px, calc(100vw - 2rem)"
      widths={[480, 720, 1080, 1280]}
      provenance={heroProvenance}
    />
  </section>

  <section class="section family-snapshot" aria-labelledby="family-title">
    <div class="family-heading">
      <div>
        <p class="eyebrow">One foundation, composed by role</p>
        <h2 id="family-title">HorneroOS is a family, not a single desktop.</h2>
      </div>
      <a class="text-link" href="/editions">
        Explore the editions <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="family-rail">
      {family.map((edition) => (
        <a class:list={['family-cell', `family-${edition.id}`, `maturity-${edition.maturity}`]} href="/editions">
          <span class="family-cell-top">
            <strong>{edition.name}</strong>
            <small>{edition.status}</small>
          </span>
          {edition.compositors.length > 0 ? (
            <span class="family-detail">
              Wayland ·{' '}
              {edition.compositors.map((backend) => (backend.id === 'hyprland' ? 'Hyprland' : 'Niri')).join(' / ')}
            </span>
          ) : (
            <span class="family-detail">Headless role</span>
          )}
          {edition.extends && (
            <span class="family-inherit">
              Builds on {editionById[edition.extends]?.title.replace('HorneroOS ', '') ?? edition.extends}
            </span>
          )}
        </a>
      ))}
    </div>
    <p class="family-note">
      Desktop is the current preview. Server, Agents and Studio remain planned; none has an installable image yet.
    </p>
  </section>

  <section class="section worlds" aria-labelledby="worlds-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Space, not skin</p>
        <h2 id="worlds-title">Make the shell fit the way you work.</h2>
      </div>
      <a class="text-link" href="/layouts">
        Explore all {layouts.length} layouts <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="layout-stories">
      {layoutShots.map((shot, i) => (
        <a class:list={['layout-story', `story-${i + 1}`]} href={shot.href}>
          <Picture
            src={shot.src}
            alt={`${shot.name} layout captured in a running Hornero desktop`}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[360, 480, 720, 1080]}
            sizes="(min-width: 1180px) 33vw, (min-width: 700px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
          />
          <span class="story-copy">
            <strong>{shot.name}</strong>
            <span>{shot.note}</span>
            <small>Hornero QA · 2026-10-03</small>
          </span>
        </a>
      ))}
    </div>
    <p class="microcopy">
      Side rail, paired bars, floating islands or a dock. Switch layouts from the desktop and keep your settings.
    </p>
  </section>

  <section class="section product-model">
    <div class="model-intro">
      <p class="eyebrow">Personalization that stays coherent</p>
      <h2>
        Choose a look.
        <br />
        Keep the details in sync.
      </h2>
      <p>
        The shell, GTK apps, icons and wallpaper can move together. When you want to fine-tune, the controls are there
        too.
      </p>
      <a href="/themes" class="text-link">
        Find your starting point <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="model-list">
      <a href="/themes#hornero-dark">
        <span class="model-index">01</span>
        <span>
          <strong>Hornero Originals</strong>
          <small>First-party looks shaped by Hornero’s design language and varied landscapes.</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/themes#more-looks">
        <span class="model-index">02</span>
        <span>
          <strong>Find a different atmosphere</strong>
          <small>From soft natural tones to neon, monochrome and synthwave.</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/themes#palette-variants">
        <span class="model-index">03</span>
        <span>
          <strong>Shape colors from your wallpaper</strong>
          <small>Choose among seven generation styles while keeping the same scene.</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="section wallpaper-worlds" aria-labelledby="wallpaper-worlds-title">
    <div class="wallpaper-heading">
      <div>
        <p class="eyebrow">The wallpaper changes the atmosphere</p>
        <h2 id="wallpaper-worlds-title">One Shell. Many atmospheres.</h2>
      </div>
      <p>
        These desktop captures offer a few windows into a much wider wallpaper collection: electric city, synthwave road
        and a pale Patagonian morning.
      </p>
    </div>
    <div class="wallpaper-grid">
      {wallpaperShots.map((shot) => (
        <a class="wallpaper-shot" href="/showroom">
          <Picture
            src={shot.src}
            alt={shot.alt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[360, 540, 720, 960]}
            sizes="(min-width: 1180px) 30vw, (min-width: 720px) 45vw, calc(100vw - 2rem)"
            loading="lazy"
            decoding="async"
          />
          <span>
            <strong>{shot.name}</strong>
            <small>{shot.note}</small>
          </span>
        </a>
      ))}
    </div>
    <p class="wallpaper-credit">
      Three real desktop captures, each using a different wallpaper already in the collection. Wallpaper-derived colors
      are an optional Appearance setting; these captures show the scenes, not a palette-generation comparison. See the{' '}
      <a href="/showroom">Showroom</a> for capture context.
    </p>
  </section>

  <section class="section closing">
    <div>
      <p class="eyebrow">Built in the open</p>
      <h2>Explore the real thing.</h2>
      <p>Hornero is a work in progress, tested as a complete desktop and documented as it changes.</p>
    </div>
    <div class="closing-links">
      <a href="/showroom" class="cta primary">
        Open the showroom
      </a>
      <a href="/docs">
        Read the documentation <span aria-hidden="true">→</span>
      </a>
      <a href="https://github.com/HorneroOS">
        Browse the source <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 4vw, 4rem) 2rem;
  }
  .hero-copy {
    display: grid;
    gap: 0.95rem;
    justify-items: start;
  }
  .hero h1 {
    max-width: 18ch;
    font-size: clamp(2.8rem, 2.25rem + 1.8vw, 4rem);
    line-height: 0.99;
    letter-spacing: -0.055em;
  }
  .hero h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .hero .lede {
    max-width: 44ch;
    font-size: clamp(1.08rem, 1rem + 0.5vw, 1.3rem);
  }
  .heritage {
    max-width: 54ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.5;
    padding-left: 0.8rem;
    border-left: 2px solid var(--accent);
  }
  .heritage a {
    color: var(--text);
    text-decoration-color: color-mix(in oklab, var(--accent) 65%, transparent);
    text-underline-offset: 0.16em;
  }
  .heritage a:hover {
    color: var(--accent);
  }
  .family-snapshot {
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .family-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .family-heading h2 {
    max-width: 24ch;
    margin-top: 0.35rem;
  }
  .family-rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .family-cell {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.8rem;
    border-top: 2px solid var(--secondary);
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    color: var(--text);
    text-decoration: none;
  }
  .family-desktop {
    border-top-color: var(--accent);
  }
  .family-server {
    border-top-color: #7daab4;
  }
  .family-agents {
    border-top-color: #a68bd0;
  }
  .family-studio {
    border-top-color: #8eab72;
  }
  .family-cell-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.5rem;
  }
  .family-cell-top small {
    color: var(--secondary);
    font: 0.63rem var(--font-data);
    text-transform: uppercase;
  }
  .family-detail {
    color: var(--text-muted);
    font-size: 0.76rem;
  }
  .family-inherit {
    color: var(--text-muted);
    font-size: 0.68rem;
  }
  .family-note {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 0.77rem;
  }
  .family-cell:hover .family-cell-top strong {
    color: var(--accent);
  }
  .hero :global(.frame) {
    width: 100%;
  }
  .hero :global(.frame-shot) {
    aspect-ratio: 16/10;
  }
  .hero :global(.frame-shot) :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .status-dot {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: #86ae68;
    box-shadow: 0 0 0 4px color-mix(in oklab, #86ae68 18%, transparent);
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .hero-facts strong {
    color: var(--text);
    font-family: var(--font-data);
    font-size: 1.1rem;
  }
  .release-note,
  .microcopy {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .release-note a {
    margin-left: 0.4rem;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .section-heading h2 {
    max-width: 18ch;
    margin-top: 0.45rem;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .text-link:hover {
    color: var(--accent);
  }
  .layout-stories {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: 1rem;
  }
  .layout-story {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .layout-story :global(picture) {
    display: block;
    overflow: hidden;
  }
  .layout-story :global(img) {
    width: 100%;
    height: clamp(190px, 22vw, 310px);
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .layout-story:hover :global(img) {
    transform: scale(1.025);
  }
  .story-copy {
    display: grid;
    gap: 0.1rem;
    padding: 0.85rem 1rem 1rem;
  }
  .story-copy strong {
    font-size: 1.05rem;
  }
  .story-copy span {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .story-copy small {
    margin-top: 0.35rem;
    color: var(--secondary);
    font: 0.62rem var(--font-data);
  }
  .microcopy {
    margin-top: 1rem;
  }
  .product-model {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: linear-gradient(135deg, var(--surface), color-mix(in oklab, var(--bg) 75%, var(--surface)));
  }
  .model-intro h2 {
    margin-top: 0.45rem;
  }
  .model-intro > p:not(.eyebrow) {
    max-width: 44ch;
    margin-block: 0.8rem 1rem;
    color: var(--text-muted);
  }
  .model-list {
    display: grid;
  }
  .model-list a {
    display: grid;
    grid-template-columns: 2.3rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0.2rem;
    color: var(--text);
    text-decoration: none;
    border-top: 1px solid var(--line);
  }
  .model-list a:hover strong {
    color: var(--accent);
  }
  .model-index {
    color: var(--secondary);
    font: 0.78rem var(--font-data);
  }
  .model-list strong,
  .model-list small {
    display: block;
  }
  .model-list small {
    margin-top: 0.2rem;
    color: var(--text-muted);
  }
  .wallpaper-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }
  .wallpaper-heading h2 {
    margin-top: 0.4rem;
  }
  .wallpaper-heading > p {
    max-width: 43ch;
    color: var(--text-muted);
  }
  .wallpaper-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .wallpaper-shot {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .wallpaper-shot :global(picture) {
    display: block;
    overflow: hidden;
  }
  .wallpaper-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .wallpaper-shot:hover :global(img) {
    transform: scale(1.025);
  }
  .wallpaper-shot > span {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0.9rem 0.95rem;
  }
  .wallpaper-shot small,
  .wallpaper-credit {
    color: var(--text-muted);
  }
  .wallpaper-credit {
    margin-top: 0.85rem;
    font-size: 0.8rem;
  }
  .wallpaper-credit a {
    color: var(--text);
  }
  .closing {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .closing h2 {
    margin-block: 0.4rem;
  }
  .closing p:not(.eyebrow) {
    max-width: 45ch;
    color: var(--text-muted);
  }
  .closing-links {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
  }
  .closing-links > a:not(.cta) {
    color: var(--text-muted);
    text-decoration: none;
  }
  .closing-links > a:hover {
    color: var(--accent);
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    }
    .product-model {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
    }
  }
  @media (max-width: 700px) {
    .family-heading {
      align-items: start;
      flex-direction: column;
    }
    .family-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .section-heading,
    .wallpaper-heading,
    .closing {
      align-items: start;
      flex-direction: column;
    }
    .section-heading {
      gap: 0.9rem;
    }
    .wallpaper-heading {
      gap: 0.75rem;
    }
    .wallpaper-grid {
      grid-template-columns: 1fr;
    }
    .layout-stories {
      grid-template-columns: 1fr 1fr;
    }
    .story-1 {
      grid-column: span 2;
    }
    .story-1 :global(img) {
      height: clamp(200px, 55vw, 340px);
    }
    .layout-story :global(img) {
      height: clamp(145px, 38vw, 220px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .layout-story :global(img),
    .wallpaper-shot :global(img) {
      transition: none;
    }
    .wallpaper-shot:hover :global(img) {
      transform: none;
    }
  }
</style>
