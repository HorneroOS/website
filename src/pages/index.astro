---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  editionCatalogue,
  editions,
  greeterScenes,
  layouts,
  themes,
  wallpapers,
} from '../data/product';
import cockpit from '../../assets/screenshots/certified/cockpit-clear.png';
import islands from '../../assets/screenshots/certified/islands.png';
import dock from '../../assets/screenshots/certified/dock-bottom.png';

const captures = await getCollection('showroom');
const layoutShots = [
  { id: 'cockpit-clear', name: 'Cockpit Clear', note: 'One calm line, edge to edge.', src: cockpit },
  { id: 'islands', name: 'Islands', note: 'Separate surfaces, one shell.', src: islands },
  { id: 'dock-bottom', name: 'Dock Bottom', note: 'A dock that leaves the sky open.', src: dock },
].map((shot) => {
  const capture = captures.find((item) => item.id === shot.id);
  if (!capture) throw new Error(`Showroom capture not found: ${shot.id}`);
  return { ...shot, provenance: capture.data.provenance };
});
const heroScene = greeterScenes.find((scene) => scene.id === 'ar-ba-nocturno');
if (!heroScene) throw new Error('Buenos Aires night scene is missing from the pinned media catalogue');
const editionOrder = ['desktop', 'server', 'agents', 'studio'];
const editionById = Object.fromEntries(editions.map((edition) => [edition.id, edition]));
const maturityNames = { planned: 'Planned', experimental: 'Experimental', preview: 'Preview', supported: 'Supported' };
const familyRoleLabels: Record<string, string> = {
  server: 'Headless · homelab and services',
  'agent-host': 'Headless · agent infrastructure',
  'creative-workstation': 'Desktop · creative production',
};
const family = editionOrder.map((id) => {
  const edition = editionById[id];
  if (!edition) throw new Error(`Edition ${id} is missing from the pinned catalogue`);
  return {
    ...edition,
    name: edition.title.replace('HorneroOS ', ''),
    status: maturityNames[edition.maturity],
    roleLabel: familyRoleLabels[edition.role] ?? edition.role,
    compositors: (edition.compositor?.supported ?? []).map((backend) => ({
      id: backend,
      maturity: editionCatalogue.compositors.find((item) => item.id === backend)?.maturity ?? 'planned',
    })),
  };
});
const desktopCompositors = (editionById.desktop?.compositor?.supported ?? []).map((id) => {
  const compositor = editionCatalogue.compositors.find((item) => item.id === id);
  const name = id === 'hyprland' ? 'Hyprland' : id === 'niri' ? 'Niri' : id;
  const maturity = compositor?.maturity ?? 'planned';
  return { name, maturity: maturity[0].toUpperCase() + maturity.slice(1) };
});
const title = 'HorneroOS | A Linux desktop, built the long way';
const description = `An Arch-based, Wayland-first desktop grown from an environment used daily since 2018. Explore ${layouts.length} layouts, ${themes.length} coordinated looks and licensed photographs from Argentina.`;
---

<SiteLayout title={title} description={description}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Arch Linux · Wayland-first · daily use since 2018</p>
      <h1 id="hero-title">A Linux desktop,<br /><em>built the <span class="phrase-tail">long way.</span></em></h1>
      <p class="lede">
        HorneroOS is an Arch-based, Wayland-first desktop grown from the environment Ulises Jeremías has used, tested
        and refined every day since 2018.
      </p>
      <p class="heritage">
        Built by <a href="https://github.com/ulises-jeremias">Ulises Jeremías</a>, with contributions from{' '}
        <a href="https://github.com/PandaFoss">Panda Foss</a>, one of the maintainers of{' '}
        <a href="https://gitlab.com/anarchyinstaller/installer">Anarchy Linux</a>. Shaped in the open with the{' '}
        <a href="https://github.com/HorneroOS">HorneroOS community</a>.
      </p>
      <div class="cta-row">
        <a href="/showroom" class="cta primary">Explore the desktop <span aria-hidden="true">↗</span></a>
        <a href="/install" class="cta secondary">See what you can install</a>
      </div>
    </div>

    <div class="hero-detail">
      <div class="hero-facts" aria-label="Hornero at a glance">
        <span><strong>{layouts.length}</strong> layouts</span>
        <span><strong>{themes.length}</strong> coordinated looks</span>
        <span><strong>{desktopCompositors.length}</strong> compositor backends</span>
      </div>
      <p class="release-note">
        Development preview · no ISO is published. Calamares remains provisional while Panda Foss develops the custom
        installer. {desktopCompositors.map((compositor) => `${compositor.name} ${compositor.maturity}`).join(' · ')}.
        {' '}<a href="/editions#desktop">Desktop support status</a> · <a href="/install">Install status</a>
      </p>
    </div>

    <figure class="hero-scene">
      <img
        src={heroScene.poster}
        alt={heroScene.description}
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>
        <span class="scene-title">{heroScene.title}</span>
        <span class="scene-place">{heroScene.place} · {heroScene.province}</span>
        <span class="scene-credit">Photograph by <a href={heroScene.sourceUrl}>{heroScene.creator}</a> · <a href={heroScene.licenseUrl}>{heroScene.license}</a></span>
      </figcaption>
      <span class="scene-index" aria-hidden="true">ARG / NIGHT</span>
    </figure>
  </section>

  <section class="section family-snapshot" aria-labelledby="family-title">
    <div class="family-heading">
      <div>
        <p class="eyebrow">One foundation, composed by role</p>
        <h2 id="family-title">One operating system family. Different ways to use it.</h2>
      </div>
      <a class="text-link" href="/editions">Explore the editions <span aria-hidden="true">→</span></a>
    </div>
    <div class="family-rail">
      {family.map((edition) => (
        <a class:list={['family-cell', `family-${edition.id}`, `maturity-${edition.maturity}`]} href={`/editions#${edition.id}`}>
          <span class="family-cell-top"><strong>{edition.name}</strong><small>{edition.status}</small></span>
          {edition.compositors.length > 0 ? (
            <span class="family-detail">Wayland · {edition.compositors.map((backend) => (backend.id === 'hyprland' ? 'Hyprland' : 'Niri')).join(' / ')}</span>
          ) : (
            <span class="family-detail">{edition.roleLabel}</span>
          )}
          {edition.extends && <span class="family-inherit">Builds on {editionById[edition.extends]?.title.replace('HorneroOS ', '') ?? edition.extends}</span>}
        </a>
      ))}
    </div>
    <p class="family-note">Desktop is the current preview. Server, Agents and Studio remain planned; none has an installable image yet.</p>
  </section>

  <section class="section worlds" aria-labelledby="worlds-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A shell with room to move</p>
        <h2 id="worlds-title">Make the desktop fit the way you work.</h2>
      </div>
      <a class="text-link" href="/layouts">Explore all {layouts.length} layouts <span aria-hidden="true">→</span></a>
    </div>
    <div class="layout-stories">
      {layoutShots.map((shot, i) => (
        <a class:list={['layout-story', `story-${i + 1}`]} href={`/layouts#${shot.id}`}>
          <Picture
            src={shot.src}
            alt={`${shot.name} layout in a real Hornero desktop capture.`}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[360, 480, 720, 1080]}
            sizes="(min-width: 1180px) 33vw, (min-width: 700px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
          />
          <span class="story-copy">
            <strong>{shot.name}</strong>
            <span>{shot.note}</span>
            <small>Real capture · {shot.provenance.source} · {shot.provenance.date}</small>
          </span>
        </a>
      ))}
    </div>
    <p class="microcopy">A side rail, paired bars, floating islands or a dock. The dated captures document layout behavior; explore the current photo collection below.</p>
  </section>

  <section class="section product-model" aria-labelledby="personalize-title">
    <div class="model-intro">
      <p class="eyebrow">Personalization that stays coherent</p>
      <h2 id="personalize-title">Choose a look.<br />Keep the details in sync.</h2>
      <p>The shell, GTK apps, icons and wallpaper can move together. Fine-tune each part when you want to.</p>
      <a href="/themes" class="text-link">Find your starting point <span aria-hidden="true">→</span></a>
    </div>
    <div class="model-list">
      <a href="/themes#hornero-originals"><span class="model-index">01</span><span><strong>Hornero Originals</strong><small>Six Argentina-inspired looks grounded in attributed photography.</small></span><span aria-hidden="true">↗</span></a>
      <a href="/themes#more-looks"><span class="model-index">02</span><span><strong>Find a different atmosphere</strong><small>Natural, classic, minimal, cyberpunk and synthwave directions.</small></span><span aria-hidden="true">↗</span></a>
      <a href="/themes#palette-variants"><span class="model-index">03</span><span><strong>Shape color from the wallpaper</strong><small>Choose among seven generation styles while keeping the same scene.</small></span><span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="terminal-feature" aria-labelledby="terminal-feature-title">
    <div class="terminal-feature-intro">
      <p class="eyebrow">The rest of the workspace, in step</p>
      <h2 id="terminal-feature-title">One palette.<br /><em>Three native terminals.</em></h2>
      <p>Hornero translates the selected appearance into native color files for Kitty, Alacritty and Ghostty. Pick an installed emulator in Settings; each keeps its own config format.</p>
      <a class="text-link" href="/terminals">See how the terminal integration works <span aria-hidden="true">→</span></a>
    </div>
    <div class="terminal-strip" aria-label="Supported terminal emulators and their native color formats">
      <div><span class="terminal-glyph" aria-hidden="true">K</span><strong>Kitty</strong><code>conf</code></div>
      <div><span class="terminal-glyph" aria-hidden="true">A</span><strong>Alacritty</strong><code>TOML</code></div>
      <div><span class="terminal-glyph" aria-hidden="true">G</span><strong>Ghostty</strong><code>theme</code></div>
    </div>
  </section>

  <section class="section photo-atlas" aria-labelledby="photo-atlas-title">
    <div class="photo-heading">
      <div>
        <p class="eyebrow">Hornero Originals · Argentina</p>
        <h2 id="photo-atlas-title">The place is real.<br /><em>The interpretation is Hornero’s.</em></h2>
      </div>
      <p>Licensed photographs ground six first-party looks in the places and light that shaped them. The source, photographer and license travel with every image.</p>
    </div>
    <ul class="photo-grid" role="list">
      {wallpapers.map((wallpaper, index) => (
        <li class:list={['photo-card', `photo-card-${index + 1}`]}>
          <a class="photo-image" href={wallpaper.preview} aria-label={`Open full photograph: ${wallpaper.title}`}>
            <img
              src={wallpaper.previewSmall}
              srcset={`${wallpaper.previewSmall} 720w, ${wallpaper.preview} 1280w`}
              sizes="(min-width: 1100px) 42vw, (min-width: 700px) 48vw, calc(100vw - 2rem)"
              alt={wallpaper.previewAlt}
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span class="photo-open" aria-hidden="true">View scene ↗</span>
          </a>
          <div class="photo-caption">
            <span class="photo-place">{wallpaper.place}</span>
            <h3>{wallpaper.title}</h3>
            <p>Photograph by {wallpaper.photographer} · <a href={wallpaper.licenseUrl}>{wallpaper.license}</a></p>
            <a class="photo-theme" href={`/themes#${wallpaper.themeId}`}>Explore {themes.find((theme) => theme.id === wallpaper.themeId)?.name ?? 'this look'} <span aria-hidden="true">→</span></a>
          </div>
        </li>
      ))}
    </ul>
    <a class="text-link atlas-link" href="/wallpapers">Browse all photographs and source credits <span aria-hidden="true">→</span></a>
  </section>

  <section class="greeter-feature" aria-labelledby="greeter-feature-title">
    <a class="greeter-feature-image" href="/greeter" aria-label="Explore the interactive HorneroOS greeter preview">
      <img
        src="/media/greeter/ar-er-el-palmar-golden-hour.webp"
        alt="Browser recreation of the HorneroOS greeter over a golden-hour view of El Palmar; this is not a desktop screenshot."
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
      <span class="feature-preview-label">BROWSER RECREATION</span>
      <span class="feature-clock" aria-hidden="true">17:42</span>
      <span class="feature-signature" aria-hidden="true">HORNERO <i>OS</i></span>
    </a>
    <div class="greeter-feature-copy">
      <p class="eyebrow">The first moment of the desktop</p>
      <h2 id="greeter-feature-title">Argentina, before the desktop.</h2>
      <p>The HorneroOS greeter pairs a calm login screen with landscapes and city lights from Argentina. Explore its local-time moods in an interactive browser recreation.</p>
      <a class="text-link" href="/greeter">Experience the greeter <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section closing" aria-labelledby="closing-title">
    <div>
      <p class="eyebrow">Built in the open</p>
      <h2 id="closing-title">Follow the work.<br />Try the desktop.</h2>
      <p>HorneroOS is a development preview: individual components are available as Arch packages, while the installable image is still in development.</p>
    </div>
    <div class="closing-links">
      <a href="/install" class="cta primary">See how to try Hornero</a>
      <a href="/docs/">Read the documentation <span aria-hidden="true">→</span></a>
      <a href="https://github.com/HorneroOS">Browse the source <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas: 'copy scene' 'detail scene';
    align-items: start;
    align-content: start;
    gap: clamp(2rem, 5vw, 5.5rem);
    padding-block: clamp(1rem, 2vw, 2rem) clamp(3rem, 7vw, 6rem);
  }
  .hero-copy { grid-area: copy; display: grid; justify-items: start; gap: 1rem; }
  .hero-detail { grid-area: detail; display: grid; justify-items: start; gap: 1rem; }
  .hero-copy .eyebrow { max-width: 43rem; }
  .hero h1 { max-width: none; font-size: clamp(3.15rem, 4.6vw, 5.9rem); line-height: 0.91; letter-spacing: -0.075em; }
  .hero h1 em { color: var(--accent); font-style: normal; }
  .hero h1 .phrase-tail { white-space: nowrap; }
  .hero .lede { max-width: 42ch; font-size: clamp(1.08rem, 1rem + 0.45vw, 1.3rem); line-height: 1.5; }
  .heritage { max-width: 50ch; padding-left: 0.85rem; border-left: 2px solid var(--accent); color: var(--text-muted); font-size: 0.82rem; line-height: 1.5; }
  .heritage a { color: var(--text); text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  .heritage a:hover { color: var(--accent); }
  .hero-facts { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; padding-block: 0.6rem; border-block: 1px solid var(--line); color: var(--text-muted); font-size: 0.9rem; }
  .hero-facts strong { color: var(--text); font: 1rem var(--font-data); }
  .release-note, .microcopy { color: var(--text-muted); font-size: 0.78rem; }
  .hero-scene { grid-area: scene; position: relative; min-width: 0; margin: 0; isolation: isolate; }
  .hero-scene::before { position: absolute; z-index: -1; inset: 0.7rem -0.7rem -0.7rem 0.7rem; border: 1px solid var(--highlight); content: ''; opacity: 0.5; }
  .hero-scene img { width: 100%; height: auto; aspect-ratio: 1.13 / 1; object-fit: cover; object-position: center; border: 1px solid color-mix(in srgb, var(--highlight) 42%, var(--line)); background: var(--surface); box-shadow: 0 1.7rem 4rem color-mix(in srgb, var(--bg) 45%, transparent); }
  .hero-scene::after { position: absolute; inset: 0; background: linear-gradient(0deg, rgb(5 8 16 / 84%), transparent 42%, rgb(5 8 16 / 7%)); content: ''; pointer-events: none; }
  .hero-scene figcaption { position: absolute; z-index: 1; right: 1.2rem; bottom: 1.1rem; left: 1.2rem; display: grid; gap: 0.22rem; color: #fff; }
  .scene-title { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.8rem); font-weight: 700; }
  .scene-place, .scene-credit { color: rgb(255 255 255 / 0.84); font-size: 0.78rem; }
  .scene-credit a { color: #fff; text-decoration-color: var(--signal); text-underline-offset: 0.16em; }
  .scene-index { position: absolute; top: 1rem; left: 1rem; z-index: 1; padding: 0.4rem 0.55rem; border: 1px solid rgb(255 255 255 / 0.5); background: rgb(5 8 16 / 0.65); color: white; font: 0.62rem var(--font-data); letter-spacing: 0.08em; }
  .family-snapshot { padding-block: 1.5rem 1.7rem; border-block: 1px solid var(--line); }
  .family-heading, .section-heading, .photo-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.4rem; margin-bottom: 1.15rem; }
  .family-heading h2, .section-heading h2, .photo-heading h2 { max-width: 24ch; margin-top: 0.4rem; }
  .family-rail { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  .family-cell { display: grid; align-content: start; gap: 0.35rem; min-width: 0; min-height: 7rem; padding: 0.85rem; border-top: 2px solid var(--secondary); background: color-mix(in oklab, var(--surface) 58%, transparent); color: var(--text); text-decoration: none; }
  .family-desktop { border-top-color: var(--accent); }
  .family-server { border-top-color: var(--highlight); }
  .family-agents { border-top-color: var(--accent); }
  .family-studio { border-top-color: var(--mint); }
  .family-cell-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 0.5rem; }
  .family-cell-top small { color: var(--secondary); font: 0.6rem var(--font-data); text-transform: uppercase; }
  .family-detail, .family-inherit { color: var(--text-muted); font-size: 0.75rem; }
  .family-inherit { font-size: 0.68rem; }
  .family-note { margin-top: 0.75rem; color: var(--text-muted); font-size: 0.76rem; }
  .family-cell:hover .family-cell-top strong { color: var(--accent); }
  .section-heading { margin-bottom: 1.4rem; }
  .section-heading .text-link, .family-heading .text-link { flex: none; }
  .layout-stories { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 1rem; }
  .layout-story { min-width: 0; overflow: hidden; border: 1px solid var(--line); background: var(--surface); color: var(--text); text-decoration: none; }
  .layout-story :global(picture) { display: block; overflow: hidden; }
  .layout-story :global(img) { width: 100%; height: clamp(190px, 22vw, 310px); object-fit: cover; transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .layout-story:hover :global(img) { transform: scale(1.025); }
  .story-copy { display: grid; gap: 0.2rem; padding: 0.85rem 1rem 1rem; }
  .story-copy strong { font-family: var(--font-display); font-size: 1.1rem; }
  .story-copy span { color: var(--text-muted); font-size: 0.84rem; }
  .story-copy small { margin-top: 0.3rem; color: var(--secondary); font: 0.61rem var(--font-data); }
  .microcopy { max-width: 78ch; margin-top: 0.85rem; }
  .product-model { display: grid; grid-template-columns: 0.9fr 1.1fr; align-items: center; gap: 2rem; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--line); background: linear-gradient(135deg, var(--surface), color-mix(in oklab, var(--bg) 72%, var(--surface))); }
  .model-intro h2 { margin-top: 0.45rem; }
  .model-intro > p:not(.eyebrow) { max-width: 44ch; margin-block: 0.8rem 1rem; color: var(--text-muted); }
  .model-list { display: grid; }
  .model-list a { display: grid; grid-template-columns: 2.3rem 1fr auto; align-items: center; gap: 0.75rem; padding: 1rem 0.2rem; border-top: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .model-list a:hover strong { color: var(--accent); }
  .model-index { color: var(--secondary); font: 0.76rem var(--font-data); }
  .model-list strong, .model-list small { display: block; }
  .model-list small { margin-top: 0.2rem; color: var(--text-muted); }
  .terminal-feature { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem, 7vw, 7rem); padding: clamp(1.5rem, 4vw, 3.5rem) 0; border-block: 1px solid var(--line); }
  .terminal-feature h2 { margin-top: 0.45rem; font-size: clamp(2rem, 4.2vw, 4rem); line-height: 1; letter-spacing: -0.055em; }
  .terminal-feature h2 em { color: var(--accent); font-style: normal; }
  .terminal-feature-intro > p:not(.eyebrow) { max-width: 50ch; margin-top: 0.8rem; color: var(--text-muted); line-height: 1.6; }
  .terminal-feature-intro .text-link { display: inline-flex; margin-top: 1rem; }
  .terminal-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .terminal-strip > div { display: grid; justify-items: start; gap: 0.55rem; min-width: 0; padding: 1rem 0.6rem; border-right: 1px solid var(--line); }
  .terminal-strip > div:last-child { border: 0; }
  .terminal-glyph { display: grid; width: 2.5rem; aspect-ratio: 1; place-items: center; border: 1px solid var(--highlight); color: var(--highlight); font: 1rem var(--font-data); }
  .terminal-strip strong { font-family: var(--font-display); font-size: 0.9rem; }
  .terminal-strip code { color: var(--secondary); font-size: 0.65rem; }
  .photo-atlas { margin-block: clamp(4rem, 8vw, 8rem); }
  .photo-heading > p { max-width: 39ch; color: var(--text-muted); }
  .photo-heading h2 em { color: var(--accent); font-weight: 500; }
  .photo-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; list-style: none; }
  .photo-card { grid-column: span 4; min-width: 0; background: var(--surface); }
  .photo-card-1 { grid-column: span 7; }
  .photo-card-2 { grid-column: span 5; }
  .photo-image { position: relative; display: block; overflow: hidden; aspect-ratio: 16 / 9; background: var(--surface-raised); }
  .photo-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .photo-image:hover img { transform: scale(1.035); }
  .photo-open { position: absolute; right: 0.75rem; bottom: 0.75rem; padding: 0.4rem 0.55rem; background: rgb(5 8 16 / 0.76); color: white; font: 0.62rem var(--font-data); }
  .photo-caption { padding: 0.85rem 0.9rem 1rem; border-top: 1px solid var(--line); }
  .photo-place { color: var(--highlight); font: 0.62rem var(--font-data); }
  .photo-caption h3 { margin-block: 0.25rem; font-size: 1.05rem; }
  .photo-caption p, .photo-theme { font-size: 0.76rem; }
  .photo-caption p { color: var(--text-muted); }
  .photo-caption a { color: var(--text); text-decoration-color: var(--accent); text-underline-offset: 0.16em; }
  .photo-theme { display: inline-block; margin-top: 0.5rem; }
  .atlas-link { margin-top: 1.25rem; }
