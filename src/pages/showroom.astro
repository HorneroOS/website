---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ArchFrame from '../components/ArchFrame.astro';

const shots = (await getCollection('showroom')).sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout
  title="Showroom — Hornero OS"
  description="Real captures of the Hornero OS desktop: launcher, dashboard, themes, each labelled with where it came from."
>
  <section class="section">
    <p class="eyebrow">Real captures, no mockups</p>
    <h1>Showroom</h1>
    <p>
      Development captures of the Hornero desktop: Hyprland and the Hornero shell on Arch. The plate under each picture
      says what produced it, at which resolution and when.
    </p>
    <div class="gallery">
      {shots.map((s, i) => (
        <article class="shot">
          <h2>{s.data.title}</h2>
          <ArchFrame
            src={s.data.image}
            alt={s.data.alt}
            eager={i < 2}
            sizes="(min-width: 1180px) 540px, (min-width: 760px) calc(50vw - 3rem), calc(100vw - 2rem)"
            provenance={s.data.provenance}
          />
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 2rem 1.5rem;
    margin-top: 2rem;
  }

  .shot {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .shot h2 {
    font-size: var(--step-1);
  }
</style>
