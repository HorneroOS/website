---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ArchFrame from '../components/ArchFrame.astro';

const shots = (await getCollection('showroom')).sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout
  title="Showroom — Hornero OS"
  description="Real Hornero QA captures of flagship themes and shell layouts, each labelled with the build, test run and resolution that produced it."
>
  <section class="section">
    <p class="eyebrow">Captured from the running desktop</p>
    <h1>Showroom</h1>
    <p>
      These are real Hornero QA captures, not polished mockups. Each plate names the tested build, desktop state,
      resolution and date. Preview and candidate runs are labelled so the screenshots never imply a released system.
    </p>
    <div class="gallery">
      {shots.map((s, i) => (
        <article class="shot">
          <h2>{s.data.title}</h2>
          <ArchFrame
            src={s.data.image}
            alt={s.data.alt}
            eager={i < 2}
            sizes="(min-width: 1180px) 540px, (min-width: 920px) calc(50vw - 3rem), calc(100vw - 2rem)"
            provenance={s.data.provenance}
          />
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 2rem 1.5rem;
    margin-top: 2rem;
  }

  .shot {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .shot :global(.frame) {
    width: 100%;
  }

  .shot h2 {
    font-size: var(--step-1);
  }
</style>
