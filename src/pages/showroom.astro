---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const shots = await getCollection('showroom');
---

<SiteLayout
  title="Showroom — Hornero OS"
  description="Screenshots of the Hornero OS desktop: launcher, dashboard, themes."
>
  <section class="section">
    <h1>Showroom</h1>
    <p>
      Development snapshots of the Hornero desktop — Hyprland plus the Hornero Shell on Arch. Most were captured from
      the graphical test harness at 1280×720; the launcher capture is 1916×1078.
    </p>
    <div class="gallery">
      {shots.map((s, i) => (
        <figure class="shot">
          <Picture
            src={s.data.image}
            alt=""
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 800, 1280]}
            sizes="(min-width: 1100px) 510px, (min-width: 700px) calc(50vw - 3rem), calc(100vw - 2rem)"
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <figcaption>{s.data.title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</SiteLayout>
