        },
        {
          "id": "libvirt",
          "name": "libvirt / virt-manager",
          "driver": "VirtIO 3D (virgl)",
          "hardwareAcceleration": true
        },
        {
          "id": "quickemu",
          "name": "Quickemu",
          "driver": "OVMF + gl=\"on\" (VirGL)",
          "hardwareAcceleration": true
        }
      ]
    },
    {
      "tierId": "compatible-with-limitations",
      "entries": [
        {
          "id": "vmware",
          "name": "VMware Workstation / Fusion",
