{
  "$schema": "hornero.website.playground/1",
  "availability": {
    "publicBrowserSessionsEnabled": false,
    "providerSelected": false,
    "endpointEnvVar": "PUBLIC_PLAYGROUND_URL",
    "featureFlagEnvVar": "PUBLIC_PLAYGROUND_ENABLED",
