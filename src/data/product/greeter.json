{
  "version": 1,
  "design": "signal",
  "bundledMedia": false,
  "components": [
    "HorizonField.qml",
    "ChannelStrip.qml",
    "HorneroSprite.qml",
    "Signal.js",
    "Strings.js",
    "UserVideo.qml"
  ],
  "palettes": [
    {
      "id": "night",
      "name": "Signal Night"
    },
    {
      "id": "day",
      "name": "Signal Day"
    },
    {
      "id": "highContrast",
      "name": "Signal High Contrast"
    }
  ],
  "languages": [
    "en",
    "es"
  ],
  "defaults": {
    "colorScheme": "auto",
    "highContrast": false,
    "largeText": false,
    "reducedMotion": false,
    "language": "auto",
    "voice": "cozy",
    "mascot": true,
    "background": "horizon",
    "backgroundMotion": true,
    "backgroundDim": 0.55,
    "showUserChannels": true,
    "allowOtherUser": true,
    "confirmPower": true
  },
